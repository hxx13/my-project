}

.ai-drawer__pref-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border: 1px solid #e6ebf2;
  border-radius: 12rpx;
  background: #ffffff;
}

.ai-drawer__pref-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
