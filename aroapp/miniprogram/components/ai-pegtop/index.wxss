/*
 * 扫描助手「三枚陀螺花瓣」加载图标 —— **与 Web 端同款**（ScanAssistantPegtopLoader）。
 *
 * 为什么这么搬：小程序 wxml 不能内联 SVG，而 Web 那份动画全在 CSS 关键帧上（三枚同样的形状
 * 各自缩放/平移错开 0.3s）。所以把形状烘成 base64 背景图、把关键帧原样搬进 wxss。
 *
 * 颜色是**金色**（用户指定；Web 那份是橙、小程序原先的球是蓝，这里按用户要求走金色）。
 * 气泡左边那一处用它；抽屉顶部那颗大球（ai-orb）不动。
 */
.ai-pegtop {
  position: relative;
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}

.ai-pegtop__one,
.ai-pegtop__two,
.ai-pegtop__three {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-image: url("data:image/svg+xml;base64,");
}

.ai-pegtop__one {
  animation: ai-pegtop-flower-one 1s linear infinite;
}

.ai-pegtop__two {
  opacity: 0;
  transform: scale(0) translateY(-200px) translateX(-100px);
  animation: ai-pegtop-flower-two 1s linear infinite;
  animation-delay: 0.3s;
}

.ai-pegtop__three {
  opacity: 0;
  transform: scale(0) translateY(-200px) translateX(100px);
  animation: ai-pegtop-flower-three 1s linear infinite;
  animation-delay: 0.6s;
}

/*
 * **静止档**（动画=false）：思考结束之后就停在这里 —— 只留一枚、位置归零、另两枚收起。
 * 与 Web 的 --static 同一套口径：回答打完还在转，会让人以为它还在干活。
 */
.ai-pegtop--static .ai-pegtop__one,
.ai-pegtop--static .ai-pegtop__two,
.ai-pegtop--static .ai-pegtop__three {
  animation: none;
}

.ai-pegtop--static .ai-pegtop__one {
  opacity: 1;
  transform: none;
}

.ai-pegtop--static .ai-pegtop__two,
.ai-pegtop--static .ai-pegtop__three {
  display: none;
}

@keyframes ai-pegtop-flower-one {
  0% { opacity: 0; transform: scale(0.5) translateY(-200px); }
  25% { opacity: 1; transform: scale(0.75) translateY(-100px); }
  50% { opacity: 1; transform: scale(1) translateY(0); }
  75% { opacity: 1; transform: scale(0.5) translateY(50px); }
  100% { opacity: 0; transform: scale(0) translateY(100px); }
}

@keyframes ai-pegtop-flower-two {
  0% { opacity: 0; transform: scale(0.5) rotate(-10deg) translateY(-200px) translateX(-100px); }
  25% { opacity: 1; transform: scale(1) rotate(-5deg) translateY(-100px) translateX(-50px); }
  50% { opacity: 1; transform: scale(1) rotate(0deg) translateY(0) translateX(-25px); }
  75% { opacity: 1; transform: scale(0.5) rotate(5deg) translateY(50px) translateX(0); }
  100% { opacity: 0; transform: scale(0) rotate(10deg) translateY(100px) translateX(25px); }
}

@keyframes ai-pegtop-flower-three {
  0% { opacity: 0; transform: scale(0.5) rotate(10deg) translateY(-200px) translateX(100px); }
  25% { opacity: 1; transform: scale(1) rotate(5deg) translateY(-100px) translateX(50px); }
  50% { opacity: 1; transform: scale(1) rotate(0deg) translateY(0) translateX(25px); }
  75% { opacity: 1; transform: scale(0.5) rotate(-5deg) translateY(50px) translateX(0); }
  100% { opacity: 0; transform: scale(0) rotate(-10deg) translateY(100px) translateX(-25px); }
}
