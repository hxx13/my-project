  0%,
  100% {
    text-shadow:
      0 0 10rpx rgba(239, 68, 68, 0.95),
      0 0 22rpx rgba(220, 38, 38, 0.65),
      0 0 36rpx rgba(248, 113, 113, 0.42);
  }
  50% {
    text-shadow:
      0 0 16rpx rgba(254, 202, 202, 0.98),
      0 0 30rpx rgba(239, 68, 68, 0.78),
      0 0 48rpx rgba(220, 38, 38, 0.52);
  }
}

@keyframes art-metric-low-glow {
  0%,
  100% {
    text-shadow:
      0 0 10rpx rgba(96, 165, 250, 0.88),
      0 0 22rpx rgba(37, 99, 235, 0.58),
      0 0 36rpx rgba(59, 130, 246, 0.4);
  }
  50% {
    text-shadow:
      0 0 16rpx rgba(191, 219, 254, 0.95),
      0 0 30rpx rgba(59, 130, 246, 0.72),
      0 0 46rpx rgba(37, 99, 235, 0.5);
  }
}

