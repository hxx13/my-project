.art-root {
  flex: 1;
  height: 100%;
  min-height: 480rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.art-fill {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.art-pad {
  padding: 12rpx 10rpx;
}

.art-muted {
  color: #71717a;
  font-size: 26rpx;
}

.art-err {
  color: #b91c1c;
  font-size: 26rpx;
}

/* 楼层分页：横向均分、加大点击区（地下室 B1F-E10 等多 tab） */
.art-tabs-head {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0;
  padding: 0 4rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e4e4e7;
}

.art-tabs-head-embedded {
  padding-left: 2rpx;
  padding-right: 2rpx;
}

.art-tabs-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.art-tab {
  flex: 0 0 auto;
  min-width: 100rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 16rpx 20rpx 14rpx;
  border-bottom: 4rpx solid transparent;
  box-sizing: border-box;
}

.art-tab-on {
  border-bottom-color: #0284c7;
}

.art-tab-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #3f3f46;
  line-height: 1.2;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.art-tab-on .art-tab-name {
  color: #0f172a;
}

.art-room-overview-row {
  align-self: flex-end;
  padding: 8rpx 10rpx 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #64748b;
  text-decoration: underline;
  text-underline-offset: 3rpx;
}

.art-link-hover {
  opacity: 0.88;
}

.art-tabs-caption {
  flex-shrink: 0;
  padding: 0 8rpx 6rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e4e4e7;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.art-tabs-caption-txt,
.art-tabs-caption-dim {
  font-size: 24rpx;
  line-height: 1.25;
  color: #94a3b8;
  font-weight: 400;
}

.art-main {
  flex: 1;
  min-width: 0;
  min-height: 0;
  height: 100%;
  max-height: 100%;
  box-sizing: border-box;
  background: #f4f4f5;
}

.art-stack-main {
  flex: 1;
  min-height: 0;
}

.art-main-inner {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 16rpx;
  padding: 16rpx 10rpx 48rpx;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

.art-chunk {
  width: 100%;
  box-sizing: border-box;
}

/* 套间块：显式占满 scroll-view 内容宽，避免真机嵌套 flex 宽度未传递导致小房间纵向独占一行 */
.art-chunk-suite {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.art-chunk-zone-band {
  flex: 0 0 100%;
  width: 100%;
  margin: 4rpx 0 8rpx;
  padding: 10rpx 12rpx;
  background: #f0f9ff;
  border: 1rpx solid #bae6fd;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.art-zone-band-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #0c4a6e;
  letter-spacing: 0.02em;
}

.art-chunk-half {
  width: calc(50% - 4rpx);
  flex: 0 0 calc(50% - 4rpx);
  max-width: calc(50% - 4rpx);
}

/* 含开关类测点的套间独占一行，覆盖 suiteHalfRow 半宽 */
.art-chunk-suite.art-chunk-suite-switch-full {
  flex: 0 0 100%;
  width: 100%;
  max-width: 100%;
}

/* 手机端：多套间纵向排列，每套全宽，避免 Web 端「一行三卡」在窄屏上过挤 */
.art-chrome-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.art-chrome-cell {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.art-suite {
  width: 100%;
  min-width: 0;
  border-radius: 28rpx;
  border: 1rpx solid rgba(30, 55, 90, 0.12);
  background: linear-gradient(145deg, #ffffff 0%, #f5f7fa 50%, #eef1f6 100%);
  box-shadow: 0 8rpx 28rpx rgba(20, 40, 70, 0.09);
  overflow: hidden;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
}

.art-suite-hd {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  padding: 2rpx 0 12rpx;
  margin-bottom: 10rpx;
  background: transparent;
  border-bottom: 1rpx solid #e8e8ec;
}

.art-suite-hd-left {
  flex: 1;
  min-width: 0;
}

.art-suite-hd-right {
  flex-shrink: 0;
  max-width: 42%;
  text-align: right;
  align-self: center;
}

/* 与其它标题槽同一横向滚动行，避免单独占一行把时间戳顶下去 */
.art-title-slots-inline {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin-top: 0;
}

.art-suite-ts-compact {
  display: block;
  font-size: 22rpx;
  line-height: 1.2;
  font-family: ui-monospace, monospace;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.art-suite-title-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 6rpx 10rpx;
  min-width: 0;
}

/* 套间名与标题行压差同一行可横向滑动，避免名称与数值拆行分离 */
.art-suite-title-row--suite {
  flex-wrap: wrap;
  align-items: center;
  min-width: 0;
  overflow-x: visible;
}

.art-suite-title-press-line {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 8rpx 12rpx;
  min-width: min-content;
}

/* 套间名后参数合计 >4：收紧标题行内间距（与 Web compactTitleSlots 对齐） */
.art-suite-title-press-line--dense {
  gap: 6rpx 8rpx;
}

/* 套间标题行：图标 + 参数名 + 趋势 + 数值单位，单行高度不超过套间标题字行 */
.art-suite-metric-pill {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 6rpx 8rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 44rpx;
  padding: 6rpx 12rpx 6rpx 8rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e4e4e7;
  background: rgba(255, 255, 255, 0.92);
}

.art-suite-metric-pill--slot-row {
  margin-top: 0;
}

/* 套间内小房间为 3 间时：仅图标+数值，见 wxml visibleRooms.length === 3 */
.art-suite-metric-pill--icons-only {
  padding-left: 4rpx;
  padding-right: 6rpx;
  gap: 2rpx 6rpx;
}

.art-suite-metric-name {
  flex-shrink: 0;
  max-width: 140rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.art-suite-metric-pill .art-metric-inline-wrap {
  flex: 0 0 auto;
  justify-content: flex-start;
  min-width: 0;
  gap: 4rpx;
}

/* 设定值：点击数值改 WinCC（需超管） */
.art-metric-val--setpoint-tap {
  border-radius: 6rpx;
  padding: 2rpx 4rpx;
  margin: -2rpx -4rpx;
  box-sizing: border-box;
}

.art-suite-title {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #18181b;
}

.art-suite-inline-metric,
.art-metric-inline.art-suite-inline-metric {
  font-size: 22rpx;
  font-weight: 600;
  color: #3f3f46;
  line-height: 1.35;
}

.art-metric-inline.art-suite-inline-metric .art-metric-num-unit {
  font-size: 22rpx;
  font-weight: 700;
}

/* 套间标题 pill 内数值 */
.art-metric-inline.art-suite-pill-val .art-metric-num-unit,
.art-metric-inline.art-ts-val.art-suite-pill-val .art-metric-num-unit {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.art-title-slots-compact .art-metric-inline.art-ts-val.art-suite-pill-val .art-metric-num-unit {
  font-size: 16rpx;
}

/* 标题槽 >4：缩短参数名—数值、数值—趋势间距 */
.art-title-slots--dense.art-title-slots-compact .art-suite-metric-pill {
  gap: 2rpx 4rpx;
  padding: 0 6rpx 0 4rpx;
}

.art-title-slots--dense.art-title-slots-compact .art-suite-metric-pill .art-metric-inline-wrap {
  gap: 4rpx;
}

.art-title-slots--dense.art-title-slots-compact .art-suite-switch-pill {
  padding: 0 8rpx;
}

/* WinCC 开关：整块色块，绿开 / 红关；仅图标 + 名称 */
.art-suite-switch-pill {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid transparent;
  font-size: 22rpx;
  font-weight: 600;
}

.art-suite-switch-pill--on {
  background: #059669;
  border-color: #047857;
  color: #ffffff;
}

.art-suite-switch-pill--off {
  background: #e11d48;
  border-color: #be123c;
  color: #ffffff;
}

.art-suite-switch-pill--unknown {
  background: #f4f4f5;
  border-color: #e4e4e7;
  color: #71717a;
}

.art-suite-switch-pill--on .art-metric-ico--suite,
.art-suite-switch-pill--off .art-metric-ico--suite {
  color: rgba(255, 255, 255, 0.95);
}

.art-suite-switch-pill-name {
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 房间内开关：整行一条可点卡片 */
.art-metric-row-switch-only {
  padding: 4rpx 0;
  border-bottom: 1rpx solid #f4f4f5;
}

.art-metric-switch-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  width: 100%;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.art-metric-switch-card--on {
  background: #059669;
  border-color: #047857;
  color: #ffffff;
}

.art-metric-switch-card--off {
  background: #e11d48;
  border-color: #be123c;
  color: #ffffff;
}

.art-metric-switch-card--unknown {
  background: #f4f4f5;
  border-color: #e4e4e7;
  color: #71717a;
}

.art-metric-switch-card-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.art-metric-switch-card--on .art-metric-ico,
.art-metric-switch-card--off .art-metric-ico {
  color: rgba(255, 255, 255, 0.95);
}

/* 数值+单位合并为单 text（art-metric-num-unit） */
.art-metric-inline {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 0;
}

/* 窄数字体，略收紧字距（真机回退系统 mono） */
.art-metric-num {
  display: inline-block;
  min-width: 0;
  max-width: 100%;
  padding-right: 1rpx;
  text-align: right;
  font-size: 16rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  font-family: "SF Mono", "Menlo", "Roboto Mono", "Consolas", "Noto Sans Mono CJK SC", ui-monospace, monospace;
  letter-spacing: -0.04em;
  line-height: 1.15;
  color: inherit;
}

/* 单位列统一占位：以「%」最窄为基准列宽，Pa/℃ 同宽居中，避免左右参差 */
.art-metric-u {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 22rpx;
  min-width: 22rpx;
  max-width: 22rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  font-size: 11rpx;
  font-weight: 600;
  color: #71717a;
  line-height: 1;
}

.art-metric-u-pa {
  font-size: 9rpx;
  letter-spacing: -0.1em;
}

.art-metric-u-temp,
.art-metric-u-hum {
  font-size: 11rpx;
}

.art-metric-ico {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

/* 套间标题 pill 内图标与标题行高协调 */
.art-metric-ico--suite {
  width: 30rpx;
  height: 30rpx;
  font-size: 21rpx;
  margin-right: 0;
}

.art-metric-ico--sm {
  width: 28rpx;
  height: 28rpx;
  font-size: 18rpx;
}

.art-metric-ico--lg {
  width: 36rpx;
  height: 36rpx;
  font-size: 26rpx;
}

.art-metric-ico--suite.art-metric-ico--sm {
  width: 26rpx;
  height: 26rpx;
  font-size: 17rpx;
}

.art-metric-ico--suite.art-metric-ico--lg {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
}

.art-metric-lab-wrap {
  flex: 0 1 auto;
  max-width: 40%;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.art-metric-lab-wrap--icononly {
  flex: 0 0 auto;
  max-width: 20%;
  min-width: 28rpx;
  margin-right: 4rpx;
}

.art-ts-lab-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  max-width: 100%;
}

.art-metric-detail-sub {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #52525b;
}

.art-title-slots {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.art-title-slots-compact {
  margin-top: 6rpx;
  gap: 6rpx;
}

.art-title-slot {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e4e4e7;
  background: #ffffff;
}

.art-title-slots-compact .art-title-slot {
  padding: 2rpx 8rpx;
}

.art-ts-lab {
  font-size: 20rpx;
  color: #71717a;
}

.art-ts-val,
.art-metric-inline.art-ts-val {
  font-size: 22rpx;
  font-weight: 700;
  font-family: ui-monospace, monospace;
  color: #18181b;
}

.art-metric-inline.art-ts-val .art-metric-num-unit {
  font-size: 22rpx;
}

.art-title-slots-compact .art-ts-lab {
  font-size: 18rpx;
}

.art-title-slots-compact .art-ts-val,
.art-title-slots-compact .art-metric-inline.art-ts-val {
  font-size: 20rpx;
}

.art-title-slots-compact .art-metric-inline.art-ts-val .art-metric-num-unit {
  font-size: 20rpx;
}

.art-lab-muted {
  display: block;
  font-size: 20rpx;
  color: #a1a1aa;
}

.art-ts-latest {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #3f3f46;
  font-family: ui-monospace, monospace;
}

.art-suite-rooms {
  padding: 4rpx 2rpx 2rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* 套间内 1 间：单行铺满 */
.art-rooms-row-1 {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.art-rooms-row-1 .art-room-wrap {
  flex: 1 1 auto;
  min-width: 0;
}

/*
 * 套间内 2/3 间：用 Grid 替代 flex row。
 * 真机上 scroll-view 嵌套 flex 时，子项偶发按「内容最小宽度」撑满一行导致纵向堆叠；Grid + minmax(0,1fr) 可稳定双列/三列。
 */
.art-rooms-row-2 {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  align-items: stretch;
}

.art-rooms-row-2 .art-room-wrap {
  min-width: 0;
}

.art-rooms-row-3 {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  align-items: stretch;
}

.art-rooms-row-3 .art-room-wrap {
  min-width: 0;
}

.art-rooms-row-3 .art-room-wrap:nth-child(3):last-child {
  grid-column: 1 / -1;
}

/*
 * 套间内 ≥4 间：固定两列（与 row-2/3 一致用 Grid）。
 * 真机上前身为 flex+wrap+calc(50%)，易出现「每行只站一格且仅占半宽、右侧留白」；Grid 双列可避免。
 */
.art-rooms-many {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  align-items: stretch;
}

.art-rooms-many .art-room-wrap {
  min-width: 0;
  box-sizing: border-box;
}

/* 奇数个最后一格单独一行时铺满宽度 */
.art-rooms-many .art-room-wrap:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

.art-room-wrap {
  flex: 1;
  min-width: 0;
}

.art-chunk-half .art-room-wrap {
  flex: 1 1 auto;
}

.art-room-card {
  border-radius: 18rpx;
  border: 1rpx solid rgba(30, 55, 90, 0.1);
  background: linear-gradient(145deg, #ffffff 0%, #f5f7fa 50%, #eef1f6 100%);
  padding: 18rpx 16rpx 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(20, 40, 70, 0.06);
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.art-room-fill {
  width: 100%;
  box-sizing: border-box;
}

.art-room-hd {
  padding-bottom: 10rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #f4f4f5;
}

.art-room-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #18181b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 小房间内：图标 / 参数名 / 趋势 / 数值+单位 / 详情 列对齐；字号档位见 animal-room-telemetry.js computeCardMetricFontTier */
.art-room-metrics {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
}

.art-metric-row--roomgrid {
  display: grid;
  grid-template-columns: minmax(44rpx, auto) minmax(0, 1fr) 36rpx minmax(140rpx, 1.4fr);
  align-items: center;
  column-gap: 8rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.art-metric-g-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 32rpx;
  min-width: 0;
}

.art-metric-g-lab {
  min-width: 0;
  display: flex;
  align-items: center;
}

.art-metric-g-trend {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.art-metric-trend-place {
  width: 100%;
  max-width: 40rpx;
  min-height: 36rpx;
}

.art-metric-row--roomgrid .art-metric-trend--cell {
  width: auto;
  max-width: 40rpx;
  min-width: 0;
  min-height: 36rpx;
  margin-right: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1;
