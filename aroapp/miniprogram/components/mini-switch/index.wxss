.ms-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.ms-label {
  font-size: 22rpx;
  color: #969799;
  line-height: 1;
}

.ms-label--on {
  color: #1989fa;
  font-weight: 600;
}

/* 迷你开关（原生 <switch> 52×32px 太大太糙，已禁用）
   立体感走纯投影 + 柔和内凹，不用硬边 inset（硬边会看着像描边变粗） */
.ms {
  position: relative;
  width: 66rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: #e3e6eb;
  border: 1rpx solid #d5d9e0;
  box-shadow: inset 0 2rpx 5rpx rgba(15, 23, 42, 0.1);
  box-sizing: border-box;
  transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.ms--on {
  background: linear-gradient(180deg, #3aa0ff 0%, #0f7ae5 100%);
  border-color: #0d6dcf;
  box-shadow: inset 0 2rpx 5rpx rgba(6, 48, 92, 0.22), 0 2rpx 6rpx rgba(25, 137, 250, 0.28);
}

.ms-knob {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ffffff 0%, #f1f3f7 100%);
  box-shadow: 0 2rpx 4rpx rgba(15, 23, 42, 0.24), 0 0 0 1rpx rgba(15, 23, 42, 0.05);
  transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.ms--on .ms-knob {
  transform: translateX(28rpx);
}
