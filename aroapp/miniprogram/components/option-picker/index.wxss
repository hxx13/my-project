/* 触发器：与表单输入框同一套质感（白底 + 发丝边 + 极轻投影） */
.op-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  padding: 0 22rpx;
  background: #fbfcfd;
  border: 1rpx solid #e6e8ec;
  border-radius: 12rpx;
  box-shadow: 0 1rpx 3rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
}

.op-trigger--hover {
  background: #f4f6f9;
}

.op-trigger--off {
  background: #f2f3f5;
}

.op-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.op-value--ph {
  color: #b8bcc4;
}

.op-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #b8bcc4;
}

.op-popup {
  max-height: 76vh;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.op-panel {
  display: flex;
  flex-direction: column;
  max-height: 76vh;
}

.op-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f4f5f7;
}

.op-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #323233;
}

.op-close {
  font-size: 24rpx;
  color: #969799;
  padding: 6rpx 12rpx;
}

.op-list {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
  padding: 0 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.op-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.op-row:last-child {
  border-bottom: none;
}

.op-row-main {
  flex: 1;
  min-width: 0;
}

.op-row-label {
  display: block;
  font-size: 27rpx;
  color: #323233;
}

.op-row-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #969799;
}

.op-row--on .op-row-label {
  color: #2563eb;
  font-weight: 600;
}

.op-row-check {
  flex-shrink: 0;
  width: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 700;
}
