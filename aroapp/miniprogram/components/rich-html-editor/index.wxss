.rhe-root {
  display: block;
}

.rhe-body-hint {
  display: block;
  font-size: 22rpx;
  color: #969799;
  margin: -8rpx 0 16rpx;
  padding: 0 8rpx 0 32rpx;
  line-height: 1.5;
}

.rhe-section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  margin: 8rpx 0 12rpx;
  padding-left: 8rpx;
}

.rhe-chip-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  padding: 12rpx 8rpx 4rpx;
  margin-bottom: 12rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  box-sizing: border-box;
}

.rhe-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #323233;
  background: #ffffff;
  border-radius: 8rpx;
  border: 1rpx solid #ebedf0;
  box-sizing: border-box;
  line-height: 1.2;
  max-width: 100%;
}

.rhe-chip--primary {
  color: #1989fa;
  border-color: rgba(25, 137, 250, 0.35);
  background: rgba(25, 137, 250, 0.06);
  font-weight: 500;
}

.rhe-chip--active {
  opacity: 0.85;
  background: #ebedf0;
}

.rhe-preview-wrap {
  margin-bottom: 16rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
}

.rhe-preview-label {
  display: block;
  font-size: 24rpx;
  color: #969799;
  padding: 12rpx 16rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #ebedf0;
}

.rhe-preview-scroll {
  max-height: 280rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.rhe-preview-empty {
  font-size: 26rpx;
  color: #c8c9cc;
}
