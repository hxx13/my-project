.presence-bar {
  margin: 16rpx 0 0;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  position: relative;
  z-index: 1;
  transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  box-shadow:
    0 8rpx 32rpx rgba(15, 23, 42, 0.07),
    0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.presence-bar--loading {
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(30, 55, 90, 0.08);
}

.presence-loading-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 72rpx;
}

.presence-loading-text {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
}

.presence-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.presence-icon-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.presence-content {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.presence-head {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
}

.presence-phase-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

.presence-room-name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.02em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.presence-subhint {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.presence-subhint--warn {
  color: #c2410c;
  font-weight: 600;
}

.presence-pills {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.presence-pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  border: 1rpx solid;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.presence-pill--urgent {
  font-weight: 800;
}

.presence-exempt-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.presence-exempt-icon {
  flex-shrink: 0;
  line-height: 1;
}

.presence-exempt-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

.presence-exempt-rooms {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.presence-exempt-detail-col {
  flex-shrink: 0;
  margin-left: auto;
  align-self: center;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 2rpx;
}

.presence-exempt-detail-line {
  display: block;
  width: 100%;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: right;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.presence-live-dot {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  opacity: 0.72;
}

.presence-live-dot-core {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #07c160;
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.18);
}

.presence-live-dot-text {
  font-size: 18rpx;
  color: #15803d;
  font-weight: 600;
}
