/* 视觉基准：物资处理页（suppliesProcess）—— #f5f6f7 底 + 白卡 + 1rpx 描边，无投影无渐变 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f7;
  box-sizing: border-box;
}

/* ---- 顶部：数据源 tab + 搜索/筛选 + 已选条件 ---- */
.head {
  flex-shrink: 0;
  padding: 16rpx 24rpx 12rpx;
  background: #f5f6f7;
  border-bottom: 1rpx solid #ebedf0;
}

.tabs-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tabs-sum {
  margin-left: auto;
  font-size: 22rpx;
  color: #969799;
}

/* 分段控件（用户指定基准：报修申请页的切换 tab）——灰底槽 + 白底选中，无描边非胶囊 */
.seg {
  display: flex;
  align-items: center;
  padding: 4rpx;
  background: #f2f3f5;
  border-radius: 12rpx;
}

.seg-item {
  padding: 12rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.4;
  color: #646566;
  border-radius: 10rpx;
  white-space: nowrap;
}

.seg-item--on {
  color: #323233;
  font-weight: 600;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.toolbar-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 16rpx;
  background: #fff;
  border: 1rpx solid #ebedf0;
  border-radius: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: 26rpx;
  color: #323233;
}

.search-clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #969799;
}

/* 动作按钮：实底无描边、10rpx 直角 */
.tb-btn {
  flex-shrink: 0;
  padding: 0 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #334155;
  background: #f1f3f7;
  border-radius: 10rpx;
}

.tb-btn--hover {
  background: #e6e9ef;
}

.tb-btn-primary {
  color: #fff;
  background: #1989fa;
}

.tb-btn-on {
  color: #1989fa;
  background: #eaf4ff;
  font-weight: 600;
}

/* 已选条件：横滑可删 chip（实底、方角） */
.chip-scroll {
  margin-top: 12rpx;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #eaf4ff;
}

.chip-t {
  font-size: 22rpx;
  color: #1989fa;
  line-height: 1.5;
}

.chip-x {
  font-size: 20rpx;
  color: #1989fa;
  opacity: 0.7;
}

/* ---- 列表 ---- */
.list-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.list-pad {
  padding: 12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  padding: 16rpx 18rpx;
  margin-bottom: 10rpx;
}

/* 姓名 / 状态标签 / 时间 同一行：必须 center 对齐，baseline 会因字号差把标签顶高 */
.c-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.c-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #323233;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c-time {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #969799;
  font-variant-numeric: tabular-nums;
}

.c-line {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #646566;
  line-height: 1.45;
  word-break: break-all;
}

.c-line--sub {
  color: #969799;
}

/* 详情只给两行，超了省略（大量信息场景，别让单卡撑高） */
.c-line--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.c-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 8rpx;
}

.tag {
  font-size: 19rpx;
  border-radius: 6rpx;
  padding: 1rpx 10rpx;
  line-height: 1.5;
  color: #646566;
  background: #f2f3f5;
}

.tag-ok {
  color: #15803d;
  background: #e8f8ef;
}

.tag-bad {
  color: #dc2626;
  background: #fde8ea;
}

.c-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.c-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ebedf0;
  background: #f5f6f7;
}

/* ---- 状态 / 分页 ---- */
.state-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.state-txt {
  font-size: 26rpx;
  color: #969799;
}

/* 触底加载提示（不用上下页按钮） */
.load-more {
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #969799;
}

/* ---- 筛选抽屉 ---- */
.filter-popup {
  max-height: 78vh;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.fs-root {
  display: flex;
  flex-direction: column;
  max-height: 78vh;
}

.fs-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f4f5f7;
}

.fs-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #323233;
}

.fs-reset {
  font-size: 24rpx;
  color: #1989fa;
  padding: 6rpx 12rpx;
}

.fs-reset--hover {
  opacity: 0.7;
}

.fs-body {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.fs-label {
  flex-shrink: 0;
  width: 132rpx;
  font-size: 24rpx;
  color: #969799;
}

.fs-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.fs-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #323233;
  background: #f2f3f5;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.fs-input-row--switch {
  justify-content: space-between;
}

.fs-date-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
}

.fs-date {
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  color: #323233;
  background: #f2f3f5;
  border-radius: 10rpx;
}

.fs-sep {
  font-size: 24rpx;
  color: #969799;
}

/* 抽屉底部：按钮走全局 .chip-btn，只负责排版 */
.fs-foot {
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
  padding: 14rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f4f5f7;
}
