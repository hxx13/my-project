<view class="page">
  <view class="head">
    <view class="search-bar">
      <view class="search-box {{searchFocused ? 'search-box--focus' : ''}}">
        <van-icon name="search" size="30rpx" color="#94a3b8" />
        <input
          class="search-input"
          placeholder="搜索通道名称/编码"
          placeholder-class="search-placeholder"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          bindconfirm="onSearchConfirm"
          bindfocus="onSearchFocus"
          bindblur="onSearchBlur"
          confirm-type="search"
        />
        <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearKeyword">
          <van-icon name="clear" size="28rpx" color="#94a3b8" />
        </view>
      </view>
      <view
        class="refresh-btn {{statusRefreshing ? 'refresh-btn--busy' : ''}}"
        aria-role="button"
        aria-label="刷新状态"
        bindtap="onRefreshTap"
      >
        <text class="refresh-icon">↻</text>
      </view>
    </view>

    <scroll-view class="filters" scroll-x show-scrollbar="{{false}}">
      <view
        wx:for="{{statusFilters}}"
        wx:key="key"
        class="filter-chip {{activeStatusFilter===item.key ? 'filter-chip--on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTapStatusFilter"
      >
        <text class="filter-label">{{item.label}}</text>
        <text class="filter-count">{{statusCounts[item.countKey]}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="layout">
    <view class="sidebar-col">
      <scroll-view class="folder-sidebar" scroll-y>
        <view
          class="folder-item {{selectedFolder==='' ? 'folder-item--on' : ''}}"
          data-folder=""
          bindtap="onTapFolder"
        >
          <text class="folder-name">全部</text>
        </view>
        <view
          wx:for="{{sidebarFolders}}"
          wx:key="name"
          class="folder-item {{selectedFolder===item.name ? 'folder-item--on' : ''}}"
          data-folder="{{item.name}}"
          bindtap="onTapFolder"
        >
          <text class="folder-name">{{item.name}}</text>
        </view>
      </scroll-view>
    </view>

    <scroll-view
      class="door-panel"
      scroll-y
      refresher-enabled="{{true}}"
      refresher-triggered="{{panelRefreshing}}"
      refresher-background="#eef0f6"
      bindrefresherrefresh="onPanelRefresher"
    >
      <view wx:if="{{loading}}" class="hint">加载通道…</view>
      <view wx:elif="{{currentItems.length === 0}}" class="hint">
        {{keyword ? '没有匹配的通道' : (statusCounts.all===0 ? '暂无可控通道' : '当前筛选下无匹配通道')}}
      </view>
      <view wx:else class="door-grid">
        <view wx:for="{{currentItems}}" wx:key="code" class="door-cell {{modeMenuCode===item.code ? 'door-cell--menu' : ''}}">
          <view class="door-card door-card--{{item.tone}} {{item.busy ? 'door-card--busy' : ''}}">
            <view class="door-head">
              <view class="door-icon door-icon--{{item.tone}}"></view>
              <text class="door-name">{{item.name}}</text>
            </view>

            <view class="door-actions">
              <view wx:if="{{item.offline}}" class="door-offline">设备离线，无法操作</view>
              <block wx:else>
                <view class="door-split">
                  <view class="door-act-btn" data-code="{{item.code}}" data-mode="OPEN" catchtap="onDoorAction">
                    <text wx:if="{{item.pendingMode==='OPEN'}}" class="door-spin">⟳</text>
                    <text wx:elif="{{flashCode===item.code && flashMode==='OPEN'}}" class="door-act-flash">已开</text>
                    <view wx:else class="door-ico door-ico--open"></view>
                  </view>
                  <view class="door-act-btn" data-code="{{item.code}}" data-mode="CLOSE" catchtap="onDoorAction">
                    <text wx:if="{{item.pendingMode==='CLOSE'}}" class="door-spin">⟳</text>
                    <text wx:elif="{{flashCode===item.code && flashMode==='CLOSE'}}" class="door-act-flash">已关</text>
                    <view wx:else class="door-ico door-ico--close"></view>
                  </view>
                </view>

                <view class="door-mode-wrap">
                  <view class="door-mode-trigger door-mode-trigger--{{item.tone}}" data-code="{{item.code}}" catchtap="onTapModePicker">
                    <text wx:if="{{item.pendingMode}}" class="door-spin">⟳</text>
                    <text wx:else>{{item.modeLabel}} ▾</text>
                  </view>
                  <view wx:if="{{modeMenuCode===item.code}}" class="door-mode-menu" catchtap="noop">
                    <view
                      wx:for="{{modeOptions}}"
                      wx:for-item="m"
                      wx:key="key"
                      class="door-mode-item {{item.mode===m.key ? 'door-mode-item--on' : ''}}"
                      data-code="{{item.code}}"
                      data-mode="{{m.key}}"
                      catchtap="onDoorAction"
                    >
                      <text>{{m.label}}</text>
                      <text wx:if="{{item.mode===m.key}}" class="door-mode-check">✓</text>
                    </view>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
