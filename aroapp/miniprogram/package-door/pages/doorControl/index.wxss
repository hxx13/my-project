/* 门禁控制：左侧文件夹树 + 右侧双列门卡，配色对齐实验动物订购页
   （底色 #eef0f6、卡片白底细投影、主色 #2563eb、绿 #16a34a / 红 #dc2626） */
page {
  height: 100%;
  overflow: hidden;
}

.page {
  height: 100%;
  background: #eef0f6;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* ===== 顶部固定区 ===== */
.head {
  flex-shrink: 0;
  background: #eef0f6;
  padding: 20rpx 24rpx 4rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-box--focus {
  border-color: #2563eb;
  box-shadow: 0 6rpx 18rpx rgba(37, 99, 235, 0.16);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.search-placeholder {
  color: #94a3b8;
}

.search-clear {
  flex-shrink: 0;
  padding: 6rpx;
}

.refresh-btn {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
  transition: background-color 0.2s ease;
}

.refresh-btn--busy {
  background: #eff4ff;
}

.refresh-icon {
  font-size: 34rpx;
  line-height: 1;
  color: #2563eb;
}

.refresh-btn--busy .refresh-icon {
  color: #94a3b8;
  animation: door-refresh-spin 0.9s linear infinite;
}

@keyframes door-refresh-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 状态筛选 ===== */
.filters {
  white-space: nowrap;
  padding: 16rpx 0 10rpx;
  box-sizing: border-box;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  background: #fff;
  box-sizing: border-box;
  vertical-align: top;
}

.filter-chip--on {
  background: #2563eb;
}

.filter-label {
  font-size: 23rpx;
  font-weight: 600;
  color: #334155;
}

.filter-count {
  font-size: 20rpx;
  font-weight: 600;
  color: #94a3b8;
}

.filter-chip--on .filter-label,
.filter-chip--on .filter-count {
  color: #fff;
}

/* ===== 左栏文件夹 + 右栏门卡 ===== */
.layout {
  display: flex;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.sidebar-col {
  width: 110rpx;
  flex-shrink: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f6f7fb;
  border-right: 1rpx solid #eef0f4;
}

/* scroll-view 必须限定高度；flex:1 + height:0 是小程序侧可靠写法 */
.folder-sidebar {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 0;
}

.folder-item {
  margin: 0 8rpx 8rpx;
  padding: 14rpx 10rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

.folder-name {
  max-width: 100%;
  font-size: 21rpx;
  line-height: 1.35;
  color: #334155;
  word-break: break-all;
}

.folder-item--on {
  background: #2563eb;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}

.folder-item--on .folder-name {
  color: #fff;
  font-weight: 600;
}

.door-panel {
  flex: 1;
  height: 100%;
  min-height: 0;
  min-width: 0;
  padding: 0;
  box-sizing: border-box;
}

.door-grid {
  display: flex;
  flex-wrap: wrap;
  box-sizing: border-box;
  padding: 20rpx 12rpx calc(24rpx + env(safe-area-inset-bottom));
}

.door-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 0 8rpx 16rpx;
}

/* 菜单展开时整格抬层，避免被相邻卡片盖住 */
.door-cell--menu {
  position: relative;
  z-index: 10;
}

.door-card {
  min-height: 140rpx;
  padding: 14rpx;
  background: #fff;
  border: 1rpx solid #ebedf0;
  border-left: 6rpx solid transparent;
  border-radius: 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10rpx;
}

/* 状态底色：常开绿 / 常闭红 / 普通白 / 离线灰，只做淡底 + 左侧色条 */
.door-card--stayopen {
  background: #f0fdf4;
  border-color: #d7f0e0;
  border-left-color: #22c55e;
}

.door-card--stayclose {
  background: #fef4f4;
  border-color: #f7dada;
  border-left-color: #ef4444;
}

.door-card--offline,
.door-card--unknown {
  background: #f7f8fa;
  border-left-color: #d5d8de;
}

.door-card--busy {
  background: #eef1f5;
}

.door-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  min-width: 0;
}

.door-icon {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background-color: rgba(15, 23, 42, 0.04);
  background-position: center;
  background-repeat: no-repeat;
  background-size: auto 30rpx;
}

.door-icon--stayopen {
  background-image: url("data:image/svg+xml;base64,");
}

.door-icon--stayclose {
  background-image: url("data:image/svg+xml;base64,");
}

.door-icon--normal {
  background-image: url("data:image/svg+xml;base64,");
}

.door-icon--offline,
.door-icon--unknown {
  background-image: url("data:image/svg+xml;base64,");
}

.door-name {
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 23rpx;
  line-height: 1.4;
  color: #323233;
  word-break: break-all;
}

.door-card--offline .door-name {
  color: #969799;
}

/* ===== 卡片内动作区（常驻）：左开/关门，右当前模式下拉 ===== */
.door-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.door-split {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.door-act-btn {
  flex: 0 0 auto;
  width: 52rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 19rpx;
  font-weight: 500;
  color: #475569;
}

.door-ico {
  width: 26rpx;
  height: 26rpx;
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}

.door-ico--open {
  background-image: url("data:image/svg+xml;base64,");
}

.door-ico--close {
  background-image: url("data:image/svg+xml;base64,");
}

.door-act-flash {
  font-size: 19rpx;
  color: #475569;
}

.door-mode-wrap {
  position: relative;
  flex-shrink: 0;
}

.door-mode-trigger {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  box-sizing: border-box;
}

/* 实色：沿用订购页面的绿/红/蓝主色 */
.door-mode-trigger--stayopen {
  background: #16a34a;
}

.door-mode-trigger--stayclose {
  background: #dc2626;
}

.door-mode-trigger--normal {
  background: #2563eb;
}

.door-mode-trigger--offline,
.door-mode-trigger--unknown {
  background: #94a3b8;
}

.door-mode-menu {
  position: absolute;
  right: 0;
  bottom: calc(100% + 6rpx);
  z-index: 20;
  min-width: 132rpx;
  padding: 4rpx;
  background: #fff;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  border-radius: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.12);
  box-sizing: border-box;
}

.door-mode-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  height: 44rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  color: #475569;
}

.door-mode-item--on {
  color: #2563eb;
}

.door-mode-check {
  font-size: 18rpx;
  color: #2563eb;
}

.door-offline {
  flex: 1;
  padding: 10rpx 0;
  text-align: center;
  font-size: 21rpx;
  color: #969799;
}

.door-spin {
  font-size: 22rpx;
  line-height: 1;
  color: #94a3b8;
}

/* ===== 提示与空态 ===== */
.hint {
  text-align: center;
  font-size: 24rpx;
  color: #969799;
  padding: 48rpx 0;
}
