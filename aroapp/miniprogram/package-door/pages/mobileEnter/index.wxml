<view class="me-root">
  <!-- 一键开关 -->
  <view class="me-card">
    <view class="me-master-row">
      <view class="me-master-text">
        <text class="me-master-title">一键开关（所有人）</text>
        <text class="me-master-desc">控制名单之外的所有人，默认关闭。白名单 / 黑名单不受它控制。</text>
      </view>
      <switch checked="{{ masterEnabled }}" color="#2563eb" disabled="{{ masterSaving }}" bindchange="onToggleMaster" />
    </view>
  </view>

  <!-- 名单切换 -->
  <view class="me-tabs">
    <view class="me-tab {{ listKey === 'WHITE' ? 'me-tab--on' : '' }}" data-key="WHITE" bindtap="onTabChange">白名单</view>
    <view class="me-tab {{ listKey === 'BLACK' ? 'me-tab--on' : '' }}" data-key="BLACK" bindtap="onTabChange">黑名单</view>
  </view>

  <!-- 工具条 -->
  <view class="me-card">
    <view class="me-tool-row">
      <input class="me-input" value="{{ kwDraft }}" placeholder="搜账号 id" placeholder-class="me-ph"
        confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearch" />
      <view class="me-btn me-btn--pri" bindtap="onSearch">搜索</view>
    </view>
    <view class="me-btn-row">
      <view class="me-btn" bindtap="onOpenPicker">＋ 添加到{{ listKey === 'WHITE' ? '白名单' : '黑名单' }}</view>
      <view wx:if="{{ selectedCount > 0 }}" class="me-btn me-btn--danger" bindtap="onRemoveSelected">移出（{{ selectedCount }}）</view>
    </view>
    <text class="me-hint">{{ listKey === 'WHITE' ? '白名单：无论一键开关怎么设，这些人都能看到「进入」按钮。' : '黑名单：无论一键开关怎么开，这些人都看不到「进入」按钮。' }}</text>
  </view>

  <!-- 名单 -->
  <view class="me-card">
    <view class="me-list-head">
      <view class="me-check {{ rows.length > 0 && selectedCount === rows.length ? 'me-check--on' : '' }}" bindtap="onToggleAll">✓</view>
      <text class="me-list-head-t">共 {{ rows.length }} 条 · 已选 {{ selectedCount }}</text>
    </view>

    <view wx:if="{{ loading }}" class="me-empty">加载中…</view>
    <view wx:elif="{{ rows.length === 0 }}" class="me-empty">{{ keyword ? '没有符合条件的账号' : (listKey === 'WHITE' ? '白名单为空' : '黑名单为空') }}</view>
    <block wx:else>
      <view wx:for="{{ rows }}" wx:key="userId" class="me-row" data-idx="{{ index }}" bindtap="onToggleRow">
        <view class="me-check {{ item.selected ? 'me-check--on' : '' }}">✓</view>
        <view class="me-row-main">
          <text class="me-row-id mono">{{ item.userId }}</text>
          <text class="me-row-meta">{{ item.enabled ? '始终开启' : '始终关闭' }} · {{ item.updatedAt || '—' }}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 选人（搜索式多选） -->
  <van-popup show="{{ pickerOpen }}" position="bottom" round safe-area-inset-bottom custom-class="me-pick-popup" bind:close="onClosePicker">
    <view class="me-pick-sheet">
      <!-- 动作收进标题栏，不再压一个大页脚在列表上 -->
      <view class="me-bar">
        <text class="me-bar-act" catchtap="onClosePicker">取消</text>
        <text class="me-bar-title">添加到{{ listKey === 'WHITE' ? '白名单' : '黑名单' }}</text>
        <text class="me-bar-act me-bar-act--pri" catchtap="onConfirmPicker">确定</text>
      </view>
      <text class="me-bar-sub">已选 {{ pickerCount }} 人 · 搜姓名 / 工号 / 账号</text>
      <view class="me-pick-search">
        <input class="me-input" value="{{ pickerKeyword }}" placeholder="搜姓名 / 工号 / 账号" placeholder-class="me-ph"
          bindinput="onPickerKeywordInput" confirm-type="search" />
        <view wx:if="{{ pickerKeyword }}" class="me-btn" bindtap="clearPickerKeyword">清空</view>
      </view>
      <scroll-view scroll-y class="me-pick-list">
        <view wx:if="{{ pickerLoading }}" class="me-empty">加载中…</view>
        <view wx:elif="{{ pickerRows.length === 0 }}" class="me-empty">没有匹配的人员</view>
        <block wx:else>
          <view wx:for="{{ pickerRows }}" wx:key="id" class="me-row" data-idx="{{ index }}" bindtap="onTogglePickerRow">
            <view class="me-check {{ item.selected ? 'me-check--on' : '' }}">✓</view>
            <view class="me-row-main">
              <text class="me-row-id">{{ item.label }}</text>
              <text class="me-row-meta">{{ item.sub || item.id }}</text>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </van-popup>
</view>
