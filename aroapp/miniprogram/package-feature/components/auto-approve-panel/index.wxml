<view wx:if="{{ visible }}" class="auto-mask" bindtap="onCloseTap">
  <view class="auto-panel" catchtap="noop">
    <view class="auto-head">
      <text class="auto-title">{{ panelTitle }}</text>
      <view class="auto-head-ops">
        <view class="op op-ghost auto-run" bindtap="onRunNow">{{ running ? '执行中…' : '立即执行' }}</view>
        <text class="auto-close" bindtap="onCloseTap">×</text>
      </view>
    </view>
    <text class="auto-tip">{{ panelTip }}</text>

    <view class="sub-tabs">
      <view class="sub-tab {{ subTab === 'trust' ? 'sub-tab-on' : '' }}" data-tab="trust" bindtap="onSubTabChange">按人规则</view>
      <view class="sub-tab {{ subTab === 'batch' ? 'sub-tab-on' : '' }}" data-tab="batch" bindtap="onSubTabChange">批量规则</view>
    </view>

    <scroll-view scroll-y class="auto-scroll" enhanced show-scrollbar="{{ false }}">
      <view wx:if="{{ loading }}" class="hint">加载中…</view>

      <block wx:elif="{{ subTab === 'trust' }}">
        <view class="form-card">
          <text class="form-title">新增 / 编辑按人规则</text>

          <text class="field-label">从已有记录选择申请人</text>
          <picker mode="selector" range="{{ candidateLabels }}" value="{{ candidateIndex }}" bindchange="onCandidatePick">
            <view class="picker-box">{{ candidateLabels[candidateIndex] }}</view>
          </picker>

          <view wx:if="{{ trustForm.subjectUserId }}" class="info-box">
            申请人：{{ trustForm.subjectDisplayName || trustForm.subjectUserId }}
          </view>

          <text class="field-label">{{ dimensionFieldLabel }}</text>
          <picker mode="selector" range="{{ dimensionLabels }}" value="{{ dimensionIndex }}" bindchange="onDimensionPick">
            <view class="picker-box">{{ dimensionLabels[dimensionIndex] }}</view>
          </picker>

          <text class="field-label">触发方式</text>
          <picker mode="selector" range="{{ triggerModeLabels }}" value="{{ triggerModeIndex }}" bindchange="onTriggerModePick">
            <view class="picker-box">{{ triggerModeLabels[triggerModeIndex] }}</view>
          </picker>

          <block wx:if="{{ trustForm.triggerMode === 'SCHEDULED' }}">
            <text class="field-label">每天触发时间</text>
            <picker mode="time" value="{{ trustScheduleTime }}" bindchange="onTrustTimePick">
              <view class="picker-box">{{ trustScheduleTime }}</view>
            </picker>
          </block>

          <text class="field-label">备注（可选）</text>
          <input class="field-input" placeholder="备注" value="{{ trustForm.note }}" bindinput="onTrustNoteInput" />

          <view class="form-ops">
            <view class="op op-primary" bindtap="onSaveTrustRule">{{ saving ? '保存中…' : '保存规则' }}</view>
            <view wx:if="{{ trustForm.id || trustForm.selectedKey }}" class="op op-ghost" bindtap="onClearTrustForm">清空</view>
          </view>
        </view>

        <view wx:if="{{ trustRulesOnSubmit.length > 0 }}" class="list-section">
          <text class="list-title">提交时审批（{{ trustRulesOnSubmit.length }}）</text>
          <view wx:for="{{ trustRulesOnSubmit }}" wx:key="id" class="rule-card">
            <view class="rule-head">
              <text class="rule-name">{{ item.subjectDisplayName || item.subjectUserId }}</text>
              <text class="tag {{ item.enabled ? 'tag-ok' : 'tag-muted' }}">{{ item.enabled ? '启用' : '停用' }}</text>
            </view>
            <text class="rule-meta">{{ item.dimensionLabel }}</text>
            <text wx:if="{{ item.note }}" class="rule-meta">{{ item.note }}</text>
            <view class="rule-ops">
              <text class="link" data-id="{{ item.id }}" bindtap="onEditTrustRule">编辑</text>
              <text class="link link-danger" data-id="{{ item.id }}" bindtap="onDeleteTrustRule">删除</text>
            </view>
          </view>
        </view>

        <view wx:if="{{ trustRulesScheduled.length > 0 }}" class="list-section">
          <text class="list-title">定时审批（{{ trustRulesScheduled.length }}）</text>
          <view wx:for="{{ trustRulesScheduled }}" wx:key="id" class="rule-card">
            <view class="rule-head">
              <text class="rule-name">{{ item.subjectDisplayName || item.subjectUserId }}</text>
              <text class="tag {{ item.enabled ? 'tag-ok' : 'tag-muted' }}">{{ item.enabled ? '启用' : '停用' }}</text>
            </view>
            <text class="rule-meta">{{ item.dimensionLabel }}</text>
            <text class="rule-meta">定时：{{ item.scheduleLabel }}</text>
            <text wx:if="{{ item.note }}" class="rule-meta">{{ item.note }}</text>
            <view class="rule-ops">
              <text class="link" data-id="{{ item.id }}" bindtap="onEditTrustRule">编辑</text>
              <text class="link link-danger" data-id="{{ item.id }}" bindtap="onDeleteTrustRule">删除</text>
            </view>
          </view>
        </view>

        <view wx:if="{{ !loading && trustRulesOnSubmit.length === 0 && trustRulesScheduled.length === 0 }}" class="hint">暂无按人规则</view>

        <view class="list-section">
          <text class="list-title">建议（一键预填并保存）</text>
          <view wx:if="{{ suggestions.length === 0 }}" class="hint">暂无建议</view>
          <view wx:for="{{ suggestions }}" wx:key="label" class="sug-row">
            <text class="sug-text">{{ item.label }}</text>
            <view wx:if="{{ !item.alreadyTrusted }}" class="op op-primary op-sm" data-idx="{{ index }}" bindtap="onApplySuggestion">添加</view>
            <text wx:else class="tag tag-ok">已配置</text>
          </view>
        </view>
      </block>

      <block wx:elif="{{ subTab === 'batch' }}">
        <view class="form-card">
          <text class="form-title">新增 / 编辑批量规则</text>

          <text class="field-label">规则名称</text>
          <input class="field-input" placeholder="规则名称" value="{{ batchForm.name }}" bindinput="onBatchNameInput" />

          <text class="field-label">{{ dimensionFieldLabel }}（多选）</text>
          <view class="check-list">
            <view wx:for="{{ dimensionOptions }}" wx:key="id" class="check-row" data-id="{{ item.id }}" bindtap="onToggleBatchDimension">
              <text class="check-box">{{ item.checked ? '☑' : '☐' }}</text>
              <text>{{ item.label }}</text>
            </view>
          </view>

          <text class="field-label">每天触发时间</text>
          <picker mode="time" value="{{ batchScheduleTime }}" bindchange="onBatchTimePick">
            <view class="picker-box">{{ batchScheduleTime }}</view>
          </picker>

          <text class="field-label">单次上限</text>
          <input class="field-input" type="number" value="{{ batchForm.maxPerRun }}" bindinput="onBatchMaxInput" />

          <view class="form-ops">
            <view class="op op-primary" bindtap="onSaveBatchRule">{{ saving ? '保存中…' : '保存批量规则' }}</view>
            <view wx:if="{{ batchForm.id }}" class="op op-ghost" bindtap="onClearBatchForm">清空</view>
          </view>
        </view>

        <view wx:if="{{ batchRules.length === 0 }}" class="hint">暂无批量规则</view>
        <view wx:for="{{ batchRules }}" wx:key="id" class="rule-card">
          <text class="rule-name">{{ item.name }}</text>
          <text class="rule-meta">{{ kind === 'material' ? '物资' : '选项' }}：{{ kind === 'material' ? item.itemSummary : item.optionSummary }}</text>
          <text class="rule-meta">定时：{{ item.scheduleLabel }}</text>
          <view class="rule-ops">
            <text class="link" data-id="{{ item.id }}" bindtap="onEditBatchRule">编辑</text>
            <text class="link link-danger" data-id="{{ item.id }}" bindtap="onDeleteBatchRule">删除</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
