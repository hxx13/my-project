.esp-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
}
.esp-sub {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
}
.esp-mono {
  font-family: monospace;
  font-weight: 700;
  color: #4f46e5;
}
.esp-section {
  margin-bottom: 18rpx;
}
.esp-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 10rpx;
}
.esp-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.esp-link {
  font-size: 22rpx;
  color: #4f46e5;
}
.esp-mode-row {
  display: flex;
  gap: 10rpx;
}
.esp-mode-chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  border-radius: 12rpx;
  border: 1rpx solid #dce3ef;
  background: #f8fafc;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}
.esp-mode-active {
  background: #fef3c7;
  border-color: #fbbf24;
  color: #92400e;
}
.esp-until-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.esp-until-chip {
  min-width: calc(33.33% - 12rpx);
  flex: 1 0 calc(33.33% - 12rpx);
  box-sizing: border-box;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 16rpx;
  border: 1rpx solid #dce3ef;
  background: #ffffff;
  color: #334155;
}
.esp-until-active {
  background: #fef3c7;
  border-color: #fbbf24;
  color: #92400e;
}
.esp-until-time {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
}
.esp-until-tag {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  opacity: 0.65;
  font-weight: 600;
}
.esp-preset {
  padding: 16rpx 18rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  border: 1rpx solid #dce3ef;
  background: #ffffff;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}
.esp-hint {
  font-size: 22rpx;
  color: #94a3b8;
}
.esp-hint-bottom {
  margin-bottom: 12rpx;
}
.esp-room-scroll {
  max-height: 280rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #fff;
  padding: 8rpx;
  box-sizing: border-box;
}
.esp-room-item {
  padding: 16rpx 18rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  border: 1rpx solid #dce3ef;
  background: #f8fafc;
  transition: background 0.15s ease, border-color 0.15s ease;
}
.esp-room-item-active {
  background: #fef3c7;
  border-color: #fbbf24;
}
.esp-room-name {
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}
.esp-room-item-active .esp-room-name {
  color: #92400e;
  font-weight: 700;
}
.esp-submit {
  margin-top: 8rpx !important;
}
