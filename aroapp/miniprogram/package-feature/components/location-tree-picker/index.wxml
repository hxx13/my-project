<!-- 存放地点树选择器：触发器 + 底部弹出面板（分级 / 默认收起 / 可搜索） -->
<view class="ltp">
  <view
    class="ltp-trigger {{disabled ? 'ltp-trigger-disabled' : ''}}"
    hover-class="{{disabled ? '' : 'ltp-trigger-hover'}}"
    bindtap="onToggleOpen"
  >
    <text class="ltp-value {{value ? '' : 'ltp-placeholder'}}">{{value || placeholder}}</text>
    <text class="ltp-arrow">▾</text>
  </view>

  <view wx:if="{{open}}" class="ltp-mask" bindtap="close" catchtouchmove="noop">
    <view class="ltp-panel" catchtap="noop">
      <view class="ltp-head">
        <text class="ltp-title">选择存放地点</text>
        <text class="ltp-close" bindtap="close">关闭</text>
      </view>

      <view class="ltp-search">
        <input
          class="ltp-input"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          placeholder="搜索地点…"
          confirm-type="search"
        />
        <text wx:if="{{keyword}}" class="ltp-clear" bindtap="onClearKeyword">✕</text>
      </view>

      <scroll-view
        scroll-y
        class="ltp-list"
        scroll-into-view="{{scrollIntoViewId}}"
        scroll-with-animation
      >
        <view
          wx:for="{{rows}}"
          wx:key="id"
          id="ltp-row-{{item.id}}"
          class="ltp-row {{item.selected ? 'ltp-row-selected' : ''}}"
          style="padding-left: {{item.depth * 24}}rpx"
          data-id="{{item.id}}"
          data-path="{{item.path}}"
          bindtap="onPick"
        >
          <!-- 叶子节点不渲染可点区域：否则那块空白会把整行的「选中」点击吃掉 -->
          <view
            wx:if="{{item.hasChildren}}"
            class="ltp-chevron"
            hover-class="ltp-chevron-hover"
            catchtap="onToggleExpand"
            data-id="{{item.id}}"
          >{{item.open ? '▾' : '▸'}}</view>
          <view wx:else class="ltp-chevron-gap"></view>
          <text wx:if="{{item.icon}}" class="ltp-icon">{{item.icon}}</text>
          <text class="ltp-name">{{item.name}}</text>
        </view>
        <view wx:if="{{!rows.length}}" class="ltp-empty">没有匹配的地点</view>
      </scroll-view>
    </view>
  </view>
</view>
