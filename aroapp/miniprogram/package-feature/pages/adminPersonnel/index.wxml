<view class="ap-root">
  <view class="ap-header">
    <view class="ap-tabs">
      <view class="ap-tab {{ activeTab === 'all' ? 'ap-tab--on' : '' }}" data-tab="all" bindtap="onTabChange">全部</view>
      <view class="ap-tab {{ activeTab === 'sys' ? 'ap-tab--on' : '' }}" data-tab="sys" bindtap="onTabChange">有系统账号</view>
      <view class="ap-tab {{ activeTab === 'nosys' ? 'ap-tab--on' : '' }}" data-tab="nosys" bindtap="onTabChange">无系统账号</view>
    </view>
  </view>

  <view class="ap-body">
    <view class="ap-toolbar-card">
      <view class="ap-toolbar-row">
        <view class="ap-toolbar-input-wrap">
          <input class="ap-toolbar-input" value="{{ keyword }}" placeholder="姓名 / 工号 / 账号 / 手机号" placeholder-class="ap-toolbar-ph"
            confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearch" />
        </view>
        <view class="ap-toolbar-btns">
          <view class="ap-tool-btn ap-tool-btn--ghost" hover-class="ap-tool-btn--hover" bindtap="onOpenCreateSheet">新建</view>
          <view class="ap-tool-btn ap-tool-btn--ghost" hover-class="ap-tool-btn--hover" bindtap="onOpenFilterSheet">筛选</view>
          <view class="ap-tool-btn ap-tool-btn--primary" hover-class="ap-tool-btn--hover" bindtap="onSearch">查询</view>
        </view>
      </view>
      <view wx:if="{{ filterGroupId || filterIdentityTagId || filterRoomName || filterRole }}" class="ap-filter-active">
        已筛选：
        <text wx:if="{{ filterGroupId }}" class="ap-filter-chip">{{ groupOptions[filterGroupIdx - 1].name }}</text>
        <text wx:if="{{ filterIdentityTagId }}" class="ap-filter-chip">{{ identityTagOptions[filterIdentityIdx - 1].label }}</text>
        <text wx:if="{{ filterRoomName }}" class="ap-filter-chip">{{ filterRoomName }}</text>
        <text wx:if="{{ filterRole }}" class="ap-filter-chip">{{ roleLabels[filterRoleIdx - 1] }}</text>
        <text class="ap-filter-clear" catchtap="onClearFilter">清除</text>
      </view>
    </view>

    <block wx:if="{{ loading }}">
      <view class="ap-empty">加载中…</view>
    </block>
    <block wx:elif="{{ rows.length === 0 }}">
      <view class="ap-empty">暂无数据</view>
    </block>
    <block wx:else>
      <view wx:for="{{ rows }}" wx:key="id" class="ap-card">
        <view class="ap-card-head">
          <view class="ap-avatar">{{ item._avatarLetter }}</view>
          <view class="ap-card-head-main">
            <view class="ap-name-row">
              <text class="ap-title">{{ item.displayName }}</text>
              <view class="ap-badges">
                <view class="ap-badge {{ item.hasAccount ? 'ap-badge--sys' : 'ap-badge--nosys' }}">{{ item.hasAccount ? '有系统账号' : '无系统账号' }}</view>
                <view wx:if="{{ item.hasAccount }}" class="ap-chip ap-chip--tap {{ item.status === 0 ? 'ap-chip--off' : 'ap-chip--on' }}"
                  data-id="{{ item.staffId }}" data-status="{{ item.status }}" catchtap="onStatusChipTap">{{ item.status === 0 ? '已禁用' : '启用中' }}</view>
                <view wx:if="{{ item.hasAccount && item.staffId === builtinSuperId }}" class="ap-chip ap-chip--static">受保护</view>
              </view>
            </view>
            <view class="ap-sub-line">{{ item.departmentName || '—' }} · {{ item.projectGroupName || '—' }}</view>
            <view class="ap-sub-line ap-sub-line--rooms" wx:if="{{ item.roomsText }}">🏷 {{ item.roomsText }}</view>
          </view>
        </view>

        <view class="ap-kv-row">
          <text class="ap-kv-label">角色</text>
          <picker wx:if="{{ item.hasAccount && item.staffId !== builtinSuperId }}" mode="selector" range="{{ roleLabels }}" value="{{ roleIdxMap[item.role] || 0 }}"
            data-id="{{ item.staffId }}" bindchange="onRoleChange">
            <view class="ap-mini-pill"><text class="ap-mini-pill-t">{{ item.roleLabel }}</text><text class="ap-chev">▾</text></view>
          </picker>
          <view wx:else class="ap-mini-pill ap-mini-pill--static"><text class="ap-mini-pill-t">{{ item.roleLabel }}</text></view>
        </view>

        <view class="ap-kv-row">
          <text class="ap-kv-label">密码</text>
          <view class="ap-pwd-inline">
            <text class="mono ap-pwd-mask">{{ item._pwdVisible ? (item._pwdPlaintext || '—') : '••••••' }}</text>
            <text wx:if="{{ item.hasAccount && item.staffId !== builtinSuperId }}" class="ap-ic" data-id="{{ item.staffId }}" catchtap="onTogglePwd">{{ item._pwdVisible ? '隐' : '显' }}</text>
            <text wx:else class="ap-muted">—</text>
          </view>
        </view>

        <view class="ap-card-actions">
          <text class="ap-ic" data-id="{{ item.id }}" catchtap="onOpenDetail">详情</text>
          <text wx:if="{{ item.hasAccount && item.staffId !== builtinSuperId }}" class="ap-ic" data-id="{{ item.staffId }}" catchtap="onResetPassword">改密</text>
          <text wx:if="{{ item.aroUserId }}" class="ap-ic" data-id="{{ item.aroUserId }}" catchtap="onResetPersonnelAccount">重置账号</text>
          <text wx:if="{{ item.hasAccount && item.staffId !== builtinSuperId }}" class="ap-ic" data-id="{{ item.staffId }}" catchtap="onResetOpenId">重置绑定</text>
        </view>
      </view>

      <view class="ap-footer">
        <text>已加载 {{ rows.length }} / 共 {{ total }} 条</text>
        <text wx:if="{{ loadingMore }}"> · 加载中…</text>
        <text wx:elif="{{ !hasMore }}"> · 没有更多了</text>
      </view>
    </block>
  </view>

  <!-- 筛选底部面板 -->
  <van-popup show="{{ showFilterSheet }}" position="bottom" round safe-area-inset-bottom custom-class="ap-filter-popup" bind:close="onCloseFilterSheet">
    <view class="ap-sheet-title">筛选</view>
    <view class="ap-sheet-group">
      <view class="ap-sheet-label">课题组</view>
      <picker mode="selector" range="{{ groupNames }}" value="{{ filterGroupIdx }}" bindchange="onGroupFilterChange">
        <view class="ap-sheet-picker"><text>{{ groupNames[filterGroupIdx] }}</text><text class="ap-chev">▾</text></view>
      </picker>
    </view>
    <view class="ap-sheet-group">
      <view class="ap-sheet-label">身份标识</view>
      <picker mode="selector" range="{{ identityTagNames }}" value="{{ filterIdentityIdx }}" bindchange="onIdentityFilterChange">
        <view class="ap-sheet-picker"><text>{{ identityTagNames[filterIdentityIdx] }}</text><text class="ap-chev">▾</text></view>
      </picker>
    </view>
    <view class="ap-sheet-group">
      <view class="ap-sheet-label">房间</view>
      <picker mode="selector" range="{{ roomNames }}" value="{{ filterRoomIdx }}" bindchange="onRoomFilterChange">
        <view class="ap-sheet-picker"><text>{{ roomNames[filterRoomIdx] }}</text><text class="ap-chev">▾</text></view>
      </picker>
    </view>
    <view class="ap-sheet-group">
      <view class="ap-sheet-label">角色</view>
      <picker mode="selector" range="{{ roleNames }}" value="{{ filterRoleIdx }}" bindchange="onRoleFilterChange">
        <view class="ap-sheet-picker"><text>{{ roleNames[filterRoleIdx] }}</text><text class="ap-chev">▾</text></view>
      </picker>
    </view>
    <view class="ap-sheet-actions">
      <van-button block round plain hairline type="primary" bind:click="onClearFilter">重置</van-button>
      <van-button block round type="primary" bind:click="onApplyFilter">确定</van-button>
    </view>
  </van-popup>

  <!-- 详情底部 sheet -->
  <van-popup show="{{ showDetailPopup }}" position="bottom" round closeable safe-area-inset-bottom custom-class="ap-detail-popup" bind:close="onCloseDetailPopup">
    <view class="ap-detail-title">{{ detailTitle }}</view>
    <scroll-view scroll-y class="ap-detail-scroll" enable-flex>
      <view wx:for="{{ detailLines }}" wx:for-index="didx" wx:key="didx" class="ap-detail-line">
        <text class="ap-detail-k">{{ item.k }}</text>
        <text class="ap-detail-v {{ item.k === '密码' ? 'mono' : '' }}" selectable="true">{{ item.k === '密码' ? (detailPwdPlaintext || '加载中…') : item.v }}</text>
      </view>
    </scroll-view>
  </van-popup>

  <!-- 其余弹窗（创建/删除/昵称/邮箱）原样保留 -->
  <van-popup
    show="{{ showNickPopup }}"
    position="center"
    round
    closeable
    custom-class="ap-modal-shell"
    bind:close="onNickPopupCloseIfIdle"
  >
    <view class="ap-modal-title">修改展示昵称</view>
    <view class="ap-modal-body">
      <view class="ap-modal-field">
        <text class="ap-modal-label">展示昵称</text>
        <input
          class="ap-modal-input"
          value="{{ nickEditValue }}"
          maxlength="{{ 32 }}"
          placeholder="最多 32 字"
          placeholder-class="ap-toolbar-ph"
          bindinput="onNickPopupInput"
        />
      </view>
    </view>
    <view class="ap-modal-footer">
      <view
        class="ap-modal-btn ap-modal-btn--ghost {{ nickSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onNickCancelTap"
      >取消</view>
      <view
        class="ap-modal-btn ap-modal-btn--primary {{ nickSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onNickConfirmTap"
      >{{ nickSubmitting ? '保存中…' : '确认' }}</view>
    </view>
  </van-popup>

  <van-popup
    show="{{ showCreateSheet }}"
    position="center"
    round
    closeable
    custom-class="ap-modal-shell"
    bind:close="onCreatePopupCloseIfIdle"
  >
    <view class="ap-modal-title">新建员工账号</view>
    <view class="ap-modal-hint">密码至少 6 位；不可新建平台所有者。已有账号可在列表中改为学生角色。</view>

    <view class="ap-modal-body">
      <view class="ap-modal-field">
        <text class="ap-modal-label">登录名</text>
        <input
          class="ap-modal-input"
          value="{{ createUsername }}"
          maxlength="{{ 64 }}"
          placeholder="2～64 字符"
          placeholder-class="ap-toolbar-ph"
          bindinput="onCreateUsernameInput"
        />
      </view>
      <view class="ap-modal-field">
        <text class="ap-modal-label">密码</text>
        <input
          class="ap-modal-input"
          password
          value="{{ createPassword }}"
          placeholder="至少 6 位"
          placeholder-class="ap-toolbar-ph"
          bindinput="onCreatePasswordInput"
        />
      </view>
      <view class="ap-modal-field">
        <text class="ap-modal-label">展示昵称</text>
        <input
          class="ap-modal-input"
          value="{{ createNickname }}"
          maxlength="{{ 32 }}"
          placeholder="可选，默认同登录名"
          placeholder-class="ap-toolbar-ph"
          bindinput="onCreateNicknameInput"
        />
      </view>
      <view class="ap-modal-field ap-modal-field--row">
        <text class="ap-modal-label">角色</text>
        <view class="ap-modal-picker-wrap">
          <picker mode="selector" range="{{ staffRolePickerLabels }}" value="{{ createRoleIdx }}" bindchange="onCreateRolePicker">
            <view class="ap-modal-picker">
              <text class="ap-modal-picker-text">{{ staffRolePickerLabels[createRoleIdx] }}</text>
              <text class="ap-chev">▾</text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view class="ap-modal-footer">
      <view
        class="ap-modal-btn ap-modal-btn--ghost {{ createSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onCreateCancelTap"
      >取消</view>
      <view
        class="ap-modal-btn ap-modal-btn--primary {{ createSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onCreateSubmitTap"
      >{{ createSubmitting ? '创建中…' : '创建' }}</view>
    </view>
  </van-popup>

  <van-popup
    show="{{ showDeleteSheet }}"
    position="bottom"
    round
    closeable
    safe-area-inset-bottom
    custom-class="ap-sheet-popup"
    bind:close="onCloseDeleteSheet"
  >
    <view class="ap-sheet-head ap-sheet-head--danger">删除账号</view>
    <view class="ap-sheet-hint">将永久删除「{{ deleteTargetUsername }}」。请输入完整登录名以确认。</view>
    <van-cell-group inset border="{{ false }}">
      <van-field
        placeholder="输入登录名"
        value="{{ deleteConfirmInput }}"
        border="{{ false }}"
        bind:change="onDeleteConfirmInputChange"
      />
    </van-cell-group>
    <view class="ap-sheet-actions">
      <van-button block round plain hairline type="primary" bind:click="onCloseDeleteSheet">取消</van-button>
      <van-button block round type="danger" loading="{{ deleteSubmitting }}" bind:click="onSubmitDeleteStaff">确认删除</van-button>
    </view>
  </van-popup>

  <!-- 邮箱编辑弹窗 -->
  <van-popup
    show="{{ showEmailPopup }}"
    position="center"
    round
    closeable
    custom-class="ap-modal-shell"
    bind:close="onCloseEmailPopup"
  >
    <view class="ap-modal-title">修改联系邮箱</view>
    <view class="ap-modal-body">
      <view class="ap-modal-field">
        <text class="ap-modal-label">邮箱地址</text>
        <input
          class="ap-modal-input"
          type="text"
          value="{{ emailEditValue }}"
          maxlength="{{ 128 }}"
          placeholder="请输入邮箱地址"
          placeholder-class="ap-toolbar-ph"
          bindinput="onEmailInput"
        />
      </view>
    </view>
    <view class="ap-modal-footer">
      <view
        class="ap-modal-btn ap-modal-btn--ghost {{ emailSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onCloseEmailPopup"
      >取消</view>
      <view
        class="ap-modal-btn ap-modal-btn--primary {{ emailSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onSubmitEmail"
      >{{ emailSubmitting ? '保存中…' : '保存' }}</view>
    </view>
  </van-popup>
</view>
