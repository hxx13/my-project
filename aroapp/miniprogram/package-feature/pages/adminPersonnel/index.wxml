<view class="ap-root">
  <view class="ap-header">
    <view class="ap-tabs">
      <view
        class="ap-tab {{ activeTab === 'personnel' ? 'ap-tab--on' : '' }}"
        data-tab="personnel"
        bindtap="onTabChange"
      >学生</view>
      <view
        class="ap-tab {{ activeTab === 'system' ? 'ap-tab--on' : '' }}"
        data-tab="system"
        bindtap="onTabChange"
      >员工</view>
    </view>
  </view>

  <view class="ap-body">
    <view class="ap-toolbar-card">
      <view class="ap-toolbar-row">
        <view class="ap-toolbar-input-wrap">
          <input
            class="ap-toolbar-input"
            value="{{ keyword }}"
            placeholder="搜索 ID / 姓名 / 账号"
            placeholder-class="ap-toolbar-ph"
            confirm-type="search"
            bindinput="onKeywordInput"
            bindconfirm="onSearch"
          />
        </view>
        <view class="ap-toolbar-btns">
          <view class="ap-tool-btn ap-tool-btn--primary" hover-class="ap-tool-btn--hover" bindtap="onSearch">查询</view>
          <view class="ap-tool-btn ap-tool-btn--ghost" hover-class="ap-tool-btn--hover" bindtap="onManualRefresh">刷新</view>
          <view
            wx:if="{{ activeTab === 'system' }}"
            class="ap-tool-btn ap-tool-btn--ghost"
            hover-class="ap-tool-btn--hover"
            bindtap="onOpenCreateSheet"
          >新建</view>
        </view>
      </view>
    </view>

    <block wx:if="{{ loading }}">
      <view class="ap-empty">加载中…</view>
    </block>
    <block wx:elif="{{ rows.length === 0 }}">
      <view class="ap-empty">暂无数据</view>
    </block>
    <block wx:else>
      <view wx:for="{{ rows }}" wx:key="id" class="ap-card">
        <view class="ap-card-head">
          <view class="ap-avatar">{{ item._avatarLetter }}</view>
          <view class="ap-card-head-main">
            <view class="ap-name-row">
              <text class="ap-title">{{ item.displayName }}</text>
              <view
                wx:if="{{ item.id !== builtinSuperId }}"
                class="ap-chip ap-chip--tap {{ item.status === 0 ? 'ap-chip--off' : 'ap-chip--on' }}"
                data-id="{{ item.id }}"
                data-status="{{ item.status }}"
                catchtap="onStatusChipTap"
              >{{ item.status === 0 ? '已禁用' : '启用中' }}</view>
              <view wx:else class="ap-chip ap-chip--static">受保护</view>
              <text class="ap-ic" data-id="{{ item.id }}" catchtap="onOpenDetail">详情</text>
              <text
                wx:if="{{ item.id !== builtinSuperId }}"
                class="ap-ic"
                data-id="{{ item.id }}"
                catchtap="onResetOpenId"
              >重置绑定</text>
              <text
                wx:if="{{ activeTab === 'system' && item.id !== builtinSuperId }}"
                class="ap-ic"
                data-id="{{ item.id }}"
                catchtap="onResetPassword"
              >改密</text>
              <text
                wx:if="{{ activeTab === 'system' && item.id !== builtinSuperId && item.id !== myUserId && item.username }}"
                class="ap-ic ap-ic--danger"
                data-id="{{ item.id }}"
                catchtap="onDeleteStaffStep1"
              >删除</text>
            </view>
            <text class="ap-sub mono">{{ item.idListText }}</text>
          </view>
        </view>

        <van-cell-group wx:if="{{ activeTab === 'personnel' && item.username }}" inset border="{{ false }}" custom-class="ap-cell-group">
          <van-cell title="登录账号" value="{{ item.usernameListText }}" title-class="ap-cell-title" value-class="ap-cell-value mono" />
        </van-cell-group>

        <view wx:if="{{ activeTab === 'system' }}" class="ap-nick-line">
          <text class="ap-kv-label">昵称</text>
          <block wx:if="{{ item.id !== builtinSuperId }}">
            <text class="ap-nick-tap" data-id="{{ item.id }}" catchtap="onOpenNickPopup">{{ item.displayNickname || item.nickDraft || '点击设置' }}</text>
          </block>
          <text wx:else class="ap-muted">—</text>
        </view>

        <van-cell-group wx:if="{{ activeTab === 'personnel' }}" inset border="{{ false }}" custom-class="ap-cell-group">
          <van-cell wx:if="{{ item.jobNumber }}" title="工号" value="{{ item.jobNumber }}" title-class="ap-cell-title" value-class="ap-cell-value" />
          <van-cell wx:if="{{ item.departmentName }}" title="部门" value="{{ item.departmentName }}" title-class="ap-cell-title" value-class="ap-cell-value" />
          <van-cell wx:if="{{ item.projectGroupName }}" title="项目组" value="{{ item.projectGroupName }}" title-class="ap-cell-title" value-class="ap-cell-value" />
        </van-cell-group>

        <view class="ap-kv-row">
          <text class="ap-kv-label">角色</text>
          <picker
            wx:if="{{ activeTab === 'personnel' && item.id !== builtinSuperId }}"
            mode="selector"
            range="{{ rolePickerLabels }}"
            value="{{ item._roleIdx }}"
            data-id="{{ item.id }}"
            bindchange="onRoleChange"
          >
            <view class="ap-mini-pill">
              <text class="ap-mini-pill-t">{{ item.roleLabel }}</text>
              <text class="ap-chev">▾</text>
            </view>
          </picker>
          <picker
            wx:elif="{{ activeTab === 'system' && item.id !== builtinSuperId }}"
            mode="selector"
            range="{{ staffEditRolePickerLabels }}"
            value="{{ item._staffRoleIdx }}"
            data-id="{{ item.id }}"
            bindchange="onRoleChange"
          >
            <view class="ap-mini-pill">
              <text class="ap-mini-pill-t">{{ item.roleLabel }}</text>
              <text class="ap-chev">▾</text>
            </view>
          </picker>
          <view wx:else class="ap-mini-pill ap-mini-pill--static">
            <text class="ap-mini-pill-t">平台所有者</text>
          </view>
        </view>

        <view class="ap-kv-row">
          <text class="ap-kv-label">密码</text>
          <view class="ap-pwd-inline">
            <text class="mono ap-pwd-mask">{{ item._pwdVisible ? (item.password || '—') : '••••••' }}</text>
            <text
              wx:if="{{ item.id !== builtinSuperId }}"
              class="ap-ic"
              data-id="{{ item.id }}"
              catchtap="onTogglePwd"
            >{{ item._pwdVisible ? '隐' : '显' }}</text>
          </view>
        </view>
      </view>

      <view class="ap-footer">
        <text>已加载 {{ rows.length }} / 共 {{ total }} 条</text>
        <text wx:if="{{ loadingMore }}"> · 加载中…</text>
        <text wx:elif="{{ !hasMore }}"> · 没有更多了</text>
      </view>
    </block>
  </view>

  <van-popup
    show="{{ showDetailPopup }}"
    position="bottom"
    round
    closeable
    safe-area-inset-bottom
    custom-class="ap-detail-popup"
    bind:close="onCloseDetailPopup"
  >
    <view class="ap-detail-title">{{ detailTitle }}</view>
    <scroll-view scroll-y class="ap-detail-scroll" enable-flex>
      <view wx:for="{{ detailLines }}" wx:for-index="didx" wx:key="didx" class="ap-detail-line">
        <text class="ap-detail-k">{{ item.k }}</text>
        <text class="ap-detail-v" selectable="true">{{ item.v }}</text>
      </view>
    </scroll-view>
  </van-popup>

  <van-popup
    show="{{ showNickPopup }}"
    position="center"
    round
    closeable
    custom-class="ap-modal-shell"
    bind:close="onNickPopupCloseIfIdle"
  >
    <view class="ap-modal-title">修改展示昵称</view>
    <view class="ap-modal-body">
      <view class="ap-modal-field">
        <text class="ap-modal-label">展示昵称</text>
        <input
          class="ap-modal-input"
          value="{{ nickEditValue }}"
          maxlength="{{ 32 }}"
          placeholder="最多 32 字"
          placeholder-class="ap-toolbar-ph"
          bindinput="onNickPopupInput"
        />
      </view>
    </view>
    <view class="ap-modal-footer">
      <view
        class="ap-modal-btn ap-modal-btn--ghost {{ nickSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onNickCancelTap"
      >取消</view>
      <view
        class="ap-modal-btn ap-modal-btn--primary {{ nickSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onNickConfirmTap"
      >{{ nickSubmitting ? '保存中…' : '确认' }}</view>
    </view>
  </van-popup>

  <van-popup
    show="{{ showCreateSheet }}"
    position="center"
    round
    closeable
    custom-class="ap-modal-shell"
    bind:close="onCreatePopupCloseIfIdle"
  >
    <view class="ap-modal-title">新建员工账号</view>
    <view class="ap-modal-hint">走管理端直建（无需推荐码）。须填真实姓名；密码至少 6 位；不可新建平台所有者。</view>

    <view class="ap-modal-body">
      <view class="ap-modal-field">
        <text class="ap-modal-label">真实姓名</text>
        <input
          class="ap-modal-input"
          value="{{ createRealName }}"
          maxlength="{{ 64 }}"
          placeholder="人员库显示名，≠ 登录账号"
          placeholder-class="ap-toolbar-ph"
          bindinput="onCreateRealNameInput"
        />
      </view>
      <view class="ap-modal-field">
        <text class="ap-modal-label">登录名</text>
        <input
          class="ap-modal-input"
          value="{{ createUsername }}"
          maxlength="{{ 64 }}"
          placeholder="2～64 字符"
          placeholder-class="ap-toolbar-ph"
          bindinput="onCreateUsernameInput"
        />
      </view>
      <view class="ap-modal-field">
        <text class="ap-modal-label">密码</text>
        <input
          class="ap-modal-input"
          password
          value="{{ createPassword }}"
          placeholder="至少 6 位"
          placeholder-class="ap-toolbar-ph"
          bindinput="onCreatePasswordInput"
        />
      </view>
      <view class="ap-modal-field">
        <text class="ap-modal-label">展示昵称</text>
        <input
          class="ap-modal-input"
          value="{{ createNickname }}"
          maxlength="{{ 32 }}"
          placeholder="可选，≠ 真实姓名"
          placeholder-class="ap-toolbar-ph"
          bindinput="onCreateNicknameInput"
        />
      </view>
      <view class="ap-modal-field ap-modal-field--row">
        <text class="ap-modal-label">角色</text>
        <view class="ap-modal-picker-wrap">
          <picker mode="selector" range="{{ staffRolePickerLabels }}" value="{{ createRoleIdx }}" bindchange="onCreateRolePicker">
            <view class="ap-modal-picker">
              <text class="ap-modal-picker-text">{{ staffRolePickerLabels[createRoleIdx] }}</text>
              <text class="ap-chev">▾</text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view class="ap-modal-footer">
      <view
        class="ap-modal-btn ap-modal-btn--ghost {{ createSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onCreateCancelTap"
      >取消</view>
      <view
        class="ap-modal-btn ap-modal-btn--primary {{ createSubmitting ? 'ap-modal-btn--disabled' : '' }}"
        hover-class="ap-tool-btn--hover"
        catchtap="onCreateSubmitTap"
      >{{ createSubmitting ? '创建中…' : '创建' }}</view>
    </view>
  </van-popup>

  <van-popup
    show="{{ showDeleteSheet }}"
    position="bottom"
    round
    closeable
    safe-area-inset-bottom
    custom-class="ap-sheet-popup"
    bind:close="onCloseDeleteSheet"
  >
    <view class="ap-sheet-head ap-sheet-head--danger">删除账号</view>
    <view class="ap-sheet-hint">将永久删除「{{ deleteTargetUsername }}」。请输入完整登录名以确认。</view>
    <van-cell-group inset border="{{ false }}">
      <van-field
        placeholder="输入登录名"
        value="{{ deleteConfirmInput }}"
        border="{{ false }}"
        bind:change="onDeleteConfirmInputChange"
      />
    </van-cell-group>
    <view class="ap-sheet-actions">
      <van-button block round plain hairline type="primary" bind:click="onCloseDeleteSheet">取消</van-button>
      <van-button block round type="danger" loading="{{ deleteSubmitting }}" bind:click="onSubmitDeleteStaff">确认删除</van-button>
    </view>
  </van-popup>
</view>
