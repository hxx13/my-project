/* 与 Tab 页一致，底部为自定义 tabBar 留白 */
page {
  padding-bottom: calc(50px + constant(safe-area-inset-bottom));
  padding-bottom: calc(50px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ai-page {
  min-height: 100vh;
  padding: 16rpx 16rpx 24rpx;
  background: linear-gradient(180deg, #eef2ff 0%, #f8fafc 40%);
  box-sizing: border-box;
}

.ai-denied {
  padding: 80rpx 32rpx;
  text-align: center;
}

.ai-denied-text {
  font-size: 28rpx;
  color: #64748b;
}

.ai-hero {
  margin-bottom: 16rpx;
}

.ai-hero-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-hero-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.ai-hero-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  gap: 10rpx;
}

.ai-refresh-btn {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1d4ed8;
  background: #ffffff;
  border: 1rpx solid #93c5fd;
}

.ai-refresh-btn--hover {
  opacity: 0.88;
}

.ai-refresh-btn--busy {
  color: #94a3b8;
  border-color: #e2e8f0;
  pointer-events: none;
}

.ai-refresh-btn--debug {
  color: #9a3412;
  background: #fff7ed;
  border-color: #fdba74;
}

.ai-cache-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.ai-hero-h1 {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.ai-hero-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.ai-state {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.ai-state--warn {
  color: #b45309;
}

.ai-card-wrap {
  margin-bottom: 20rpx;
}

.ai-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 20rpx 18rpx 16rpx;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.06);
}

.ai-card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ai-room-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  word-break: break-all;
}

.ai-cold {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #64748b;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
}

.ai-metrics {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.ai-metric {
  flex: 1;
  min-width: 0;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  text-align: center;
}

.ai-metric-k {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.ai-metric-v {
  font-size: 28rpx;
  font-weight: 800;
  color: #ea580c;
}

.ai-metric-v--sm {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f172a;
}

.ai-metric-v--risk {
  color: #dc2626;
}

.ai-alert {
  font-size: 22rpx;
  color: #334155;
  line-height: 1.45;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  margin-bottom: 14rpx;
}

.ai-next {
  margin-bottom: 14rpx;
}

.ai-next-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #475569;
  margin-bottom: 8rpx;
  display: block;
}

.ai-next-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.ai-next-row:last-child {
  border-bottom: none;
}

.ai-next-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #64748b;
  padding-right: 12rpx;
  word-break: break-all;
}

.ai-next-prob {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 800;
  color: #64748b;
}

.ai-next-prob--top {
  color: #2563eb;
}

.ai-week-block {
  margin-bottom: 16rpx;
  padding: 12rpx 10rpx 10rpx;
  border-radius: 12rpx;
  background: #0f172a;
  border: 1rpx solid #1e293b;
}

/* 综合周带：置于普通文档流且压低层级，避免滚动时盖住自定义 tabBar（tabBar 已提高 z-index） */
.ai-week-block--global {
  position: relative;
  z-index: 0;
  isolation: isolate;
  transform: translateZ(0);
}

.ai-week-block .ai-chart-title {
  color: #e2e8f0;
}

.ai-week-block .ai-chart-legend {
  color: #94a3b8;
}

.ai-chart-head--light .ai-chart-title {
  color: #475569;
}

.ai-chart-head--light .ai-chart-legend {
  color: #64748b;
}

.ai-week-scale {
  display: block;
  font-size: 18rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.ai-week-cols {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 6rpx;
}

.ai-week-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ai-week-col-inner {
  position: relative;
  width: 100%;
  height: 100rpx;
  border-radius: 8rpx;
  background: rgba(30, 41, 59, 0.85);
  overflow: hidden;
}

.ai-week-band {
  position: absolute;
  left: 10%;
  right: 10%;
  border-radius: 6rpx;
  background: linear-gradient(180deg, rgba(96, 165, 250, 0.45) 0%, rgba(167, 139, 250, 0.45) 100%);
  box-sizing: border-box;
  border: 1rpx solid rgba(147, 197, 253, 0.35);
}

.ai-week-cols--share {
  align-items: flex-end;
}

.ai-week-col-inner--share {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
}

.ai-week-bar-pair {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
  width: 100%;
  height: 100%;
  padding-bottom: 6rpx;
  box-sizing: border-box;
}

.ai-week-bar {
  width: 14rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  min-height: 6rpx;
}

.ai-week-bar--in {
  background: linear-gradient(180deg, #60a5fa 0%, #2563eb 100%);
}

.ai-week-bar--out {
  background: linear-gradient(180deg, #c4b5fd 0%, #7c3aed 100%);
}

.ai-week-day {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #94a3b8;
}

.ai-chart-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.ai-chart-head-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding-right: 8rpx;
}

.ai-chart-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #475569;
}

.ai-chart-sub {
  font-size: 18rpx;
  color: #94a3b8;
  line-height: 1.25;
}

.ai-chart-legend {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  font-size: 20rpx;
  color: #64748b;
}

.ai-lg-in::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #3b82f6;
  margin-right: 6rpx;
}

.ai-lg-out::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  border: 2rpx solid #6366f1;
  margin-right: 6rpx;
  vertical-align: middle;
}

.ai-chart-slot {
  position: relative;
  z-index: 0;
  min-height: 88rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #0f172a;
}

.ai-chart-img {
  display: block;
  width: 100%;
  border-radius: 12rpx;
  vertical-align: top;
}

.ai-chart-placeholder {
  padding: 28rpx 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #64748b;
  background: #0f172a;
  border-radius: 12rpx;
}

.ai-canvas-offscreen {
  position: fixed;
  left: -2000px;
  top: 0;
  opacity: 0;
  pointer-events: none;
}
