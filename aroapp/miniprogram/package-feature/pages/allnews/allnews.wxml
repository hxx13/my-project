<view class="news-center">


  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 新闻列表 -->
  <van-cell-group wx:else border="{{false}}">
    <van-cell
      wx:for="{{newsList}}"
      wx:key="id"
      title="{{item.newsName}}"
      label="{{item.createTime}}"
      is-link
      bind:click="toDetail"
      data-id="{{item.id}}"
      custom-style="margin: 10rpx 20rpx; border-radius: 12rpx; background:#fff;"
    />
  </van-cell-group>
</view>