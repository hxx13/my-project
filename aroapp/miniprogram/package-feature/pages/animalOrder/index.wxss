.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f4ef;
  box-sizing: border-box;
}

/* 时间窗 */
.time-banner {
  margin: 12rpx 20rpx 0;
  padding: 12rpx 16rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #9a3412;
}
.time-eta {
  margin: 12rpx 20rpx 0;
  font-size: 22rpx;
  color: #646566;
}

/* 面包屑 */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin: 12rpx 20rpx 0;
  padding: 8rpx 12rpx;
  background: #fff;
  border: 1rpx solid #ebecef;
  border-radius: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
}
.crumb-back {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: #ac1736;
}
.crumb-sep {
  color: #c8c9cc;
  margin: 0 4rpx;
}
.crumb-item {
  font-size: 24rpx;
  color: #646566;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.crumb-on {
  color: #323233;
  font-weight: 600;
}

/* 列表：下钻 + 侧边栏 */
.main-area {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}
.main-area-split {
  flex-direction: row;
}
.side {
  width: 192rpx;
  flex-shrink: 0;
  min-height: 0;
  border-right: 1rpx solid #ebecef;
  background: #faf8f4;
  box-sizing: border-box;
}
.side-back {
  padding: 16rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #ac1736;
  border-bottom: 1rpx solid #ebecef;
}
.side-title {
  padding: 12rpx;
  font-size: 20rpx;
  color: #969799;
  letter-spacing: 1rpx;
}
.side-item {
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  color: #646566;
  border-left: 6rpx solid transparent;
  word-break: break-all;
  line-height: 1.4;
}
.side-item-on {
  border-left-color: #ac1736;
  background: #fff;
  color: #ac1736;
  font-weight: 600;
}
.list {
  flex: 1;
  min-width: 0;
  min-height: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.list-pad {
  height: 24rpx;
}
.muted {
  padding: 80rpx 0;
  text-align: center;
  color: #969799;
  font-size: 26rpx;
}
.muted.pad {
  padding: 48rpx 24rpx;
}
.goods {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 1rpx solid #ebecef;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.goods-cover {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.goods-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #c8c9cc;
}
.goods-main {
  flex: 1;
  min-width: 0;
}
/* 价格 + 操作控件同一行；控件不再绝对定位，不抢文本宽度也不独占一行 */
.goods-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 8rpx;
}
.goods-spec {
  position: relative;
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  background: #f7f8fa;
  color: #323233;
  border: 1rpx solid #e3e5e8;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}
/* 数量选择器：复用物资领用的胶囊组（一条描边 + 中间手动输入框），替代原来的独立大方块 */
.step-inline {
  flex-shrink: 0;
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  border: 1rpx solid #dcdee0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
  box-sizing: border-box;
}
/* 卡片里的实例脱离文档流（文字已按此预留右侧空间） */
.si-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  color: #323233;
}
.si-btn-plus {
  color: #fff;
  background: #1989fa;
}
.si-btn-hover {
  opacity: 0.88;
}
.si-num-input {
  width: 72rpx;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 4rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #323233;
  background: #f7f8fa;
  border-left: 1rpx solid #ebecef;
  border-right: 1rpx solid #ebecef;
  box-sizing: border-box;
}
.goods-spec-badge {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  line-height: 30rpx;
  text-align: center;
  background: #ef4444;
  color: #fff;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
}
/* 主标题 + 副标题同排：容器裁切，副标题跟在标题后面 */
.goods-title-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}
.goods-sub {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #969799;
}
.goods-arrow {
  flex-shrink: 0;
  color: #c8c9cc;
  font-size: 36rpx;
}
.goods-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #969799;
}
.goods-price {
  font-size: 24rpx;
  font-weight: 700;
  color: #0369a1;
}
/* 未开启价格时的占位，保持各行高度与操作区位置一致 */
.goods-price-empty {
  color: #c8c9cc;
  font-weight: 500;
}

/* 底部栏 */
.cart-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #ebecef;
}
.cart-orders {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  border: 1rpx solid #ebecef;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #646566;
  background: #f7f4ef;
}
.cart-main {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 0;
  background: #ac1736;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.cart-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ef4444;
  color: #fff;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

/* Sheet 通用 */
.sheet {
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}
.sheet-head {
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #ebecef;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #323233;
}
.sheet-scroll {
  max-height: 46vh;
  padding: 8rpx 32rpx;
  box-sizing: border-box;
}
.sheet-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ebecef;
}
.foot-btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.foot-btn.ghost {
  border: 1rpx solid #ebecef;
  color: #646566;
  background: #fff;
}
.foot-btn.primary {
  background: #ac1736;
  color: #fff;
}
.sheet-remark {
  padding: 12rpx 32rpx;
  border-top: 1rpx solid #ebecef;
}
.remark-input {
  width: 100%;
  padding: 16rpx;
  background: #f7f4ef;
  border-radius: 12rpx;
  font-size: 24rpx;
}

/* 规格行 */
.spec-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
/* 同规格模板内互斥：另一个选项已选时本行置灰（如性别只能二选一） */
.spec-row--blocked {
  opacity: 0.45;
  pointer-events: none;
}
.spec-blocked-hint {
  display: block;
  font-size: 20rpx;
  color: #969799;
}
/* 每规格行备注：换行占满整行 */
.spec-remark {
  width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
  background: #fff;
  font-size: 24rpx;
  color: #323233;
}
.spec-label {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #323233;
}
/* 购物车行 */
.cart-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.cart-line-mid {
  flex: 1;
  min-width: 0;
}
.cart-line-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-line-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

/* ── 购物车分组（镜像 CartTree.tsx 的 AUP→实验员 / 规格→实验员） ── */
.cart-tree-tabs {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0 16rpx;
}
.ct-group { margin-bottom: 24rpx; }
.ct-group-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #0369a1;
}
.ct-sub { padding-left: 16rpx; }
.ct-sub-title {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #969799;
}
.cart-line-remark {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #969799;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-line-qty {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #323233;
}

/* AUP 选项 */
.aup-opt {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.aup-opt-on .aup-opt-no {
  color: #ac1736;
  font-weight: 700;
}
.aup-opt-no {
  font-size: 26rpx;
  color: #323233;
}
.aup-opt-group {
  font-size: 22rpx;
  color: #969799;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 提交确认 */
.confirm {
  padding: 32rpx;
}
.confirm-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #323233;
}
.confirm-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #969799;
}
.confirm-input {
  width: 100%;
  margin-top: 20rpx;
  padding: 16rpx;
  background: #f7f4ef;
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  height: 140rpx;
}
.confirm-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 订单页统一 border-box：小程序无全局 reset，content-box 下的 padding 会把整页撑出屏幕 */
.orders,
.orders view,
.orders scroll-view,
.orders text,
.orders input {
  box-sizing: border-box;
}

/* 订单（整页显示，撑满导航栏以下） */
.orders {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  background: #f7f4ef;
}
.orders-scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx 32rpx;
}
.order-card {
  background: #fff;
  border: 1rpx solid #ebecef;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order-id {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}
.order-status {
  font-size: 22rpx;
  font-weight: 600;
  color: #ac1736;
  background: #fbecee;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.order-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #969799;
}

/* 访客 */
.gate {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  background: #f7f4ef;
}
.gate-title {
  font-size: 30rpx;
  color: #646566;
}
.gate-btn {
  padding: 18rpx 64rpx;
  background: #ac1736;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* ── 校区门禁 ── */
.campus-gate {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.campus-gate-card {
  width: 100%;
  padding: 40rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #e5e0d8;
  border-radius: 24rpx;
  box-sizing: border-box;
}
.campus-gate-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #323233;
}
.campus-gate-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a8578;
}
.campus-gate-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
.campus-gate-btn {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #0284c7;
  background: #eef6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 16rpx;
}

/* ── 领用方式/房间 + 代领人 ── */
.pickup-block {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.pickup-field { margin-bottom: 20rpx; }
.pickup-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.pickup-label .req { color: #e64340; }
.pickup-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #fff;
  font-size: 26rpx;
  color: #333;
}
.pickup-value-empty { color: #bbb; }
.pickup-hint { color: #bbb; font-size: 22rpx; }
.pickup-arrow { color: #bbb; font-size: 32rpx; line-height: 1; }

/* 房间树 */
.room-error {
  padding: 24rpx 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #ac1736;
  word-break: break-all;
}
.room-error-retry { color: #0369a1; }
.room-search { padding: 0 24rpx 12rpx; }
.room-search-input {
  height: 68rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #f8f8f8;
  font-size: 26rpx;
}
.room-row {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding-right: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 24rpx;
  color: #333;
}
.room-row-folder { color: #666; font-weight: 500; }
.room-row-leaf { color: #333; }
.room-row-sel { background: #eef7ff; color: #1677ff; font-weight: 600; }
.room-caret {
  width: 26rpx;
  flex: 0 0 26rpx;
  color: #bbb;
  font-size: 20rpx;
}
.room-name { flex: 1; min-width: 0; }

/* 代领人 */
.collector-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333;
}
.collector-row-sel { background: #eef7ff; color: #1677ff; font-weight: 600; }
.collector-name { flex: 1; min-width: 0; }
.collector-job { color: #999; font-size: 24rpx; }
.foot-btn-off { opacity: 0.6; }

/* ── 价格显示 ── */
.spec-main { flex: 1; min-width: 0; }
.spec-price {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #64748b;
}
.spec-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #f8fafc;
  border-radius: 12rpx;
}
.spec-total-label { font-size: 24rpx; color: #64748b; }
.spec-total-value { font-size: 30rpx; font-weight: 700; color: #0369a1; }
.cart-line-price {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #0369a1;
}
.cart-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}
.cart-total-label { font-size: 24rpx; color: #64748b; }
.cart-total-value { font-size: 30rpx; font-weight: 700; color: #0369a1; }

/* ── 订单记录（页签 / 筛选 / 卡片 / 表格） ── */
.ord-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-wrap: wrap;
}
.ord-tabs {
  display: flex;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 4rpx;
}
.ord-tab {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #646566;
  border-radius: 999rpx;
}
.ord-tab-on {
  background: #fff;
  color: #323233;
  font-weight: 600;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}
.ord-count { font-size: 22rpx; color: #969799; margin-left: auto; }
.ord-btn {
  padding: 10rpx 26rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #323233;
}
.ord-btn-primary { background: #1677ff; border-color: #1677ff; color: #fff; font-weight: 600; }
.ord-btn-off { opacity: 0.45; }

.ord-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}
.ord-field { width: calc(50% - 8rpx); }
.ord-field-wide { width: 100%; }
.ord-flabel { display: block; font-size: 22rpx; color: #969799; margin-bottom: 6rpx; }
.ord-finput {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
  background: #fff;
  font-size: 26rpx;
  color: #323233;
}
.ord-filter-actions { width: 100%; display: flex; justify-content: flex-end; gap: 16rpx; }

/* 表格：scroll-x 撑开 + 外层纵向滚动，与 suppliesAudit 同一套做法 */
.ord-table-wrap { width: 100%; border: 1rpx solid #ebedf0; border-radius: 12rpx; background: #fff; }
.ord-table { min-width: 2200rpx; padding-bottom: 8rpx; }
.ord-tr { display: flex; flex-direction: row; border-bottom: 1rpx solid #f2f3f5; }
.ord-tr-head { background: #f7f8fa; font-size: 22rpx; color: #646566; font-weight: 600; }
.ord-td { flex-shrink: 0; padding: 14rpx 12rpx; font-size: 22rpx; color: #323233; word-break: break-all; }
.ord-td.mono { font-family: monospace; font-size: 20rpx; color: #969799; }
.w-no { width: 220rpx; }
.w-src { width: 110rpx; text-align: center; }
.w-group { width: 240rpx; }
.w-pi { width: 150rpx; }
.w-item { width: 340rpx; }
.w-supplier { width: 280rpx; }
.w-xs { width: 96rpx; text-align: center; }
.w-amt { width: 160rpx; text-align: right; color: #0369a1; font-weight: 600; }
.w-aup { width: 220rpx; }
.w-mid { width: 160rpx; }
.w-room { width: 280rpx; }
.w-date { width: 240rpx; }
.w-remark { width: 340rpx; }

/* 卡片 */
.ord-card {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 12rpx;
  background: #fff;
}
.ord-card-head { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.ord-card-no { font-family: monospace; font-size: 22rpx; color: #969799; }
.ord-chip {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #f2f3f5;
  font-size: 20rpx;
  color: #646566;
}
.ord-card-status { font-size: 24rpx; font-weight: 600; color: #323233; }
.ord-card-toggle { margin-left: auto; font-size: 20rpx; color: #969799; }
.ord-card-line { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; font-size: 24rpx; }
.ord-k { color: #969799; margin-right: 6rpx; }
.ord-v { color: #323233; }
.ord-v.strong { font-weight: 700; }
.ord-v.price { font-weight: 700; color: #0369a1; }
.ord-item-line { margin-top: 6rpx; font-size: 24rpx; color: #323233; }
.ord-card-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f3f5;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}
.ord-kv { width: calc(50% - 12rpx); }
.ord-kv-wide { width: 100%; }

.ord-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.ord-page-text { font-size: 24rpx; color: #646566; }

/* ── 编辑模式横幅 / 记录卡动作 ── */
.edit-banner {
  margin: 12rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border: 1rpx solid #bae6fd;
  border-radius: 12rpx;
  background: #f0f9ff;
}
.edit-banner-title { font-size: 26rpx; font-weight: 700; color: #0c4a6e; }
.edit-banner-desc { margin-top: 4rpx; font-size: 22rpx; color: #0c4a6e; opacity: 0.8; line-height: 1.5; }
.edit-banner-actions { margin-top: 14rpx; display: flex; justify-content: flex-end; gap: 16rpx; }
.ord-card-actions { margin-top: 14rpx; display: flex; justify-content: flex-end; }
.foot-btn-off { opacity: 0.5; }

/* ── 加购上下文条（校区 + AUP 合成一条） ── */
.ctx-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.ctx-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  color: #323233;
}
.ctx-chip-flex { flex: 1; min-width: 0; }
.ctx-chip-warn { border-color: #fcd34d; background: #fffbeb; color: #92400e; }
.ctx-ico { font-size: 24rpx; }
.ctx-tag { font-size: 20rpx; font-weight: 700; color: #0369a1; letter-spacing: 1rpx; }
.ctx-txt { font-size: 26rpx; }
.ctx-ellipsis { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ctx-arrow { font-size: 22rpx; color: #969799; }

/* 校区选择项 */
.campus-opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 12rpx;
  background: #fff;
  font-size: 28rpx;
  color: #323233;
}
.campus-opt-on { border-color: #1677ff; background: rgba(22, 119, 255, 0.08); font-weight: 600; }
.campus-opt-check { color: #1677ff; font-size: 30rpx; }
