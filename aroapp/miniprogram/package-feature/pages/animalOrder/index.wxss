.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f4ef;
  box-sizing: border-box;
}

/* AUP 选择条 */
.aup-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 20rpx 0;
  padding: 16rpx 20rpx;
  background: #eef6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 16rpx;
}
.aup-bar-empty {
  background: #fff7ed;
  border-color: #fed7aa;
}
.aup-tag {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #0284c7;
  text-transform: uppercase;
}
.aup-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.aup-arrow {
  color: #969799;
  font-size: 30rpx;
}

/* 时间窗 */
.time-banner {
  margin: 12rpx 20rpx 0;
  padding: 12rpx 16rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #9a3412;
}
.time-eta {
  margin: 12rpx 20rpx 0;
  font-size: 22rpx;
  color: #646566;
}

/* 面包屑 */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin: 12rpx 20rpx 0;
  padding: 8rpx 12rpx;
  background: #fff;
  border: 1rpx solid #ebecef;
  border-radius: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
}
.crumb-back {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: #ac1736;
}
.crumb-sep {
  color: #c8c9cc;
  margin: 0 4rpx;
}
.crumb-item {
  font-size: 24rpx;
  color: #646566;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.crumb-on {
  color: #323233;
  font-weight: 600;
}

/* 列表：下钻 + 侧边栏 */
.main-area {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}
.main-area-split {
  flex-direction: row;
}
.side {
  width: 256rpx;
  flex-shrink: 0;
  min-height: 0;
  border-right: 1rpx solid #ebecef;
  background: #faf8f4;
  box-sizing: border-box;
}
.side-back {
  padding: 16rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #ac1736;
  border-bottom: 1rpx solid #ebecef;
}
.side-title {
  padding: 12rpx;
  font-size: 20rpx;
  color: #969799;
  letter-spacing: 1rpx;
}
.side-item {
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  color: #646566;
  border-left: 6rpx solid transparent;
  word-break: break-all;
  line-height: 1.4;
}
.side-item-on {
  border-left-color: #ac1736;
  background: #fff;
  color: #ac1736;
  font-weight: 600;
}
.list {
  flex: 1;
  min-width: 0;
  min-height: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.list-pad {
  height: 24rpx;
}
.muted {
  padding: 80rpx 0;
  text-align: center;
  color: #969799;
  font-size: 26rpx;
}
.muted.pad {
  padding: 48rpx 24rpx;
}
.goods {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 1rpx solid #ebecef;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.goods-cover {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.goods-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #c8c9cc;
}
.goods-main {
  flex: 1;
  min-width: 0;
}
.goods-spec {
  position: relative;
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  background: #fbecee;
  color: #ac1736;
  border: 1rpx solid rgba(172, 23, 54, 0.25);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.goods-spec-badge {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  line-height: 30rpx;
  text-align: center;
  background: #ef4444;
  color: #fff;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
}
.goods-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}
.goods-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #969799;
}
.goods-arrow {
  flex-shrink: 0;
  color: #c8c9cc;
  font-size: 36rpx;
}

/* 底部栏 */
.cart-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #ebecef;
}
.cart-orders {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  border: 1rpx solid #ebecef;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #646566;
  background: #f7f4ef;
}
.cart-main {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 0;
  background: #ac1736;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.cart-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ef4444;
  color: #fff;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

/* Sheet 通用 */
.sheet {
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}
.sheet-head {
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #ebecef;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #323233;
}
.sheet-scroll {
  max-height: 46vh;
  padding: 8rpx 32rpx;
  box-sizing: border-box;
}
.sheet-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ebecef;
}
.foot-btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.foot-btn.ghost {
  border: 1rpx solid #ebecef;
  color: #646566;
  background: #fff;
}
.foot-btn.primary {
  background: #ac1736;
  color: #fff;
}
.sheet-remark {
  padding: 12rpx 32rpx;
  border-top: 1rpx solid #ebecef;
}
.remark-input {
  width: 100%;
  padding: 16rpx;
  background: #f7f4ef;
  border-radius: 12rpx;
  font-size: 24rpx;
}

/* 规格行 */
.spec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.spec-label {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #323233;
}
.spec-step {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border: 1rpx solid #ebecef;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #323233;
  background: #fff;
}
.step-btn-plus {
  background: #ac1736;
  color: #fff;
  border-color: #ac1736;
}
.step-btn-off {
  opacity: 0.4;
}
.step-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

/* 购物车行 */
.cart-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.cart-line-mid {
  flex: 1;
  min-width: 0;
}
.cart-line-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-line-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

/* AUP 选项 */
.aup-opt {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.aup-opt-on .aup-opt-no {
  color: #ac1736;
  font-weight: 700;
}
.aup-opt-no {
  font-size: 26rpx;
  color: #323233;
}
.aup-opt-group {
  font-size: 22rpx;
  color: #969799;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 提交确认 */
.confirm {
  padding: 32rpx;
}
.confirm-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #323233;
}
.confirm-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #969799;
}
.confirm-input {
  width: 100%;
  margin-top: 20rpx;
  padding: 16rpx;
  background: #f7f4ef;
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  height: 140rpx;
}
.confirm-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 订单 */
.orders {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f7f4ef;
}
.orders-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #ebecef;
  background: #fff;
}
.orders-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #323233;
}
.orders-close {
  font-size: 30rpx;
  color: #969799;
  padding: 8rpx;
}
.orders-scroll {
  flex: 1;
  padding: 20rpx 32rpx;
}
.order-card {
  background: #fff;
  border: 1rpx solid #ebecef;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order-id {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}
.order-status {
  font-size: 22rpx;
  font-weight: 600;
  color: #ac1736;
  background: #fbecee;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.order-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #969799;
}

/* 访客 */
.gate {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  background: #f7f4ef;
}
.gate-title {
  font-size: 30rpx;
  color: #646566;
}
.gate-btn {
  padding: 18rpx 64rpx;
  background: #ac1736;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
