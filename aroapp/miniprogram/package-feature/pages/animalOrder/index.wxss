.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #eef0f6;
  box-sizing: border-box;
}

/* 时间窗 */
.time-banner {
  margin: 12rpx 20rpx 0;
  padding: 12rpx 16rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #9a3412;
}
.time-eta {
  margin: 12rpx 20rpx 0;
  font-size: 22rpx;
  color: #334155;
}

/* 面包屑 */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin: 12rpx 20rpx 0;
  padding: 8rpx 12rpx;
  background: #fff;
  
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  border-radius: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
}
.crumb-back {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: #1d4ed8;
}
.crumb-sep {
  color: #cbd5e1;
  margin: 0 4rpx;
}
.crumb-item {
  font-size: 24rpx;
  color: #334155;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.crumb-on {
  color: #1f2937;
  font-weight: 600;
}

/* 列表：下钻 + 侧边栏 */
.main-area {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}
.main-area-split {
  flex-direction: row;
}
.side {
  width: 192rpx;
  flex-shrink: 0;
  min-height: 0;
  border-right: 1rpx solid #eef0f4;
  background: #f6f7fb;
  box-sizing: border-box;
}
.side-back {
  padding: 16rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #2563eb;
  border-bottom: 1rpx solid #eef0f4;
}
.side-title {
  padding: 12rpx;
  font-size: 20rpx;
  color: #94a3b8;
  letter-spacing: 1rpx;
}
.side-item {
  padding: 16rpx 12rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #334155;
  word-break: break-all;
  line-height: 1.4;
}
.side-item-on {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}
.list {
  flex: 1;
  min-width: 0;
  min-height: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.list-pad {
  height: 24rpx;
}
.muted {
  padding: 80rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}
.muted.pad {
  padding: 48rpx 24rpx;
}
.goods {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.goods-cover {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #f1f3f7;
}
.goods-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #cbd5e1;
}
.goods-main {
  flex: 1;
  min-width: 0;
}
/* 价格 + 操作控件同一行；控件不再绝对定位，不抢文本宽度也不独占一行 */
.goods-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 8rpx;
}
.goods-spec {
  position: relative;
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  background: #f6f7fb;
  color: #1f2937;
  background: #f6f7fb;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}
/* 数量选择器：复用物资领用的胶囊组（一条描边 + 中间手动输入框），替代原来的独立大方块 */
.step-inline {
  flex-shrink: 0;
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
  box-sizing: border-box;
}
/* 卡片里的实例脱离文档流（文字已按此预留右侧空间） */
.si-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1f2937;
}
.si-btn-plus {
  color: #fff;
  background: #2563eb;
}
.si-btn-hover {
  background: #1d4ed8;
}
.si-num-input {
  width: 72rpx;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 4rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
  background: #f6f7fb;
  box-sizing: border-box;
}
.goods-spec-badge {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  line-height: 30rpx;
  text-align: center;
  background: #ef4444;
  color: #fff;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
}
/* 主标题 + 副标题同排：容器裁切，副标题跟在标题后面 */
.goods-title-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.goods-sub {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
.goods-arrow {
  flex-shrink: 0;
  color: #cbd5e1;
  font-size: 36rpx;
}
.goods-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #94a3b8;
}
.goods-price {
  font-size: 24rpx;
  font-weight: 700;
  color: #1d4ed8;
}
/* 未开启价格时的占位，保持各行高度与操作区位置一致 */
.goods-price-empty {
  color: #cbd5e1;
  font-weight: 500;
}
/* 行内「剩余可订量」：价格与「选择规格」之间挤一行，超出省略号，不撑高行 */
/* 每周期上限：独立一行、占满卡片正文宽度（以前挤在 goods-foot 里被省略号截成「雌性 …」） */
.goods-quota {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #64748b;
}
.goods-quota--grey {
  color: #94a3b8;
}

/* 底部栏 */
.cart-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eef0f4;
}
.cart-orders {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  background: #f1f3f7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #334155;
  background: #f6f7fb;
}
.cart-main {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 0;
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.cart-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ef4444;
  color: #fff;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

/* Sheet 通用 */
.sheet {
  display: flex;
  flex-direction: column;
  max-height: 94vh;
}
.sheet-head {
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #eef0f4;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}
/* 标题下方的次要说明（分配浮层用来放「已选 N 笼 · 已分配 x/y」） */
.sheet-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
.sheet-scroll {
  /* flex:1 + min-height:0：固定住页脚，列表再长也在区域内滚；
     只用 max-height 的话内容一多会把底部按钮顶出弹层 */
  flex: 1;
  min-height: 0;
  padding: 8rpx 32rpx;
  box-sizing: border-box;
}
.foot-btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.foot-btn.ghost {
  color: #334155;
  background: #f1f3f7;
}
.foot-btn.primary {
  background: #2563eb;
  color: #fff;
}
/* 小号文字动作：「清空草稿」「撤回 READY」用，与实底按钮同排但不占按钮宽度
   —— 否则四个控件挤一行会把备注输入框压没。文字动作不是按钮，不适用实底/描边那套规范。 */
.foot-link {
  flex-shrink: 0;
  padding: 0 10rpx;
  font-size: 24rpx;
  line-height: 1;
  color: #64748b;
}
.foot-link--danger {
  color: #dc2626;
}
/* 抽屉页脚：按钮并排、按内容宽度靠右（原先 .sheet-foot 根本没定义 → view 是块级，按钮各占一整行） */
.sheet-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eef0f4;
}
.sheet-foot .foot-btn { flex-shrink: 0; }

/* 打包备注：跟提交按钮同一行，吃剩余宽度 */
.remark-input {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  padding: 14rpx 16rpx;
  background: #f6f7fb;
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

/* 购物车行：左信息列 + 右加减器同一行。
   原先没有这条 flex，右侧的加减器/×N 会掉到文字块下面自成一行，一车行看着全是竖条。 */
.cart-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}

.cart-line-mid {
  flex: 1;
  min-width: 0;
}

/* 主行：品名 + 规格 + 状态徽标挤一行 */
.cart-line-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.cart-line-name {
  /* 只缩不涨：规格/状态徽标紧跟品名，不会因为名字短就飘到最右边贴着加减器 */
  flex: 0 1 auto;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-line-spec {
  flex-shrink: 0;
  max-width: 45%;
  padding: 0 6rpx;
  border-radius: 6rpx;
  background: #f1f5f9;
  font-size: 20rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-line-status {
  flex-shrink: 0;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #f1f5f9;
  font-size: 18rpx;
  font-weight: 700;
  color: #94a3b8;
}

.cart-line-status--ready {
  background: #d1fae5;
  color: #047857;
}

/* 副行：房间 / 领用人 / 金额一行挤下，金额靠右；再挤就省略号，不换行堆高 */
.cart-line-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  min-width: 0;
  overflow: hidden;
}

.cart-line-tag {
  flex-shrink: 0;
  max-width: 100%;
  font-size: 20rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-line-tag--price {
  margin-left: auto;
  font-weight: 600;
  color: #1d4ed8;
}

/* ── 购物车分组（镜像 CartTree.tsx 的 AUP→实验员 / 规格→实验员） ── */
/* 标题 + 视角切换并排（切换器在标题行内，不再另占一行）。
   padding-right 让开 van-popup closeable 的关闭按钮 —— 那个 × 是绝对定位在弹层右上角，
   不留位的话胶囊会被它压住，看着就像没有。 */
.sheet-head--cart {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-right: 72rpx;
}

/* 一行里要放下标题 + 胶囊 + 关闭按钮：标题只缩不换行，胶囊整体压一档 */
.sheet-head--cart .sheet-title {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-head--cart .ord-tab {
  padding: 6rpx 14rpx;
  font-size: 22rpx;
}
.cart-tree-tabs {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
  padding: 0;
}
.ct-group { margin-bottom: 24rpx; }
.ct-group-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #1d4ed8;
}
.ct-sub { padding-left: 16rpx; }
.ct-sub-title {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
}
.cart-line-qty {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
}

/* AUP 选项 */
.aup-opt {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #eef0f4;
}
.aup-opt-on {
  background: #2563eb;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}

.aup-opt-on .aup-opt-no,
.aup-opt-on .aup-opt-group {
  color: #fff;
}
.aup-opt-no {
  font-size: 26rpx;
  color: #1f2937;
}
.aup-opt-group {
  font-size: 22rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 提交确认 */
.confirm {
  padding: 32rpx;
}
.confirm-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}
.confirm-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
}
.confirm-input {
  width: 100%;
  margin-top: 20rpx;
  padding: 16rpx;
  background: #f6f7fb;
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  height: 140rpx;
}
.confirm-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 订单页统一 border-box：小程序无全局 reset，content-box 下的 padding 会把整页撑出屏幕 */
.orders,
.orders view,
.orders scroll-view,
.orders text,
.orders input {
  box-sizing: border-box;
}

/* 订单（整页显示，撑满导航栏以下） */
.orders {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  background: #f6f7fb;
}
.orders-scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx 32rpx;
}
/* 触底加载提示：必须留在滚动区内部（放外面会让滚动区高度变化 → 微信重置 scrollTop，一触底就跳回顶部） */
.ord-foot {
  padding: 28rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
}
.order-card {
  background: #fff;
  
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order-id {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.order-status {
  font-size: 22rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: #e8f0fe;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.order-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

/* 访客 */
.gate {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  background: #f6f7fb;
}
.gate-title {
  font-size: 30rpx;
  color: #334155;
}
.gate-btn {
  padding: 18rpx 64rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* ── 校区门禁 ── */
.campus-gate {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.campus-gate-card {
  width: 100%;
  padding: 40rpx 32rpx;
  background: #ffffff;
  
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  border-radius: 24rpx;
  box-sizing: border-box;
}
.campus-gate-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}
.campus-gate-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a8578;
}
.campus-gate-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
.campus-gate-btn {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  background: #f1f3f7;
  border-radius: 16rpx;
}

/* ── 领用方式/房间 + 代领人 ── */
.pickup-block {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef0f4;
}
.pickup-label .req { color: #ef4444; }
/* 房间树 */


/* 代领人 */
.collector-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eef0f4;
  font-size: 28rpx;
  color: #1f2937;
}
.collector-row-sel {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}
.collector-name { flex: 1; min-width: 0; }
.collector-job { color: #94a3b8; font-size: 24rpx; }
.foot-btn-off {
  background: #e5e7eb;
  color: #9aa0a6;
}

.spec-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #eef0f4;
  background: #f6f7fb;
  border-radius: 12rpx;
}
.spec-total-label { font-size: 24rpx; color: #64748b; }
.spec-total-value { font-size: 30rpx; font-weight: 700; color: #1d4ed8; }
.cart-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #eef0f4;
}
.cart-total-label { font-size: 24rpx; color: #64748b; }
.cart-total-value { font-size: 30rpx; font-weight: 700; color: #1d4ed8; }

/* ── 订单记录（页签 / 筛选 / 卡片 / 表格） ── */
.ord-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  border-bottom: 1rpx solid #eef0f4;
  flex-wrap: wrap;
}
.ord-tabs {
  display: flex;
  background: #f1f3f7;
  border-radius: 999rpx;
  padding: 4rpx;
}
.ord-tab {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #334155;
  border-radius: 999rpx;
}
.ord-tab-on {
  background: #fff;
  color: #1f2937;
  font-weight: 600;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}
.ord-count { font-size: 22rpx; color: #94a3b8; margin-left: auto; }
.ord-btn {
  padding: 10rpx 26rpx;
  background: #f1f3f7;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #1f2937;
}
.ord-btn-primary { background: #2563eb; border-color: #2563eb; color: #fff; font-weight: 600; }
.ord-btn-off {
  background: #e5e7eb;
  border-color: #e5e7eb;
  color: #9aa0a6;
}

.ord-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #f6f7fb;
  border-bottom: 1rpx solid #eef0f4;
}
.ord-field { width: calc(50% - 8rpx); }
.ord-field-wide { width: 100%; }
.ord-flabel { display: block; font-size: 22rpx; color: #94a3b8; margin-bottom: 6rpx; }
.ord-finput {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  background: #fff;
  font-size: 26rpx;
  color: #1f2937;
}
.ord-filter-actions { width: 100%; display: flex; justify-content: flex-end; gap: 16rpx; }

/* 表格：横向滚动走 CSS（内嵌 scroll-view 会让外层竖滚区在追加时被重置 scrollTop，见 wxml 注释） */
.ord-table-wrap { width: 100%; overflow-x: auto;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  border-radius: 12rpx; background: #fff; }
.ord-table { min-width: 2200rpx; padding-bottom: 8rpx; }
.ord-tr { display: flex; flex-direction: row; border-bottom: 1rpx solid #eef0f4; }
.ord-tr-head { background: #f6f7fb; font-size: 22rpx; color: #334155; font-weight: 600; }
.ord-td { flex-shrink: 0; padding: 14rpx 12rpx; font-size: 22rpx; color: #1f2937; word-break: break-all; }
.ord-td.mono { font-family: monospace; font-size: 20rpx; color: #94a3b8; }
/* 表格拆成明细行：订单级块与行级块之间加竖分隔线，相邻订单之间加粗上边线 */
.ord-td.ord-line-split { background: #f6f7fb; }
.ord-tr-order { border-top: 2rpx solid #dde1e8; }
.ord-sub { font-size: 20rpx; color: #94a3b8; }
.w-no { width: 220rpx; }
.w-src { width: 110rpx; text-align: center; }
.w-group { width: 240rpx; }
.w-pi { width: 150rpx; }
.w-item { width: 340rpx; }
.w-supplier { width: 280rpx; }
.w-xs { width: 96rpx; text-align: center; }
.w-amt { width: 160rpx; text-align: right; color: #1d4ed8; font-weight: 600; }
.w-aup { width: 220rpx; }
.w-mid { width: 160rpx; }
.w-room { width: 280rpx; }
.w-cage { width: 280rpx; }
.w-date { width: 240rpx; }
.w-remark { width: 340rpx; }

/* 卡片 */
.ord-card {
  margin-bottom: 16rpx;
  padding: 20rpx;
  
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  border-radius: 12rpx;
  background: #fff;
}
.ord-card-head { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.ord-card-no { font-family: monospace; font-size: 22rpx; color: #94a3b8; }
.ord-chip {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #f1f3f7;
  font-size: 20rpx;
  color: #334155;
}
.ord-card-status { font-size: 24rpx; font-weight: 600; color: #1f2937; }
.ord-chip--pre {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #fef3c7;
  font-size: 20rpx;
  color: #b45309;
  font-weight: 600;
}
.ord-card-toggle { margin-left: auto; font-size: 20rpx; color: #94a3b8; }
.ord-card-line { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; font-size: 24rpx; }
.ord-k { color: #94a3b8; margin-right: 6rpx; font-size: 22rpx; }
.ord-v { color: #1f2937; font-size: 22rpx; }
.ord-v.strong { font-weight: 700; }
.ord-v.price { font-weight: 700; color: #1d4ed8; }
/* 明细摘要：收起态压成一行（最多两行），不再「一条明细一个块 + 单独一行『另有 N 项』」 */
.ord-item-line {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #475569;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.ord-card-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef0f4;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}
.ord-kv { width: calc(50% - 12rpx); font-size: 22rpx; }
.ord-kv-wide { width: 100%; }

/* ── 编辑模式横幅 / 记录卡动作 ── */
.edit-banner {
  margin: 12rpx 24rpx 0;
  padding: 16rpx 20rpx;
  
  border-radius: 12rpx;
  background: #f6f7fb;
}
.edit-banner-title { font-size: 26rpx; font-weight: 700; color: #1f2937; }
.edit-banner-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}
.edit-banner-actions { margin-top: 14rpx; display: flex; justify-content: flex-end; gap: 16rpx; }
.ord-card-actions { margin-top: 14rpx; display: flex; justify-content: flex-end; }
.foot-btn-off {
  background: #e5e7eb;
  color: #9aa0a6;
}

/* ── 加购上下文条（校区 + AUP 合成一条） ── */
.ctx-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eef0f4;
}
.ctx-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f1f3f7;
  border-radius: 999rpx;
  background: #f6f7fb;
  font-size: 26rpx;
  color: #1f2937;
}
.ctx-chip-flex { flex: 1; min-width: 0; }
.ctx-chip-warn { border-color: #fcd34d; background: #fffbeb; color: #92400e; }
.ctx-ico { font-size: 24rpx; }
.ctx-tag { font-size: 20rpx; font-weight: 700; color: #1d4ed8; letter-spacing: 1rpx; }
.ctx-txt { font-size: 26rpx; }
.ctx-ellipsis { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ctx-arrow { font-size: 22rpx; color: #94a3b8; }

/* 校区选择项 */
.campus-opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  border-radius: 12rpx;
  background: #fff;
  font-size: 28rpx;
  color: #1f2937;
}
.campus-opt-on {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}
.campus-opt-check { color: #fff; font-size: 30rpx; }

/* ---- 笼位区（订购抽屉）------------------------------------------------
   一笼一规格：可点=状态底色，不可点=实色灰，已选=蓝环 + 分配数角标。
   不用 opacity（半透明看着糊），禁用态用实色灰压掉 inline 的状态底色。 */
.cage-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.cage-title {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.cage-hint {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #94a3b8;
}

/* 「分配」入口：笼位行右侧的药丸，点开分配浮层（不换抽屉内容） */
.cage-assign {
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #e8f0ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.cage-clear {
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f1f3f7;
  color: #334155;
  font-size: 22rpx;
  line-height: 48rpx;
}

.cage-error {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #dc2626;
}

.cage-loading {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

/* tab 与动作按钮同一行 */
.cage-tabs-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.cage-tabs {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.cage-tabs-placeholder {
  flex: 1;
  min-width: 0;
}

.cage-acts {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cage-act {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
}

.cage-act--ghost {
  background: #f1f3f7;
  color: #334155;
}

.cage-act--primary {
  background: #2563eb;
  color: #fff;
}

.cage-act--off {
  background: #e5e7eb;
  color: #9aa0a6;
}

.cage-tabs-inner {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.cage-tab {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f1f3f7;
  color: #334155;
  font-size: 24rpx;
}

.cage-tab-on {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.28);
}

.cage-shelf {
  margin-bottom: 10rpx;
}

.cage-shelf-name {
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

/* 超额提示：常驻底部浮层，不参与文档流。原先跟在网格后面，一出现把内容顶高、
   一消失又缩回，滚动位置随内容高度弹一下（点格子像「跳回购物车那一行」）。 */
.cage-warn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  /* 压过 van-popup（默认 z-index 100 起）：分配浮层开着时加数量照样看得见「超出 N 只」 */
  z-index: 9999;
  margin: 0;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(220, 38, 38, 0.94);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(220, 38, 38, 0.32);
}

/* 按顺序分配（照 H5 抽屉第二页的列表形态）：一笼一行，右侧 −/+ 微调；
   默认已按选中顺序自动分好，这里只处理「想多放/少放」的例外 */
.cage-alloc-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fff;
}

.cage-alloc-no {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #0ea5e9;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
}

.cage-alloc-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cage-alloc-pos {
  font-size: 26rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cage-alloc-where {
  font-size: 20rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cage-alloc-step {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cage-alloc-btn {
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #f1f3f7;
  color: #334155;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 62rpx;
  text-align: center;
}

.cage-alloc-btn--plus {
  background: #2563eb;
  border-color: #2563eb;
  color: #fff;
}

.cage-alloc-btn--hover {
  opacity: 0.75;
}

.cage-alloc-btn--off {
  opacity: 0.35;
}

.cage-alloc-qty {
  min-width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.cage-alloc-hint {
  padding: 8rpx 0 24rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #94a3b8;
}

/* ---- 规格选项：一条一张卡；填了数量的那条高亮（蓝底白字，与全站选中口径一致） ---- */
/* 一行两个（只有一条时自动撑满整行） */
.spec-opts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.spec-opt {
  flex: 1 1 calc(50% - 6rpx);
  min-width: 0;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f6f7fb;
  box-sizing: border-box;
}

/* 名称与步进器同一行（半宽卡片里也放得下） */
.spec-opt-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.spec-opt--on {
  background: #2563eb;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}

.spec-opt--blocked {
  background: #f1f3f7;
}

/* 名字 + 上限挤在一个可伸缩块里：不加这层的话名字的 flex:1 会把上限推到步进器边上，
   读起来不像「这个规格的上限」。卡片是半宽的，所以名字仍要能省略。 */
.spec-opt-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.spec-opt-name {
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 剩余上限：与卡片上的 goods-quota 同一套配色（够用=slate、已订满=更浅） */
.spec-opt-quota {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #64748b;
}
.spec-opt-quota--out {
  color: #94a3b8;
}

.spec-opt-price {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #64748b;
}

.spec-opt-hint {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9aa0a6;
}

.spec-opt--on .spec-opt-name,
.spec-opt--on .spec-opt-price {
  color: #fff;
}

.spec-opt--blocked .spec-opt-name {
  color: #9aa0a6;
}

.spec-step {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
}

.spec-step-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #334155;
  background: #fff;
}

.spec-step-btn--hover {
  background: #e5e7eb;
}

.spec-step-btn--plus {
  color: #fff;
  background: #2563eb;
}

.spec-opt--on .spec-step-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.spec-opt--on .spec-step-btn--plus {
  background: #fff;
  color: #2563eb;
}

.spec-step-input {
  width: 68rpx;
  height: 44rpx;
  margin: 0 6rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1f2937;
  background: #fff;
}

/* 备注：只在选中该选项后出现，窄条一行放在卡片底部 */
.spec-opt-remark {
  width: 100%;
  height: 44rpx;
  margin-top: 8rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #fff;
  font-size: 22rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.spec-opt-remark-ph {
  color: #b0b8c4;
}

/* ---- 领用房间 / 领用人：一行一条，靠分隔线分层，不再用线框 ---- */
.pickup-block {
  margin-top: 12rpx;
}

/* 领用房间 / 领用人 并排一行（省纵向空间） */
.pickup-block--two {
  display: flex;
  gap: 16rpx;
}

.pickup-block--two .pickup-row {
  flex: 1;
  min-width: 0;
  border-top: 1rpx solid #eef0f4;
}

.pickup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #eef0f4;
}

.pickup-block--two .pickup-row-label {
  font-size: 24rpx;
}

.pickup-row-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #334155;
}

.pickup-row-value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.pickup-row-value--empty {
  color: #b0b8c4;
}

.pickup-row-hint {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.pickup-row-arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #cbd5e1;
}

/* ── 领用方式切换：饲养=预定笼位（默认），取走=不占笼位不选房间。
   实色底 + 1px 描边（全站选中口径），复用本文件的蓝 #2563eb / 描边 #e5e7eb / 分隔 #eef0f4。 ── */
.pickup-mode {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef0f4;
}
.pickup-mode-btn {
  padding: 8rpx 28rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: 1rpx solid #e5e7eb;
  color: #334155;
  background: #fff;
}
.pickup-mode-btn--on {
  background: #2563eb;
  border-color: #2563eb;
  color: #fff;
}
.pickup-mode-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: #94a3b8;
}

/* ── 到货周期：与领用方式同排的紧凑 picker（不排按钮，否则周期一多就换行、把网格挤没） ── */
.pickup-cycle-pick {
  margin-left: auto;
  min-width: 0;
}
.pickup-cycle {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e5e7eb;
  background: #fff;
}
.pickup-cycle-key {
  font-size: 22rpx;
  color: #94a3b8;
}
.pickup-cycle-val {
  font-size: 24rpx;
  color: #334155;
}
/* 选了未来周期 = 预约：标成主色实底，与「本周期」一眼可分 */
.pickup-cycle-val--on {
  color: #2563eb;
  font-weight: 600;
}
.pickup-cycle-arrow {
  font-size: 20rpx;
  color: #94a3b8;
}

/* ── 未配上限的规格：置灰 + 说明文字（不静默，明确「未配置订购上限」） ── */
.spec-opt--noquota {
  background: #f1f3f7;
}
.spec-opt--noquota .spec-opt-name {
