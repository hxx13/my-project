.aa-page {
  min-height: 100vh;
  background: #f5f6f7;
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.aa-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.aa-toolbar-text {
  flex: 1;
  min-width: 0;
}
.aa-toolbar-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #323233;
  line-height: 1.35;
}
.aa-toolbar-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #646566;
  line-height: 1.5;
}

.aa-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}
.aa-btn--primary {
  color: #fff;
  background: linear-gradient(135deg, #c41e3a 0%, #ac1736 100%);
  box-shadow: 0 4rpx 14rpx rgba(172, 23, 54, 0.22);
}
.aa-btn--ghost {
  color: #ac1736;
  border-color: rgba(172, 23, 54, 0.28);
  background: rgba(172, 23, 54, 0.06);
}

.aa-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.aa-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(235, 238, 239, 0.95);
  box-shadow: 0 4rpx 18rpx rgba(31, 56, 88, 0.06);
}
.aa-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.aa-card-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}
.aa-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.aa-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.3;
}
.aa-status--on {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}
.aa-status--off {
  color: #969799;
  background: #f2f3f5;
}
.aa-card-summary {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #646566;
  line-height: 1.55;
}
.aa-card-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #969799;
}

.aa-empty,
.aa-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  text-align: center;
  color: #969799;
  padding: 100rpx 32rpx;
  font-size: 26rpx;
}
.aa-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #646566;
}
.aa-empty-hint {
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}
