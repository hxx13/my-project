<view class="ae-page">
  <view wx:if="{{ loading }}" class="ae-status-wrap">
    <van-loading type="spinner" size="48rpx" color="#ac1736" />
    <text class="ae-status-text">加载中…</text>
  </view>

  <view wx:elif="{{ errorMessage }}" class="ae-status-wrap">
    <text class="ae-error-text">{{ errorMessage }}</text>
    <view class="ae-btn ae-btn--primary" bindtap="retryLoad">重试</view>
  </view>

  <block wx:else>
    <scroll-view scroll-y class="ae-scroll" enhanced show-scrollbar="{{ false }}">
      <view class="ae-section">
        <text class="ae-section-label">基本信息</text>
        <van-cell-group inset border="{{ false }}">
          <van-field label="标题" required placeholder="公告标题" value="{{ form.title }}" bind:change="onFv" data-k="title" />
          <van-field
            label="摘要"
            type="textarea"
            autosize="{{ { minHeight: 60 } }}"
            placeholder="列表摘要（可选）"
            value="{{ form.summary }}"
            bind:change="onFv"
            data-k="summary"
          />
        </van-cell-group>
      </view>

      <view class="ae-section">
        <text class="ae-section-label">正文内容</text>
        <view class="ae-editor-wrap">
          <md-editor value="{{ form.bodyMd }}" disabled="{{ submitting }}" bind:change="onRichBodyChange" />
        </view>
      </view>

      <view class="ae-section">
        <text class="ae-section-label">发布设置</text>
        <van-cell-group inset border="{{ false }}">
          <van-field
            label="排序权重"
            type="number"
            placeholder="数字越大越靠前"
            value="{{ form.sortOrderStr }}"
            bind:change="onFv"
            data-k="sortOrderStr"
          />
          <view class="ae-switch-row">
            <view class="ae-switch-copy">
              <text class="ae-switch-label">上线展示</text>
              <text class="ae-switch-hint">关闭后保存为草稿，首页不展示</text>
            </view>
            <van-switch checked="{{ form.enabled }}" bind:change="onEnabledSwitch" active-color="#ac1736" />
          </view>
        </van-cell-group>
      </view>
    </scroll-view>

    <view class="ae-foot">
      <view wx:if="{{ editingId }}" class="ae-foot-row">
        <view class="ae-btn ae-btn--danger" bindtap="confirmDelete">删除</view>
      </view>
      <view class="ae-foot-row ae-foot-row--main">
        <view class="ae-btn ae-btn--ghost" bindtap="onCancel">取消</view>
        <view class="ae-btn ae-btn--primary" bindtap="submitForm">{{ submitting ? '提交中…' : submitBtnText }}</view>
      </view>
    </view>
  </block>
</view>
