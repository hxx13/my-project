.page {
  padding: 20rpx;
  background: #f6f7fb;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

/* ── 标题行 ── */
.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  flex: 0 0 auto;
}

.title-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
}

/* ── 基础按钮 ── */
.ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 8rpx;
  white-space: nowrap;
  text-align: center;
  font-size: 20rpx;
  line-height: 1;
  border: none;
  height: 40rpx;
  padding: 0 14rpx;
  font-weight: 500;
  gap: 4rpx;
}

/* ── 校区按钮 ── */
.ui-btn-campus {
  background: #f1f5f9;
  color: #64748b;
}

.campus-pudong {
  background: #3b82f6;
  color: #ffffff;
}

.campus-puxi {
  background: #f97316;
  color: #ffffff;
}

.campus-arrow {
  font-size: 14rpx;
}

/* ── 添加资产（蓝色实心 + 扫码图标） ── */
.ui-btn-add {
  background: #3b82f6;
  color: #ffffff;
}

/* ── 导出表格（深灰实心） ── */
.ui-btn-export {
  background: #475569;
  color: #ffffff;
}

/* ── 申请转移（琥珀色实心） ── */
.ui-btn-transfer {
  background: #d97706;
  color: #ffffff;
}

/* ── 搜索栏 ── */
.search-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.search-input-wrap {
  position: relative;
  flex: 1 1 auto;
  min-width: 0;
}

.search-input {
  width: 100%;
  height: 56rpx;
  border: 1rpx solid #dce3ef;
  border-radius: 10rpx;
  padding: 0 56rpx 0 16rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: normal;
}

.scan-btn {
  position: absolute;
  right: 8rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-top: -22rpx;
  border: 1rpx solid #dce3ef;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  background: #f8fafc;
}

.ui-btn-search-main {
  background: #3b82f6;
  color: #ffffff;
  height: 56rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  min-width: 80rpx;
}

.ui-btn-search-sub {
  background: #475569;
  color: #ffffff;
  height: 56rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  min-width: 80rpx;
}

/* ── 资产卡片 ── */
.asset-item-card {
  position: relative;
  padding-bottom: 20rpx;
}

/* 校区左边框色条 */
.card-campus-pudong {
  border-left: 6rpx solid #3b82f6;
}

.card-campus-puxi {
  border-left: 6rpx solid #f97316;
}

.card-campus-unknown {
  border-left: 6rpx solid #cbd5e1;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  min-width: 0;
}

.item-row-label {
  min-width: 132rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.item-row-value {
  flex: 1;
  min-width: 0;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.item-row-with-actions {
  position: relative;
}

.item-row-value-with-actions {
  padding-right: 166rpx;
}

.inline-card-actions {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  z-index: 2;
}

.inline-card-actions .ui-btn {
  border: 1rpx solid #cbd5e1;
  background: #fff;
  color: #475569;
  font-size: 20rpx;
  height: 36rpx;
  padding: 0 10rpx;
}

/* 校区标签 */
.campus-tag {
  margin-left: auto;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
  flex: 0 0 auto;
}

.campus-tag-pudong {
  color: #ffffff;
  background: #3b82f6;
}

.campus-tag-puxi {
  color: #ffffff;
  background: #f97316;
}

.campus-tag-unknown {
  color: #64748b;
  background: #f1f5f9;
  border: 1rpx dashed #cbd5e1;
}

.campus-tag:active {
  opacity: 0.85;
}

/* ── 通用面板/Mask ── */
.meta {
  color: #64748b;
  font-size: 26rpx;
  text-align: center;
  padding: 30rpx 0;
}

.input {
  flex: 1;
  border: 1rpx solid #dce3ef;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  min-width: 0;
  height: 56rpx;
  line-height: normal;
}

.row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.panel {
  width: 100%;
  max-height: 90vh;
  background: #fff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  padding: 20rpx;
  overflow-y: auto;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
}

.panel-close {
  font-size: 26rpx;
  color: #64748b;
}

.panel-close-primary {
  color: #3b82f6;
}

.panel-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.field {
  margin-bottom: 18rpx;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
}

.value {
  font-size: 28rpx;
  color: #1e293b;
}

.detail-edit-input {
  font-size: 28rpx;
  padding: 0 14rpx;
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  min-width: 0;
}

/* ── 详情面板 ── */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20rpx;
}

.detail-panel {
  width: 92vw;
  max-height: 82vh;
  background: #f6f7fb;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.detail-scroll {
  flex: 1;
  max-height: 64vh;
}

/* 详情内容卡片 */
.detail-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  min-height: 56rpx;
}
.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  min-width: 120rpx;
  font-size: 26rpx;
  color: #64748b;
  flex: 0 0 auto;
  line-height: 1.4;
}
.detail-label-empty {
  color: #94a3b8;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
  word-break: break-all;
  line-height: 1.4;
}
.detail-value-empty {
  color: #94a3b8;
}
.detail-value-status {
  font-weight: 600;
}

.detail-transfer-card {
  border-left: 4rpx solid #d97706;
}

/* 字段分组标题（与展开更多按钮风格统一） */
.detail-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.group-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #475569;
}

.group-arrow {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 折叠空字段 */
.detail-more-wrap {
  margin-bottom: 14rpx;
}

.detail-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #64748b;
}

.more-arrow {
  font-size: 20rpx;
}

/* 照片头 */
.detail-photo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-photo-empty {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.ui-icon-btn-sm {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 1rpx solid #3b82f6;
  color: #3b82f6;
  background: #eff6ff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ── 动态列（旧，保留） ── */
.dyn-wrap {
  margin-top: 8rpx;
}

.dyn-line {
  font-size: 24rpx;
  color: #334155;
  margin-bottom: 6rpx;
}

.dyn-key {
  color: #64748b;
}

/* ── 照片 ── */
.photo-toolbar {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-thumb-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.photo-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
}

.photo-remove {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(15, 23, 42, 0.65);
  border-radius: 18rpx;
}

.detail-photo-block {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #e2e8f0;
}

/* ── 上传/图标按钮 ── */
.ui-icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  border: 1rpx solid #3b82f6;
  color: #3b82f6;
  background: #eff6ff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ui-btn-disabled {
  opacity: 0.55;
}

/* 通用实心按钮（蓝底白字，用于弹窗内确认等） */
.ui-btn-primary {
  background: #3b82f6;
  color: #ffffff;
  border: none;
}

.ui-btn-mini {
  min-width: 80rpx;
  height: 56rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  border: none;
  flex: 0 0 auto;
}

/* 转移弹窗（居中） */
.apply-panel {
  width: 92vw;
  max-height: 82vh;
  background: #f6f7fb;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
  overflow-y: auto;
}

.apply-search-scroll {
  max-height: 360rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  background: #fff;
}

.ui-btn-submit {
  width: 100%;
  height: 52rpx;
  margin-top: 12rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: #3b82f6;
  color: #fff;
}

/* ── 路径联想 ── */
.location-input-wrap {
  position: relative;
}

.location-suggestions {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  max-height: 280rpx;
  overflow-y: auto;
  z-index: 10;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
}

.location-suggestion-item {
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #334155;
  border-bottom: 1rpx solid #f1f5f9;
}

.location-suggestion-item:active {
  background: #eff6ff;
}

/* ── 扫码填充面板 ── */
.fill-panel {
  width: 86vw;
  max-height: 68vh;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.fill-scroll {
  max-height: 40vh;
}

.fill-field-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.fill-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
  flex: 0 0 36rpx;
}

.fill-checkbox-on {
  background: #3b82f6;
  border-color: #3b82f6;
  color: #fff;
}

.fill-field-label {
  font-size: 23rpx;
  color: #64748b;
  flex: 0 0 auto;
  min-width: 100rpx;
}

.fill-field-value {
  font-size: 23rpx;
  color: #334155;
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fill-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
  justify-content: center;
}

.fill-actions .ui-btn {
  height: 40rpx;
  border: none;
}

/* ── 已存在资产提示 ── */
.existing-hint {
  text-align: center;
  padding: 30rpx 0;
}

.existing-icon {
  font-size: 48rpx;
  margin-bottom: 14rpx;
}

.existing-text {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.existing-detail {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 20rpx;
}

.existing-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.existing-actions .ui-btn {
  border: none;
}

/* ── 转移资产摘要卡片 ── */
.transfer-asset-card {
  background: #f8fafc;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.transfer-asset-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.transfer-asset-code {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.transfer-asset-from {
  font-size: 24rpx;
  color: #f97316;
  font-weight: 500;
}

.photo-count {
  font-size: 22rpx;
  color: #64748b;
  margin-left: 8rpx;
}

/* ── 搜索/转移面板 ── */
.search-box {
  max-height: 320rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  margin-top: 8rpx;
}

.search-row {
  padding: 10rpx 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.search-name {
  font-size: 26rpx;
  color: #0f172a;
}

.search-sub {
  font-size: 23rpx;
  color: #64748b;
}

.transfer-time-row {
  align-items: center;
}

.time-picker {
  flex: 1 1 0;
  min-width: 0;
}

.time-picker-inner {
  text-align: center;
}

.picker {
  width: 100%;
  border: 1rpx solid #dce3ef;
  border-radius: 10rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
  background: #fff;
  font-size: 28rpx;
  color: #1e293b;
  text-align: left;
  box-sizing: border-box;
}

.picker-date {
  color: #1e293b;
}
