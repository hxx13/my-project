/* ================================================================== */
/*  Card Print —— 页面骨架（业务逻辑由后续任务填）                        */
/* ================================================================== */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #eef0f6;
  overflow-x: hidden;
}

/* ── 顶部固定卡：标题 + 操作 + 面包屑 + 队列（值照 fileTemplates，类名换 cp- 前缀） ── */
/* 本页 .page 没有 padding，卡片自带左右外边距，别贴边 */
.cp-card {
  flex-shrink: 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 12rpx 16rpx 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.cp-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.cp-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
  flex: 0 0 auto;
  white-space: nowrap;
}

.cp-title-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1 1 auto;
  justify-content: flex-end;
  min-width: 0;
}

/* ── 基础按钮 ── */
.cp-ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 10rpx;
  white-space: nowrap;
  text-align: center;
  font-size: 24rpx;
  line-height: 1;
  border: none;
  height: 56rpx;
  padding: 0 16rpx;
  font-weight: 500;
  gap: 4rpx;
}

.cp-ui-btn-plain {
  background: #f1f3f7;
  color: #334155;
}

/* 实色强调按钮：值照 fileTemplates .ui-btn-add（实色蓝 + 白字，不描边不淡底） */
.cp-ui-btn-add {
  background: #2563eb;
  color: #ffffff;
}

.cp-ui-btn-primary {
  background: #2563eb;
  color: #ffffff;
}

.cp-ui-btn-mini {
  min-width: 0;
  height: 52rpx;
  padding: 0 14rpx;
  font-size: 21rpx;
  border-radius: 8rpx;
  flex: 0 0 auto;
}

.cp-ui-btn-disabled {
  background: #e5e7eb;
  color: #9aa0a6;
}



/* ── 搜索（值照 fileTemplates .search-bar；不独占一行，并进操作行） ── */
.cp-ui-btn-search-sub {
  height: 56rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  min-width: 96rpx;
}

.cp-search-wrap {
  position: relative;
  flex: 1 1 auto;
  min-width: 0;
}

.cp-search-input {
  width: 100%;
  height: 56rpx;
  border: 1rpx solid #e4e8ef;
  border-radius: 10rpx;
  padding: 0 60rpx 0 16rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: normal;
}

.cp-search-input::placeholder,
.cp-search-input::-webkit-input-placeholder {
  color: #b0b8c4;
}

.cp-search-clear {
  position: absolute;
  right: 8rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-top: -22rpx;
  border: none;
  border-radius: 10rpx;
  color: #94a3b8;
  background: #f1f3f7;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
  overflow: hidden;
}

/* ── 打印队列条 ── */
.cp-queue-strip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #f6f7fb;
}

.cp-queue-strip-hover {
  background: #eceff5;
}

.cp-queue-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #334155;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cp-queue-fail {
  color: #b91c1c;
}

.cp-queue-strip-go {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #2563eb;
}

/* ── 打印队列弹窗（照文件模板库的 dispatch-panel：居中面板 + 头/体/脚） ── */
.cp-panel {
  width: 92vw;
  max-height: 72vh;   /* 按内容撑，别用固定高度——空队列会留一大片空白 */
  background: #f6f7fb;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.cp-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.cp-panel-head-btns {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.cp-panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}


.cp-panel-sum {
  flex-shrink: 0;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #334155;
}

.cp-panel-tabs {
  flex-shrink: 0;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.cp-panel-tabs-inner {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.cp-panel-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #334155;
  font-size: 25rpx;
  box-sizing: border-box;
}

.cp-panel-tab--on {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}

.cp-panel-tab-n {
  font-size: 20rpx;
  color: #94a3b8;
}

.cp-panel-tab--on .cp-panel-tab-n {
  color: #dbeafe;
}

.cp-panel-hint {
  flex-shrink: 0;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.cp-panel-scroll {
  max-height: 56vh;   /* 任务多时才滚，少时面板就矮 */
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
}


.cp-queue-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c8c9cc;
}

.cp-queue-dot--pending { background: #f59e0b; }
.cp-queue-dot--ok { background: #16a34a; }
.cp-queue-dot--bad { background: #dc2626; }


.cp-queue-empty {
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.cp-queue-item {
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #e8eaf0;
}

.cp-queue-item:last-child {
  border-bottom: none;
}

.cp-queue-item-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.cp-queue-item-status {
  font-size: 23rpx;
  color: #64748b;
  flex-shrink: 0;
}

.cp-queue-item-station {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #2563eb;
}

.cp-queue-item-file {
  flex: 1;
  min-width: 140rpx;
  font-size: 25rpx;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cp-queue-item-time {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #94a3b8;
}

.cp-queue-item-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.cp-queue-item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}

.cp-queue-item-meta {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #94a3b8;
}

.cp-queue-item-error {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b91c1c;
  line-height: 1.4;
}

.cp-queue-item-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

/* ── 内容区：圆角卡片容器 + 区域内滚（flex-1 必须配 min-height:0，否则整页下滚） ── */
.cp-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  /* 下边距要够厚，否则容器底边贴着屏幕、底部边框与圆角等于看不见；再让出安全区 */
  margin: 0 16rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border: 2rpx solid #dde1e8;
  border-radius: 16rpx;
}

.cp-scroll {
  height: 100%;
  box-sizing: border-box;
}

.cp-placeholder {
  display: block;
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

/* ── 操作行（原底部 dock 上移进顶卡）：搜索占左、按钮靠右 ── */
.cp-act-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

/* 生成中：实色灰 + 禁点（不用 opacity，半透明按钮看起来像糊的） */
.cp-ui-btn-busy {
  background: #e5e7eb;
  color: #6b7280;
  pointer-events: none;
}

/* ── 生成中遮罩（照 fileTemplates .detail-mask） ── */
.cp-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.45);
}

.cp-mask-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  min-width: 260rpx;
  padding: 40rpx 48rpx;
  background: #fff;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.cp-mask-text {
  font-size: 26rpx;
  color: #1f2937;
}






.cp-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.cp-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cp-item-name {
  min-width: 0;
  font-size: 28rpx;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 搜索结果第二行：校区 · 房间 · 笼架组，说明这架在哪 */
.cp-item-sub {
  margin-top: 4rpx;
  min-width: 0;
  font-size: 22rpx;
  color: #9aa0a6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cp-item-count {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9aa0a6;
}

.cp-item-arrow {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #c0c4cc;
}

.cp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 80rpx 0;
}

.cp-empty-text {
  font-size: 26rpx;
  color: #6b7280;
}

.cp-retry {
  height: 56rpx;
  padding: 0 40rpx;
  font-size: 26rpx;
}

/* ── 视图② 网格（区头 + 格子） ── */
.cp-body--grid {
  display: flex;
  flex-direction: column;
}

/* 区头：返回 + 笼架名 + 本架计数 + 批量操作（值照 fileTemplates .folder-bar） */
.cp-grid-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-bottom: 2rpx solid #eef0f4;
}

.cp-grid-back {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ebecef;
  background: #fff;
  font-size: 23rpx;
  color: #4b5563;
}

.cp-grid-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cp-grid-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #94a3b8;
}

.cp-grid-wrap {
  padding: 12rpx;
}

.cp-scroll--grid {
  flex: 1;
  min-height: 0;
  overflow-x: hidden;
}

/* ── 模板选择弹窗 ── */
.cp-picker {
  padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.cp-picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
  margin-bottom: 24rpx;
}

.cp-picker-scroll {
  max-height: 60vh;
}

.cp-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 16rpx;
  border-top: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}

.cp-picker-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 选中项：品牌浅底 + 主色文字 + 「当前」标记，跟未选中项拉开区分度 */
.cp-picker-item--active {
  background: #2563eb;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}

.cp-picker-item--active .cp-picker-name {
  color: #fff;
  font-weight: 600;
}

.cp-picker-cur {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.cp-picker-cur-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

/* ── 已选清单弹窗：按房间分 tab，房间内按笼架出表 ── */
.cp-picked {
  padding: 20rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
}

.cp-picked-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.cp-picked-title {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 房间 tab（横滑不换行） */
.cp-picked-tabs {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.cp-picked-tabs-inner {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.cp-picked-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f1f3f7;
  color: #334155;
  font-size: 26rpx;
  box-sizing: border-box;
}

.cp-picked-tab--on {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
}

.cp-picked-tab-n {
  font-size: 22rpx;
  color: #94a3b8;
}

.cp-picked-tab--on .cp-picked-tab-n {
  color: #dbeafe;
}

.cp-picked-scroll {
  max-height: 86vh;
}

.cp-picked-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

.cp-picked-shelf {
  margin-bottom: 12rpx;
}

.cp-picked-shelfbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 4rpx 12rpx;
  background: #f6f7fb;
  border-radius: 8rpx;
}

.cp-picked-shelfname {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cp-picked-shelfcount {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #94a3b8;
}

/* ── 打印弹窗（选工位 + 份数） ── */
.cp-print {
  padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.cp-print-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.cp-print-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.cp-print-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.cp-print-label--inline {
  margin-bottom: 0;
}

.cp-print-stations {
  max-height: 44vh;
}

.cp-print-station {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 20rpx;
  border-top: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}

/* 单工位：不出列表，只出一行，仍保留同样的分隔线视觉 */
.cp-print-station--only {
  border-bottom: 1rpx solid #e5e7eb;
}

/* 选中工位：实色蓝底 + 白字 + 投影，做出「按下去选中了」的实物质感 */
.cp-print-station--on {
  background: #2563eb;
  border-radius: 12rpx;
  border-top-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}

.cp-print-sname {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cp-print-station--on .cp-print-sname {
  color: #fff;
  font-weight: 600;
}

.cp-print-station--on .cp-print-sstatus {
  color: #dbeafe;
}

/* 蓝底上的单选点：白圈 + 蓝心（反过来才看得见） */
.cp-print-station--on .cp-radio--on {
  border-color: #fff;
  background: #fff;
  box-shadow: inset 0 0 0 6rpx #2563eb;
}

.cp-print-sstatus {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #d97706; /* 非在线：离线/未知都是橙色警示，不拦截只提示 */
}

.cp-print-sstatus--on {
  color: #16a34a;
}

.cp-print-copies {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 4rpx;
}

/* 备注 / 加急：对齐 web 端打印弹窗的那两个控件 */
.cp-print-note {
  width: 100%;
  height: 72rpx;
  margin-top: 20rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1e293b;
  background: #f6f7fb;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.cp-print-note-ph {
  color: #b0b8c4;
}

/* 单选圆点：工位选项靠它区分选中/未选 */
.cp-radio {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #cbd5e1;
  box-sizing: border-box;
}

.cp-radio--on {
  border-color: #2563eb;
  background: #2563eb;
  box-shadow: inset 0 0 0 6rpx #fff;
}

/* 字段之间的分隔线：不然工位/份数/备注糊成一片 */
.cp-print-sep {
  height: 1rpx;
  margin: 20rpx 0 0;
  background: #eef0f4;
}

/* 份数 + 加急同一行 */
.cp-print-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}

.cp-urgent {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cp-urgent-label {
  font-size: 26rpx;
  color: #1e293b;
}

.cp-checkbox {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.cp-checkbox--on {
  background: #2563eb;
  border-color: #2563eb;
}

.cp-print-foot {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}


/* ── 手写份数步进器（本目录 vant 构建产物没有 stepper，照「文件模板库」页自绘） ── */
.cp-stepper {
  display: flex;
  align-items: center;
}

.cp-step-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 36rpx;
  color: #334155;
  background: #f2f3f5;
  border-radius: 10rpx;
}

.cp-step-btn--hover {
  background: #e5e7eb;
}

.cp-step-input {
  width: 120rpx;
  height: 64rpx;
  margin: 0 12rpx;
  text-align: center;
  font-size: 30rpx;
  color: #1e293b;
  background: #f2f3f5;
  border-radius: 10rpx;
}

/* ── 树形列表：排布照笼架页（校区卡片 → 房间头部行 → 笼架组左竖线 → 笼架卡片两列） ── */
.cp-campus-list {
  padding: 12rpx 16rpx 24rpx;
}

.cp-campus {
  margin-bottom: 24rpx;
  border-radius: 18rpx;
  border: 2rpx solid #dde1e8;
  background: #fafbfc;
  overflow: hidden;
}

.cp-campus-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #eef0f6 0%, #e2e5ed 100%);
  font-size: 28rpx;
  font-weight: 700;
  color: #323233;
}

.cp-campus-arrow {
  margin-right: 4rpx;
  display: flex;
  align-items: center;
}

.cp-campus-count {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: #969799;
}

.cp-campus-body {
  padding: 4rpx 16rpx 12rpx;
}

.cp-room-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  width: 100%;
  padding: 14rpx 20rpx 12rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.cp-room-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.cp-room-name {
  flex-shrink: 0;
  max-width: 50%;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cp-room-count {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 24rpx;
  color: #969799;
}

.cp-room-body {
  padding: 4rpx 0 4rpx 8rpx;
}

/* 笼架组：左侧那道竖线就是层级提示（照笼架页） */
.cp-group {
  margin-bottom: 6rpx;
  margin-left: 8rpx;
  border-radius: 10rpx;
  border-left: 6rpx solid #dde1e8;
}

.cp-group-hd {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
}

.cp-group-hd:active {
  background: #f0f1f5;
}

.cp-group-arrow {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cp-group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  flex-shrink: 0;
}

.cp-group-count {
  margin-left: auto;
  font-size: 20rpx;
  color: #969799;
  flex-shrink: 0;
}

/* 笼架：两列卡片（照笼架页 .room-shelf-grid / .shelf-card） */
.cp-shelf-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 8rpx 6rpx 8rpx;
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.cp-shelf-card {
  display: flex;
  flex-direction: column;
  flex: 0 0 calc(50% - 4rpx);
  width: calc(50% - 4rpx);
  padding: 16rpx 14rpx 14rpx;
  border-radius: 8rpx;
  background: #fff;
  border: 1rpx solid #eef0f6;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06), 0 1rpx 2rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.cp-shelf-card:active {
  background: #f8f9fc;
}

.cp-shelf-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── 搜索结果：跨层级的命中列表 ── */
.cp-hits {
  padding: 8rpx 16rpx 24rpx;
}

.cp-hit {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.cp-hit-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cp-hit-name {
  font-size: 28rpx;
  color: #2563eb;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cp-hit-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa0a6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cp-hit-go {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #c0c4cc;
}

/* ── 空/错态 ── */