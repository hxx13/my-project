/* 检查维护模块：与小程序首页中国红 #ac1736 主题对齐 */

.text-link {
  color: #ac1736;
}

.preset-chip {
  color: #ac1736;
  background: rgba(172, 23, 54, 0.1);
}

.preset-chip--on {
  color: #fff;
  background: #ac1736;
}

.fm-pill-primary {
  color: #fff;
  background: linear-gradient(135deg, #c41e3a, #ac1736);
  box-shadow: 0 6rpx 18rpx rgba(172, 23, 54, 0.28);
}

.fm-pill-info {
  color: #fff;
  background: linear-gradient(135deg, #8c1229, #ac1736);
  box-shadow: 0 6rpx 16rpx rgba(140, 18, 41, 0.22);
}

.fm-pill-outline {
  color: #ac1736;
  background: rgba(172, 23, 54, 0.08);
  border: 1rpx solid rgba(172, 23, 54, 0.35);
}

.fm-fab {
  background: linear-gradient(145deg, #c41e3a, #ac1736);
  box-shadow: 0 12rpx 32rpx rgba(172, 23, 54, 0.32);
}
