@import './_fm-theme.wxss';
@import './fm-controls.wxss';

.fm-inline-add {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 8rpx;
}
.fm-inline-add-hint {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
}
.fm-switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.picker-label {
  font-size: 24rpx;
  color: #969799;
  margin: 12rpx 0 8rpx;
}
.picker-box {
  padding: 16rpx 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #323233;
}
.picker-box.sm {
  font-size: 26rpx;
}
.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.pad {
  padding: 16rpx 24rpx 32rpx;
}
.row-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 12rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #ebedf0;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}
.card-sub {
  font-size: 24rpx;
  color: #969799;
  margin-top: 8rpx;
}
.toolbar {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #ebedf0;
}
.popup-body {
  padding: 24rpx 32rpx 32rpx;
  max-height: 75vh;
  overflow-y: auto;
}
.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.tpl-item {
  border: 1rpx solid #ebedf0;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.item-del {
  font-size: 24rpx;
  color: #ee0a24;
}

.fm-tpl-sites-block {
  margin: 16rpx 0 8rpx;
}
.fm-tpl-site-group {
  display: block;
  margin-top: 12rpx;
  max-height: 280rpx;
  overflow-y: auto;
  padding: 12rpx 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}
.fm-checkbox-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 0;
}
.fm-checkbox-line-text {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #323233;
}
