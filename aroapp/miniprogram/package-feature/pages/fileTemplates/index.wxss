/* ═══════════════════════════════════════════════════════════════
   设计令牌与 assetRecord 一致（勿擅自新增实心色块）
     实心主操作 #2563EB / 次级 #F1F3F7+#334155 / 强调 #EFF4FF+#1D4ED8
     危险 #FEF1F1+#B91C1C —— 新按钮先复用 .ui-btn-plain / .ui-btn-accent
   ═══════════════════════════════════════════════════════════════ */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f2f3f5;
  padding: 20rpx;
  box-sizing: border-box;
}

/* ── 顶部固定卡片 ── */
.card {
  flex-shrink: 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
  flex: 0 0 auto;
  white-space: nowrap;
}

.title-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1 1 auto;
  justify-content: flex-end;
  min-width: 0;
}

/* ── 基础按钮 ── */
.ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 10rpx;
  white-space: nowrap;
  text-align: center;
  font-size: 24rpx;
  line-height: 1;
  border: none;
  height: 56rpx;
  padding: 0 16rpx;
  font-weight: 500;
  gap: 4rpx;
}

/* 实心主按钮：同一界面只允许一个 */
.ui-btn-add {
  background: #2563eb;
  color: #ffffff;
}

.ui-btn-primary {
  background: #2563eb;
  color: #ffffff;
}

.ui-btn-plain {
  background: #f1f3f7;
  color: #334155;
}

/* 强调（非实心）：卡片内主要动作 */
.ui-btn-accent {
  background: #eff4ff;
  color: #1d4ed8;
}

.ui-btn-icon {
  min-width: 0;
  width: 52rpx;
  height: 52rpx;
  padding: 0;
}

.ui-btn-mini {
  min-width: 0;
  height: 52rpx;
  padding: 0 14rpx;
  font-size: 21rpx;
  border-radius: 8rpx;
  flex: 0 0 auto;
}

.ui-btn-disabled {
  opacity: 0.55;
}

/* ── 搜索栏 ── */
.search-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.search-input-wrap {
  position: relative;
  flex: 1 1 auto;
  min-width: 0;
}

.search-input {
  width: 100%;
  height: 56rpx;
  border: 1rpx solid #e4e8ef;
  border-radius: 10rpx;
  padding: 0 60rpx 0 16rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: normal;
}

.search-input::placeholder,
.search-input::-webkit-input-placeholder {
  color: #b0b8c4;
  opacity: 1;
}

.clear-btn {
  position: absolute;
  right: 8rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-top: -22rpx;
  border: none;
  border-radius: 10rpx;
  color: #94a3b8;
  background: #f1f3f7;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
  overflow: hidden;
}

.ui-btn-search-sub {
  height: 56rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  min-width: 96rpx;
}

/* ── 打印队列条（固定区） ── */
.queue-strip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #f6f7fb;
}

.queue-strip-hover {
  background: #eceff5;
}

.queue-strip-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #334155;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.queue-strip-fail {
  color: #b91c1c;
}

.queue-strip-arrow {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #94a3b8;
}

.queue-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c8c9cc;
}

.queue-dot--pending { background: #f59e0b; }
.queue-dot--info { background: #2563eb; }
.queue-dot--ok { background: #16a34a; }
.queue-dot--bad { background: #dc2626; }
.queue-dot--none { background: #c8c9cc; }

/* ── 列表区（flex 填充剩余空间） ── */
.list-panel {
  flex: 1;
  min-height: 0;
  background: #f6f7fb;
  border-radius: 16rpx;
  overflow: hidden;
}

.list-scroll {
  height: 100%;
  padding: 16rpx 20rpx 20rpx;
  box-sizing: border-box;
}

.meta {
  color: #64748b;
  font-size: 26rpx;
  text-align: center;
  padding: 30rpx 0;
}

.list-section-title {
  padding: 12rpx 8rpx 6rpx;
  font-size: 23rpx;
  color: #8a8f98;
}

/* ── 队列详情 ── */
.queue-detail {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.queue-empty {
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.queue-item {
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #f1f3f7;
}

.queue-item:last-child {
  border-bottom: none;
}

.queue-item-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.queue-item-status {
  font-size: 23rpx;
  color: #64748b;
  flex-shrink: 0;
}

.queue-item-station {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #2563eb;
}

.queue-item-file {
  flex: 1;
  min-width: 140rpx;
  font-size: 25rpx;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.queue-item-meta {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #94a3b8;
}

.queue-item-error {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b91c1c;
  line-height: 1.4;
}

.queue-item-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  justify-content: flex-end;
}

/* ── 文件卡片：单行主布局，按钮与文件名同行 ── */
.asset-item-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
}

.file-main {
  flex: 1;
  min-width: 0;
}

.file-name {
  display: block;
  font-size: 25rpx;
  color: #1e293b;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.file-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

/* ── 文件卡左滑操作（移动 / 删除），间距从卡移到滑动单元外沿 ── */
.file-swipe-cell {
  margin-bottom: 10rpx;
}

.file-swipe-right {
  display: flex;
  flex-direction: row;
  height: 100%;
}

.file-swipe-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66px;
  height: 100%;
  font-size: 13px;
  font-weight: 600;
  box-sizing: border-box;
}

.file-swipe-btn--move {
  background: #eff4ff;
  color: #1d4ed8;
}

.file-swipe-btn--del {
  background: #fef1f1;
  color: #b91c1c;
}

/* ── 派发面板（居中） ── */
/* ⚠️ flex column 面板必须 height + max-height 双写，否则 scroll-view 塌成 0 */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20rpx;
}

.dispatch-panel {
  width: 92vw;
  height: 78vh;
  max-height: 78vh;
  background: #f6f7fb;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  flex-shrink: 0;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.panel-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #334155;
  background: #f1f3f7;
  border: none;
}

.dispatch-scroll {
  flex: 1 1 0;
  min-height: 0;
}

.dispatch-file {
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #fff;
  font-size: 26rpx;
  color: #1e293b;
  word-break: break-all;
}

.section-label {
  margin: 24rpx 0 12rpx;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

/* 与控件同行的标签：去掉上下外边距 */
.section-label--inline {
  margin: 0 12rpx 0 0;
}

/* 份数 + 加急同一行 */
.dispatch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.dispatch-copies {
  display: flex;
  align-items: center;
}

/* 同行形态的勾选行：去掉通栏底色与内边距 */
.check-row--inline {
  margin-top: 0;
  padding: 0;
  background: transparent;
}

.dispatch-empty {
  padding: 24rpx;
  border-radius: 12rpx;
  background: #fff;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
}

.station-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid transparent;
}

.station-item--on {
  background: #2563eb;
  border-color: #2563eb;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}

.station-item--on .station-name {
  color: #fff;
}

.station-item--on .station-cap {
  color: #dbeafe;
}

.station-item--on .station-reason {
  color: #fecaca;
}

.station-item--on .station-check {
  color: #fff;
}

.station-main {
  flex: 1;
  min-width: 0;
}

.station-name {
  display: block;
  font-size: 26rpx;
  color: #1e293b;
}

.station-cap {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.station-reason {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #b91c1c;
}

.station-check {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #1d4ed8;
  font-weight: 600;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 36rpx;
  color: #334155;
  background: #fff;
  border-radius: 10rpx;
}

.step-btn-hover {
  background: #f1f3f7;
}

.step-input {
  width: 120rpx;
  height: 64rpx;
  margin: 0 12rpx;
  text-align: center;
  font-size: 30rpx;
  color: #1e293b;
  background: #fff;
  border-radius: 10rpx;
}

.check-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff;
}

.check-label {
  font-size: 26rpx;
  color: #1e293b;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.checkbox--on {
  background: #2563eb;
  border-color: #2563eb;
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #1e293b;
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.dispatch-foot {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
  flex-shrink: 0;
}

.dispatch-foot-btn {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

/* ── 待打清单抽屉（条目） ── */
.dispatch-cart-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 10rpx;
}

.dispatch-cart-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.dispatch-cart-name {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dispatch-cart-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.dispatch-cart-urgent {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* ── 文件夹导航（面包屑 + 子文件夹入口，与 assetRecord 同源） ── */
.folder-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 8rpx 8rpx;
}

.folder-crumb {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.folder-crumb-item {
  font-size: 25rpx;
  color: #2563eb;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.folder-crumb-current {
  color: #0f172a;
  font-weight: 600;
}

.folder-crumb-sep {
  margin: 0 8rpx;
  font-size: 22rpx;
  color: #c0c4cc;
}

.folder-back {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ebecef;
  background: #fff;
  font-size: 23rpx;
  color: #4b5563;
}


.folder-list {
  margin-bottom: 12rpx;
}

.folder-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f3f7;
}

.folder-item-icon {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
}

.folder-item-name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #1e293b;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.folder-item-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9aa0a6;
}

.folder-item-arrow {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #c0c4cc;
}

.folder-item-more {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #94a3b8;
}

/* ── 文件夹新建/改名弹窗 ── */
.folder-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1e293b;
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* ── 文件移动弹窗 ── */
.move-folder-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 20rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  background: #fff;
}

.move-folder-item--on {
  background: #eff4ff;
}

.move-folder-name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #1e293b;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.move-folder-check {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #1d4ed8;
  font-weight: 600;
}
