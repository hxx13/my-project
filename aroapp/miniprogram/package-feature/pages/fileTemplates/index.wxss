.tpl-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 20rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tpl-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tpl-toolbar-tip {
  flex: 1;
  min-width: 200rpx;
  font-size: 22rpx;
  color: #969799;
  line-height: 1.4;
}

.tpl-hint {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #646566;
  line-height: 1.5;
  background: #fff7e8;
  border-radius: 12rpx;
  border: 1rpx solid #ffe7ba;
}

.tpl-placeholder {
  padding: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #969799;
}
