<view class="page notifications-page">
  <view class="student-notices">
    <view class="sn-tabs">
      <view class="sn-tab {{ activeTab === 'notice' ? 'sn-tab--on' : '' }}" data-tab="notice" bindtap="onSwitchTab">公告</view>
      <view class="sn-tab {{ activeTab === 'system' ? 'sn-tab--on' : '' }}" data-tab="system" bindtap="onSwitchTab">系统公告</view>
    </view>

    <view wx:if="{{ loading }}" class="alerts-center">
      <van-loading size="40rpx" color="#ac1736" />
      <text class="alerts-loading-text">加载中…</text>
    </view>

    <view wx:elif="{{ error }}" class="alerts-center">
      <text class="alerts-error-text">{{ error }}</text>
      <view class="alerts-retry-btn" bindtap="loadStudentData">重试</view>
    </view>

    <scroll-view wx:else scroll-y class="alerts-list">
      <block wx:if="{{ activeTab === 'notice' }}">
        <view wx:if="{{ generalNotices.length }}" class="sn-section-head">
          <text class="sn-section-title">通用公告</text>
        </view>
        <view
          wx:for="{{ generalNotices }}"
          wx:key="id"
          class="msg-card msg-card--bulletin"
          data-id="{{ item.id }}"
          data-kind="{{ item.kind }}"
          bindtap="onAlertTap"
        >
          <view class="mc-top">
            <text class="mc-badge" style="background:{{ item.badgeBg }};color:{{ item.badgeColor }};">{{ item.badgeLabel }}</text>
            <text wx:if="{{ item.time }}" class="mc-time">{{ item.time }}</text>
          </view>
          <text class="mc-title">{{ item.title }}</text>
          <text wx:if="{{ item.preview }}" class="mc-preview">{{ item.preview }}</text>
        </view>

        <view wx:if="{{ personalNotices.length }}" class="sn-section-head">
          <text class="sn-section-title">我的提醒</text>
        </view>
        <view
          wx:for="{{ personalNotices }}"
          wx:key="id"
          class="msg-card msg-card--bulletin"
          data-id="{{ item.id }}"
          data-kind="{{ item.kind }}"
          bindtap="onAlertTap"
        >
          <view class="mc-top">
            <text class="mc-badge" style="background:{{ item.badgeBg }};color:{{ item.badgeColor }};">{{ item.badgeLabel }}</text>
            <text wx:if="{{ item.time }}" class="mc-time">{{ item.time }}</text>
          </view>
          <text class="mc-title">{{ item.title }}</text>
          <text wx:if="{{ item.preview }}" class="mc-preview">{{ item.preview }}</text>
        </view>

        <view wx:if="{{ !generalNotices.length && !personalNotices.length }}" class="alerts-center alerts-empty">
          <text class="alerts-empty-title">暂无公告</text>
          <text class="alerts-empty-text">管理员发布的公告会显示在这里</text>
        </view>
      </block>

      <block wx:elif="{{ activeTab === 'system' }}">
        <view
          wx:for="{{ systemNotices }}"
          wx:key="id"
          class="msg-card msg-card--bulletin"
        >
          <view class="mc-top">
            <text class="mc-badge">系统</text>
            <text wx:if="{{ item.time }}" class="mc-time">{{ item.time }}</text>
          </view>
          <text class="mc-title">{{ item.title }}</text>
          <text wx:if="{{ item.preview }}" class="mc-preview">{{ item.preview }}</text>
        </view>
        <view wx:if="{{ !systemNotices.length }}" class="alerts-center alerts-empty">
          <text class="alerts-empty-title">暂无系统公告</text>
          <text class="alerts-empty-text">小程序的版本更新记录会显示在这里</text>
        </view>
      </block>

      <view class="list-pad-bottom" />
    </scroll-view>
  </view>
</view>
