<view class="page">
  <view class="rs-head">
    <view class="rs-head-main">
      <text class="rs-title">远程屏幕</text>
      <text class="rs-hint">同账号的页面自动列出；其它账号用配对码连</text>
    </view>
    <view class="chip-btn chip-btn--xs chip-btn--ghost" bindtap="onRefresh">刷新</view>
  </view>

  <scroll-view
    scroll-y
    class="rs-scroll"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <!-- 配对码：页面角落显示 6 位，凭它连上**其他账号 / 其他设备**打开的页面 -->
    <view class="rs-pair">
      <view class="rs-pair-title">配对码</view>
      <view class="rs-pair-row">
        <input
          class="rs-pair-input"
          value="{{pairCode}}"
          placeholder="输入页面角落的 6 位码"
          maxlength="6"
          confirm-type="done"
          bindinput="onPairInput"
          bindconfirm="onPair"
        />
        <view
          class="chip-btn chip-btn--sm chip-btn--primary {{pairCode ? '' : 'chip-btn--off'}}"
          bindtap="onPair"
        >{{pairing ? '连接中…' : '连接'}}</view>
      </view>

      <view wx:if="{{paired}}" class="rs-paired" bindtap="onTapPaired">
        <view class="rs-card-top">
          <view class="rs-dot"></view>
          <text class="rs-name">{{paired.name}}</text>
          <view class="rs-rename" catchtap="onUnpair">断开</view>
        </view>
        <view class="rs-route">{{paired.route}}</view>
        <view class="rs-go">点这里让它切页面 ›</view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="rs-empty">读取中…</view>
    <view wx:elif="{{error}}" class="rs-empty">{{error}}</view>
    <view wx:elif="{{!screens.length}}" class="rs-empty">同账号登录的网页会自动列在这里；其它账号的页面请用上面的配对码连接。</view>
    <block wx:else>
      <view
        wx:for="{{screens}}"
        wx:key="screenId"
        class="rs-card"
        data-id="{{item.screenId}}"
        bindtap="onTapScreen"
      >
        <view class="rs-card-top">
          <view class="rs-dot"></view>
          <text class="rs-name">{{item.name}}</text>
          <view class="rs-rename" data-id="{{item.screenId}}" catchtap="onRenameScreen">改名</view>
        </view>
        <view class="rs-route">{{item.route}}</view>
        <view class="rs-meta">{{item.ip}} · 最后在线 {{item.lastSeen}}</view>
        <view class="rs-go">点这里让它切页面 ›</view>
      </view>
    </block>
  </scroll-view>

  <!-- 选一个页面发过去 -->
  <van-popup show="{{sheetOpen}}" position="bottom" round custom-style="padding-bottom: env(safe-area-inset-bottom);" bind:close="onCloseSheet">
    <view class="rs-sheet">
      <view class="rs-sheet-head">
        <text class="rs-sheet-title">让「{{targetName}}」切到</text>
        <text class="rs-sheet-now">当前：{{target.route}}</text>
      </view>

      <scroll-view scroll-y class="rs-sheet-body">
        <view class="rs-grid">
          <view
            wx:for="{{routes}}"
            wx:key="value"
            class="rs-tile"
            data-route="{{item.value}}"
            bindtap="onPickRoute"
          >{{item.label}}</view>
        </view>

        <view class="rs-custom">
          <input
            class="rs-input"
            value="{{custom}}"
            placeholder="或输入路径，如 /console/admin/aup"
            confirm-type="go"
            bindinput="onCustomInput"
            bindconfirm="onCustomGo"
          />
          <view class="chip-btn chip-btn--sm chip-btn--primary {{custom ? '' : 'chip-btn--off'}}" bindtap="onCustomGo">前往</view>
        </view>
      </scroll-view>

      <view class="rs-sheet-foot">
        <view class="chip-btn chip-btn--ghost" bindtap="onCloseSheet">关闭</view>
      </view>
    </view>
  </van-popup>
</view>
