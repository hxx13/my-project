.rw-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f8fa;
  box-sizing: border-box;
}

.rw-scroll {
  flex: 1;
  height: 0;
}

.rw-hint {
  margin: 16rpx 24rpx 12rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  box-sizing: border-box;
}

.rw-hint-text {
  display: block;
  font-size: 24rpx;
  color: #646566;
  line-height: 1.45;
}

.rw-campus-group {
  margin-top: 12rpx !important;
}

.rw-cell-strong .van-cell__title {
  font-weight: 600;
}

.rw-campus-title {
  font-size: 28rpx;
}

.rw-row {
  display: flex;
  align-items: center;
}

.rw-footer-spacer {
  height: 160rpx;
}

.rw-footer {
  flex-shrink: 0;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.rw-save-btn {
  font-weight: 600 !important;
}
