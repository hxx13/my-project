<!-- 分笼/转移确认弹窗：复核已选坐标 + 保留源笼位 + 原因 -->
<van-popup
  show="{{ opConfirmOpen }}"
  position="center"
  round
  closeable
  close-icon-position="top-right"
  z-index="{{ 22000 }}"
  custom-style="width:90vw;max-width:600rpx;padding:24rpx;box-sizing:border-box;"
  bind:close="onOpCloseConfirm"
>
  <view class="cf-root">
    <view class="cf-title">{{ opKind === 'divide' ? '确认分笼' : '确认转移笼位' }}</view>
    <view class="op-confirm-src">源笼位：{{ opSourceLabel }}</view>
    <scroll-view scroll-y class="op-confirm-list">
      <view wx:for="{{ opPicked }}" wx:key="animalCageId" class="op-confirm-row">
        <text class="op-confirm-pos">{{ item.positionX }}-{{ item.positionY }}</text>
        <text class="op-confirm-where">{{ item.campusName }} / {{ item.roomName }} / {{ item.shelveName }}</text>
        <text class="op-confirm-aup">{{ item.aupNumber }}</text>
      </view>
    </scroll-view>
    <view wx:if="{{ opKind === 'divide' }}" class="op-confirm-keep">
      <switch checked="{{ opKeepSource }}" bindchange="onOpKeepSourceChange" color="#ac1736" />
      <text>保留原笼位不变（默认保留；不勾选则源笼位归档为空笼盒）</text>
    </view>
    <input class="rp-input" placeholder="原因（可选，会记入留痕）" value="{{ opReason }}" bindinput="onOpReasonInput" />
    <view class="op-confirm-actions">
      <view class="op-select-btn" bindtap="onOpCloseConfirm">返回选位</view>
      <view class="op-select-btn op-select-btn--primary" bindtap="onOpSubmit">{{ opSubmitting ? '提交中…' : (opKind === 'divide' ? '确认分笼（' + opSelectedCount + '）' : '确认转移') }}</view>
    </view>
  </view>
</van-popup>

<canvas canvas-id="cageQrCanvasOffscreen" class="detail-qr-canvas-offscreen" />
