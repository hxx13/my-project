    </view>
    <view class="cf-tip">确认归档该笼位？归档后释放占用并回到空笼盒</view>
    <view class="cf-btns">
      <view class="cf-btn-cancel" bindtap="onCloseArchiveDialog">取消</view>
      <view class="cf-btn-confirm {{ archiveSubmitting ? 'cf-btn-confirm--disabled' : '' }}" bindtap="{{ archiveSubmitting ? '' : 'handleArchiveConfirm' }}">{{ archiveSubmitting ? '归档中...' : '确认归档' }}</view>
    </view>
  </view>
</van-popup>

<!-- 记录模式：笼位变更留痕（居中弹窗 · 时间轴） -->
<van-popup
  show="{{ recordOpen }}"
  position="center"
  root-portal="{{ true }}"
  z-index="{{ 21000 }}"
  custom-class="cs-sheet"
  bind:close="onCloseRecordDialog"
>
  <view class="cs-id">
    <text class="cs-id-pos">{{ recordTarget.positionLabel }}</text>
    <view class="cs-ticks">
      <text class="cs-id-sub">{{ recordEvents.length }} 次变更 · {{ recordFieldCount }} 个字段</text>
    </view>
    <view class="cs-x" bindtap="onCloseRecordDialog">✕</view>
  </view>

  <scroll-view scroll-y class="cs-body">
    <view wx:if="{{ recordLoading }}" class="cs-hint cs-hint--block">加载中…</view>
    <view wx:elif="{{ recordEvents.length === 0 }}" class="cs-hint cs-hint--block">该笼位暂无变更留痕</view>
    <view wx:else class="cs-tl cs-tl--inset">
      <!-- 后端结构：events[].{changeType, kind, at, operator, changes[].{label, before, after}}
           kind ∈ IN|OUT|EDIT 由后端 CageFormAuditService 给出；_dot/_kindLabel/_typeLabel 由 JS 预计算 -->
      <view wx:for="{{ recordEvents }}" wx:key="index" wx:for-item="ev" class="cs-tl-node">
        <view class="cs-tl-rail" />
        <view class="cs-tl-dot" style="background:{{ ev._dot }};" />
        <view class="cs-tl-card">
          <view class="cs-tl-hd">
            <text class="cs-tl-kind">{{ ev._kindLabel }}</text>
            <text class="cs-tl-type">{{ ev._typeLabel }}</text>
            <text class="cs-tl-time">{{ ev.at }}</text>
          </view>
          <view class="cs-tl-bd">
            <text wx:if="{{ ev.operator }}" class="cs-tl-op">{{ ev.operator }}</text>
            <view wx:if="{{ !ev.changes.length }}" class="cs-hint">无字段变化</view>
            <view wx:for="{{ ev.changes }}" wx:key="canonical" wx:for-item="ch" class="cs-diff">
              <text class="cs-diff-label">{{ ch.label }}</text>
              <text class="cs-diff-before {{ ch.before ? '' : 'cs-diff-before--empty' }}">{{ ch.before || '（空）' }}</text>
              <text class="cs-diff-arrow">→</text>
              <text class="cs-diff-after">{{ ch.after || '（清空）' }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</van-popup>

<!-- 我的申请列表 -->
<van-popup
  show="{{ myClaimsOpen }}"
