<!-- List View -->
<view wx:if="{{ screen === 'list' }}" class="page">
  <view wx:if="{{ loading }}" class="center-box">
    <van-loading size="24px" color="#ac1736" />
    <text class="loading-text">加载中…</text>
  </view>

  <view wx:elif="{{ error }}" class="error-box">
    <text class="error-icon">!</text>
    <text class="error-text">{{ error }}</text>
    <view class="retry-btn" bindtap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{ shelves.length === 0 }}" class="empty-box">
    <text class="empty-icon">&#x2302;</text>
    <text class="empty-text">暂无笼架数据</text>
    <view class="retry-btn" bindtap="onRefresh">刷新</view>
  </view>

  <view wx:else class="list-root">
    <view class="list-sticky-header">
      <view class="list-search-bar">
        <van-icon name="search" size="16px" color="#94a3b8" class="list-search-icon" />
        <input class="list-search-input" type="text" value="{{ searchQuery }}" placeholder="搜索房间名称…" placeholder-class="list-search-placeholder" bindinput="onSearchInput" confirm-type="search" />
        <view class="list-special-status-btn" bindtap="onOpenSpecialStatus">特殊状态</view>
        <view class="list-collapse-all-btn" bindtap="onToggleAllRooms">{{ allExpanded ? '收起全部' : '展开全部' }}</view>
      </view>
    </view>

    <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{ campusGroups.length === 0 }}" class="no-match-box">
        <text class="no-match-text">没有匹配的房间</text>
        <view class="clear-filter-btn" bindtap="onClearFilter">清除筛选</view>
      </view>

      <block wx:for="{{ campusGroups }}" wx:key="campusName" wx:for-item="camp">
        <view class="campus-group">
          <!-- 校区头部 -->
          <view class="campus-group-header" style="{{ camp._headerStyle }}" data-campus-name="{{ camp.campusName }}" bindtap="onToggleCampus">
            <view class="cgh-arrow">
              <van-icon name="{{ camp.expanded ? 'arrow-down' : 'arrow' }}" size="30rpx" color="#fff" />
            </view>
            <text class="cgh-name">{{ camp.campusName }}校区</text>
            <text class="cgh-count">{{ camp.shelfCount }} 架</text>
          </view>

          <!-- 房间列表 -->
          <view wx:if="{{ camp.expanded }}" class="campus-rooms">
            <view wx:for="{{ camp.rooms }}" wx:key="roomName" wx:for-item="room" class="room-group">
              <view class="room-group-header {{ room.hasHighlight ? 'room-group-header--hl' : '' }}" data-campus-name="{{ camp.campusName }}" data-room-name="{{ room.roomName }}" bindtap="onToggleRoom">
                <view wx:if="{{ room._bars && room._bars.length }}" class="room-bar-strip">
                  <view wx:for="{{ room._bars }}" wx:key="type" wx:for-item="seg" class="room-bar-seg" style="width:{{ seg.pct }}%;background:{{ seg.color }};"></view>
                </view>
                <view class="rgh-arrow">
                  <van-icon name="{{ room.expanded ? 'arrow-down' : 'arrow' }}" size="28rpx" color="{{ room.hasHighlight ? '#ac1736' : '#969799' }}" />
                </view>
                <view class="rgh-body">
                  <text class="rgh-name {{ room.hasHighlight ? 'rgh-name--hl' : '' }}">{{ room.roomName }}</text>
                </view>
                <text class="rgh-count">{{ room.shelves.length }}架</text>
              </view>

              <view wx:if="{{ room.expanded }}" class="room-shelf-grid">
                <view wx:for="{{ room.shelves }}" wx:key="shelveId" wx:for-item="shelf" class="shelf-card {{ shelf.highlight ? 'shelf-card-highlight' : '' }}" data-shelve-id="{{ shelf.shelveId }}" bindtap="onShelfTap">
                  <view wx:if="{{ shelf._bars && shelf._bars.length }}" class="shelf-bar-strip">
                    <view wx:for="{{ shelf._bars }}" wx:key="type" wx:for-item="seg" class="shelf-bar-seg" style="width:{{ seg.pct }}%;background:{{ seg.color }};"></view>
                  </view>
                  <view class="shelf-card-icon"><view class="shelf-card-icon-dot"></view></view>
                  <text class="shelf-card-name">{{ shelf.shelveName || shelf.shelveId }}</text>
                  <view wx:if="{{ shelf._bars && shelf._bars.length }}" class="shelf-bar-legend">
                    <block wx:for="{{ shelf._bars }}" wx:key="type" wx:for-item="seg">
                      <text class="shelf-bar-legend-item"><text class="shelf-bar-dot" style="background:{{ seg.color }};"></text>{{ seg.label }}{{ seg.count }}</text>
                    </block>
                  </view>
                  <view wx:if="{{ shelf.highlight }}" class="shelf-card-highlight-badge"><text>本组</text></view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view class="list-pad-bottom" />
    </scroll-view>
  </view>
</view>

<!-- Grid View -->
<view wx:if="{{ screen === 'grid' }}" class="page grid-page">
  <view class="grid-topbar">
    <view class="gt-back" bindtap="onBackToList">
      <van-icon name="arrow-left" size="36rpx" color="#323233" />
    </view>
    <view class="gt-info">
      <text class="gt-name">{{ gridMeta.shelveName || selectedShelf.shelveName }}</text>
      <text class="gt-meta">已填{{ filledCount }}/{{ totalCells }} · {{ gridMeta.roomName || '' }}</text>
    </view>
    <view class="gt-back" bindtap="onRefreshGrid">
      <van-icon name="replay" size="36rpx" color="#969799" />
    </view>
  </view>

  <view wx:if="{{ loading }}" class="center-box">
    <van-loading size="28px" color="#ac1736" />
  </view>

  <view wx:elif="{{ error }}" class="error-box">
    <text class="error-icon">!</text>
    <text class="error-text">{{ error }}</text>
    <view class="retry-btn" bindtap="onRetry">重新加载</view>
    <view class="back-link" bindtap="onBackToList">返回列表</view>
  </view>

  <scroll-view wx:else class="grid-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="grid-legend-card">
      <text class="legend-section-title">特殊状态 → 格子背景</text>
      <view class="grid-legend grid-legend--status">
        <view class="legend-item"><view class="legend-dot" style="background:#a7f3d0;border:2rpx solid #10b981;"></view><text class="legend-label">合笼/繁殖</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#fecaca;border:2rpx solid #ef4444;"></view><text class="legend-label">特殊饲养</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#fef08a;border:2rpx solid #eab308;"></view><text class="legend-label">请分笼</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#e9d5ff;border:2rpx solid #a855f7;"></view><text class="legend-label">健康异常</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#cffafe;border:2rpx solid #06b6d4;"></view><text class="legend-label">动物转移</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#f1f5f9;border:2rpx solid #cbd5e1;"></view><text class="legend-label">正常</text></view>
      </view>

      <text class="legend-section-title legend-section-title--spaced">笼位状态 → 右上角指示灯</text>
      <view class="grid-legend grid-legend--cage-type">
        <view class="legend-item">
          <view class="legend-cage-dot legend-cage-dot--wait"><text>待</text></view>
          <text class="legend-label">等待分配</text>
        </view>
        <view class="legend-item">
          <view class="legend-cage-dot legend-cage-dot--empty"><text>空</text></view>
          <text class="legend-label">已预约(空笼盒)</text>
        </view>
        <view class="legend-item">
          <view class="legend-cage-dot legend-cage-dot--feeding"></view>
          <text class="legend-label legend-label--mute">已预约(饲养中) 无指示灯</text>
        </view>
        <view class="legend-item">
          <view class="legend-cage-dot legend-cage-dot--abnormal"><text>异</text></view>
          <text class="legend-label">异常</text>
        </view>
      </view>
    </view>

    <view class="grid-wrapper">
      <view class="grid-container">
        <view
          wx:for="{{ grid }}"
          wx:key="position"
          class="grid-cell {{ item.empty ? 'gcell-empty' : (item.visible === false ? 'gcell-hidden' : 'gcell-filled') }}"
          style="{{ item._cellStyle }}"
          data-x="{{ item.x }}"
          data-y="{{ item.y }}"
          bindtap="onCellTap"
        >
          <text class="gcell-pos">{{ item.position }}</text>
          <block wx:if="{{ !item.empty && item.visible !== false }}">
            <text wx:if="{{ item._projectGroupShort }}" class="gcell-group">{{ item._projectGroupShort }}</text>
            <text class="gcell-pi">{{ item._piShort || '' }}</text>
            <text class="gcell-type-label">{{ item._cageTypeLabelShort || '' }}</text>
            <view wx:if="{{ item._cageTypeDotColor }}" class="gcell-dot" style="background:{{ item._cageTypeDotColor }};">
              <text>{{ item._cageTypeAbbr }}</text>
            </view>
          </block>
          <text wx:if="{{ item.empty }}" class="gcell-empty-text">空</text>
          <text wx:elif="{{ item.visible === false }}" class="gcell-hidden-text">***</text>
        </view>
      </view>
      <view class="grid-pad-bottom" />
    </view>
  </scroll-view>
</view>

<!-- Cell Detail Popup（对齐 Web CellDetailPanel / MobileCageCellDetailDialog） -->
<van-popup show="{{ showCellDetail }}" position="bottom" round closeable bind:close="onCloseCellDetail" custom-style="max-height:88vh;width:100%;box-sizing:border-box;overflow:hidden;">
  <scroll-view wx:if="{{ selectedCell && cellDetailMeta }}" class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="detail-root">
      <view class="detail-head">
        <view class="detail-head-main">
          <view class="detail-head-title-row">
            <text class="detail-head-title">笼位详情</text>
            <view class="detail-head-position-badge"><text>{{ selectedCell.position }}</text></view>
            <view wx:if="{{ selectedCell._cageTypeDotColor }}" class="detail-head-dot" style="background:{{ selectedCell._cageTypeDotColor }};">
              <text>{{ selectedCell._cageTypeAbbr }}</text>
            </view>
          </view>
          <text class="detail-head-sub">{{ cellDetailMeta.cageTypeLabel }} · {{ cellDetailMeta.stateName || '—' }}</text>
        </view>
      </view>

      <view class="detail-section-label"><text>ARO 官方数据</text></view>

      <block wx:if="{{ cellDetailMeta.permitted }}">
        <view wx:if="{{ cellDetailMeta.specialChips.length }}" class="detail-status-chips">
          <view wx:for="{{ cellDetailMeta.specialChips }}" wx:key="code" class="detail-status-chip detail-status-chip--{{ item.code }}">
            <text class="detail-status-chip-abbr">{{ item.abbr }}</text>
            <text class="detail-status-chip-label">{{ item.label }}</text>
          </view>
        </view>

        <!-- 基础信息 -->
        <view class="detail-section-group">
          <view class="detail-section-group-title"><text>基础信息</text></view>
          <view class="detail-field-grid">
            <view class="detail-field">
              <text class="detail-field-label">笼位类型</text>
              <text class="detail-field-value">{{ cellDetailMeta.cageTypeLabel }}</text>
            </view>
            <view wx:if="{{ cellDetailMeta.stateName }}" class="detail-field">
              <text class="detail-field-label">状态名称</text>
              <text class="detail-field-value">{{ cellDetailMeta.stateName }}</text>
            </view>
            <view wx:if="{{ cellDetailMeta.specialStatusSummary }}" class="detail-field detail-field--full">
              <text class="detail-field-label">特殊状态</text>
              <text class="detail-field-value">{{ cellDetailMeta.specialStatusSummary }}</text>
            </view>
          </view>
        </view>

        <!-- 课题信息 -->
        <view wx:if="{{ cellDetailMeta.hasProjectInfo }}" class="detail-section-group">
          <view class="detail-section-group-title"><text>课题信息</text></view>
          <view class="detail-field-grid">
            <view wx:if="{{ cellDetailMeta.departmentName }}" class="detail-field">
              <text class="detail-field-label">课题组</text>
              <text class="detail-field-value">{{ cellDetailMeta.departmentName }}</text>
            </view>
            <view wx:if="{{ cellDetailMeta.projectPiName }}" class="detail-field">
              <text class="detail-field-label">课题 PI</text>
              <text class="detail-field-value">{{ cellDetailMeta.projectPiName }}</text>
            </view>
            <view wx:if="{{ cellDetailMeta.aupNumber }}" class="detail-field">
              <text class="detail-field-label">AUP 编号</text>
              <text class="detail-field-value">{{ cellDetailMeta.aupNumber }}</text>
            </view>
            <view wx:if="{{ cellDetailMeta.mobilePhone }}" class="detail-field">
              <text class="detail-field-label">手机号</text>
              <text class="detail-field-value">{{ cellDetailMeta.mobilePhone }}</text>
            </view>
          </view>
        </view>

        <!-- 饲养与状态标记 -->
        <view wx:if="{{ cellDetailMeta.hasFlags }}" class="detail-section-group">
          <view class="detail-section-group-title"><text>饲养与状态标记</text></view>
          <view class="detail-field-grid">
            <view wx:if="{{ cellDetailMeta.showNeedDivide }}" class="detail-field">
              <text class="detail-field-label">请分笼</text>
              <text class="detail-field-value detail-field-value--danger">是</text>
            </view>
            <view wx:if="{{ cellDetailMeta.showNeedFeeding }}" class="detail-field">
              <text class="detail-field-label">特殊饲养</text>
              <text class="detail-field-value detail-field-value--warn">是</text>
            </view>
            <view wx:if="{{ cellDetailMeta.showNeedTransfer }}" class="detail-field">
              <text class="detail-field-label">动物转移</text>
              <text class="detail-field-value detail-field-value--info">是</text>
            </view>
            <view wx:if="{{ cellDetailMeta.showAbnormalHealth }}" class="detail-field">
              <text class="detail-field-label">健康异常</text>
              <text class="detail-field-value detail-field-value--health">是</text>
            </view>
            <view wx:if="{{ cellDetailMeta.closingDate }}" class="detail-field">
              <text class="detail-field-label">合笼日期</text>
              <text class="detail-field-value">{{ cellDetailMeta.closingDate }}</text>
            </view>
            <view wx:if="{{ cellDetailMeta.specialBreedingName }}" class="detail-field detail-field--full">
              <text class="detail-field-label">特殊饲养名称</text>
              <text class="detail-field-value">{{ cellDetailMeta.specialBreedingName }}</text>
            </view>
            <view wx:if="{{ cellDetailMeta.specialBreedingDesc }}" class="detail-field detail-field--full">
              <text class="detail-field-label">特殊饲养说明</text>
              <text class="detail-field-value">{{ cellDetailMeta.specialBreedingDesc }}</text>
            </view>
          </view>
        </view>

        <!-- 笼盒信息 -->
        <view wx:if="{{ cellDetailMeta.hasBoxInfo }}" class="detail-section-group">
          <view class="detail-section-group-title"><text>笼盒信息</text></view>
          <view class="detail-field-grid">
            <view wx:if="{{ cellDetailMeta.cageBoxQrCode }}" class="detail-field detail-field--full">
              <text class="detail-field-label">笼盒卡号</text>
              <text class="detail-field-value detail-field-value--mono">{{ cellDetailMeta.cageBoxQrCode }}</text>
              <view class="detail-qr-wrap">
                <image wx:if="{{ detailQrImageSrc }}" class="detail-qr-image" src="{{ detailQrImageSrc }}" mode="aspectFit" />
                <text wx:else class="detail-qr-loading">二维码生成中…</text>
              </view>
            </view>
            <view wx:if="{{ cellDetailMeta.hasPhysicalBox }}" class="detail-field">
              <text class="detail-field-label">实体笼盒</text>
              <text class="detail-field-value">{{ cellDetailMeta.hasPhysicalBoxLabel }}</text>
            </view>
          </view>
        </view>

        <!-- 位置 -->
        <view wx:if="{{ cellDetailMeta.locationText }}" class="detail-section-group">
          <view class="detail-section-group-title"><text>位置</text></view>
          <view class="detail-field-grid">
            <view class="detail-field detail-field--full">
              <text class="detail-field-label">所在位置</text>
              <text class="detail-field-value detail-field-value--location">{{ cellDetailMeta.locationText }}</text>
            </view>
          </view>
        </view>

        <!-- 系统信息 -->
        <view wx:if="{{ cellDetailMeta.hasSystemInfo }}" class="detail-section-group">
          <view class="detail-section-group-title"><text>系统信息</text></view>
          <view class="detail-field-grid">
            <view wx:if="{{ cellDetailMeta.createAdmin }}" class="detail-field">
              <text class="detail-field-label">创建人</text>
              <text class="detail-field-value">{{ cellDetailMeta.createAdmin }}</text>
            </view>
            <view wx:if="{{ cellDetailMeta.createTime }}" class="detail-field">
              <text class="detail-field-label">创建时间</text>
              <text class="detail-field-value">{{ cellDetailMeta.createTime }}</text>
            </view>
            <view wx:if="{{ cellDetailMeta.updateTime }}" class="detail-field">
              <text class="detail-field-label">更新时间</text>
              <text class="detail-field-value">{{ cellDetailMeta.updateTime }}</text>
            </view>
          </view>
        </view>

        <view class="detail-divider" />
        <view class="detail-section-label"><text>备注与标注</text></view>

        <view wx:if="{{ detailAnnotationLoading }}" class="detail-annotation-loading">
          <van-loading size="20px" color="#ac1736" />
          <text>加载标注…</text>
        </view>
        <block wx:else>
          <view class="detail-form-block">
            <text class="detail-form-label">富文本备注</text>
            <textarea
              class="detail-textarea"
              value="{{ detailRichText }}"
              placeholder="输入备注信息（支持 HTML）…"
              maxlength="-1"
              auto-height
              bindinput="onDetailRichTextInput"
            />
          </view>
          <view class="detail-form-block">
            <view class="detail-form-label-row">
              <text class="detail-form-label">图片（每行一个 URL）</text>
              <view class="detail-upload-btn {{ detailUploading ? 'detail-upload-btn--disabled' : '' }}" bindtap="onChooseAndUploadImage">
                <text>{{ detailUploading ? '上传中…' : '上传图片' }}</text>
              </view>
            </view>
            <textarea
              class="detail-textarea detail-textarea--mono"
              value="{{ detailImageUrls }}"
              placeholder="上传后自动填入 URL，也可手动编辑"
              maxlength="-1"
              auto-height
              bindinput="onDetailImageUrlsInput"
            />
          </view>
          <view wx:if="{{ detailImagePreviewUrls.length }}" class="detail-image-previews">
            <image
              wx:for="{{ detailImagePreviewUrls }}"
              wx:key="*this"
              class="detail-preview-image"
              src="{{ item }}"
              mode="aspectFill"
              binderror="onDetailImageError"
              data-url="{{ item }}"
            />
          </view>
          <view class="detail-save-row">
            <view class="detail-save-btn {{ detailSaving ? 'detail-save-btn--disabled' : '' }}" bindtap="onSaveCellAnnotation">
              <text>{{ detailSaving ? '保存中…' : '保存标注' }}</text>
            </view>
            <text wx:if="{{ detailSaveMsg }}" class="detail-save-msg detail-save-msg--{{ detailSaveMsgType }}">{{ detailSaveMsg }}</text>
          </view>
        </block>
      </block>

      <view wx:else class="detail-no-permission">
        <text>仅限所属课题组及管理员查看详情</text>
      </view>

      <view class="detail-close-wrap">
        <view class="detail-close-btn detail-close-btn--secondary" bindtap="onCloseCellDetail">关闭</view>
      </view>
    </view>
  </scroll-view>
</van-popup>

<!-- 特殊状态总览弹窗（紧凑表格式布局，按房间/课题组双维度折叠） -->
<van-popup
  show="{{ specialStatusOpen }}"
  position="center"
  round
  closeable
  close-icon-position="top-right"
  root-portal="{{ true }}"
  z-index="{{ 20000 }}"
  custom-style="width:92vw;max-width:700rpx;max-height:82vh;box-sizing:border-box;overflow:hidden;"
  bind:close="onCloseSpecialStatus"
>
  <view class="sp-popup">
    <view class="sp-hd">
      <text class="sp-title">特殊状态总览</text>
      <view wx:if="{{ specialStatusScannedAt }}" class="sp-meta-row">
        <text class="sp-meta">最近扫描：{{ specialStatusScannedAt }}</text>
        <text wx:if="{{ specialStatusTotal }}" class="sp-meta"> · 共 {{ specialStatusTotal }} 个异常笼位</text>
      </view>
    </view>

    <scroll-view scroll-y class="sp-body">
      <view wx:if="{{ specialStatusLoading }}" class="sp-hint"><van-loading size="20px" color="#ac1736" /><text style="margin-left:12rpx;">加载中…</text></view>
      <view wx:elif="{{ specialStatusError }}" class="sp-hint sp-err">{{ specialStatusError }}</view>
      <view wx:elif="{{ specialStatusGroups.length === 0 }}" class="sp-hint">暂无特殊状态笼位</view>

      <view wx:else>
        <block wx:for="{{ specialStatusGroups }}" wx:key="code" wx:for-item="grp">
          <view wx:if="{{ grp.cages.length }}" class="sp-card">
            <!-- 状态卡片头部（点击折叠/展开） -->
            <view class="sp-card-hd" data-code="{{ grp.code }}" bindtap="onToggleSpecialGroup">
              <view class="sp-dot" style="background:{{ grp.dotColor }};border-color:{{ grp.borderColor }};"></view>
              <text class="sp-card-name">{{ grp.label }}</text>
              <text class="sp-card-badge">{{ grp.cages.length }}</text>
              <text class="sp-card-arrow">{{ grp.expanded ? '▾' : '▸' }}</text>
            </view>

            <view wx:if="{{ grp.expanded }}" class="sp-card-body">
              <!-- 分组维度切换 -->
              <view wx:if="{{ grp.byRoom.length && grp.byGroup.length }}" class="sp-dim-tabs">
                <view class="sp-dim-tab {{ grp._groupBy === 'room' ? 'sp-dim-tab--on' : '' }}" data-code="{{ grp.code }}" data-dim="room" bindtap="onSwitchSpecialGroupDim">按房间</view>
                <view class="sp-dim-tab {{ grp._groupBy === 'group' ? 'sp-dim-tab--on' : '' }}" data-code="{{ grp.code }}" data-dim="group" bindtap="onSwitchSpecialGroupDim">按课题组</view>
              </view>

              <!-- 按房间分组 -->
              <view wx:if="{{ grp._groupBy === 'room' }}" class="sp-sub-list">
                <block wx:for="{{ grp.byRoom }}" wx:key="key" wx:for-item="rm">
                  <view wx:if="{{ rm.cages.length }}" class="sp-sub-card">
                    <view class="sp-sub-hd" data-pkey="{{ grp.code }}" data-skey="{{ rm.key }}" bindtap="onToggleSpecialSubGroup">
                      <text class="sp-sub-arrow">{{ rm._expanded !== false ? '▾' : '▸' }}</text>
                      <text class="sp-sub-name">{{ rm.campusName }} · {{ rm.roomName }}</text>
                      <text class="sp-sub-count">{{ rm.cages.length }}</text>
                    </view>
                    <view wx:if="{{ rm._expanded !== false }}" class="sp-sub-body">
                      <view wx:for="{{ rm.cages }}" wx:key="key" wx:for-item="cage" class="sp-row">
                        <text class="sp-row-pos">{{ cage.position }}</text>
                        <text class="sp-row-pi">{{ cage.piName || cage.projectPiName || '-' }}</text>
                        <text wx:if="{{ cage.departmentName }}" class="sp-row-dept">{{ cage.departmentName }}</text>
                      </view>
                    </view>
                  </view>
                </block>
              </view>

              <!-- 按课题组分组 -->
              <view wx:if="{{ grp._groupBy === 'group' }}" class="sp-sub-list">
                <block wx:for="{{ grp.byGroup }}" wx:key="key" wx:for-item="gp">
                  <view wx:if="{{ gp.cages.length }}" class="sp-sub-card">
                    <view class="sp-sub-hd" data-pkey="{{ grp.code }}" data-skey="{{ gp.key }}" bindtap="onToggleSpecialSubGroup">
                      <text class="sp-sub-arrow">{{ gp._expanded !== false ? '▾' : '▸' }}</text>
                      <text class="sp-sub-name">{{ gp.groupName }}</text>
                      <text class="sp-sub-count">{{ gp.cages.length }}</text>
                    </view>
                    <view wx:if="{{ gp._expanded !== false }}" class="sp-sub-body">
                      <view wx:for="{{ gp.cages }}" wx:key="key" wx:for-item="cage" class="sp-row">
                        <text class="sp-row-pos">{{ cage.position }}</text>
                        <text class="sp-row-room">{{ cage.roomName || '-' }}</text>
                        <text wx:if="{{ cage.departmentName }}" class="sp-row-dept">{{ cage.departmentName }}</text>
                      </view>
                    </view>
                  </view>
                </block>
              </view>
            </view>
          </view>
        </block>
      </view>
      <view class="sp-pad" />
    </scroll-view>
  </view>
</van-popup>

<canvas canvas-id="cageQrCanvasOffscreen" class="detail-qr-canvas-offscreen" />
