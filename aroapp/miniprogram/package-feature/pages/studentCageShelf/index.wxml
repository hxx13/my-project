<!-- List View -->
<!-- ponytail: 列表始终渲染，grid 以固定覆盖层叠在上面，列表 scroll-view 从不 display:none → 滚动位置原生保留 -->
<view class="page">
  <subpage-nav-bar title="笼架" />
  <view wx:if="{{ loading }}" class="center-box">
    <van-loading size="24px" color="#ac1736" />
    <text class="loading-text">加载中…</text>
  </view>

  <view wx:elif="{{ error }}" class="error-box">
    <text class="error-icon">!</text>
    <text class="error-text">{{ error }}</text>
    <view class="retry-btn" bindtap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{ shelves.length === 0 }}" class="empty-box">
    <text class="empty-icon">&#x2302;</text>
    <text class="empty-text">暂无笼架数据</text>
    <view class="retry-btn" bindtap="onRefresh">刷新</view>
  </view>

  <view wx:else class="list-root">
    <view class="list-sticky-header">
      <view class="list-count-row">
        <text class="list-count-text">共 {{ totalCount }} 个笼架</text>
        <text wx:if="{{ scannedAt }}" class="list-scanned-at">{{ scannedAt }}</text>
        <view class="list-special-status-btn" bindtap="onOpenSpecialStatus">特殊状态</view>
        <view wx:if="{{ !isStaffView }}" class="list-special-status-btn list-my-claims-btn" bindtap="onOpenMyClaims">我的申请</view>
      </view>
      <view class="list-search-row">
        <view class="list-search-bar">
          <van-icon name="search" size="16px" color="#94a3b8" class="list-search-icon" />
          <input class="list-search-input" type="text" value="{{ searchQuery }}" placeholder="搜索房间名称…" placeholder-class="list-search-placeholder" bindinput="onSearchInput" confirm-type="search" />
        </view>
        <view class="list-collapse-all-btn" bindtap="onToggleAllRooms">{{ allExpanded ? '收起全部' : '展开全部' }}</view>
      </view>
    </view>

    <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{ loading }}" bindrefresherrefresh="onScrollRefresh">
      <view wx:if="{{ shelfGroups.length === 0 }}" class="no-match-box">
        <text class="no-match-text">没有匹配的房间</text>
        <view class="clear-filter-btn" bindtap="onClearFilter">清除筛选</view>
      </view>

      <view wx:for="{{ shelfGroups }}" wx:key="campusName" class="campus-group">
        <view class="campus-group-header" data-campus-name="{{ item.campusName }}" bindtap="onToggleCampus">
          <view class="cgh-arrow">
            <van-icon name="{{ item._collapsed ? 'arrow' : 'arrow-down' }}" size="32rpx" color="#646566" />
          </view>
          <text>{{ item.campusName }}校区</text>
          <text class="cgh-count">{{ item.rooms.length }}个房间</text>
        </view>
        <view wx:if="{{ !item._collapsed }}" class="campus-group-body">
        <view wx:for="{{ item.rooms }}" wx:key="roomName" wx:for-item="room" class="room-group">
          <view class="room-group-header {{ room.hasHighlight ? 'room-group-header--hl' : '' }}" data-room-name="{{ room.roomName }}" bindtap="onToggleRoom">
            <view class="rgh-arrow">
              <van-icon name="{{ room.expanded ? 'arrow-down' : 'arrow' }}" size="28rpx" color="{{ room.hasHighlight ? '#ac1736' : '#969799' }}" />
            </view>
            <view class="rgh-main">
              <view class="rgh-top">
                <text class="rgh-name {{ room.hasHighlight ? 'rgh-name--hl' : '' }}">{{ room.roomName }}房间</text>
                <view class="rgh-metrics">
                  <view wx:if="{{ room.c1 + room.c2 + room.c3 + room.c4 > 0 }}" class="rgh-stats">
                    <text wx:if="{{ room.c3 > 0 }}" class="rs-stat" style="color:#f43f5e;">饲{{ room.c3 }}</text>
                    <text wx:if="{{ room.c3 > 0 && (room.c1 > 0 || room.c4 > 0 || room.c2 > 0) }}" class="rs-sep">/</text>
                    <text wx:if="{{ room.c1 > 0 }}" class="rs-stat" style="color:#f59e0b;">待{{ room.c1 }}</text>
                    <text wx:if="{{ room.c1 > 0 && (room.c4 > 0 || room.c2 > 0) }}" class="rs-sep">/</text>
                    <text wx:if="{{ room.c4 > 0 }}" class="rs-stat" style="color:#3b82f6;">异{{ room.c4 }}</text>
                    <text wx:if="{{ room.c4 > 0 && room.c2 > 0 }}" class="rs-sep">/</text>
                    <text wx:if="{{ room.c2 > 0 }}" class="rs-stat" style="color:#10b981;">空{{ room.c2 }}</text>
                  </view>
                  <view wx:if="{{ room.c1 + room.c2 + room.c3 + room.c4 > 0 }}" class="rgh-bar-wrap">
                    <view class="rgh-bar">
                      <view wx:if="{{ room.c3 > 0 }}" class="rgh-bar-seg" style="flex:{{ room.c3 }};background:#f43f5e;"></view>
                      <view wx:if="{{ room.c1 > 0 }}" class="rgh-bar-seg" style="flex:{{ room.c1 }};background:#f59e0b;"></view>
                      <view wx:if="{{ room.c4 > 0 }}" class="rgh-bar-seg" style="flex:{{ room.c4 }};background:#3b82f6;"></view>
                      <view wx:if="{{ room.c2 > 0 }}" class="rgh-bar-seg" style="flex:{{ room.c2 }};background:#10b981;"></view>
                    </view>
                  </view>
                </view>
                <text class="rgh-count">{{ room.shelfCount }}架</text>
              </view>
            </view>
          </view>

          <view wx:if="{{ room.expanded }}" class="room-shelf-body">
            <block wx:for="{{ room.shelfGroups }}" wx:key="key" wx:for-item="grp">
              <view class="shelf-group {{ grp.hasHighlight ? 'shelf-group--hl' : '' }}">
                <view class="shelf-group-hd" data-room-name="{{ room.roomName }}" data-group-key="{{ grp.key }}" bindtap="onToggleShelfGroup">
                  <view class="sgh-arrow">
                    <van-icon name="{{ grp.expanded ? 'arrow-down' : 'arrow' }}" size="24rpx" color="{{ grp.hasHighlight ? '#ac1736' : '#969799' }}" />
                  </view>
                  <text class="sgh-name {{ grp.hasHighlight ? 'sgh-name--hl' : '' }}">{{ grp.name }}</text>
                  <view class="sgh-metrics">
                    <view wx:if="{{ grp.c1 + grp.c2 + grp.c3 + grp.c4 > 0 }}" class="sgh-stats">
                      <text wx:if="{{ grp.c3 > 0 }}" class="ss-stat" style="color:#f43f5e;">饲{{ grp.c3 }}</text>
                      <text wx:if="{{ grp.c3 > 0 && (grp.c1 > 0 || grp.c4 > 0 || grp.c2 > 0) }}" class="ss-sep">/</text>
                      <text wx:if="{{ grp.c1 > 0 }}" class="ss-stat" style="color:#f59e0b;">待{{ grp.c1 }}</text>
                      <text wx:if="{{ grp.c1 > 0 && (grp.c4 > 0 || grp.c2 > 0) }}" class="ss-sep">/</text>
                      <text wx:if="{{ grp.c4 > 0 }}" class="ss-stat" style="color:#3b82f6;">异{{ grp.c4 }}</text>
                      <text wx:if="{{ grp.c4 > 0 && grp.c2 > 0 }}" class="ss-sep">/</text>
                      <text wx:if="{{ grp.c2 > 0 }}" class="ss-stat" style="color:#10b981;">空{{ grp.c2 }}</text>
                    </view>
                    <view wx:if="{{ grp.c1 + grp.c2 + grp.c3 + grp.c4 > 0 }}" class="sgh-bar-wrap">
                      <view class="sgh-bar">
                        <view wx:if="{{ grp.c3 > 0 }}" class="sgh-bar-seg" style="flex:{{ grp.c3 }};background:#f43f5e;"></view>
                        <view wx:if="{{ grp.c1 > 0 }}" class="sgh-bar-seg" style="flex:{{ grp.c1 }};background:#f59e0b;"></view>
                        <view wx:if="{{ grp.c4 > 0 }}" class="sgh-bar-seg" style="flex:{{ grp.c4 }};background:#3b82f6;"></view>
                        <view wx:if="{{ grp.c2 > 0 }}" class="sgh-bar-seg" style="flex:{{ grp.c2 }};background:#10b981;"></view>
                      </view>
                    </view>
                  </view>
                  <text class="sgh-count">{{ grp.shelves.length }}架</text>
                </view>
                <view wx:if="{{ grp.expanded }}" class="room-shelf-grid">
                  <view wx:for="{{ grp.shelves }}" wx:key="shelveId" wx:for-item="shelf" class="shelf-card {{ shelf.highlight ? 'shelf-card-highlight' : '' }}" data-shelve-id="{{ shelf.shelveId }}" bindtap="onShelfTap">
                    <view wx:if="{{ shelf.highlight }}" class="shelf-card-icon"><view class="shelf-card-icon-dot"></view></view>
                    <view class="shelf-card-head">
                      <text class="shelf-card-name">{{ shelf.shelveName || shelf.shelveId }}</text>
                      <view class="shelf-card-metrics">
                        <view wx:if="{{ shelf.c1 + shelf.c2 + shelf.c3 + shelf.c4 > 0 }}" class="shelf-card-stats">
                          <text wx:if="{{ shelf.c3 > 0 }}" class="sc-stat" style="color:#f43f5e;">饲{{ shelf.c3 }}</text>
                          <text wx:if="{{ shelf.c3 > 0 && (shelf.c1 > 0 || shelf.c4 > 0 || shelf.c2 > 0) }}" class="sc-sep">/</text>
                          <text wx:if="{{ shelf.c1 > 0 }}" class="sc-stat" style="color:#f59e0b;">待{{ shelf.c1 }}</text>
                          <text wx:if="{{ shelf.c1 > 0 && (shelf.c4 > 0 || shelf.c2 > 0) }}" class="sc-sep">/</text>
                          <text wx:if="{{ shelf.c4 > 0 }}" class="sc-stat" style="color:#3b82f6;">异{{ shelf.c4 }}</text>
                          <text wx:if="{{ shelf.c4 > 0 && shelf.c2 > 0 }}" class="sc-sep">/</text>
                          <text wx:if="{{ shelf.c2 > 0 }}" class="sc-stat" style="color:#10b981;">空{{ shelf.c2 }}</text>
                        </view>
                        <view wx:if="{{ shelf.c1 + shelf.c2 + shelf.c3 + shelf.c4 > 0 }}" class="shelf-card-bar-wrap">
                          <view class="shelf-card-bar">
                            <view wx:if="{{ shelf.c3 > 0 }}" class="shelf-bar-seg" style="flex:{{ shelf.c3 }};background:#f43f5e;"></view>
                            <view wx:if="{{ shelf.c1 > 0 }}" class="shelf-bar-seg" style="flex:{{ shelf.c1 }};background:#f59e0b;"></view>
                            <view wx:if="{{ shelf.c4 > 0 }}" class="shelf-bar-seg" style="flex:{{ shelf.c4 }};background:#3b82f6;"></view>
                            <view wx:if="{{ shelf.c2 > 0 }}" class="shelf-bar-seg" style="flex:{{ shelf.c2 }};background:#10b981;"></view>
                          </view>
                        </view>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </view>
        </view>
        </view>
      </view>
      <view class="list-pad-bottom" />
    </scroll-view>
    <!-- ── 扫码定位 FAB（列表页常驻）── -->
    <view class="scan-float-btn" bindtap="onScanLock">
      <van-icon name="scan" size="44rpx" color="#fff" />
    </view>
  </view>
</view>

<!-- Grid View -->
<view wx:if="{{ screen === 'grid' }}" class="page grid-page">
  <subpage-nav-bar title="{{ gridMeta.shelveName || selectedShelf.shelveName }}" customBack="{{ true }}" bind:back="onBackToList" />
  <!-- 操作栏：图例 + 刷新 + 提交 -->
  <view class="grid-actions-bar" style="top: {{ navBarHeight }}px;">
    <view class="gt-left-btns">
      <!-- 模式切换（横向滚动，8 项手机宽度放不下） -->
      <scroll-view class="gt-mode-scroll" scroll-x enhanced show-scrollbar="{{ false }}">
        <view class="gt-mode-seg">
          <view wx:for="{{ modeOptions }}" wx:key="key" class="gt-mode-btn {{ pageMode === item.key ? 'gt-mode-btn--on' : '' }}" style="{{ pageMode === item.key && modeColor ? 'background:' + modeColor : '' }}" data-mode="{{ item.key }}" bindtap="onSwitchMode">{{ item.label }}</view>
        </view>
      </scroll-view>
    </view>
    <view class="grid-actions-btns">
      <!-- 常驻扫码入口（顶栏）：全角色可见，结果按当前模式分派 -->
      <view class="gt-scan-btn" bindtap="onScanLock">
        <van-icon name="scan" size="34rpx" color="#fff" />
      </view>
      <view class="gt-legend-btn {{ legendOpen ? 'gt-legend-btn--on' : '' }}" bindtap="onToggleGridLegend">
        <van-icon name="warning-o" size="26rpx" color="{{ legendOpen ? '#fff' : '#ac1736' }}" />
      </view>
      <view wx:if="{{ !isStaffView }}" class="gt-my-claims-btn" bindtap="onOpenMyClaims">我的申请</view>
    </view>
  </view>

  <!-- 固定操作栏占位（actions bar 为 position:fixed，需在文档流中为其留出空间） -->
  <view class="grid-actions-spacer"></view>

  <!-- 预约模式：房间概览（内联，位于模式栏下方） -->
  <view wx:if="{{ pageMode === 'booking' }}" class="booking-inline">
    <view wx:if="{{ bookingLoading }}" class="rp-hint">加载中…</view>
    <view wx:elif="{{ bookingRoom }}" class="booking-card">
      <view class="booking-card-head">
        <view class="booking-card-title">
          <text class="booking-name">{{ bookingRoom.name }}</text>
          <text wx:if="{{ bookingRoom.description }}" class="booking-desc">{{ bookingRoom.description }}</text>
        </view>
        <view class="booking-remain">
          <text class="booking-remain-num">{{ bookingRoom.remaining }}</text>
          <text class="booking-remain-label">剩余可用</text>
        </view>
      </view>
      <view class="booking-cap">
        <text class="booking-cap-label">房间上限</text>
        <view wx:if="{{ editingCapacity }}" class="booking-cap-edit">
          <input class="booking-cap-input" type="number" value="{{ capacityDraft }}" bindinput="onCapacityDraftInput" />
          <text class="booking-cap-btn booking-cap-btn--ok" bindtap="{{ savingCapacity ? '' : 'saveCapacity' }}">保存</text>
          <text class="booking-cap-btn" bindtap="cancelCapacityEdit">取消</text>
        </view>
        <view wx:else class="booking-cap-view">
          <text class="booking-cap-num">{{ bookingRoom.animalCageNumber }}</text>
          <text class="booking-cap-btn" bindtap="startCapacityEdit">编辑</text>
        </view>
      </view>
      <view class="booking-bar-block">
        <view class="booking-bar-row">
          <text class="booking-bar-label">已预约</text>
          <text class="booking-bar-val">{{ bookingRoom.rentAnimalCageNumber }} / {{ bookingRoom.animalCageNumber }}</text>
        </view>
        <view class="booking-bar-track"><view class="booking-bar-fill booking-bar-fill--booked" style="width: {{ bookingRoom.bookedPct }}%;"></view></view>
      </view>
      <view class="booking-bar-block">
        <view class="booking-bar-row">
          <text class="booking-bar-label">已使用</text>
          <text class="booking-bar-val">{{ bookingRoom.usedAnimalCageNumber }} / {{ bookingRoom.animalCageNumber }}</text>
        </view>
        <view class="booking-bar-track"><view class="booking-bar-fill booking-bar-fill--used" style="width: {{ bookingRoom.usedPct }}%;"></view></view>
      </view>
    </view>
    <view wx:else class="rp-hint">当前房间暂无预约数据</view>

    <!-- AUP 分配明细表 -->
    <view wx:if="{{ bookingRoom }}" class="booking-aup-panel">
      <view class="booking-aup-head">
        <text class="booking-aup-title">AUP 分配明细</text>
        <view class="booking-aup-add {{ bookingEditingId === 'new' ? 'booking-aup-add--disabled' : '' }}" bindtap="{{ bookingEditingId === 'new' ? '' : 'startBookingNew' }}">新增分配</view>
      </view>

      <view wx:if="{{ bookingAupLoading }}" class="rp-hint">加载明细中…</view>

      <block wx:else>
        <view wx:if="{{ bookingAups.length === 0 && bookingEditingId !== 'new' }}" class="rp-hint">暂无分配记录</view>

        <!-- 表头 -->
        <view wx:if="{{ bookingAups.length > 0 || bookingEditingId === 'new' }}" class="booking-table-head">
          <text class="col-group">课题组</text>
          <text class="col-aup">AUP 编号</text>
          <text class="col-rent">预约</text>
          <text class="col-used">已用</text>
          <text class="col-memo">备注</text>
          <text class="col-op">操作</text>
        </view>

        <!-- 新增行 -->
        <view wx:if="{{ bookingEditingId === 'new' }}" class="booking-aup-row booking-aup-row--edit">
          <view class="booking-edit-grid">
            <picker class="booking-picker" range="{{ bookingPiNames }}" value="{{ bookingEditPiIndex }}" bindchange="onBookingPiChange">
              <view class="booking-picker-box {{ bookingEdit.piName ? '' : 'booking-picker-box--empty' }}">{{ bookingEdit.piName || '选择课题组' }}</view>
            </picker>
            <picker class="booking-picker" range="{{ bookingEditAupOptions }}" range-key="registerNo" value="{{ bookingEditAupIndex }}" bindchange="onBookingAupChange" disabled="{{ !bookingEdit.piName }}">
              <view class="booking-picker-box {{ bookingEdit.aupId ? '' : 'booking-picker-box--empty' }}">{{ bookingEdit.registerNumber || (bookingEdit.piName ? '选择 AUP 编号' : '先选课题组') }}</view>
            </picker>
            <input class="booking-edit-input" type="number" value="{{ bookingEdit.rentNumber }}" bindinput="onBookingRentInput" placeholder="预约数量" />
            <input class="booking-edit-input" type="text" value="{{ bookingEdit.memo }}" bindinput="onBookingMemoInput" placeholder="备注" />
          </view>
          <view class="booking-row-ops">
            <text class="booking-op-btn booking-op-btn--ok" bindtap="{{ bookingSaving ? '' : 'saveBookingAup' }}">{{ bookingSaving ? '保存中' : '保存' }}</text>
            <text class="booking-op-btn" bindtap="cancelBookingEdit">取消</text>
          </view>
        </view>

        <!-- 现有行 -->
        <view wx:for="{{ bookingAups }}" wx:key="id" wx:for-item="aup" class="booking-aup-row">
          <block wx:if="{{ bookingEditingId === aup.id }}">
            <view class="booking-edit-grid">
              <picker class="booking-picker" range="{{ bookingPiNames }}" value="{{ bookingEditPiIndex }}" bindchange="onBookingPiChange">
                <view class="booking-picker-box {{ bookingEdit.piName ? '' : 'booking-picker-box--empty' }}">{{ bookingEdit.piName || '选择课题组' }}</view>
              </picker>
              <picker class="booking-picker" range="{{ bookingEditAupOptions }}" range-key="registerNo" value="{{ bookingEditAupIndex }}" bindchange="onBookingAupChange" disabled="{{ !bookingEdit.piName }}">
                <view class="booking-picker-box {{ bookingEdit.aupId ? '' : 'booking-picker-box--empty' }}">{{ bookingEdit.registerNumber || (bookingEdit.piName ? '选择 AUP 编号' : '先选课题组') }}</view>
              </picker>
              <input class="booking-edit-input" type="number" value="{{ bookingEdit.rentNumber }}" bindinput="onBookingRentInput" placeholder="预约数量" />
              <input class="booking-edit-input" type="text" value="{{ bookingEdit.memo }}" bindinput="onBookingMemoInput" placeholder="备注" />
            </view>
            <view class="booking-row-ops">
              <text class="booking-op-btn booking-op-btn--ok" bindtap="{{ bookingSaving ? '' : 'saveBookingAup' }}">{{ bookingSaving ? '保存中' : '保存' }}</text>
              <text class="booking-op-btn" bindtap="cancelBookingEdit">取消</text>
            </view>
          </block>
          <block wx:else>
            <view class="booking-aup-cols">
              <text class="col-group">{{ aup.piName }}</text>
              <text class="col-aup">{{ aup.registerNumber }}</text>
              <text class="col-rent">{{ aup.rentNumber }}</text>
              <text class="col-used">{{ aup.usedAnimalCageNumber }}</text>
              <text class="col-memo">{{ aup.memo || '—' }}</text>
              <view class="col-op">
                <text class="booking-op-btn" data-id="{{ aup.id }}" bindtap="startBookingEdit">编辑</text>
                <text class="booking-op-btn booking-op-btn--danger" data-id="{{ aup.id }}" bindtap="deleteBookingAup">删除</text>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>
  </view>

  <!-- 模式横幅（对齐资产记录页「扫码归位」）：模式名+计数 / 按钮组（单行换行）/ 待选胶囊 -->
  <view wx:if="{{ pageMode === 'allocate' || pageMode === 'reserve' || pageMode === 'studentClaim' || pageMode === 'edit' || pageMode === 'division' }}" class="mode-banner" style="{{ modeColor ? '--mode-color:' + modeColor : '' }}">
    <view class="mb-row">
      <text class="mb-title">
        <block wx:if="{{ pageMode === 'allocate' }}">{{ allocBatchKind === 'cancel' ? '撤回 AUP' : '待分配' }}</block>
        <block wx:elif="{{ pageMode === 'reserve' }}">预定选位</block>
        <block wx:elif="{{ pageMode === 'studentClaim' }}">申请预约选位</block>
        <block wx:elif="{{ pageMode === 'division' }}">划分选位</block>
        <block wx:else>状态标记</block><block wx:if="{{ pageMode === 'edit' && stagedItems.length }}"> · {{ stagedItems.length }} 格</block>
      </text>
      <!-- 连续扫码开关：扫一台加入待选后自动重开扫码机（划分不走扫码，故不显示） -->
      <view
        wx:if="{{ pageMode === 'allocate' || pageMode === 'reserve' || pageMode === 'studentClaim' || pageMode === 'edit' }}"
        class="mb-btn {{ scanContinuous ? 'mb-btn--on' : '' }}"
        bindtap="onToggleScanContinuous"
      >连续扫码{{ scanContinuous ? '开' : '关' }}</view>
      <!-- 扫码入口：扫一台即加入待选（右下角 FAB 仍可用） -->
      <view
        wx:if="{{ pageMode === 'allocate' || pageMode === 'reserve' || pageMode === 'studentClaim' || pageMode === 'edit' }}"
        class="mb-btn"
        bindtap="onScanLock"
      >扫码</view>
      <!-- 主操作：按模式二选一（分配区分下发 AUP / 撤回 AUP） -->
      <view wx:if="{{ pageMode === 'allocate' && selectedCount > 0 && allocBatchKind === 'allocate' }}" class="mb-btn mb-btn--primary" bindtap="onOpenAupDialog">分配 {{ selectedCount }}</view>
      <view wx:if="{{ pageMode === 'allocate' && selectedCount > 0 && allocBatchKind === 'cancel' }}" class="mb-btn mb-btn--danger" bindtap="handleCancelAssign">撤回 {{ selectedCount }}</view>
      <view wx:if="{{ pageMode === 'reserve' && selectedCount > 0 }}" class="mb-btn mb-btn--primary" bindtap="openReservePerson">预定 {{ selectedCount }}</view>
      <view wx:if="{{ pageMode === 'studentClaim' && selectedCount > 0 }}" class="mb-btn mb-btn--primary" bindtap="handleStudentClaim">申请 {{ selectedCount }}</view>
      <view wx:if="{{ pageMode === 'division' && selectedCount > 0 }}" class="mb-btn mb-btn--primary" bindtap="openDivisionPerson">划分 {{ selectedCount }}</view>
      <view wx:if="{{ pageMode === 'edit' && scanTotalActions > 0 }}" class="mb-btn mb-btn--primary" bindtap="onSubmitScanActions">提交 {{ scanTotalActions }} 项</view>
      <view wx:if="{{ pageMode === 'edit' && scanCacheSize > 0 }}" class="mb-btn" bindtap="onExitScanMode">清除</view>
      <view wx:if="{{ pageMode !== 'edit' && selectedCount > 0 }}" class="mb-btn" bindtap="onClearSelection">清除</view>
      <!-- 取消模式：退回查看模式（对齐资产页「退出」的位次，放按钮组末尾） -->
      <view class="mb-btn" bindtap="onExitMode">取消</view>
    </view>

    <!-- 待选区：缓冲里的笼位以胶囊横排换行，点 ✕ 单独移除 -->
    <view wx:if="{{ stagedItems.length }}" class="mb-chips">
      <text class="mb-chips-label">{{ pageMode === 'edit' ? '待提交' : '待选' }}</text>
      <view wx:for="{{ stagedItems }}" wx:key="key" class="mb-chip">
        <text class="mb-chip-pos">{{ item.label }}</text>
        <text wx:if="{{ item.meta }}" class="mb-chip-meta">{{ item.meta }}</text>
        <text class="mb-chip-x" data-key="{{ item.key }}" catchtap="onRemoveSelected">✕</text>
      </view>
    </view>
  </view>

  <view wx:if="{{ gridLoading }}" class="center-box">
      <van-loading size="28px" color="#ac1736" />
    </view>

    <view wx:elif="{{ gridError }}" class="error-box">
      <text class="error-icon">!</text>
      <text class="error-text">{{ gridError }}</text>
      <view class="retry-btn" bindtap="onRetry">重新加载</view>
      <view class="back-link" bindtap="onBackToList">返回列表</view>
    </view>

  <!-- 分笼/转移选位条 -->
  <view wx:if="{{ opActive }}" class="op-select-bar">
    <view class="op-select-info">
      <text class="op-select-title">{{ opKind === 'divide' ? '分笼选位' : '转移选位' }}</text>
      <text class="op-select-src">源笼位 {{ opSourceLabel }}</text>
      <text class="op-select-hint">{{ opLoading ? '加载可选笼位…' : (opError ? opError : (opKind === 'divide' ? '点绿色高亮选目标（可多选，可切架）' : '点绿色高亮选目标（单选，可切架）')) }}</text>
    </view>
    <text class="op-select-count">已选 {{ opSelectedCount }}</text>
    <view class="op-select-btn op-select-btn--primary {{ opSelectedCount === 0 ? 'is-disabled' : '' }}" bindtap="onOpOpenConfirm">确认</view>
    <view class="op-select-btn" bindtap="onOpCancel">取消</view>
  </view>

  <scroll-view wx:if="{{ !gridLoading && !gridError && pageMode !== 'booking' }}" class="grid-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{ gridLoading }}" bindrefresherrefresh="onRetry">
    <!-- 图例：默认收起，点 "!" 展开 -->
    <view wx:if="{{ legendOpen }}" class="grid-legend-card">
      <text class="legend-section-title">特殊状态 → 格子背景</text>
      <view class="grid-legend grid-legend--status">
        <view class="legend-item"><view class="legend-dot" style="background:#a7f3d0;border:2rpx solid #10b981;"></view><text class="legend-label">合笼/繁殖</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#fecaca;border:2rpx solid #ef4444;"></view><text class="legend-label">特殊饲养</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#fef08a;border:2rpx solid #eab308;"></view><text class="legend-label">请分笼</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#e9d5ff;border:2rpx solid #a855f7;"></view><text class="legend-label">健康异常</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#cffafe;border:2rpx solid #06b6d4;"></view><text class="legend-label">动物转移</text></view>
        <view class="legend-item"><view class="legend-dot" style="background:#f1f5f9;border:2rpx solid #cbd5e1;"></view><text class="legend-label">正常</text></view>
      </view>

      <text class="legend-section-title legend-section-title--spaced">笼位状态 → 右上角指示灯</text>
      <view class="grid-legend grid-legend--cage-type">
        <view class="legend-item"><view class="legend-cage-dot legend-cage-dot--wait"><text>待</text></view><text class="legend-label">(等待分配)</text></view>
        <view class="legend-item"><view class="legend-cage-dot legend-cage-dot--empty"><text>空</text></view><text class="legend-label">(空笼位)</text></view>
        <view class="legend-item"><view class="legend-cage-dot legend-cage-dot--feeding"><text>饲</text></view><text class="legend-label">(饲养中)</text></view>
        <view class="legend-item"><view class="legend-cage-dot legend-cage-dot--abnormal"><text>异</text></view><text class="legend-label">(异常)</text></view>
      </view>
    </view>

    <!-- 扫码结果面板（扫码后始终显示供切换选项，不受 diff 影响；提交按钮单独判断 scanTotalActions） -->
    <view wx:if="{{ pageMode === 'edit' && lastScannedKey && scanCacheSize > 0 }}" class="scan-result-panel">
      <view class="scan-result-top-row">
        <view class="scan-result-info">
          <text class="scan-result-label">已定位:</text>
          <text class="scan-result-pos">{{ lastScannedEntry.position }}</text>
          <text class="scan-result-code">· {{ lastScannedEntry.code }}</text>
        </view>
        <view class="scan-dismiss-btn" bindtap="onDismissCrosshair">
          <van-icon name="cross" size="28rpx" color="#969799" />
        </view>
      </view>
      <view class="scan-action-btns">
        <view
          wx:for="{{ editActionOptions }}" wx:key="action" wx:for-item="a"
          class="scan-action-btn {{ lastScannedEntry[a._actKey] ? 'scan-action-btn--on' : '' }}"
          data-key="{{ lastScannedKey }}" data-act="{{ a.action }}" bindtap="onToggleAction">
          <text wx:if="{{ lastScannedEntry[a._actKey] }}">✓ </text><text>{{ a.label }}</text>
        </view>
      </view>
    </view>

    <view class="grid-wrapper {{ modeColor ? 'grid-wrapper--glow' : '' }}" style="{{ modeColor ? '--mode-color:' + modeColor : '' }}">
      <view class="grid-container">
        <view
          wx:for="{{ grid }}"
          wx:key="position"
          class="grid-cell {{ item.empty ? 'gcell-empty' : (item.visible === false ? 'gcell-hidden' : 'gcell-filled') }} {{ item._cachedLast ? 'gcell-hit' : '' }} {{ item._cached && !item._cachedLast ? 'gcell-hit gcell-hit--cached' : '' }} {{ item._cachedBg ? 'gcell-cached' : '' }} {{ lastScannedKey && item.x === scannedCellX && item.y === scannedCellY ? '' : (lastScannedKey && (item.x === scannedCellX || item.y === scannedCellY) ? 'gcell-cross' : '') }} {{ item._selected ? 'gcell-selected' : '' }} {{ item._inPool ? 'gcell-inpool' : '' }} {{ item._myClaim ? 'gcell-myclaim' : '' }} {{ item._divisionNames ? 'gcell-division' : '' }} {{ item._divisionMine ? 'gcell-division--mine' : '' }}"
          style="{{ item._cellStyle }}"
          data-x="{{ item.x }}"
          data-y="{{ item.y }}"
          bindtap="onCellTap"
        >
          <text class="gcell-pos">{{ item._displayPosition || item.position }}</text>
          <view wx:if="{{ item._claimBadge }}" class="gcell-badge {{ item._claimBadge.cls }}">{{ item._claimBadge.text }}</view>
          <!-- 划分名单：本人命中 → 专属标签；管家（教职工视角）看名单 -->
          <view wx:if="{{ item._divisionMine }}" class="gcell-badge gcell-badge--division">已划分给你</view>
          <view wx:elif="{{ isStaffView && item._divisionNames }}" class="gcell-badge gcell-badge--division">已划分：{{ item._divisionNames }}</view>
          <block wx:if="{{ !item.empty && item.visible !== false }}">
            <text class="gcell-pi">{{ item._piShort || '' }}</text>
            <text wx:if="{{ item._experimenterShort }}" class="gcell-exp">{{ item._experimenterShort }}</text>
            <view wx:if="{{ item._cageTypeDotColor }}" class="gcell-dot" style="background:{{ item._cageTypeDotColor }};">
              <text>{{ item._cageTypeAbbr }}</text>
            </view>
          </block>
          <text wx:if="{{ item.empty }}" class="gcell-empty-text">空</text>
          <text wx:elif="{{ item.visible === false }}" class="gcell-hidden-text">***</text>
          <view wx:if="{{ scanLockHighlight && (scanLockHighlight.sid + '') === (gridMeta.shelveId + '') && scanLockHighlight.x === item.x && scanLockHighlight.y === item.y }}" class="scan-flash-overlay"></view>
          <!-- 待审分笼/转移中间态：配对色环 + 底部色条 + 正中色底图标（对齐 Web CellButton） -->
          <view wx:if="{{ item._opMark }}" class="gcell-opmark" style="box-shadow: inset 0 0 0 3px {{ item._opMark.color }}, 0 0 10px {{ item._opMark.color }}66;">
            <view class="gcell-opmark-veil"></view>
            <view class="gcell-opmark-icon" style="background:{{ item._opMark.color }};">{{ item._opMark.abbr }}</view>
            <view class="gcell-opmark-bar" style="background:{{ item._opMark.color }};">{{ item._opMark.label }}</view>
          </view>
        </view>
      </view>
      <view class="grid-pad-bottom" />
    </view>
  </scroll-view>

  <!-- ── 扫码定位 FAB（右下悬浮圆形按钮，常驻）── -->
  <view class="scan-float-btn" bindtap="onScanLock">
    <van-icon name="scan" size="44rpx" color="#fff" />
  </view>
</view>

<!-- Cell Detail Popup（居中弹窗 · 标本卡式：等宽字 + 点线规格表 + 模板分组） -->
<van-popup
  show="{{ showCellDetail }}"
  position="center"
  root-portal="{{ true }}"
  z-index="{{ 20000 }}"
  custom-class="cs-sheet {{ formEditing ? 'cs-sheet--editing' : '' }}"
  bind:close="onCloseCellDetail"
>
  <!-- 身份条：位置 + 状态刻度 + 编辑徽标 + 关闭，一行 -->
  <view class="cs-id">
    <text class="cs-id-pos">{{ cellDetail.position }}</text>
    <view class="cs-ticks">
      <view wx:for="{{ cellDetail.statusChips }}" wx:key="code" class="cs-tick" style="--c:{{ item.color }};--c-bg:{{ item.bg }};">
        <text class="cs-tick-g">{{ item.abbr }}</text>
        <text>{{ item.label }}</text>
      </view>
    </view>
    <view wx:if="{{ formEditing }}" class="cs-badge">编辑</view>
    <view class="cs-x" bindtap="onCloseCellDetail">✕</view>
  </view>

  <scroll-view class="cs-body" scroll-y enhanced show-scrollbar="{{false}}">

    <!-- 未决分笼/转移：配对色做左侧色条 -->
    <view wx:if="{{ detailOpMark }}" class="cs-notice" style="--notice:{{ detailOpMark.color }};">
      <text class="cs-notice-txt">{{ detailOpMark.label }}，暂不能对该笼位发起新的分笼/转移</text>
    </view>

    <!-- 关键信息：按模板分区渲染。字段多的分区默认收起，行尾带摘要 -->
    <view wx:if="{{ formLoading }}" class="cs-sec">
      <view class="cs-sec-bd"><text class="cs-hint">加载表单…</text></view>
    </view>
    <view wx:elif="{{ formError }}" class="cs-sec">
      <view class="cs-sec-bd"><text class="cs-hint cs-hint--error">{{ formError }}</text></view>
    </view>
    <view wx:elif="{{ !formGroups.length }}" class="cs-sec">
      <view class="cs-sec-bd"><text class="cs-hint">表单无字段</text></view>
    </view>
    <block wx:else>
      <view wx:for="{{ formGroups }}" wx:key="key" wx:for-item="grp" wx:for-index="gi" class="cs-sec">
        <view class="cs-sec-hd" data-g="{{ gi }}" bindtap="onToggleFormSection">
          <text class="cs-sec-no">{{ grp._no }}</text>
          <text class="cs-sec-title">{{ grp.title }}</text>
          <text class="cs-sec-n">{{ grp.count }}</text>
          <text wx:if="{{ grp.dirtyCount }}" class="cs-sec-dirty">{{ grp.dirtyCount }}</text>
          <text wx:if="{{ grp.collapsed && grp.summaryText }}" class="cs-sec-sum">{{ grp.summaryText }}</text>
          <text class="cs-chev">{{ grp.collapsed ? '▸' : '▾' }}</text>
        </view>

        <view wx:if="{{ !grp.collapsed }}" class="cs-sec-bd">
          <block wx:for="{{ grp.subs }}" wx:key="key" wx:for-item="sub" wx:for-index="si">
            <view wx:if="{{ !sub._plain }}" class="cs-sub">
              <text class="cs-sub-mark">▏</text>
              <text>{{ sub.title }}</text>
            </view>

            <block wx:for="{{ sub.rows }}" wx:key="key" wx:for-item="row" wx:for-index="ri">
              <!-- 长文本字段：整行铺开，不套规格行（套了会被渲染两遍）。
                   阅读态且为空时退回规格行显示 —，避免一个大空盒子 -->
              <block wx:if="{{ (row.fieldType === 'textarea' || row.fieldType === 'richText') && (formEditing || row.value !== '—') }}">
                <view class="cs-wide">
                  <text class="cs-wide-label"><text wx:if="{{ formEditing && row.required }}" class="cs-req">*</text>{{ row.label }}</text>
                  <textarea wx:if="{{ formEditing && row.editable }}"
                    class="cs-textarea {{ row._error ? 'cs-ctl--err' : '' }}"
                    value="{{ row.raw }}" data-g="{{ gi }}" data-s="{{ si }}" data-r="{{ ri }}"
                    bindinput="onFormInput" auto-height maxlength="-1" />
                  <text wx:else class="cs-textarea cs-textarea--read">{{ row.value }}</text>
                  <text wx:if="{{ row._error }}" class="cs-errmsg">{{ row._error }}</text>
                </view>
              </block>

              <!-- 编辑态 + 该字段可编辑：值换成控件，只留下划线 -->
              <block wx:elif="{{ formEditing && row.editable }}">
                <view class="cs-row {{ ri % 2 === 1 ? 'cs-row--alt' : '' }} {{ row._dirty ? 'cs-row--dirty' : '' }} {{ row._error ? 'cs-row--err' : '' }}">
                  <text class="cs-row-label"><text wx:if="{{ row.required }}" class="cs-req">*</text>{{ row.label }}</text>

                  <view wx:if="{{ row.fieldType === 'checkbox' }}"
                    class="cs-sw {{ row.raw === true || row.raw === 1 || row.raw === '1' ? 'cs-sw--on' : '' }}"
                    data-g="{{ gi }}" data-s="{{ si }}" data-r="{{ ri }}" bindtap="onFormToggleBool">
                    <view class="cs-sw-knob" />
                  </view>

                  <picker wx:elif="{{ row.fieldType === 'select' || row.fieldType === 'choice' }}"
                    range="{{ row.options }}" range-key="label" data-g="{{ gi }}" data-s="{{ si }}" data-r="{{ ri }}" bindchange="onFormPicker">
                    <view class="cs-pick {{ row.value === '—' || !row.value ? 'cs-pick--blank' : '' }} {{ row._error ? 'cs-pick--err' : '' }}">
                      <text class="cs-pick-txt">{{ row.value === '—' || !row.value ? '请选择' : row.value }}</text>
                      <text class="cs-pick-i">▼</text>
                    </view>
                  </picker>

                  <picker wx:elif="{{ row.fieldType === 'date' || row.fieldType === 'dateRange' }}"
                    mode="date" value="{{ row.raw }}" data-g="{{ gi }}" data-s="{{ si }}" data-r="{{ ri }}" bindchange="onFormPicker">
                    <view class="cs-pick {{ !row.raw ? 'cs-pick--blank' : '' }} {{ row._error ? 'cs-pick--err' : '' }}">
                      <text class="cs-pick-txt">{{ row.raw || '选择日期' }}</text>
                      <text class="cs-pick-i">▼</text>
                    </view>
                  </picker>

                  <input wx:else
                    class="cs-ctl {{ row.fieldType === 'number' || row.dataType === 'INTEGER' || row.dataType === 'DECIMAL' ? 'cs-ctl--mono' : '' }} {{ row._error ? 'cs-ctl--err' : '' }}"
                    type="{{ row.fieldType === 'number' || row.dataType === 'INTEGER' || row.dataType === 'DECIMAL' ? 'digit' : 'text' }}"
                    value="{{ row.raw }}" data-g="{{ gi }}" data-s="{{ si }}" data-r="{{ ri }}" bindinput="onFormInput" />
                </view>
                <text wx:if="{{ row._error }}" class="cs-errmsg">{{ row._error }}</text>
              </block>

              <!-- 阅读态；编辑态下不可编辑的字段降调 -->
              <view wx:else class="cs-row {{ ri % 2 === 1 ? 'cs-row--alt' : '' }} {{ formEditing ? 'cs-row--ro' : '' }}">
                <text class="cs-row-label">{{ row.label }}</text>
                <text class="cs-row-val {{ row.fieldType === 'number' || row.dataType === 'INTEGER' || row.dataType === 'DECIMAL' ? 'cs-row-val--mono' : '' }} {{ row.value === '—' ? 'cs-row-val--blank' : '' }}">{{ row.value }}</text>
              </view>
            </block>
          </block>
        </view>
      </view>
    </block>

    <!-- 分笼 / 转移 / 认领 / 清空划分：笼位级动作，整节只出现一次 -->
    <view wx:if="{{ cellDetailMeta && cellDetailMeta.permitted && (detailOperable || detailOperableCode === 'NOT_CLAIMED' || detailCanClaimOnBehalf || selectedCell._divisionNames) }}" class="cs-sec">
      <view class="cs-sec-bd cs-sec-bd--pad">
        <view class="cs-ops">
          <block wx:if="{{ detailOperable }}">
            <view class="cs-op-btn" data-kind="divide" bindtap="onStartOp">分笼</view>
            <view class="cs-op-btn" data-kind="transfer" bindtap="onStartOp">转移笼位</view>
          </block>
          <block wx:if="{{ detailOperableCode === 'NOT_CLAIMED' }}">
            <text class="cs-op-hint">{{ detailOperableReason }}</text>
            <view class="cs-op-btn cs-op-btn--primary" bindtap="onSelfClaim">{{ detailClaiming ? '认领中…' : '认领该笼位' }}</view>
          </block>
          <view wx:if="{{ detailCanClaimOnBehalf }}" class="cs-op-btn" bindtap="onOpenClaimOnBehalf">认领</view>
          <block wx:if="{{ selectedCell._divisionNames }}">
            <text class="cs-op-hint">已划分给：{{ selectedCell._divisionNames }}</text>
            <view class="cs-op-btn cs-op-btn--danger" bindtap="onClearDivision">{{ detailClearingDivision ? '清空中…' : '清空划分' }}</view>
          </block>
        </view>
      </view>
    </view>

    <!-- 无权限 -->
    <view wx:if="{{ cellDetailMeta && !cellDetailMeta.permitted }}" class="cs-sec">
      <view class="cs-sec-bd"><text class="cs-hint">仅限所属课题组及管理员查看详情</text></view>
    </view>

    <!-- 状态与照片（只读；无标注时整节不渲染，避免空标题） -->
    <view wx:if="{{ detailHasStatusBlock }}" class="cs-sec">
      <view class="cs-sec-hd" data-key="status" bindtap="onToggleSection">
        <text class="cs-sec-no">{{ statusSecNo }}</text>
        <text class="cs-sec-title">状态与照片</text>
        <text class="cs-chev">{{ openSections.status ? '▾' : '▸' }}</text>
      </view>
      <view wx:if="{{ openSections.status }}" class="cs-sec-bd">
        <block wx:for="{{ cellDetail.statusChips }}" wx:key="code">
          <view wx:if="{{ detailStatusPhotos[item.statusField] && detailStatusPhotos[item.statusField].length }}" class="cs-photo-group">
            <view class="cs-tick" style="--c:{{ item.color }};--c-bg:{{ item.bg }};">
              <text class="cs-tick-g">{{ item.abbr }}</text>
              <text>{{ item.label }}</text>
            </view>
            <view class="cs-photos">
              <view wx:for="{{ detailStatusPhotos[item.statusField] }}" wx:key="*this" wx:for-item="img" class="cs-photo-wrap">
                <image src="{{ img }}" mode="aspectFill" class="cs-photo" data-url="{{ img }}" bindtap="onDetailPreviewImage"></image>
              </view>
            </view>
          </view>
        </block>
        <view wx:if="{{ detailStatusPhotos._note }}" class="cs-note">
          <text class="cs-note-label">标注备注</text>
          <text class="cs-note-txt">{{ detailStatusPhotos._note }}</text>
        </view>
      </view>
    </view>

    <!-- 实验记录 + 照片（通道二）。编辑关键信息时压灰禁用：两条保存路径不能混 -->
    <view wx:if="{{ cellDetailMeta && cellDetailMeta.permitted }}" class="cs-sec {{ formEditing ? 'cs-sec--dim' : '' }}">
      <view class="cs-sec-hd" data-key="exp" bindtap="onToggleSection">
        <text class="cs-sec-no">{{ expSecNo }}</text>
        <text class="cs-sec-title">实验记录</text>
        <text class="cs-chev">{{ openSections.exp ? '▾' : '▸' }}</text>
      </view>
      <view wx:if="{{ openSections.exp }}" class="cs-sec-bd">
        <text wx:if="{{ formEditing }}" class="cs-lockhint">编辑关键信息时不可修改</text>
        <textarea
          class="cs-textarea {{ formEditing ? 'cs-textarea--disabled' : '' }}"
          value="{{ experimentDesc }}"
          placeholder="{{ formEditing ? '退出编辑后可填写…' : '输入实验记录…' }}"
          maxlength="-1"
          auto-height
          disabled="{{ formEditing }}"
          bindinput="onDetailExperimentDescInput"
        />
        <view class="cs-photo-hd">
          <text class="cs-sec-title">照片</text>
          <text wx:if="{{ detailImages.length }}" class="cs-sec-n">{{ detailImages.length }}</text>
        </view>
        <view class="cs-photos">
          <view wx:for="{{ detailImages }}" wx:key="*this" wx:for-item="imgUrl" wx:for-index="imgIdx" class="cs-photo-wrap">
            <image class="cs-photo" src="{{ imgUrl }}" mode="aspectFill" data-url="{{ imgUrl }}" bindtap="onDetailPreviewImage" />
            <view class="cs-photo-del" data-index="{{ imgIdx }}" catchtap="onDetailRemoveImage">✕</view>
          </view>
          <view class="cs-photo-add {{ detailImageUploading ? 'cs-btn--disabled' : '' }}" bindtap="onDetailChooseImage">
            <text class="cs-photo-add-icon">+</text>
            <text>{{ detailImageUploading ? '上传中' : '上传' }}</text>
          </view>
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- 底栏：一个时刻只有一个保存目标 -->
  <view wx:if="{{ cellDetailMeta && cellDetailMeta.permitted }}" class="cs-dock">
    <block wx:if="{{ formEditing }}">
      <view class="cs-btn cs-btn--soft" bindtap="onFormEditCancel">取消</view>
      <text wx:if="{{ formSaveMsg }}" class="cs-dock-msg cs-dock-msg--err">{{ formSaveMsg }}</text>
      <view class="cs-btn cs-btn--primary cs-dock-push {{ formSaving ? 'cs-btn--disabled' : '' }}" bindtap="onFormSave">{{ formSaving ? '保存中…' : '保存关键信息' }}</view>
    </block>
    <block wx:else>
      <view wx:if="{{ formEditable }}" class="cs-btn cs-btn--soft" bindtap="onFormEditStart">编辑关键信息</view>
      <!-- 不可编辑时把后端给的原因说出来：只把按钮藏掉，用户只会觉得按钮"没了" -->
      <text wx:elif="{{ formEditableReason }}" class="cs-dock-hint">{{ formEditableReason }}</text>
      <text wx:if="{{ detailSaveMsg }}" class="cs-dock-msg cs-dock-msg--{{ detailSaveMsgType }}">{{ detailSaveMsg }}</text>
      <view class="cs-btn cs-btn--primary cs-dock-push {{ detailSaving ? 'cs-btn--disabled' : '' }}" bindtap="onSaveCellAnnotation">{{ detailSaving ? '保存中…' : '保存记录' }}</view>
    </block>
  </view>
</van-popup>

<!-- 状态模式：笼位状态标注（居中弹窗 · 四态状态机） -->
<van-popup
  show="{{ editActionPopup }}"
  position="center"
  root-portal="{{ true }}"
  z-index="{{ 21000 }}"
  custom-class="cs-sheet"
  bind:close="onEditActionJustClose"
>
  <view class="cs-id">
    <text class="cs-id-pos">{{ editActionCell._displayPosition || '' }}</text>
    <view class="cs-ticks" />
    <view class="cs-x" bindtap="onEditActionJustClose">✕</view>
  </view>

  <scroll-view class="cs-body" scroll-y enhanced show-scrollbar="{{false}}">

    <!-- 状态标记：未标 / 已标 / 本次新增 / 本次移除 -->
    <view class="cs-sec">
      <view class="cs-sec-hd">
        <text class="cs-sec-no">01</text>
        <text class="cs-sec-title">状态标记</text>
      </view>
      <view class="cs-sec-bd">
        <view class="cs-stat-grid">
          <view wx:for="{{ editActionOptions }}" wx:key="action" wx:for-item="a"
            class="cs-stat {{ editActionCurrent[a.action] ? 'cs-stat--on' : '' }} {{ editActionCurrent[a.action] && !editActionInitial[a.action] ? 'cs-stat--add' : '' }} {{ !editActionCurrent[a.action] && editActionInitial[a.action] ? 'cs-stat--rm' : '' }}"
            style="--c:{{ a.color }};--c-bg:{{ a.bg }};"
            hover-class="cs-stat--hover" hover-stay-time="60"
            data-action="{{ a.action }}" bindtap="onEditActionToggle">
            <view class="cs-stat-g">
              <text>{{ a.abbr }}</text>
              <view wx:if="{{ !editActionCurrent[a.action] && editActionInitial[a.action] }}" class="cs-stat-strike" />
            </view>
            <text class="cs-stat-t">{{ a.label }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 照片 -->
    <view class="cs-sec">
      <view class="cs-sec-hd">
        <text class="cs-sec-no">02</text>
        <text class="cs-sec-title">照片</text>
        <text wx:if="{{ editActionPhotos.length }}" class="cs-sec-n">{{ editActionPhotos.length }}</text>
      </view>
      <view class="cs-sec-bd">
        <view class="cs-photos">
          <view wx:for="{{ editActionPhotos }}" wx:key="*this" wx:for-index="idx" class="cs-photo-wrap">
            <image src="{{ item }}" mode="aspectFill" class="cs-photo" data-url="{{ item }}" bindtap="onDetailPreviewImage"/>
            <view class="cs-photo-del" data-index="{{ idx }}" catchtap="onEditActionRemovePhoto">✕</view>
          </view>
          <view class="cs-photo-add {{ editActionUploading ? 'cs-btn--disabled' : '' }}" bindtap="onEditActionChoosePhoto">
            <text class="cs-photo-add-icon">{{ editActionUploading ? '⏳' : '+' }}</text>
            <text>{{ editActionUploading ? '上传中' : '添加' }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="cs-sec">
      <view class="cs-sec-hd">
        <text class="cs-sec-no">03</text>
        <text class="cs-sec-title">备注</text>
      </view>
      <view class="cs-sec-bd">
        <textarea class="cs-textarea" value="{{ editActionNote }}" placeholder="备注…" bindinput="onEditActionNoteInput" maxlength="-1" />
      </view>
    </view>

    <!-- 历史记录（默认折叠） -->
    <view class="cs-sec">
      <view class="cs-sec-hd" data-key="history" bindtap="onToggleSection">
        <text class="cs-sec-no">04</text>
        <text class="cs-sec-title">历史记录</text>
        <text wx:if="{{ editHistory.length }}" class="cs-sec-n">{{ editHistory.length }}</text>
        <text class="cs-chev">{{ openSections.history ? '▾' : '▸' }}</text>
      </view>
      <view wx:if="{{ openSections.history }}" class="cs-sec-bd">
        <view wx:if="{{ editHistoryLoading }}" class="cs-hint">加载历史…</view>
        <view wx:elif="{{ !editHistory.length }}" class="cs-hint">暂无历史记录</view>
        <view wx:else class="cs-tl">
          <view wx:for="{{ editHistory }}" wx:key="id" class="cs-tl-node">
            <view class="cs-tl-rail" />
            <view class="cs-tl-dot" style="background:{{ item._dot }};" />
            <view class="cs-tl-card">
              <view class="cs-tl-hd">
                <text class="cs-tl-kind">{{ item._label }}</text>
                <text class="cs-tl-time">{{ item.createdAt }}</text>
                <view class="cs-tl-del" data-id="{{ item.id }}" catchtap="onEditHistoryDelete">✕</view>
              </view>
              <view wx:if="{{ item.experimentDesc || (item._imgs && item._imgs.length) }}" class="cs-tl-bd">
                <text wx:if="{{ item.experimentDesc }}" class="cs-tl-op">{{ item.experimentDesc }}</text>
                <view wx:if="{{ item._imgs && item._imgs.length }}" class="cs-photos">
                  <image wx:for="{{ item._imgs }}" wx:key="*this" wx:for-item="img" src="{{ img }}" mode="aspectFill" class="cs-photo cs-photo--sm" data-url="{{ img }}" bindtap="onDetailPreviewImage"/>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

  </scroll-view>

  <view class="cs-dock">
    <view class="cs-btn cs-btn--soft" bindtap="onEditActionNewVersion">存为新记录</view>
    <view class="cs-btn cs-btn--primary cs-dock-push" bindtap="onEditActionSave">保存标注</view>
  </view>
</van-popup>

<!-- 特殊状态总览弹窗（对齐 H5 MobileSpecialStatusPanel 三层折叠设计） -->
<van-popup
  show="{{ specialStatusOpen }}"
  position="center"
  round
  closeable
  close-icon-position="top-right"
  root-portal="{{ true }}"
  z-index="{{ 20000 }}"
  custom-style="width:90vw;max-width:680rpx;height:80vh;box-sizing:border-box;overflow:hidden;"
  bind:close="onCloseSpecialStatus"
>
  <view class="sp-status-popup">
    <view class="sp-status-hd">
      <text class="sp-status-title">特殊状态总览</text>
      <text wx:if="{{ specialStatusScannedAt }}" class="sp-status-meta">上次扫描 {{ specialStatusScannedAt }} · 共 {{ specialStatusGroups.length }} 类特殊状态</text>
    </view>
    <scroll-view scroll-y class="sp-status-scroll">
      <view wx:if="{{ specialStatusLoading }}" class="sp-status-loading">
        <van-loading size="20px" color="#ac1736" />
        <text>加载中…</text>
      </view>
      <view wx:elif="{{ specialStatusError }}" class="sp-status-err-msg">{{ specialStatusError }}</view>
      <view wx:elif="{{ specialStatusGroups.length === 0 }}" class="sp-status-empty">暂无特殊状态笼位</view>
      <view wx:else class="sp-status-list">
        <block wx:for="{{ specialStatusGroups }}" wx:key="code" wx:for-item="grp">
          <!-- 第一层：状态类型 -->
          <view class="sp-group-card">
            <view class="sp-group-hd" data-code="{{ grp.code }}" bindtap="onToggleSpecialGroup">
              <view class="sp-group-dot" style="background:{{ grp.dotColor }};">
                <text class="sp-group-abbr">{{ grp.abbr }}</text>
              </view>
              <text class="sp-group-name">{{ grp.label }}</text>
              <text class="sp-group-badge">{{ grp.count }}</text>
              <text class="sp-group-arrow">{{ grp.expanded ? '▴' : '▾' }}</text>
            </view>
            <!-- 第二层：笼架分组 -->
            <view wx:if="{{ grp.expanded && grp.shelfGroups.length }}" class="sp-group-body">
              <block wx:for="{{ grp.shelfGroups }}" wx:key="key" wx:for-item="shf">
                <view class="sp-shelf-card">
                  <view class="sp-shelf-hd" data-code="{{ grp.code }}" data-key="{{ shf.key }}" bindtap="onToggleSpecialShelf">
                    <view class="sp-shelf-info">
                      <text class="sp-shelf-title">{{ shf.title }}</text>
                      <text wx:if="{{ shf.meta }}" class="sp-shelf-meta">{{ shf.meta }}</text>
                    </view>
                    <text class="sp-shelf-count">{{ shf.cages.length }} 位</text>
                    <text class="sp-shelf-arrow">{{ shf._expanded ? '▴' : '▾' }}</text>
                  </view>
                  <!-- 第三层：笼位列表 -->
                  <view wx:if="{{ shf._expanded }}" class="sp-shelf-body">
                    <view wx:for="{{ shf.cages }}" wx:key="position" wx:for-item="cage" class="sp-cage-row">
                      <view class="sp-cage-main">
                        <text class="sp-cage-pos">{{ cage._displayPosition || cage.position }}</text>
                        <text class="sp-cage-pi">PI {{ cage.projectPiName || cage.piName || '—' }}</text>
                      </view>
                      <text wx:if="{{ cage.detailName || cage.detailDescription }}" class="sp-cage-detail">{{ cage.detailName || cage.detailDescription }}</text>
                    </view>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>
</van-popup>

<!-- 扫码确认核对弹窗 -->
<van-popup
  show="{{ showConfirmDialog }}"
  position="center"
  round
  closeable
  close-icon-position="top-right"
  root-portal="{{ true }}"
  z-index="{{ 22000 }}"
  custom-style="width:90vw;max-width:600rpx;padding:24rpx;box-sizing:border-box;"
  bind:close="onCloseConfirmDialog"
>
  <view class="cf-root">
    <view class="cf-title">确认 · 核对信息</view>
    <view class="cf-rows">
      <view wx:for="{{ confirmRows }}" wx:key="label" class="cf-row">
        <text class="cf-row-label">{{ item.label }}</text>
        <text class="cf-row-value {{ item.em ? 'cf-row-value--em' : '' }}">{{ item.value }}</text>
      </view>
    </view>

    <!-- hasInfo === false 时内嵌笼位信息填写表单（复用统一表单渲染链路） -->
    <view wx:if="{{ confirmLookup && confirmLookup.claim && !confirmLookup.claim.hasInfo }}" class="cf-form">
      <view wx:if="{{ formLoading }}" class="detail-form-hint">加载表单…</view>
      <view wx:elif="{{ formError }}" class="detail-form-hint detail-form-hint--error">{{ formError }}</view>
      <view wx:elif="{{ !formRows.length }}" class="detail-form-hint">表单无字段</view>
      <view wx:else class="detail-form-grid">
        <view wx:for="{{ formRows }}" wx:key="key" class="detail-form-cell">
          <text class="detail-form-cell-label">{{ item.label }}</text>
          <text class="detail-form-cell-value">{{ item.value }}</text>
        </view>
      </view>
    </view>

    <view class="cf-tip">确认该笼位已到位（由学生本人账号确认）</view>

    <view class="cf-btns">
      <view class="cf-btn-cancel" bindtap="onCloseConfirmDialog">取消</view>
      <view class="cf-btn-confirm {{ confirmSubmitting ? 'cf-btn-confirm--disabled' : '' }}" bindtap="{{ confirmSubmitting ? '' : 'handleConfirmArrival' }}">
        {{ confirmSubmitting ? '处理中...' : '确认到位' }}
      </view>
    </view>
  </view>
</van-popup>

<!-- 分配 AUP 选择弹窗 -->
<van-popup
  show="{{ showAupDialog }}"
  position="center"
  round
  closeable
  close-icon-position="top-right"
  root-portal="{{ true }}"
  z-index="{{ 22000 }}"
  custom-style="width:90vw;max-width:600rpx;padding:24rpx;box-sizing:border-box;"
  bind:close="onCloseAupDialog"
>
  <view class="cf-root">
    <view class="cf-title">分配选定笼位 · 选择 AUP</view>
    <scroll-view scroll-y class="aup-list">
      <view wx:for="{{ aupOptions }}" wx:key="value" class="aup-row {{ selectedAupId === item.value ? 'aup-row--on' : '' }}" data-value="{{ item.value }}" bindtap="onAupSelect">
        <text class="aup-row-text">{{ item.text }}</text>
        <text wx:if="{{ selectedAupId === item.value }}" class="aup-row-check">✓</text>
      </view>
      <view wx:if="{{ aupOptions.length === 0 }}" class="aup-empty">暂无可用 AUP</view>
    </scroll-view>
    <view class="cf-btns">
      <view class="cf-btn-cancel" bindtap="onCloseAupDialog">取消</view>
      <view class="cf-btn-confirm {{ allocSubmitting ? 'cf-btn-confirm--disabled' : '' }}" bindtap="{{ allocSubmitting ? '' : 'handleConfirmAssign' }}">{{ allocSubmitting ? '分配中...' : '确认分配' }}</view>
    </view>
  </view>
</van-popup>

<!-- 教职工认领：人员检索弹窗 -->
<van-popup
  show="{{ reservePersonOpen }}"
  position="center"
  round
  closeable
  close-icon-position="top-right"
  root-portal="{{ true }}"
  z-index="{{ 22000 }}"
  custom-style="width:90vw;max-width:600rpx;padding:24rpx;box-sizing:border-box;"
  bind:close="onCloseReservePerson"
>
  <view class="cf-root">
    <view class="cf-title">{{ personPickerPurpose === 'claimOnBehalf' ? '代认领 · 选择实验员' : (personPickerPurpose === 'division' ? '划分 · 选择本课题组成员' : '确认预定 · 选择占用者') }}</view>
    <view class="rp-search-row">
      <input class="rp-input" type="text" value="{{ reserveKeyword }}" placeholder="姓名 / 工号" placeholder-class="list-search-placeholder" bindinput="onReserveKeywordInput" confirm-type="search" bindconfirm="onReserveSearch" />
      <view class="rp-search-btn" bindtap="onReserveSearch">搜索</view>
    </view>
    <!-- 打开即按已选笼位的 AUP 课题组预览成员，无需先手输关键字 -->
    <view wx:if="{{ reserveGroups.length > 0 }}" class="rp-groups">课题组：{{ reserveGroups }}</view>
    <scroll-view scroll-y class="rp-list">
      <view wx:if="{{ reserveSearching }}" class="rp-hint">加载中…</view>
      <view wx:elif="{{ reserveResults.length === 0 }}" class="rp-hint">{{ reserveGroups.length > 0 ? '该课题组暂无可选成员，可手动搜索' : '输入关键字检索人员' }}</view>
      <block wx:else>
        <view wx:for="{{ reserveResults }}" wx:key="accountId" class="rp-row {{ divisionPicked[item.accountId] ? 'rp-row--on' : '' }}" data-account-id="{{ item.accountId }}" data-name="{{ item.name }}" bindtap="onReservePickPerson">
          <text class="rp-name">{{ item.name }}</text>
          <text class="rp-group">{{ item.projectGroupName }}</text>
          <text wx:if="{{ divisionPicked[item.accountId] }}" class="rp-check">✓</text>
        </view>
      </block>
    </scroll-view>
    <!-- 划分模式：弹窗内多选后统一提交 -->
    <view wx:if="{{ personPickerPurpose === 'division' }}" class="cf-btns">
      <view class="cf-btn-cancel" bindtap="onCloseReservePerson">取消</view>
      <view class="cf-btn-confirm {{ (divisionPickedCount === 0 || divisionSubmitting) ? 'cf-btn-confirm--disabled' : '' }}" bindtap="{{ (divisionPickedCount === 0 || divisionSubmitting) ? '' : 'handleDivisionSubmit' }}">{{ divisionSubmitting ? '提交中...' : '确定划分 (' + divisionPickedCount + ')' }}</view>
    </view>
  </view>
</van-popup>

<!-- 归档确认弹窗 -->
<van-popup
  show="{{ showArchiveDialog }}"
  position="center"
  round
  closeable
  close-icon-position="top-right"
  root-portal="{{ true }}"
  z-index="{{ 22000 }}"
  custom-style="width:90vw;max-width:600rpx;padding:24rpx;box-sizing:border-box;"
  bind:close="onCloseArchiveDialog"
>
  <view class="cf-root">
    <view class="cf-title">归档笼位</view>
    <view class="cf-rows">
      <view wx:if="{{ archiveTarget.positionLabel }}" class="cf-row"><text class="cf-row-label">笼位</text><text class="cf-row-value">{{ archiveTarget.positionLabel }}</text></view>
      <view wx:if="{{ archiveTarget.occupantName }}" class="cf-row"><text class="cf-row-label">占用者</text><text class="cf-row-value cf-row-value--em">{{ archiveTarget.occupantName }}</text></view>
      <view wx:if="{{ archiveTarget.projectPiName }}" class="cf-row"><text class="cf-row-label">课题组 PI</text><text class="cf-row-value">{{ archiveTarget.projectPiName }}</text></view>
