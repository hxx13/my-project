    <view class="cf-title">我的申请</view>
    <scroll-view scroll-y class="record-scroll">
      <view wx:if="{{ myClaimsLoading }}" class="rp-hint">加载中…</view>
      <view wx:elif="{{ myClaims.length === 0 }}" class="rp-hint">暂无申请记录</view>
      <block wx:else>
        <view wx:for="{{ myClaims }}" wx:key="id" class="mc-item">
          <view class="mc-item-top">
            <text class="mc-item-pos">{{ item.positionLabel || item.animalCageId }}</text>
            <text class="mc-item-status">{{ item._statusLabel }}</text>
          </view>
          <view wx:if="{{ item.roomName || item.shelveName }}" class="mc-item-sub">{{ item.campusName }} {{ item.roomName }} {{ item.shelveName }}</view>
          <view wx:if="{{ item.latestRejectReason }}" class="mc-item-reject">驳回原因：{{ item.latestRejectReason }}</view>
          <view class="mc-item-actions">
