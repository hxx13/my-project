  margin-top: 12rpx;
}
/* 转移申请卡片最后一行：时间在左、按钮在右，按钮因此落在卡片右下但不单独占一行。

   试过更"标准"的 position:absolute 钉 bottom-right —— 会在窄屏上压住三签标签：
   三个 chip 在 card 内宽约 520rpx 时会折成两行，第二行正好贴在卡片底部，
   而绝对定位的按钮也在那儿，直接盖上去。绝对定位的锚点是"卡片底边"，
   可这卡片最底下那行并不固定是谁。并成一行反而稳，且同样不占额外高度。 */
.mc-item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 6rpx;
}
.mc-item-sub--tight {
  margin-top: 0;
}
.mc-btn {
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}
/* 视觉基准 = pages/animalOrder：主操作蓝底白字，其余 var(--fill-2) 底 + var(--body) 字。
   禁描边、禁半透明、禁大红大绿。 */
.mc-btn--primary {
  color: #fff;
  background: var(--accent);
}
.mc-btn--danger {
  color: var(--body);
  background: var(--fill-2);
}

/* 选人弹窗：已选笼位所属课题组提示 */
.rp-groups {
  font-size: 22rpx;
  color: var(--faint);
  padding: 8rpx 4rpx 0;
  line-height: 1.5;
}

/* ── 分笼 / 转移 / 认领 ── */

/* 详情弹窗内的操作入口 */
/* 划分名单：独立属性块，用中性色区别于「待认领」警示色 */

/* 选位条（网格上方） */
.op-select-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #f5f7ff;
  border-bottom: 1rpx solid #e0e7ff;
}
.op-select-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.op-select-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
}
.op-select-src {
  font-size: 22rpx;
  color: var(--ink);
}
.op-select-hint {
  font-size: 20rpx;
  color: var(--mute);
}
.op-select-count {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
}
.op-select-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-strong);
  background: #fff;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}
.op-select-btn--primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}
.op-select-btn.is-disabled {
  opacity: 0.5;
}

/* 确认弹窗 */
.op-confirm-src {
  font-size: 24rpx;
  color: var(--ink);
  margin: 8rpx 0 12rpx;
}
.op-confirm-list {
  max-height: 360rpx;
}
.op-confirm-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}
.op-confirm-pos {
  min-width: 80rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}
.op-confirm-where {
  flex: 1;
  font-size: 22rpx;
  color: var(--mute);
}
.op-confirm-aup {
  font-size: 20rpx;
  color: var(--faint);
}
.op-confirm-keep {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 16rpx 0;
  font-size: 22rpx;
  color: var(--ink);
}
.op-confirm-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 20rpx;
}
/* 转移单表单块（确认弹窗内，仅 transfer）：紧凑，浅底，单一蓝主色 */
.op-form {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--fill);
}
/* 所有文字与输入框内的文字共用同一条左边缘：输入框是 1rpx 边框 + 18rpx 内边距，
   所以标签行也缩进 19rpx。不缩进的话，标签在灰块边缘、框内文字在 19rpx 处，
   看起来就是「输入框歪了、和上面的文字对不齐」。 */
.op-form-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  padding-left: 19rpx;
  padding-right: 19rpx;
}
.op-form-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}
.op-form-hint {
  font-size: 20rpx;
  color: var(--faint);
  text-align: right;
}
.op-form-auto {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 18rpx;
  margin-top: 8rpx;
  padding-left: 19rpx;
  padding-right: 19rpx;
  font-size: 20rpx;
  color: var(--mute);
}
.op-form-auto-i {
  white-space: nowrap;
}
.op-form-rows {
  margin-top: 4rpx;
}
.op-form-top {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 10rpx;
}
.op-form-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}
.op-form-pos {
  flex-shrink: 0;
  min-width: 76rpx;
  padding-left: 19rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink);
}
/* 规格对齐同页的 .rp-input（原因那个框）：12rpx 圆角 / 26rpx 字 / --ink。
   底色不同是必要的 —— 它压在 --fill 灰块上，用 --fill 会整块消失。

   **高度必须钉死**：♀ / ♂ 是符号字形，落的字体与中文不是同一套、行高不同，
   高度交给内容的话那两个框会和「品系」不一样高，行内 align-items:center 一居中
   上下边就错开，整行看着是歪的。 */
.op-form-ipt {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 62rpx;      /* 62 = 64 - 上下各 1rpx 边框 */
  color: var(--ink);
  background: var(--paper);
}
/* 拟定转移日期：原生 date picker 包一层 view 冒充输入框（见 wxml）。
   picker 是 inline 包装节点，不撑满宽度的话里面的框会缩成内容宽。 */
.op-form-pick-wrap {
  display: block;
  width: 100%;
}
.op-form-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  line-height: normal;   /* 覆盖 .op-form-ipt 的 62rpx —— 靠 flex 居中，行高会把右侧箭头顶偏 */
}
.op-form-pick-txt {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 没选日期时按占位色，与其它输入框的 placeholder 观感一致 */
.op-form-pick--empty .op-form-pick-txt {
  color: var(--off);
}

.op-form-ipt--strain {
  flex: 2;
}
.op-form-ipt--num {
  flex: 1;
  text-align: center;
}
/* ================================================================== */
/*  Cage Sheet —— 查看 / 状态 / 记录 三弹窗共用的结构与令牌                    */
/*  方向与「动物订购 · 选购弹窗」对齐：白底 + 中性灰分层 + 单一蓝主色。          */
/*  规矩：按钮一律实底，不描边、不用半透明；结构色只走 var(--fill) / var(--line) 这档，   */
/*  不铺大红大绿（状态色仅以 10rpx 圆点出现在标签上）。                         */
/*  令牌统一在文件顶部的 page{} 里 —— 不回写 app.wxss，波及其他页面。          */
/* ================================================================== */

/* 令牌统一在文件顶部的 page{} 里，这里不再重复声明 */
.cs-sheet {
  display: flex;
  flex-direction: column;
  width: 86vw;
  max-width: 680rpx;
  max-height: 78vh;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--paper);
  border-radius: 22rpx;
  box-shadow: 0 12rpx 44rpx rgba(15, 23, 42, 0.16), 0 2rpx 6rpx rgba(15, 23, 42, 0.06);
}

/* 编辑态：不再套红环，头部染一层极浅蓝 + 徽标换成蓝底，够醒目又不吵 */
.cs-sheet--editing .cs-id {
  background: var(--accent-bg);
}

/* ---- 身份条：位置 + 关闭一行，状态标签另起一行 ---- */
.cs-id {
  flex-shrink: 0;
  padding: 26rpx 26rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.cs-id-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cs-id-pos {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 身份条副信息（如记录弹窗的「N 次变更 · M 个字段」） */
.cs-id-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.cs-ticks {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

/* 状态标签：中性浅底胶囊 + 一颗状态色圆点。颜色只落在 10rpx 的点上 */
.cs-tick {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: var(--fill-2);
  font-size: 22rpx;
  font-weight: 500;
  color: var(--body);
  white-space: nowrap;
}

.cs-tick-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c);
}

.cs-badge {
  flex-shrink: 0;
  padding: 5rpx 14rpx;
  border-radius: 8rpx;
  background: var(--accent);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

/* 自带关闭按钮：vant 那个是绝对定位，放不进身份条的行内节奏 */
.cs-x {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--faint);
  font-size: 28rpx;
  line-height: 1;
}

.cs-x:active {
  background: var(--fill-2);
  color: var(--mute);
}

/* ---- 唯一滚动区 ---- */
/* max-height 之外还要给一个确定的高度上限：外层 .cs-sheet 只有 max-height，
   flex 不会因此收缩子项，scroll-view 会拿到内容高度并溢出到底栏底下。
   54vh + 头部（状态标签 / 笼位动作两行都出现时约 13vh）+ 底栏（含安全区约 9vh）
   ≈ 76vh，留在 .cs-sheet 的 78vh 之内。 */
.cs-body {
  flex: 1;
  min-height: 0;
  max-height: 54vh;
  width: 100%;
  box-sizing: border-box;
}

/* ---- 底部动作坞 ---- */
.cs-dock {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 26rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--paper);
}

.cs-dock-msg {
  flex-shrink: 0;
  margin-right: auto;
  font-size: 21rpx;
}

/* 不可编辑的原因：占左侧、可折行、极淡，不与主操作抢视线 */
.cs-dock-hint {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
  font-size: 20rpx;
  color: var(--faint);
  line-height: 1.35;
}

.cs-dock-msg--ok { color: var(--ok); }
.cs-dock-msg--err { color: var(--danger); }

.cs-dock-push { margin-left: auto; }

/* ================================================================== */
/*  分区                                                                */
/* ================================================================== */

.cs-sec {
  border-bottom: 1rpx solid var(--line2);
}

.cs-sec:last-child {
  border-bottom: none;
}

.cs-sec-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 26rpx;
}

.cs-sec-hd:active {
  background: var(--fill);
}

.cs-sec-no {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--faint);
}

.cs-sec-title {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.cs-sec-n {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 20rpx;
  background: var(--fill-2);
  color: var(--mute);
  font-size: 20rpx;
}

/* 收起的分区里有多少行改动过 —— 没有它用户是按黑箱保存 */
.cs-sec-dirty {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 20rpx;
  background: var(--accent);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.cs-chev {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 18rpx;
  color: var(--faint);
}

.cs-sec-bd {
  padding: 0 26rpx 22rpx;
}

/* 编辑关键信息时，实验记录 / 照片区不可点 —— 两条保存路径不能混。
   不用整块 opacity（底下会透出来），改为把文字压淡、输入框换成中灰实底 */
.cs-sec--dim > .cs-sec-hd .cs-sec-title {
  color: var(--mute);
}

.cs-sec--dim > .cs-sec-bd {
  pointer-events: none;
}

.cs-sec--dim .cs-textarea {
  background: var(--line2);
  color: var(--faint);
}

.cs-sec--dim .cs-wide-label,
.cs-sec--dim .cs-photo-hd .cs-sec-title,
.cs-sec--dim .cs-lockhint {
  color: var(--faint);
}

.cs-lockhint {
  display: block;
  padding: 2rpx 0 10rpx;
  font-size: 20rpx;
  color: var(--faint);
}

/* ---- 子模块小标题：分区内一层，不再往下折 ---- */
.cs-sub {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 6rpx 0 2rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--mute);
}

.cs-sub:first-child {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

/* ================================================================== */
/*  规格行：双列网格。整组收进一块浅底卡（内容分层），格内不画线、不隔行底色。      */
/*  每格「标签在上 / 值在下」——值不再被右推成一条参差的边；放不下的长值            */
/*  （项目名称、单位、来源…）由 JS 打 _wide 标记跨满两列。                       */
/* ================================================================== */

/* 字段一栏一张卡（对齐 web 详情弹窗 CageFormFill 阅读态：rounded + hairline + 浅底） */
.cs-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.cs-fields .cs-textarea {
  background: #fff;
}

/* 子模块小标题与长文本框跨满两列 */
.cs-fields .cs-sub,
.cs-wide {
  grid-column: 1 / -1;
}

.cs-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx 16rpx;
  min-width: 0;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--fill);
}

.cs-row--wide {
  grid-column: 1 / -1;
}

.cs-row-label {
  font-size: 21rpx;
  color: var(--mute);
  line-height: 1.4;
  letter-spacing: 1rpx;
}

/* 只读提示（对齐 web：只读 · 点「编辑」可修改） */
.cs-form-hint {
  display: block;
  margin-bottom: 12rpx;
  font-size: 19rpx;
  color: var(--mute);
}

/* 「自动获取」角标：与 web 同款石板灰小药丸 */
.cs-auto {
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #64748b;
  background: rgba(100, 116, 139, 0.09);
  border: 1rpx solid rgba(100, 116, 139, 0.25);
}

.cs-row-val {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.45;
  word-break: break-all;
}

.cs-row-val--mono {
  font-variant-numeric: tabular-nums;
}

.cs-row-val--blank {
  color: var(--faint);
  font-weight: 400;
}

.cs-req {
  color: var(--danger);
  font-weight: 700;
  margin-right: 3rpx;
}

/* 只读行（字段字典 editable:false）：编辑态主动降调，不用锁图标 */
.cs-row--ro .cs-row-label {
  color: var(--faint);
}

.cs-row--ro .cs-row-val {
  color: var(--mute);
  font-weight: 500;
}

/* 本次改动过的行：标签后一个品牌红小点 */
.cs-row--dirty .cs-row-label::after {
  content: "";
  display: inline-block;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--accent);
  margin-left: 8rpx;
  vertical-align: 2rpx;
}

.cs-row--err {
  background: #fef2f2;
  border-radius: 8rpx;
}

.cs-errmsg {
  display: block;
  padding: 0 0 6rpx;
  text-align: left;
  font-size: 20rpx;
  color: var(--danger);
}

/* ================================================================== */
/*  编辑控件：浅底卡上给白底实心块，不再用下划线那一套「线条」                     */
/* ================================================================== */

.cs-ctl {
  width: 100%;
  height: 56rpx;
  padding: 0 16rpx;
  border: none;
  border-radius: 10rpx;
  background: #fff;
  text-align: left;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ink);
  box-sizing: border-box;
}

.cs-ctl--mono {
  font-variant-numeric: tabular-nums;
}

.cs-ctl--err {
  background: #fef2f2;
}

/* 选择类：值 + 细箭头，整行点开原生 picker */
.cs-pick {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #fff;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ink);
  box-sizing: border-box;
}

.cs-pick--blank {
  color: var(--faint);
  font-weight: 400;
}

.cs-pick--err {
  background: #fef2f2;
}

.cs-pick-txt {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cs-pick-i {
  flex-shrink: 0;
  font-size: 18rpx;
  color: var(--faint);
}

/* 布尔：小开关，跟在标签下方 */
.cs-sw {
  position: relative;
  flex-shrink: 0;
  width: 60rpx;
  height: 34rpx;
  border-radius: 18rpx;
  background: var(--line-strong);
  align-self: flex-start;
  transition: background 0.16s;
}

.cs-sw-knob {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.16s;
}

.cs-sw--on {
  background: var(--accent);
}

.cs-sw--on .cs-sw-knob {
  transform: translateX(26rpx);
}

/* 长文本字段：标签在上、内容在下，占满整行 */
.cs-wide {
  display: block;
  padding: 12rpx 0;
}

.cs-wide-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  color: var(--mute);
}

.cs-textarea {
  display: block;
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 14rpx;
  background: var(--fill);
  font-size: 25rpx;
  color: var(--ink);
  line-height: 1.55;
}

.cs-textarea--read {
  min-height: 0;
  background: var(--fill);
  color: var(--body);
}

.cs-textarea--disabled {
  background: var(--line2);
  color: var(--faint);
}

/* ================================================================== */
/*  按钮：一律实底，不描边、不用半透明                                        */
/* ================================================================== */

.cs-btn {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
  line-height: 1;
}

.cs-btn--primary {
  background: var(--accent);
  color: #fff;
}

/* 次级动作：实底中性灰 */
.cs-btn--soft {
  background: var(--fill-2);
  color: var(--body);
}

/* 禁用：压成实心中灰，不靠 opacity 把底下的东西透出来 */
.cs-btn--disabled {
  background: var(--line-strong);
  color: #fff;
}

/* ---- 笼位操作胶囊（分笼 / 转移 / 认领 / 清空划分） ---- */
/* 贴在身份条下面，随头部固定；底部的动作坞只留保存类按钮 */
.cs-ops {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

/* 实底中性灰，与「编辑关键信息」同一档；主操作才给蓝 */
.cs-op-btn {
  padding: 16rpx 28rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 12rpx;
  background: var(--fill-2);
  color: var(--body);
  font-size: 24rpx;
  font-weight: 600;
}

.cs-op-btn--primary {
  background: var(--accent);
  color: #fff;
}

/* 破坏性动作（清空划分）：仍是实底，只是把字压淡，不与主操作抢 */
.cs-op-btn--danger {
  background: var(--fill-2);
  color: var(--mute);
}

.cs-op-hint {
  width: 100%;
  font-size: 21rpx;
  color: var(--mute);
  line-height: 1.45;
}

/* ================================================================== */
/*  提示 / 空态 / 未决条                                                 */
/* ================================================================== */

.cs-hint {
  display: block;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: var(--mute);
  line-height: 1.5;
}

.cs-hint--block {
  padding: 140rpx 0;
  text-align: center;
}

.cs-hint--error {
  color: var(--danger);
}

/* 未决分笼/转移：左侧状态色条 + 浅底，与全站通知卡同一口径 */
.cs-notice {
  display: flex;
  align-items: flex-start;
  margin: 18rpx 26rpx 0;
  padding: 14rpx 16rpx;
  border-left: 6rpx solid var(--notice, #f59e0b);
  border-radius: 0 12rpx 12rpx 0;
  background: var(--fill);
  font-size: 22rpx;
  color: var(--ink);
  line-height: 1.5;
}

.cs-notice-txt {
  flex: 1;
  min-width: 0;
}

/* 未决条右侧的入口（查看转移单）：文字链，不跟正文抢视觉 */
.cs-notice-link {
  flex: none;
  margin-left: 16rpx;
  color: var(--accent);
  font-weight: 600;
}

/* ================================================================== */
/*  照片                                                                */
/* ================================================================== */

.cs-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.cs-photo-wrap {
  position: relative;
}

.cs-photo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: var(--fill);
}

.cs-photo--sm {
  width: 72rpx;
  height: 72rpx;
}

.cs-photo-del {
  position: absolute;
  top: -9rpx;
  right: -9rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--body);
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cs-photo-add {
  width: 100rpx;
  height: 100rpx;
  border: none;
  border-radius: 12rpx;
  background: var(--fill);
  color: var(--mute);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 20rpx;
  box-sizing: border-box;
}

.cs-photo-add-icon {
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
}

.cs-photo-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 22rpx 0 12rpx;
}

.cs-photo-group {
  margin-bottom: 16rpx;
}

.cs-photo-group:last-child {
  margin-bottom: 0;
}

/* ---- 只读备注：浅底卡，不画引用竖线 ---- */
.cs-note {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--fill);
}

.cs-note-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 21rpx;
  color: var(--mute);
}

.cs-note-txt {
  display: block;
  font-size: 24rpx;
  color: var(--body);
  line-height: 1.55;
  word-break: break-all;
}

/* ================================================================== */
/*  状态标记：四态状态机（未标 / 已标 / 本次新增 / 本次移除）                  */
/* ================================================================== */

.cs-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.cs-stat {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: transparent;
  box-sizing: border-box;
  overflow: hidden;
}

.cs-stat--hover {
  opacity: 0.75;
}

/* 状态字块：反白单字，没标记时是描边空块 */
.cs-stat-g {
  position: relative;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  background: var(--paper);
  color: var(--faint);
  font-family: monospace;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cs-stat-t {
  min-width: 0;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--mute);
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 已标记：用该状态自己的色（继承网格），不是一个统一的绿 */
.cs-stat--on {
  border-color: var(--c);
  background: var(--c-bg, var(--fill));
}

.cs-stat--on .cs-stat-g {
  background: var(--c);
  border-color: var(--c);
  color: #fff;
}

.cs-stat--on .cs-stat-t {
  color: var(--ink);
  font-weight: 600;
}

/* 本次新增：右上折角（狗耳朵），扫一眼就知道这次改了什么 */
.cs-stat--add::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 22rpx 22rpx 0;
  border-color: transparent var(--c) transparent transparent;
}

/* 本次移除：虚框 + 斜杠划过字块 + 文字删除线 */
.cs-stat--rm {
  border-style: dashed;
  border-color: var(--mute);
}

.cs-stat--rm .cs-stat-g {
  color: var(--mute);
  border-color: var(--mute);
  background: var(--paper);
}

.cs-stat-strike {
  position: absolute;
  left: -2rpx;
  right: -2rpx;
  top: 50%;
  height: 2rpx;
  background: var(--mute);
  transform: rotate(-45deg);
}

.cs-stat--rm .cs-stat-t {
  color: var(--mute);
  text-decoration: line-through;
}

/* ================================================================== */
/*  时间轴（记录弹窗 / 状态弹窗的历史）                                     */
/* ================================================================== */

.cs-tl {
  padding-left: 30rpx;
}

/* 记录弹窗没有分区，时间轴直接进 body，需要自己留边距 */
.cs-tl--inset {
  padding: 22rpx 26rpx 24rpx 56rpx;
}

.cs-tl-node {
  position: relative;
  padding-bottom: 18rpx;
}

.cs-tl-node:last-child {
  padding-bottom: 0;
}

.cs-tl-rail {
  position: absolute;
  left: -22rpx;
  top: 30rpx;
  bottom: -10rpx;
  width: 1rpx;
  background: var(--line);
}

.cs-tl-node:last-child .cs-tl-rail {
  display: none;
}

.cs-tl-dot {
  position: absolute;
  left: -27rpx;
  top: 16rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 5rpx var(--paper);
}

.cs-tl-card {
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--paper);
  overflow: hidden;
}

.cs-tl-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
}

.cs-tl-kind {
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink);
}

.cs-tl-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--mute);
}

.cs-tl-time {
  flex-shrink: 0;
  margin-left: auto;
  font-family: monospace;
  font-size: 20rpx;
  color: var(--mute);
  font-variant-numeric: tabular-nums;
}

.cs-tl-del {
  flex-shrink: 0;
  padding: 0 4rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.cs-tl-bd {
  padding: 14rpx 18rpx;
  border-top: 1rpx solid var(--line2);
  background: #fcfbfa;
}

.cs-tl-op {
  display: block;
  margin-bottom: 10rpx;
  font-size: 21rpx;
  color: var(--mute);
  line-height: 1.5;
  word-break: break-all;
}

.cs-tl-op:last-child {
  margin-bottom: 0;
}

/* ---- 字段差异行：旧值划掉 → 新值加粗 ---- */
.cs-diff {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 5rpx 0;
  font-size: 23rpx;
  line-height: 1.5;
}

.cs-diff:first-child {
  padding-top: 0;
}

.cs-diff:last-child {
  padding-bottom: 0;
}

.cs-diff-label {
  flex-shrink: 0;
  width: 124rpx;
  font-size: 21rpx;
  color: var(--mute);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cs-diff-before {
  flex-shrink: 0;
  max-width: 40%;
  font-family: monospace;
  color: var(--faint);
  text-decoration: line-through;
  word-break: break-all;
}

.cs-diff-before--empty {
  text-decoration: none;
}

.cs-diff-arrow {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--faint);
}

.cs-diff-after {
  flex: 1;
  min-width: 0;
  font-family: monospace;
  font-weight: 600;
  color: var(--ink);
  word-break: break-all;
}

/* ── 特殊饲养明细（子状态）────────────────────────────────────────────
   强绑定：只在「需特殊饲养」开着时渲染（见 editActionSfOn）；
   配色沿用本页令牌（--brand / --ink / --soft），与状态动作那组磁贴同一套观感。 */
.cs-detail {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
}
.cs-detail-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.cs-detail-t { font-size: 24rpx; font-weight: 600; color: var(--ink); }
.cs-detail-note { font-size: 20rpx; color: var(--faint); }
.cs-detail-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cs-detail-chip {
  padding: 8rpx 18rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 10rpx;
  font-size: 22rpx;
  color: var(--mute);
}
.cs-detail-chip--on { border-color: var(--accent); color: var(--accent); background: var(--fill); font-weight: 600; }
.cs-detail-chip--add { font-weight: 700; }
.cs-detail-chip--rm { text-decoration: line-through; opacity: 0.6; }

/* 严重程度每档：外面包一层定位容器，右上角挂「瘙痒」勾选框（勾上 = 该档 + 瘙痒） */
.cs-sev-wrap { position: relative; margin-top: 10rpx; }
.cs-sev-itch {
  position: absolute;
  right: -8rpx;
  top: -16rpx;
  padding: 0 8rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 999rpx;
  background: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  color: var(--faint);
}
.cs-sev-itch--on { border-color: var(--accent); color: var(--accent); font-weight: 600; }

/* 导航栏右侧操作（图例 / 我的申请）：走 subpage-nav-bar 的命名插槽，
   替代原来独占一行的顶部操作栏（模式切换已交给左下角模式岛、扫码入口右下角 FAB 已有） */
.nav-right-acts {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 我的转移单：三签进度条（.sg-* 槽位样式在 app.wxss，跟审核页共用一套） */
.mc-sign {
  margin: 8rpx 0 0;
}

/* 收藏入口按钮的定义在列表头部那一段（与「展开全部」合并成一条共用规则）；
   这里只留收藏弹层自己的样式。 */
.fav-star { flex-shrink: 0; display: inline-flex; align-items: center; padding: 4rpx 6rpx; margin-left: 4rpx; }
.fav-star--sm { padding: 2rpx 4rpx; margin-left: 2rpx; }

/* 弹层：白卡 + 浅底 + 本页令牌 */
.fav-sheet { border-radius: 20rpx 20rpx 0 0; overflow: hidden; background: #fff; }
.fav-sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
.fav-sheet-title { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.fav-sheet-x { font-size: 30rpx; color: var(--faint); padding: 0 8rpx; }
.fav-sheet-body { max-height: 60vh; padding: 20rpx 24rpx 32rpx; box-sizing: border-box; background: var(--fill); }
.fav-empty { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 80rpx 0; }
.fav-empty-t { font-size: 26rpx; color: var(--mute); }
.fav-empty-s { font-size: 22rpx; color: var(--faint); }
.fav-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 1rpx solid var(--line);
}
.fav-item--hover { background: var(--fill-2); }
.fav-item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  max-width: 42%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.fav-item-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--mute);
  background: var(--fill-2);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.fav-item-sub {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--faint);
  max-width: 34%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 行尾箭头：贴右，提示「这一条可以点开/可以进」 */
.fav-item-chev {
  flex-shrink: 0;
  margin-left: 4rpx;
}

/* 房间条目 = 一张卡：房间头 + 展开的笼架胶囊住在同一张卡里。
   展开的笼架**横排换行**，不是一架一行 —— 它只是分类下的一个小入口，
   铺成一行一架会把整个弹层占满。 */
.fav-room-card {
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  overflow: hidden;
}
.fav-room-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
}
.fav-room-head--hover { background: var(--fill-2); }

/* 房间下展开的笼架：**定宽 4 列网格**，一格一个。
   为什么不是自适应胶囊：内容宽度不等会让每行尾巴参差（第一行 5 个、第二行 3 个），看着乱；
   而且挤成一排的小胶囊点不准。格子高度按 44px 可点标准来（与列表页那两枚工具按钮同档）。
   字号在 4 列下放得下 6 个字（201A-1 这种），更长的名字走省略号。 */
.fav-subs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  padding: 0 20rpx 20rpx;
}
.fav-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: var(--fill-2);
}
.fav-chip-t {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--body);
}
.fav-chip--hover { background: var(--off-bg); }
.fav-sub-empty {
  grid-column: 1 / -1;
  font-size: 22rpx;
  color: var(--faint);
}

/* ═══ 批量转移缓冲抽屉 ═══════════════════════════════════════════
   壳与令牌整段抄自 animalOrder/index.wxss（那边是订购选购抽屉），
   改一边必须同步另一边，别自己发明配色。 */

/* Sheet 通用 */
.sheet {
  display: flex;
  flex-direction: column;
  max-height: 94vh;
}
.sheet-head {
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #eef0f4;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}
/* 标题下方的次要说明 */
.sheet-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
.sheet-scroll {
  /* flex:1 + min-height:0：固定住页脚，列表再长也在区域内滚；
     只用 max-height 的话内容一多会把底部按钮顶出弹层 */
  flex: 1;
  min-height: 0;
  padding: 8rpx 32rpx;
  box-sizing: border-box;
}

.cage-clear {
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f1f3f7;
  color: #334155;
  font-size: 22rpx;
  line-height: 48rpx;
}

.cage-error {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #dc2626;
}

.cage-loading {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

/* 动作按钮（下一步 / 返回选源 / 提交） */
.cage-acts {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cage-act {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
}

.cage-act--ghost {
  background: #f1f3f7;
  color: #334155;
}

.cage-act--primary {
  background: #2563eb;
  color: #fff;
}

.cage-act--off {
  background: #e5e7eb;
  color: #9aa0a6;
}

/* ── 批量转移缓冲抽屉专属 ─────────────────────────────────────── */
.bt-sheet { max-height: 94vh; }

/* 动作行：右对齐（树与网格两屏共用） */
.bt-acts-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 10rpx;
}

/* 树状列表：校区（可折叠）→ 房间（可折叠）→ 架行 */
.bt-tree {
  display: flex;
  flex-direction: column;
}
.bt-campus { margin-bottom: 4rpx; }
.bt-campus-hd {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #f1f3f7;
}
.bt-campus-name {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  font-weight: 600;
  color: #1f2937;
}
.bt-room { padding-left: 12rpx; }
.bt-room-hd {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 12rpx;
}
.bt-room-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #334155;
}
.bt-shelf-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  margin-left: 28rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #fff;
}
.bt-shelf-row-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #334155;
}
.bt-shelf-row-count {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #2563eb;
}

/* 屏 B · 单架网格顶栏 */
.bt-grid-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.bt-grid-back {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  height: 52rpx;
  padding: 0 10rpx;
  font-size: 24rpx;
  color: #334155;
}
.bt-grid-titles {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.bt-grid-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}
.bt-grid-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #94a3b8;
}

.bt-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

/* 目标阶段：当前源的进度条 */
.bt-progress {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #e8f0ff;
}
.bt-progress-txt {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: #2563eb;
}

/* 阶段提示：一句「下一步该做什么」，贴在标题下面。
   与 .bt-progress 同一套（浅主色底 + 主色字），只是不占单独一块区域。 */
.bt-hint {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #e8f0ff;
}
.bt-hint-txt {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #2563eb;
}

/* 底部缓冲/配对条：常驻在网格下方，不参与滚动 */
.bt-buffer {
  flex-shrink: 0;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eef0f4;
}
.bt-buffer-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.bt-buffer-title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
}
.bt-pairs { white-space: nowrap; }
.bt-pairs-inner {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

/* 配对 chip：未配 = 浅底中性；已配 = 弱主色底；当前光标 = 主色实底 */
.bt-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f1f3f7;
  color: #334155;
  font-size: 22rpx;
}
.bt-chip--ok {
  background: #e8f0ff;
  color: #2563eb;
}
.bt-chip--on {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.28);
}
.bt-chip-txt { font-variant-numeric: tabular-nums; }
