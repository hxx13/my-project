  border-color: var(--accent);
}
/* 行/列交叉定位 */
.gcell-cross {
  /* 同行/同列：明显蓝框 + 淡蓝底色（主色，与高亮文字同源） */
  box-shadow: inset 0 0 0 4rpx rgba(37,99,235,0.35), 0 0 8rpx rgba(37,99,235,0.12);
  background-image: linear-gradient(rgba(37,99,235,0.12), rgba(37,99,235,0.12));
}
.gcell-hit {
  transform: scale(1.08);
  z-index: 10;
  box-shadow: 0 0 28rpx rgba(37,99,235,0.55);
  border-color: var(--accent) !important;
  border-width: 6rpx !important;
}
.gcell-hit--cached {
  box-shadow: 0 0 20rpx rgba(217,119,6,0.45);
  border-color: #d97706 !important;
}
.gcell-cached {
  border-width: 3rpx !important;
}

/* ================================================================== */
/*  扫码定位 FAB（右下悬浮圆形按钮，常驻）                                    */
/* ================================================================== */

.scan-float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
