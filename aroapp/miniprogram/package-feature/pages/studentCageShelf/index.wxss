}
.grid-actions-meta {
  font-size: 22rpx;
  color: #94a3b8;
  flex: 1;
}
.grid-actions-btns {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
/* ── 扫码模式 ── */
