}
.scan-result-label {
  font-size: 24rpx;
  color: #969799;
}
.scan-result-pos {
  font-size: 26rpx;
  font-weight: 700;
  color: #ac1736;
}
.scan-result-code {
  font-size: 22rpx;
  color: #646566;
