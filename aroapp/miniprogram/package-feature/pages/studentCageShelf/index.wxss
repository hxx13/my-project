/* ================================================================== */
/*  预约 / 我的申请 弹窗                                                 */
/* ================================================================== */
.booking-root,
.my-claims-root {
  display: flex;
  flex-direction: column;
  height: 100%;
  /* 左右留边：这两个弹窗（我的申请 / 我的转移单）的 custom-style **没有** padding，
     只靠 .cf-root 那 4rpx —— 卡片基本贴着圆角边，看着像要溢出去。
     box-sizing 必须给：height:100% 再加内边距不 border-box 会直接把弹窗撑破。
     只改这一个容器类，不动 .cf-root —— 确认/分配等弹窗在 custom-style 里各自给了
     24rpx，动共用的那个会变成双重内边距。 */
  box-sizing: border-box;
  padding-left: 20rpx;
  padding-right: 20rpx;
}
/* 我的申请弹窗复用（记录弹窗已改用 .cs-body） */
