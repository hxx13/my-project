  background: #ac1736;
  border-color: #ac1736;
}
/* 行/列交叉定位 */
.gcell-cross {
  /* 同行/同列：明显红框+淡红底色 */
  box-shadow: inset 0 0 0 4rpx rgba(172,23,54,0.35), 0 0 8rpx rgba(172,23,54,0.12);
  background-image: linear-gradient(rgba(172,23,54,0.12), rgba(172,23,54,0.12));
}
.gcell-hit {
  transform: scale(1.08);
  z-index: 10;
  box-shadow: 0 0 28rpx rgba(172,23,54,0.55);
  border-color: #ac1736 !important;
  border-width: 6rpx !important;
}
.gcell-hit--cached {
  box-shadow: 0 0 20rpx rgba(217,119,6,0.45);
  border-color: #d97706 !important;
}
.gcell-cached {
  border-width: 3rpx !important;
}

/* ================================================================== */
/*  扫码定位 FAB（右下悬浮圆形按钮，常驻）                                    */
/* ================================================================== */

.scan-float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #ac1736;
  box-shadow: 0 8rpx 24rpx rgba(172, 23, 54, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 950;
}

.scan-float-btn:active {
  transform: scale(0.92);
  opacity: 0.85;
}

@keyframes scan-flash {
  0% { opacity: 0.2; transform: scale(0.95); }
  30% { opacity: 0.85; transform: scale(1.03); }
  100% { opacity: 0.35; transform: scale(1); }
}

.scan-flash-overlay {
  position: absolute;
  inset: 0;
  z-index: 10;
  border-radius: 8rpx;
  border: 4rpx solid rgba(239, 68, 68, 0.8);
  box-shadow: 0 0 16rpx rgba(239, 68, 68, 0.5);
  animation: scan-flash 0.5s ease-in-out 2;
  pointer-events: none;
}

/* ================================================================== */
/*  扫码确认核对弹窗                                                    */
/* ================================================================== */

