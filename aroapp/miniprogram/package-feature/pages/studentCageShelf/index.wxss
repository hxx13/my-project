/* ================================================================== */
/*  设计令牌 —— 整套搬自「实验动物订购」页（animalOrder）。                 */
/*                                                                      */
/*  ⚠️ 为什么要挂这么一串选择器，而不是只挂 page：                          */
/*  van-popup 带 root-portal 时会把节点挂到**页面根之下、page 元素之外**，   */
/*  继承不到 page 上的自定义属性 —— 弹窗里所有 var(--x) 会静默失效，       */
/*  表现是「背景全白、边框全无、文字退成继承色」。                          */
/*  所以页面内容靠 page，每个 root-portal 弹层再在**自己的根**上声明一次。   */
/*  新增 root-portal 弹窗时，把它的根类补进这一串。                        */
/*                                                                      */
/*  本页的 root-portal 根一共四类：.cs-sheet（查看/状态/记录三弹窗）、       */
/*  .cf-root（确认/分配/人员/选择/归档/我的申请/转移单）、.fav-sheet（收藏）。 */
/* ================================================================== */
page,
.cs-sheet,
.cf-root,
.fav-sheet {
  --paper: #ffffff;      /* 白纸 */
  --canvas: #eef0f6;     /* 页面底 */
  --ink: #1f2937;
  --body: #334155;
  --mute: #64748b;
  --faint: #94a3b8;
  --off: #9aa0a6;        /* 禁用 / 占位文字 */
  --off-bg: #e5e7eb;     /* 禁用底（.ord-btn-off） */
  --line: #eef0f4;       /* hairline：分隔线，几乎看不见 */
  --line-strong: #dcdee0; /* 可见描边：输入框 / 胶囊 / 开关的边，要看得出来 */
  --line2: #f1f3f7;
  --accent: #2563eb;     /* 唯一主色 */
  --accent-bg: #eff6ff;
  --fill: #f6f7fb;       /* 浅底卡 / 输入框 */
  --fill-2: #f1f3f7;     /* 次级按钮实底 */
  --danger: #dc2626;
  --ok: #15803d;
}

/* ================================================================== */
/*  Page Base                                                           */
/* ================================================================== */

.page {
  position: relative;
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--canvas);
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}

.grid-page {
  overflow: hidden;
  /* ponytail: 覆盖层而非隐藏列表——列表 scroll-view 常驻可视，返回时滚动位置原生保留 */
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

/* ================================================================== */
/*  Shared States                                                       */
/* ================================================================== */

.center-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  gap: 16rpx;
}

.loading-text {
  font-size: 24rpx;
  color: var(--faint);
}

.error-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  padding: 0 48rpx;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--off);
  background: var(--fill-2);
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 26rpx;
  color: var(--faint);
  text-align: center;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.retry-btn {
  font-size: 26rpx;
  color: #fff;
  padding: 16rpx 56rpx;
  background: var(--accent);
  border-radius: 999rpx;
  font-weight: 500;
}

.back-link {
  font-size: 24rpx;
  color: var(--accent);
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
}

.empty-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}

.empty-icon {
  font-size: 72rpx;
  color: var(--off);
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--faint);
  margin-bottom: 24rpx;
}

/* ================================================================== */
/*  List View                                                           */
/* ================================================================== */

.list-root {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

/* Sticky header */
.list-sticky-header {
  flex-shrink: 0;
  padding: 10rpx 24rpx 8rpx;
  background: var(--canvas);
  z-index: 10;
}

.list-count-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;   /* 计数与扫描时间读成一句，别一个贴左一个贴右 */
  margin-bottom: 16rpx;
}

.list-count-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--mute);
}

.list-scanned-at {
  font-size: 20rpx;
  color: var(--faint);
  margin-left: 12rpx;
}

.list-filtered-hint {
  font-size: 22rpx;
  color: var(--faint);
}

.list-refresh-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.92);
  border: 1rpx solid rgba(30,55,90,0.08);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}

/* Search bar */
.list-search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.list-search-bar {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;          /* 44px：42px 略低于可点标准，且它旁边就是易误触的「展开全部」 */
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 20rpx;
  border: 1rpx solid rgba(30,55,90,0.08);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}

.list-search-icon {
  flex-shrink: 0;
}

.list-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
  background: transparent;
}

.list-search-placeholder {
  color: var(--faint);
  font-size: 26rpx;
}

/* Room filter picker */
.list-filter-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 20rpx;
  border: 1rpx solid rgba(30,55,90,0.08);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
  margin-bottom: 12rpx;
  box-sizing: border-box;
  max-width: 100%;
  overflow: hidden;
}

.list-filter-picker-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 占比条图例（列表首行，随内容滚走，不占吸顶空间） */
.list-ratio-legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
  padding: 10rpx 0 14rpx;
}

.lrl-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.lrl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.lrl-text {
  font-size: 22rpx;
  /* #94a3b8 在 #f6f7fb 上只有 ~2.8:1，小字不达标；压到 --body 那档约 5:1 */
  color: var(--body);
}

/* 列表首行曾放过一枚「我的申请」大胶囊，撤掉后入口挪进吸顶搜索行（.list-collapse-all-btn /
   .list-fav-btn 那一串）。相关 .list-actions-row / .list-actions-pill 样式已删，不留死代码。 */

/* 校区全收起时下方一大片空白的引导 */
.list-collapsed-hint {
  padding: 48rpx 0 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--faint);
}

/* 搜索框右边那两枚工具按钮：与搜索框同族的**白卡**（同圆角、同描边、同投影），
   就像订购页里 .breadcrumb 那种摆在 var(--canvas) 页底上的白卡。
   一个都不能省：
   - 不能用次级底 --fill-2：它压在页底 --canvas 上几乎同色，按钮会「消失」成一片灰字。
   - 不能用半透明、不能只描边（按钮身份靠实底，不靠线）。
   - 高度与搜索框齐平 88rpx = 44px：它俩紧贴搜索框，矮了容易误触输入框。

   原先这两枚是两组人做的：一枚是 999rpx 胶囊，另一枚是 12rpx 圆角矩形还带一颗琥珀星 —— 形状和色值两样都对不上。 */
.list-collapse-all-btn,
.list-fav-btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  /* 高度**必须**与搜索框齐平 88rpx：它俩紧贴输入框，矮了容易误触（见上一条注释）。
     三个胶囊并排会挤，挤的是**宽度**不是高度 —— 所以只压横向：
     内边距 24→14rpx、gap 6→4rpx、字号 24→22rpx、圆角 20→16rpx，
     再配合把「展开全部/收起全部」缩成「展开/收起」。 */
  min-height: 88rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 1rpx solid rgba(30, 55, 90, 0.08);
  background: var(--paper);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--body);
  white-space: nowrap;
}

/* 收藏有内容：底色不动，只把星标与数字换成主色。
   整枚填蓝太重 —— 它表达的是「有内容」，不是「已选中」。 */
.list-fav-btn--on {
  color: var(--accent);
}
.list-search-input {
  flex: 1;
  min-width: 0;
}

/* Scroll area */
.list-scroll-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
  display: flex;
  flex-direction: column;
}

/* 列表区：固定高度的**面板**（无投影）。
   三级明度做立体：页面 var(--canvas) → 面板 var(--fill) → 卡片 #fff。
   面板若也用纯白，白卡就沉进白底里，立体感全没了。 */
.list-scroll {
  flex: 1;
  min-height: 0;
  margin: 0 12rpx 12rpx;
  padding: 8rpx 16rpx 0;
  box-sizing: border-box;
  background: var(--fill);
  border-radius: 18rpx;
}

/* 下拉刷新改用 scroll-view 原生 refresher：指示器由列表自己画在列表顶部（会把内容推下去），
   原来那套自绘 refresh-pill 是页面级下拉的补丁 —— 绝对定位盖在列表首行上，已删。 */

.list-pad-bottom {
  height: 64rpx;
}

/* No match */
.no-match-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.no-match-text {
  font-size: 26rpx;
  color: var(--faint);
  margin-bottom: 24rpx;
}

.clear-filter-btn {
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 500;
  padding: 12rpx 40rpx;
}

/* Campus group — 最外层容器 */
/* 校区组 = 面板里唯一的**卡片层**：白底 + 圆角 + 投影（立体感靠投影和明度差，不靠灰底）。
   再往里（房间行 / 笼架组）一律扁平 —— 卡片嵌套卡片是明确的坏味道。 */
.campus-group {
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
  overflow: hidden;
}

.campus-group-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;          /* 44px：原来是 34px，而这行是展开校区的唯一入口 */
  box-sizing: border-box;
  padding: 14rpx 24rpx;
  background: #fff;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.campus-group-body {
  padding: 4rpx 16rpx 12rpx;
}

.cgh-arrow {
  margin-right: 4rpx;
  display: flex;
  align-items: center;
}

.cgh-count {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--faint);
}

/* Room group */
.room-group {
  margin-bottom: 8rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

/* Room group accordion header — 一级：最突出 */
.room-group-header {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  width: 100%;
  max-width: 100%;
  padding: 14rpx 20rpx 12rpx;
  background: #fff;
  /* 白面板里不再描边+投影：那两层叠起来就是「灰块 + 脏阴影」的来源，靠分隔线分层 */
  border-bottom: 1rpx solid var(--fill-2);
  box-sizing: border-box;
  overflow: hidden;
}

.room-group-header--hl {
  background: rgba(37,99,235, 0.04);
  border-color: rgba(37,99,235, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(37,99,235, 0.06);
}

/* Arrow wrapper — native view keeps van-icon aligned */
.rgh-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 12rpx;
}

/* Room name — shrink to content, truncate if needed */
.rgh-name {
  flex-shrink: 0;
  max-width: 50%;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rgh-name--hl {
  color: var(--accent);
}

/* Shelf count badge */
.rgh-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.rgh-main {
  flex: 1;
  min-width: 0;
}

.rgh-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rgh-metrics {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.rgh-stats {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.rs-stat {
  font-size: 20rpx;
  font-weight: 600;
}

.rs-sep {
  font-size: 18rpx;
  color: var(--off);
}

.rgh-bar-wrap {
  width: 90%;
}

.rgh-bar {
  display: flex;
  height: 10rpx;
  border-radius: 5rpx;
  overflow: hidden;
  background: var(--fill-2);
}

.rgh-bar-seg {
  min-width: 4rpx;
  height: 100%;
}

.shelf-card-bar-wrap {
  width: 80%;
}

.shelf-card-bar {
  display: flex;
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: var(--fill-2);
  width: 100%;
}

.shelf-bar-seg {
  min-width: 4rpx;
  height: 100%;
}

.bar-legend-tag {
  font-size: 18rpx;
  color: var(--faint);
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.bar-legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ---- 第二层：笼架组（左缩进，左侧 accent 色条） ---- */
.room-shelf-body {
  padding: 4rpx 0 4rpx 8rpx;
}

.shelf-group {
  margin-bottom: 6rpx;
  margin-left: 8rpx;
  /* 第三层：只用一条 1rpx 竖线 + 缩进表示层级，不再灰底 + 6rpx 粗竖条
     （粗色条是明确的坏味道，灰底在白面板上又会读成阴影） */
  border-left: 1rpx solid var(--canvas);
  overflow: hidden;
}

.shelf-group--hl {
  border-left-color: var(--accent);
  background: rgba(37,99,235, 0.03);
}

.shelf-group-hd {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
}

.shelf-group-hd:active {
  background: var(--fill-2);
}

.sgh-arrow {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sgh-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  flex-shrink: 0;
}

.sgh-name--hl {
  color: var(--accent);
}

.sgh-metrics {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3rpx;
  flex: 1;
  min-width: 0;
}

.sgh-stats {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.ss-stat {
  font-size: 20rpx;
  font-weight: 600;
}

.ss-sep {
  font-size: 18rpx;
  color: var(--off);
}

.sgh-bar-wrap {
  width: 70%;
}

.sgh-bar {
  display: flex;
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: var(--line);
}

.sgh-bar-seg {
  min-width: 4rpx;
  height: 100%;
}

.sgh-count {
  font-size: 20rpx;
  color: var(--faint);
  flex-shrink: 0;
}

/* Shelf cards grid (2 columns) — 第三层：最内层卡片 */
.room-shelf-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 8rpx 6rpx 8rpx;
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.shelf-card {
  display: flex;
  flex-direction: column;
  flex: 0 0 calc(50% - 4rpx);
  width: calc(50% - 4rpx);
  padding: 16rpx 14rpx 14rpx;
  border-radius: 8rpx;
  background: #fff;
  border: 1rpx solid var(--canvas);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06), 0 1rpx 2rpx rgba(0,0,0,0.04);
  box-sizing: border-box;
  position: relative;
}

.shelf-card:active {
  background: var(--fill);
}

.shelf-card-highlight {
  background: #fff5f5;
  border-color: #f4b8b8;
}

.shelf-card-icon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
}

.shelf-card-icon-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--line-strong);
}

.shelf-card-highlight .shelf-card-icon-dot {
  background: var(--accent);
}

.shelf-card-head {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.shelf-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}

.shelf-card-metrics {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3rpx;
  flex: 1;
  min-width: 0;
}

.shelf-card-stats {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.sc-stat {
  font-size: 20rpx;
  font-weight: 600;
}

.sc-sep {
  font-size: 18rpx;
  color: var(--off);
}

.shelf-card-highlight .shelf-card-name {
  color: var(--accent);
}

/* ================================================================== */
/*  Grid Scroll & Legend                                                */
/* ================================================================== */

.grid-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 16rpx 12rpx 0;
  overflow-x: hidden;
}

.grid-legend-card {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 14rpx 16rpx 16rpx;
  margin-bottom: 16rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 16rpx;
  border: 1rpx solid rgba(30,55,90,0.06);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}

.legend-section-title {
  display: block;
  max-width: 100%;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--mute);
  line-height: 1.4;
  word-break: break-all;
}

.legend-section-title--spaced {
  margin-top: 18rpx;
}

.grid-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  margin-top: 10rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  min-width: 0;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.legend-cage-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.18);
  border: 2rpx solid rgba(255,255,255,0.65);
  box-sizing: border-box;
}

.legend-cage-dot text {
  font-size: 16rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.legend-cage-dot--wait {
  background: #f59e0b;
}

.legend-cage-dot--empty {
  background: #10b981;
}

.legend-cage-dot--abnormal {
  background: #3b82f6;
}

.legend-cage-dot--feeding {
  background: #f43f5e;
}

.legend-label {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--mute);
  line-height: 1.35;
  word-break: break-all;
}

.legend-label--mute {
  color: var(--faint);
}

/* ================================================================== */
/*  Grid Wrapper & Container (8 columns)                                */
/* ================================================================== */

.grid-wrapper {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255,255,255,0.85);
  border-radius: 20rpx;
  border: 1rpx solid rgba(30,55,90,0.06);
  box-shadow: 0 2px 8px rgba(15,23,42,0.04);
  padding: 8rpx;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 4rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* ================================================================== */
/*  Grid Cell (72rpx target)                                            */
/* ================================================================== */

.grid-cell {
  position: relative;
  aspect-ratio: 1;
  min-width: 0;
  max-width: 100%;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
}

.gcell-pos {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
  max-width: 100%;
  padding: 0 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.gcell-empty .gcell-pos { color: var(--faint); }
.gcell-hidden .gcell-pos { color: var(--ink); }

.gcell-filled:active {
  transform: scale(0.94);
}

.gcell-pi {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 92%;
  margin-top: 2rpx;
}

.gcell-exp {
  font-size: 18rpx;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 92%;
  margin-top: 2rpx;
}

.gcell-empty-text {
  font-size: 24rpx;
  color: var(--faint);
  margin-top: 2rpx;
}

.gcell-hidden-text {
  font-size: 24rpx;
  color: var(--faint);
  font-weight: 600;
  margin-top: 2rpx;
}

.gcell-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.18);
  border: 1rpx solid rgba(255,255,255,0.65);
  box-sizing: border-box;
  z-index: 1;
}

.gcell-dot text {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

/* 特殊饲养明细角标（+食 / −水）—— 贴右上角，与类型指示灯同角：明细强绑定特殊饲养，
   该格必是「饲养中」，而 type 3 不点灯，两者不会同时出现。
   字号比认领徽标（16rpx）再小一档、只贴右边，给居中的位号（26rpx）让位。 */
.gcell-sf {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  z-index: 2;
}

.gcell-sf-pill {
  margin-bottom: 2rpx;
  padding: 0 4rpx;
  border-radius: 4rpx;
  font-size: 14rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.5;
  white-space: nowrap;
}

.grid-pad-bottom {
  height: 48rpx;
}

