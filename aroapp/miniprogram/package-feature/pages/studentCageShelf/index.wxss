/* ================================================================== */
/*  认领徽标（未到位/待审批/待释放，对齐 H5 CellButton 左上角）            */
/* ================================================================== */
.gcell-badge {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  z-index: 2;
  padding: 0 6rpx;
  font-size: 16rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 4rpx;
  line-height: 1.5;
}
.gcell-badge--locked { background: #f59e0b; }
.gcell-badge--pending { background: #3b82f6; }
.gcell-badge--release { background: #f97316; }

/* 选中态（分配/认领/学生申请） */
.gcell-selected {
  box-shadow: inset 0 0 0 4rpx #3b82f6, 0 0 8rpx rgba(59, 130, 246, 0.35);
  border-color: #3b82f6 !important;
  border-width: 4rpx !important;
}
/* 学生申请池内可申请笼位 */
.gcell-inpool {
  box-shadow: inset 0 0 0 3rpx #34d399, 0 0 8rpx rgba(52, 211, 153, 0.35);
}
/* 学生确认模式：本人待确认到位(locked)的笼位，琥珀描边高亮（与「未到位」徽标同色系） */
.gcell-myclaim {
  box-shadow: inset 0 0 0 3rpx #fbbf24, 0 0 8rpx rgba(251, 191, 36, 0.45);
  border-color: #fbbf24 !important;
  border-width: 3rpx !important;
}

