/* ================================================================== */
/*  Page Base                                                           */
/* ================================================================== */

.page {
  position: relative;
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  background: #eef0f6;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}

.grid-page {
  overflow: hidden;
}

/* ================================================================== */
/*  Shared States                                                       */
/* ================================================================== */

.center-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  gap: 16rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #969799;
}

.error-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  padding: 0 48rpx;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #c8c9cc;
  background: #f2f3f5;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 26rpx;
  color: #969799;
  text-align: center;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.retry-btn {
  font-size: 26rpx;
  color: #fff;
  padding: 16rpx 56rpx;
  background: linear-gradient(135deg, #ac1736, #8B1229);
  border-radius: 999rpx;
  font-weight: 500;
}

.back-link {
  font-size: 24rpx;
  color: #ac1736;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
}

.empty-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}

.empty-icon {
  font-size: 72rpx;
  color: #c8c9cc;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #969799;
  margin-bottom: 24rpx;
}

/* ================================================================== */
/*  List View                                                           */
/* ================================================================== */

.list-root {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

/* Sticky header — simplified: only search bar row */
.list-sticky-header {
  flex-shrink: 0;
  padding: 16rpx 24rpx 12rpx;
  background: #eef0f6;
  z-index: 10;
}

/* Search bar — now contains: search icon | input | special status btn | collapse btn */
.list-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 20rpx;
  border: 1rpx solid rgba(30,55,90,0.08);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}

.list-search-icon {
  flex-shrink: 0;
}

.list-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #323233;
  background: transparent;
}

.list-search-placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}

/* Special status button (now inside search bar) */
.list-special-status-btn {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #ac1736;
}

/* Collapse/expand all button (search bar right) */
.list-collapse-all-btn {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #646566;
  background: #f2f3f5;
}

/* ====== Special Status Popup (tight, no wasted horizontal space) ====== */
.sp-popup {
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.sp-hd {
  padding: 20rpx 24rpx 12rpx;
  border-bottom: 1rpx solid #f0f1f2;
  flex-shrink: 0;
  box-sizing: border-box;
}

.sp-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.sp-meta-row {
  margin-top: 4rpx;
}

.sp-meta {
  font-size: 20rpx;
  color: #969799;
}

/* scroll body */
.sp-body {
  flex: 1;
  min-height: 0;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

.sp-pad { height: 16rpx; }

.sp-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #969799;
}

.sp-err { color: #dc2626; }

/* ---- card ---- */
.sp-card {
  margin-bottom: 12rpx;
  border-radius: 10rpx;
  border: 1rpx solid #ebedf0;
  background: #fff;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

.sp-card-hd {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 16rpx;
  background: #fafafa;
  width: 100%;
  box-sizing: border-box;
}

.sp-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid;
  flex-shrink: 0;
}

.sp-card-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sp-card-badge {
  flex-shrink: 0;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 18rpx;
  font-weight: 700;
  color: #ac1736;
  background: rgba(172, 23, 54, 0.08);
  border-radius: 50%;
}

.sp-card-arrow {
  font-size: 18rpx;
  color: #969799;
  flex-shrink: 0;
}

.sp-card-body {
  border-top: 1rpx solid #f0f1f2;
  width: 100%;
  box-sizing: border-box;
}

/* ---- dimension tabs ---- */
.sp-dim-tabs {
  display: flex;
  gap: 0;
  padding: 4rpx 10rpx;
  background: #f7f8fa;
  border-bottom: 1rpx solid #ebedf0;
}

.sp-dim-tab {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  font-size: 22rpx;
  font-weight: 500;
  color: #969799;
  border-radius: 6rpx;
}

.sp-dim-tab--on {
  color: #ac1736;
  font-weight: 600;
  background: #fff;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
}

/* ---- sub-group cards ---- */
.sp-sub-list {
  padding: 4rpx 6rpx;
  width: 100%;
  box-sizing: border-box;
}

.sp-sub-card {
  margin-bottom: 6rpx;
  border-radius: 8rpx;
  border: 1rpx solid #f0f1f2;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

.sp-sub-hd {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 10rpx;
  background: #fafafa;
  width: 100%;
  box-sizing: border-box;
}

.sp-sub-arrow {
  font-size: 16rpx;
  color: #969799;
  flex-shrink: 0;
  width: 20rpx;
  text-align: center;
}

.sp-sub-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sp-sub-count {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #969799;
  background: #f2f3f5;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}

.sp-sub-body {
  padding: 2rpx 8rpx 6rpx;
  width: 100%;
  box-sizing: border-box;
}

/* ---- cage row (tight single line) ---- */
.sp-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 2rpx;
  border-bottom: 1rpx solid #f7f8fa;
  width: 100%;
  box-sizing: border-box;
}

.sp-row:last-child { border-bottom: none; }

.sp-row-pos {
  font-size: 22rpx;
  font-weight: 700;
  color: #323233;
  font-family: monospace;
  flex-shrink: 0;
  width: 54rpx;
}

.sp-row-pi {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #475569;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sp-row-room {
  font-size: 18rpx;
  color: #94a3b8;
  flex-shrink: 0;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sp-row-dept {
  font-size: 18rpx;
  color: #94a3b8;
  flex-shrink: 0;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Scroll area */
.list-scroll {
  flex: 1;
  min-height: 0;
  padding: 8rpx 24rpx 0;
  box-sizing: border-box;
}

.list-pad-bottom {
  height: 64rpx;
}

/* No match */
.no-match-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.no-match-text {
  font-size: 26rpx;
  color: #969799;
  margin-bottom: 24rpx;
}

.clear-filter-btn {
  font-size: 26rpx;
  color: #ac1736;
  font-weight: 500;
  padding: 12rpx 40rpx;
}

/* Campus group */
.campus-group {
  margin-bottom: 16rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.campus-group-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  max-width: 100%;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(15,23,42,0.08);
}

.cgh-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.cgh-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cgh-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.18);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

.campus-rooms {
  padding-left: 8rpx;
  padding-top: 8rpx;
}

/* Room group */
.room-group {
  margin-bottom: 12rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.room-group-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  max-width: 100%;
  padding: 24rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.75);
  border: 1rpx solid rgba(30,55,90,0.06);
  box-sizing: border-box;
  overflow: hidden;
}

.room-group-header--hl {
  background: rgba(172, 23, 54, 0.06);
  border-color: rgba(172, 23, 54, 0.22);
}

.rgh-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.rgh-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rgh-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rgh-name--hl {
  color: #ac1736;
}

.rgh-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #969799;
}

/* ====== Indicator-style progress bar strips ====== */

/* Room header — thin color strip at top */
.room-group-header {
  position: relative;
  overflow: hidden;
}

.room-bar-strip {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  height: 6rpx;
}

.room-bar-seg {
  height: 100%;
  min-width: 4rpx;
}

/* Shelf card — thin color strip at top */
.shelf-bar-strip {
  display: flex;
  height: 6rpx;
  border-radius: 3rpx 3rpx 0 0;
  overflow: hidden;
  margin: -16rpx -16rpx 10rpx -16rpx;
}

.shelf-bar-seg {
  height: 100%;
  min-width: 4rpx;
}

/* Legend with dot indicators */
.shelf-bar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 2rpx 10rpx;
  margin-top: 6rpx;
}

.shelf-bar-legend-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 18rpx;
  color: #64748b;
}

.shelf-bar-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.15);
  border: 1rpx solid rgba(255,255,255,0.6);
  flex-shrink: 0;
}

.room-shelf-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0 4rpx;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.shelf-card {
  display: flex;
  flex-direction: column;
  flex: 0 0 calc(50% - 6rpx);
  width: calc(50% - 6rpx);
  padding: 16rpx 16rpx 14rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #eef0f6;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.shelf-card-highlight {
  background: #fff5f5;
  border-color: #f4b8b8;
}

.shelf-card-icon {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 12rpx;
  height: 12rpx;
}

.shelf-card-icon-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #cbd5e1;
}

.shelf-card-highlight .shelf-card-icon-dot {
  background: #ac1736;
}

.shelf-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 20rpx;
}

.shelf-card-highlight .shelf-card-name {
  color: #ac1736;
}

.shelf-card-campus {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shelf-card-highlight-badge {
  margin-top: 8rpx;
  align-self: flex-start;
  padding: 2rpx 12rpx;
  background: rgba(172, 23, 54, 0.1);
  border-radius: 6rpx;
}

.shelf-card-highlight-badge text {
  font-size: 20rpx;
  color: #ac1736;
  font-weight: 600;
}

/* Grid top bar */
.grid-topbar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  overflow: hidden;
}

.gt-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
}

.gt-back:active {
  background: #f5f5f5;
}

.gt-info {
  flex: 1;
  min-width: 0;
  padding: 0 8rpx;
}

.gt-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 44rpx;
}

.gt-meta {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ================================================================== */
/*  Grid Scroll & Legend                                                */
/* ================================================================== */

.grid-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 16rpx 12rpx 0;
  overflow-x: hidden;
}

.grid-legend-card {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 14rpx 16rpx 16rpx;
  margin-bottom: 16rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 16rpx;
  border: 1rpx solid rgba(30,55,90,0.06);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}

.legend-section-title {
  display: block;
  max-width: 100%;
  font-size: 22rpx;
  font-weight: 600;
  color: #646566;
  line-height: 1.4;
  word-break: break-all;
}

.legend-section-title--spaced {
  margin-top: 18rpx;
}

.grid-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  margin-top: 10rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  min-width: 0;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.legend-cage-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.18);
  border: 2rpx solid rgba(255,255,255,0.65);
  box-sizing: border-box;
}

.legend-cage-dot text {
  font-size: 16rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.legend-cage-dot--wait { background: #f59e0b; }
.legend-cage-dot--empty { background: #f43f5e; }
.legend-cage-dot--abnormal { background: #3b82f6; }
.legend-cage-dot--feeding {
  background: rgba(167, 243, 208, 0.45);
  border: 2rpx dashed #34d399;
  box-shadow: none;
}

.legend-label {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #646566;
  line-height: 1.35;
  word-break: break-all;
}

.legend-label--mute {
  color: #969799;
}

/* ================================================================== */
/*  Grid Wrapper & Container (8 columns)                                */
/* ================================================================== */

.grid-wrapper {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255,255,255,0.85);
  border-radius: 20rpx;
  border: 1rpx solid rgba(30,55,90,0.06);
  box-shadow: 0 2px 8px rgba(15,23,42,0.04);
  padding: 8rpx;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 4rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* ================================================================== */
/*  Grid Cell — enhanced content (aligns with Web CellButton)           */
/* ================================================================== */

.grid-cell {
  position: relative;
  aspect-ratio: 1;
  min-width: 0;
  max-width: 100%;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
}

.gcell-pos {
  font-size: 14rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.1;
  max-width: 100%;
  padding: 0 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.gcell-empty .gcell-pos { color: #94a3b8; }
.gcell-hidden .gcell-pos { color: #92400e; }

.gcell-filled:active {
  transform: scale(0.94);
}

/* Project group name */
.gcell-group {
  font-size: 12rpx;
  font-weight: 500;
  color: #475569;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 92%;
  margin-top: 1rpx;
}

/* PI name */
.gcell-pi {
  font-size: 13rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 92%;
  margin-top: 1rpx;
}

/* Cage type label (e.g. "等待分配") */
.gcell-type-label {
  font-size: 10rpx;
  font-weight: 400;
  color: #94a3b8;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 92%;
  margin-top: 1rpx;
}

.gcell-empty-text {
  font-size: 16rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.gcell-hidden-text {
  font-size: 16rpx;
  color: #92400e;
  font-weight: 600;
  margin-top: 2rpx;
}

.gcell-dot {
  position: absolute;
  top: 1rpx;
  right: 1rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.18);
  border: 1rpx solid rgba(255,255,255,0.65);
  box-sizing: border-box;
  z-index: 1;
}

.gcell-dot text {
  font-size: 12rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.grid-pad-bottom {
  height: 48rpx;
}

/* ================================================================== */
/*  Cell Detail Popup（对齐 Web / H5）                                   */
/* ================================================================== */

.detail-scroll {
  width: 100%;
  max-width: 100%;
  max-height: 88vh;
  box-sizing: border-box;
  overflow-x: hidden;
}

.detail-root {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.detail-head {
  padding: 28rpx 88rpx 16rpx 32rpx;
  border-bottom: 1rpx solid #f2f3f5;
  box-sizing: border-box;
}

.detail-head-main {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.detail-head-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  max-width: 100%;
}

.detail-head-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #323233;
  max-width: 100%;
}

.detail-head-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #969799;
  max-width: 100%;
  word-break: break-all;
  line-height: 1.4;
}

.detail-head-position-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f7f8fa;
}

.detail-head-position-badge text {
  font-size: 22rpx;
  font-weight: 600;
  color: #646566;
}

.detail-head-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
  border: 3rpx solid rgba(255,255,255,0.7);
}

.detail-head-dot text {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
}

.detail-section-label {
  padding: 20rpx 32rpx 8rpx;
  box-sizing: border-box;
  max-width: 100%;
}

.detail-section-label text {
  font-size: 22rpx;
  font-weight: 600;
  color: #969799;
  letter-spacing: 1rpx;
  word-break: break-all;
}

.detail-divider {
  height: 1rpx;
  margin: 8rpx 32rpx 0;
  background: #ebedf0;
}

/* Section groups for detail popup */
.detail-section-group {
  padding: 4rpx 32rpx 4rpx;
  box-sizing: border-box;
  max-width: 100%;
}

.detail-section-group-title {
  padding: 12rpx 0 6rpx;
  box-sizing: border-box;
}

.detail-section-group-title text {
  font-size: 22rpx;
  font-weight: 600;
  color: #969799;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.detail-status-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 8rpx 32rpx 12rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.detail-status-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.detail-status-chip-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.detail-status-chip--COHABITATION { background: #10b981; }
.detail-status-chip--SPECIAL_FEEDING { background: #ef4444; }
.detail-status-chip--NEED_DIVIDE { background: #eab308; }
.detail-status-chip--HEALTH_ABNORMAL { background: #a855f7; }
.detail-status-chip--ANIMAL_TRANSFER { background: #06b6d4; }

.detail-status-chip-abbr {
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.28);
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.detail-field-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.detail-field {
  flex: 0 0 calc((100% - 12rpx) / 2);
  width: calc((100% - 12rpx) / 2);
  max-width: calc((100% - 12rpx) / 2);
  min-width: 0;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  background: #fff;
  overflow: hidden;
}

.detail-field--full {
  flex: 0 0 100%;
  width: 100%;
  max-width: 100%;
}

.detail-field-label {
  display: block;
  font-size: 22rpx;
  color: #969799;
  line-height: 1.3;
}

.detail-field-value {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #323233;
  word-break: break-all;
  line-height: 1.4;
}

.detail-field-value--mono {
  font-family: monospace;
  font-size: 24rpx;
}

.detail-field-value--location {
  font-size: 24rpx;
  color: #646566;
}

.detail-field-value--danger { color: #ee0a24; font-weight: 600; }
.detail-field-value--warn { color: #ed6a0c; font-weight: 600; }
.detail-field-value--info { color: #1989fa; font-weight: 600; }
.detail-field-value--health { color: #ff976a; font-weight: 600; }

.detail-qr-wrap {
  margin-top: 12rpx;
  padding: 12rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 12rpx;
  display: inline-block;
  background: #fff;
}

.detail-qr-image {
  width: 160rpx;
  height: 160rpx;
  display: block;
}

.detail-qr-loading {
  font-size: 22rpx;
  color: #969799;
  padding: 40rpx 24rpx;
  display: block;
}

.detail-qr-canvas-offscreen {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 160px;
  height: 160px;
}

.detail-no-permission {
  padding: 48rpx 32rpx;
  text-align: center;
}

.detail-no-permission text {
  font-size: 26rpx;
  color: #969799;
  line-height: 1.5;
}

.detail-annotation-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
}

.detail-annotation-loading text {
  font-size: 24rpx;
  color: #969799;
}

.detail-form-block {
  padding: 0 32rpx 16rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.detail-form-label {
  display: block;
  font-size: 24rpx;
  color: #646566;
  margin-bottom: 10rpx;
}

/* Label row with upload button */
.detail-form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.detail-upload-btn {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #ac1736;
  background: #fff;
  border: 1rpx solid #ac1736;
}

.detail-upload-btn--disabled {
  opacity: 0.5;
  pointer-events: none;
}

.detail-textarea {
  display: block;
  width: 100%;
  max-width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  background: #f7f8fa;
  font-size: 26rpx;
  color: #323233;
  line-height: 1.5;
  overflow-x: hidden;
  word-break: break-all;
}

.detail-textarea--mono {
  min-height: 120rpx;
  font-size: 22rpx;
  font-family: monospace;
}

.detail-image-previews {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 32rpx 16rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.detail-preview-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  background: #f7f8fa;
}

.detail-save-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 32rpx 16rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.detail-close-wrap {
  padding: 8rpx 32rpx 32rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.detail-save-btn {
  padding: 18rpx 36rpx;
  border-radius: 12rpx;
  background: #ac1736;
}

.detail-save-btn text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.detail-save-btn--disabled {
  opacity: 0.55;
}

.detail-save-msg {
  font-size: 24rpx;
}

.detail-save-msg--ok { color: #07c160; }
.detail-save-msg--err { color: #ee0a24; }

.detail-close-btn {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: #ac1736;
  border-radius: 16rpx;
  padding: 22rpx 0;
}

.detail-close-btn--secondary {
  background: #f7f8fa;
  color: #646566;
  border: 1rpx solid #ebedf0;
}

.detail-close-btn:active {
  opacity: 0.88;
}
