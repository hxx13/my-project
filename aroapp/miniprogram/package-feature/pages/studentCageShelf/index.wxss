  margin-bottom: 16rpx;
}
.scan-action-btn {
  padding: 10rpx 24rpx;
  border-radius: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ac1736;
  background: rgba(172,23,54,0.08);
  border: 1rpx solid rgba(172,23,54,0.2);
}
.scan-action-btn--on {
  color: #fff;
  background: #ac1736;
  border-color: #ac1736;
}
/* 行/列交叉定位 */
.gcell-cross {
  /* 同行/同列：明显红框+淡红底色 */
  box-shadow: inset 0 0 0 4rpx rgba(172,23,54,0.35), 0 0 8rpx rgba(172,23,54,0.12);
  background-image: linear-gradient(rgba(172,23,54,0.12), rgba(172,23,54,0.12));
}
.gcell-hit {
  transform: scale(1.08);
  z-index: 10;
  box-shadow: 0 0 28rpx rgba(172,23,54,0.55);
  border-color: #ac1736 !important;
  border-width: 6rpx !important;
}
.gcell-hit--cached {
  box-shadow: 0 0 20rpx rgba(217,119,6,0.45);
  border-color: #d97706 !important;
}
.gcell-cached {
  border-width: 3rpx !important;
}

/* ── 编辑模式操作弹窗 ── */
.ea-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.ea-pos {
  font-size: 32rpx;
  font-weight: 700;
  color: #323233;
}
.ea-type {
  font-size: 22rpx;
  color: #969799;
}
.ea-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.ea-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 56rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  border: 2rpx solid #ebedf0;
  background: #f7f8fa;
  color: #646566;
