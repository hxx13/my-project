}
.cf-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.cf-row:last-child {
  border-bottom: none;
}
.cf-row-label {
  color: var(--faint);
  font-size: 24rpx;
  flex-shrink: 0;
}
.cf-row-value {
  color: var(--ink);
  font-size: 24rpx;
  text-align: right;
  margin-left: 24rpx;
  word-break: break-all;
}
.cf-row-value--em {
  font-weight: 700;
}
.cf-form {
  margin-top: 20rpx;
}
.cf-tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7ed;
