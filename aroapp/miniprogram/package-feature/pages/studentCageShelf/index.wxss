}
.cf-btn-confirm--disabled {
  opacity: 0.5;
}

/* ================================================================== */
/*  认领徽标（未到位/待审批/待释放，对齐 H5 CellButton 左上角）            */
/* ================================================================== */
.gcell-badge {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  z-index: 2;
  padding: 0 6rpx;
  font-size: 16rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 4rpx;
  line-height: 1.5;
}
.gcell-badge--locked { background: #f59e0b; }
.gcell-badge--pending { background: #3b82f6; }
.gcell-badge--release { background: #f97316; }

/* 当前模式的呼吸光晕（与 Web 端 cage-mode-glow.css 同款效果）。
   用 inset 内发光而非外投影：外层是滚动容器，外投影会被裁掉。
   颜色由页面通过 --mode-color 传入（见 MODE_COLOR / switchMode 的 modeColor）。 */
@keyframes cage-glow-breathe {
  0%, 100% {
    box-shadow: inset 0 0 0 2rpx var(--mode-color), inset 0 0 5rpx 0 var(--mode-color);
  }
  50% {
    box-shadow: inset 0 0 0 2rpx var(--mode-color), inset 0 0 18rpx 3rpx var(--mode-color);
  }
}
.grid-wrapper--glow {
  animation: cage-glow-breathe 2.6s ease-in-out infinite;
}

/* 笼位划分（格子有划分名单时的淡色环 + 淡玫瑰底，让划分范围成片一眼可辨；置于选中态之前让选中环优先覆盖） */
.gcell-division {
  box-shadow: inset 0 0 0 3rpx #fb7185, 0 0 8rpx rgba(244, 63, 94, 0.28);
  /* 用 background-image 叠加，不覆盖格子自身的状态底色 */
  background-image: linear-gradient(rgba(225, 29, 72, 0.10), rgba(225, 29, 72, 0.10));
}
/* 划分名单含本人：专属高亮（比淡色环更重） */
.gcell-division--mine {
  box-shadow: inset 0 0 0 4rpx #e11d48, 0 0 8rpx rgba(225, 29, 72, 0.45);
  border-color: #e11d48 !important;
  border-width: 4rpx !important;
}
/* 划分徽标：贴左下角，避开左上角的认领徽标；名单过长省略号收起 */
.gcell-badge--division {
  top: auto;
  bottom: 2rpx;
  left: 2rpx;
  max-width: calc(100% - 4rpx);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: #e11d48;
}

/* 选中态（分配/认领/学生申请） */
.gcell-selected {
  box-shadow: inset 0 0 0 4rpx #3b82f6, 0 0 8rpx rgba(59, 130, 246, 0.35);
  border-color: #3b82f6 !important;
  border-width: 4rpx !important;
}
/* 学生申请池内可申请笼位 */
.gcell-inpool {
  box-shadow: inset 0 0 0 3rpx #34d399, 0 0 8rpx rgba(52, 211, 153, 0.35);
}
/* 学生确认模式：本人待确认到位(locked)的笼位，琥珀描边高亮（与「未到位」徽标同色系） */
.gcell-myclaim {
  box-shadow: inset 0 0 0 3rpx #fbbf24, 0 0 8rpx rgba(251, 191, 36, 0.45);
  border-color: #fbbf24 !important;
  border-width: 3rpx !important;
}

/* ================================================================== */
/*  待审分笼/转移中间态（对齐 Web CellButton opMarker + 正中图标层）        */
/*  色环的 inset 阴影由 wxml 内联（配对色随请求变化），此处只管结构         */
/* ================================================================== */
.gcell-opmark {
  position: absolute;
  inset: 0;
  z-index: 12;
  border-radius: 6rpx;
  pointer-events: none;
}
.gcell-opmark-veil {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.25);
}
.gcell-opmark-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 44rpx;
  height: 44rpx;
  margin: -22rpx 0 0 -22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
  box-sizing: border-box;
}
.gcell-opmark-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 详情弹窗内的一句话提示 */

/* ================================================================== */
/*  模式横幅：标题+计数 / 按钮组 / 待选卡片列表                          */
/*  （形态对齐资产记录页「扫码归位」，配色跟随当前模式 --mode-color）      */
/* ================================================================== */
.mode-banner {
  margin: 12rpx 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(30, 55, 90, 0.1);
  /* 左侧模式色条：底色无法由变量算透明度，改用色条承载模式身份 */
  border-left: 6rpx solid var(--mode-color, #2563eb);
  background: #f7f9fc;
  box-sizing: border-box;
}
.mb-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}
.mb-title {
  margin-right: 4rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--mode-color, #1d4ed8);
}
.mb-btn {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(30, 55, 90, 0.14);
  background: #fff;
  font-size: 22rpx;
  color: #4b5563;
}
.mb-btn--on {
  border-color: var(--mode-color, #2563eb);
  color: var(--mode-color, #2563eb);
}
.mb-btn--primary {
  border-color: var(--mode-color, #2563eb);
  background: var(--mode-color, #2563eb);
  color: #fff;
}
.mb-btn--danger {
  border-color: #ef4444;
  background: #ef4444;
  color: #fff;
}
/* 待选区：胶囊横排换行，不占整行 */
.mb-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(30, 55, 90, 0.12);
}
.mb-chips-label {
  font-size: 22rpx;
  color: var(--faint);
}
.mb-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--mode-color, var(--accent));
  background: #fff;
  font-size: 22rpx;
  color: #333;
}
.mb-chip-pos {
  font-weight: 600;
  font-family: monospace;
  color: var(--mode-color, var(--accent));
}
.mb-chip-meta {
  color: var(--faint);
}
.mb-chip-x {
  padding: 0 4rpx;
  font-size: 24rpx;
  color: var(--off);
}

.gt-my-claims-btn {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
