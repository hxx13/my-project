  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.scan-action-btn {
  padding: 10rpx 24rpx;
  border-radius: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ac1736;
  background: rgba(172,23,54,0.08);
  border: 1rpx solid rgba(172,23,54,0.2);
}
.scan-action-btn--on {
