/* ================================================================== */
/*  Cage Sheet —— 查看 / 状态 / 记录 三弹窗共用的结构与令牌                    */
/*  方向：标本卡 / 笼位标签。编码与数值走等宽字，点线引导的规格行代替色块，       */
/*  状态色继承网格那套（分笼黄/饲养红/异常紫/合笼橙/转移青），品牌红只留给主操作。 */
/*  令牌作用域限定在 .cs-sheet 内，不写入 app.wxss，避免波及其他页面。          */
/* ================================================================== */

.cs-sheet {
  --paper: #fdfcfb;      /* 暖白纸面，不用纯白，避免与卡片叠在一起发灰 */
  --ink: #171a1f;
  --body: #4a5160;
  --mute: #8f96a3;
  --faint: #c2c7d0;
  --line: #e9e6e3;       /* 暖调 hairline，不用蓝灰，跟纸面对齐 */
  --line2: #f2f0ee;
  --brand: #ac1736;
  --soft: #f7f6f5;
  /* 次级按钮的实底。--soft 太接近纸面（#fdfcfb），当按钮底色会被看成白的 */
  --soft-2: #efece9;

  display: flex;
  flex-direction: column;
  width: 86vw;
  max-width: 680rpx;
  max-height: 78vh;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--paper);
  border-radius: 22rpx;
  box-shadow: 0 12rpx 52rpx rgba(23, 26, 31, 0.18), 0 2rpx 6rpx rgba(23, 26, 31, 0.08);
}

/* 编辑态：外壳加一圈极细红环，让人意识到「正在改数据」 */
.cs-sheet--editing {
  box-shadow: 0 0 0 3rpx rgba(172, 23, 54, 0.5), 0 12rpx 52rpx rgba(23, 26, 31, 0.18);
}

/* ---- 身份条：位置 + 状态刻度 + 关闭，一行 ---- */
.cs-id {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 26rpx 22rpx;
  border-bottom: 1rpx solid var(--line);
}

.cs-id-pos {
  flex-shrink: 0;
  font-family: monospace;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* 身份条副信息（如记录弹窗的「N 次变更 · M 个字段」） */
.cs-id-sub {
  font-family: monospace;
  font-size: 20rpx;
  color: var(--mute);
  font-variant-numeric: tabular-nums;
}

.cs-ticks {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

/* 状态刻度：反白单字块 + 浅底描边，像档案夹的索引标签 */
.cs-tick {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding-right: 10rpx;
  border: 1rpx solid var(--c);
  border-radius: 6rpx;
  background: var(--c-bg, var(--soft));
  font-size: 20rpx;
  font-weight: 600;
  color: var(--c);
  white-space: nowrap;
  overflow: hidden;
  box-sizing: border-box;
}

.cs-tick-g {
  align-self: stretch;
  display: flex;
  align-items: center;
  padding: 0 7rpx;
  margin-right: 7rpx;
  background: var(--c);
  color: #fff;
  font-family: monospace;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.cs-badge {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 4rpx;
  background: var(--brand);
  color: #fff;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 自带关闭按钮：vant 那个是绝对定位，放不进身份条的行内节奏 */
.cs-x {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: var(--faint);
  font-size: 26rpx;
  line-height: 1;
}

.cs-x:active {
  background: var(--line2);
  color: var(--mute);
}

/* ---- 唯一滚动区 ---- */
/* max-height 之外还要给一个确定的高度上限：外层 .cs-sheet 只有 max-height，
   flex 不会因此收缩子项，scroll-view 会拿到内容高度并溢出到底栏底下。
   62vh + 身份条 + 底栏 ≈ 76vh，留在 .cs-sheet 的 78vh 之内。 */
.cs-body {
  flex: 1;
  min-height: 0;
  max-height: 62vh;
  width: 100%;
  box-sizing: border-box;
}

/* ---- 底部动作坞 ---- */
.cs-dock {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 26rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--paper);
}

.cs-dock-msg {
  flex-shrink: 0;
  margin-right: auto;
  font-size: 21rpx;
}

/* 不可编辑的原因：占左侧、可折行、极淡，不与主操作抢视线 */
.cs-dock-hint {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
  font-size: 20rpx;
  color: var(--faint);
  line-height: 1.35;
}

.cs-dock-msg--ok { color: #10b981; }
.cs-dock-msg--err { color: #e0574f; }

.cs-dock-push { margin-left: auto; }

/* ================================================================== */
/*  分区                                                                */
/* ================================================================== */

.cs-sec {
  border-bottom: 1rpx solid var(--line2);
}

.cs-sec:last-child {
  border-bottom: none;
}

.cs-sec-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 26rpx;
}

.cs-sec-hd:active {
  background: var(--soft);
}

.cs-sec-no {
  flex-shrink: 0;
  font-family: monospace;
  font-size: 20rpx;
  color: var(--faint);
  letter-spacing: 1rpx;
}

.cs-sec-title {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.cs-sec-n {
  flex-shrink: 0;
  padding: 2rpx 9rpx;
  border-radius: 4rpx;
  background: var(--line2);
  color: var(--mute);
  font-family: monospace;
  font-size: 20rpx;
}

/* 收起的分区里有多少行改动过 —— 没有它用户是按黑箱保存 */
.cs-sec-dirty {
  flex-shrink: 0;
  padding: 2rpx 9rpx;
  border-radius: 4rpx;
  background: var(--brand);
  color: #fff;
  font-family: monospace;
  font-size: 20rpx;
  font-weight: 700;
}

/* 收起态的行尾摘要，避免「折叠 = 藏起来」 */
.cs-sec-sum {
  flex: 1;
  min-width: 0;
  margin-right: 10rpx;
  text-align: right;
  font-size: 21rpx;
  color: var(--faint);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cs-chev {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 18rpx;
  color: var(--faint);
}

.cs-sec-sum + .cs-chev {
  margin-left: 0;
}

.cs-sec-bd {
  padding: 0 26rpx 22rpx;
}

/* 无标题分区（如笼位操作行）自成一节，需要自己补上边距 */
.cs-sec-bd--pad {
  padding-top: 22rpx;
}

/* 编辑关键信息时，实验记录 / 照片区压灰禁用 —— 两条保存路径不能混 */
.cs-sec--dim > .cs-sec-hd .cs-sec-title {
  color: var(--mute);
}

.cs-sec--dim > .cs-sec-bd {
  opacity: 0.45;
  pointer-events: none;
}

.cs-lockhint {
  display: block;
  padding: 2rpx 0 10rpx;
  font-size: 20rpx;
  color: var(--faint);
}

/* ---- 子模块小标题：分区内一层，不再往下折 ---- */
.cs-sub {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 16rpx 0 6rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line2);
  font-size: 20rpx;
  font-weight: 600;
  color: var(--mute);
  letter-spacing: 1.5rpx;
}

.cs-sub:first-child {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.cs-sub-mark {
  font-family: monospace;
  font-size: 19rpx;
  color: var(--faint);
}

/* ================================================================== */
/*  规格行：固定标签列 + 值右对齐，不画任何线                                 */
/*  分隔靠「列宽对齐 + 隔行极浅底」，不靠点线或框线                            */
/* ================================================================== */

.cs-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 11rpx 0;
  min-width: 0;
}

/* 隔行浅底：整行内缩一点，让色带不贴边，读起来是「行」而不是「块」 */
.cs-row--alt {
  background: var(--soft);
  border-radius: 6rpx;
  padding-left: 10rpx;
  padding-right: 10rpx;
}

.cs-row-label {
  flex: 0 0 auto;
  width: 196rpx;
  font-size: 22rpx;
  color: var(--mute);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cs-row-val {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  word-break: break-all;
}

.cs-row-val--mono {
  font-family: monospace;
  font-variant-numeric: tabular-nums;
}

.cs-row-val--blank {
  color: var(--faint);
  font-weight: 400;
}

.cs-req {
  color: var(--brand);
  font-weight: 700;
  margin-right: 3rpx;
}

/* 只读行（字段字典 editable:false）：编辑态主动降调，不用锁图标 */
.cs-row--ro .cs-row-label {
  color: var(--faint);
}

.cs-row--ro .cs-row-val {
  color: var(--mute);
  font-weight: 500;
}

/* 本次改动过的行：标签后一个品牌红小点 */
.cs-row--dirty .cs-row-label::after {
  content: "";
  display: inline-block;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-left: 8rpx;
  vertical-align: 2rpx;
}

.cs-row--err {
  background: rgba(224, 87, 79, 0.07);
  border-radius: 6rpx;
}

.cs-errmsg {
  display: block;
  padding: 0 0 4rpx;
  text-align: right;
  font-size: 20rpx;
  color: #e0574f;
}

/* ================================================================== */
/*  编辑控件：不做盒子，只留一条下划线，保住规格行的节奏                       */
/* ================================================================== */

.cs-ctl {
  flex: 1;
  min-width: 0;
  padding: 2rpx 0;
  border: none;
  border-bottom: 3rpx solid var(--line);
  border-radius: 0;
  background: transparent;
  text-align: right;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
  box-sizing: border-box;
}

.cs-ctl--mono {
  font-family: monospace;
  font-variant-numeric: tabular-nums;
}

.cs-ctl--err {
  border-bottom-color: #e0574f;
}

/* 选择类：值 + 细箭头，整行点开原生 picker */
.cs-pick {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  padding: 2rpx 0;
  border-bottom: 3rpx solid var(--line);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  box-sizing: border-box;
}

.cs-pick--blank {
  color: var(--faint);
  font-weight: 400;
}

.cs-pick--err {
  border-bottom-color: #e0574f;
}

.cs-pick-txt {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cs-pick-i {
  flex-shrink: 0;
  font-size: 18rpx;
  color: var(--brand);
}

/* 布尔：小开关，居中于行 */
.cs-sw {
  position: relative;
  flex-shrink: 0;
  margin-left: auto;
  width: 60rpx;
  height: 34rpx;
  border-radius: 18rpx;
  background: #dcd9d6;
  align-self: center;
  transition: background 0.16s;
}

.cs-sw-knob {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.16s;
}

.cs-sw--on {
  background: var(--brand);
}

.cs-sw--on .cs-sw-knob {
  transform: translateX(26rpx);
}

/* 长文本字段：整行铺开，唯一允许出现浅底的地方 */
.cs-wide {
  display: block;
  padding: 12rpx 0 4rpx;
}

.cs-wide-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--mute);
}

.cs-textarea {
  display: block;
  width: 100%;
  min-height: 132rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--paper);
  font-size: 25rpx;
  color: var(--ink);
  line-height: 1.5;
}

.cs-textarea--read {
  min-height: 0;
  padding: 12rpx 16rpx;
  background: var(--soft);
  color: var(--body);
}

.cs-textarea--disabled {
  opacity: 0.45;
}

/* ================================================================== */
/*  按钮                                                                */
/* ================================================================== */

.cs-btn {
  flex-shrink: 0;
  padding: 0 30rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  border: 1rpx solid transparent;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-sizing: border-box;
  line-height: 1;
}

.cs-btn--primary {
  background: var(--brand);
  color: #fff;
}

/* 次级动作：实底中性灰。原来是 transparent（ghost），等于没有按钮感 */
.cs-btn--soft {
  background: var(--soft-2);
  color: var(--body);
}

.cs-btn--disabled {
  opacity: 0.55;
}

/* ---- 笼位操作胶囊（分笼 / 转移 / 认领 / 清空划分） ---- */
/* 自成一个无标题分区，上边距由 .cs-sec-bd--pad 给，这里不再画分隔线 */
.cs-ops {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

/* 实底，不用描边。9% 的浓度在纸面上混出来接近白，提到 20% 才看得出是按钮 */
.cs-op-btn {
  padding: 13rpx 24rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 8rpx;
  background: rgba(172, 23, 54, 0.2);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
}

.cs-op-btn--primary {
  background: var(--brand);
  color: #fff;
}

/* 清空划分是破坏性动作。品牌色本身也是红，用同一浓度会跟分笼撞成一片，
   所以压成中性灰：语义上从属，且靠上方的「已划分给：X」提示给上下文 */
.cs-op-btn--danger {
  background: var(--soft-2);
  color: var(--mute);
}

.cs-op-hint {
  width: 100%;
  font-size: 21rpx;
  color: var(--mute);
  line-height: 1.45;
}

/* ================================================================== */
/*  提示 / 空态 / 未决条                                                 */
/* ================================================================== */

.cs-hint {
  display: block;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: var(--mute);
  line-height: 1.5;
}

.cs-hint--block {
  padding: 140rpx 0;
  text-align: center;
}

.cs-hint--error {
  color: #e0574f;
}

/* 未决分笼/转移：用配对色做左侧色条，不做实心底（饱和色配深字读不出来） */
.cs-notice {
  display: flex;
  align-items: flex-start;
  margin: 18rpx 26rpx 0;
  padding: 12rpx 0 12rpx 16rpx;
  border-left: 6rpx solid var(--notice, #f59e0b);
  font-size: 21rpx;
  color: var(--ink);
  line-height: 1.45;
}

.cs-notice-txt {
  flex: 1;
  min-width: 0;
}

/* ================================================================== */
/*  照片                                                                */
/* ================================================================== */

.cs-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.cs-photo-wrap {
  position: relative;
}

.cs-photo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  background: var(--soft);
}

.cs-photo--sm {
  width: 72rpx;
  height: 72rpx;
}

.cs-photo-del {
  position: absolute;
  top: -9rpx;
  right: -9rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cs-photo-add {
  width: 100rpx;
  height: 100rpx;
  border: 1rpx dashed var(--faint);
  border-radius: 8rpx;
  background: var(--paper);
  color: var(--faint);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 19rpx;
  box-sizing: border-box;
}

.cs-photo-add-icon {
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
}

.cs-photo-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 22rpx 0 12rpx;
}

.cs-photo-group {
  margin-bottom: 16rpx;
}

.cs-photo-group:last-child {
  margin-bottom: 0;
}

/* ---- 只读备注：引用块 ---- */
.cs-note {
  margin-top: 16rpx;
  padding: 12rpx 0 12rpx 16rpx;
  border-left: 3rpx solid var(--line);
}

.cs-note-label {
  display: block;
  margin-bottom: 4rpx;
  font-size: 20rpx;
  color: var(--mute);
  letter-spacing: 1rpx;
}

.cs-note-txt {
  display: block;
  font-size: 23rpx;
  color: var(--body);
  line-height: 1.55;
  word-break: break-all;
}

/* ================================================================== */
/*  状态标记：四态状态机（未标 / 已标 / 本次新增 / 本次移除）                  */
/* ================================================================== */

.cs-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.cs-stat {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: transparent;
  box-sizing: border-box;
  overflow: hidden;
}

.cs-stat--hover {
  opacity: 0.75;
}

/* 状态字块：反白单字，没标记时是描边空块 */
.cs-stat-g {
  position: relative;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  background: var(--paper);
  color: var(--faint);
  font-family: monospace;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cs-stat-t {
  min-width: 0;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--mute);
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 已标记：用该状态自己的色（继承网格），不是一个统一的绿 */
.cs-stat--on {
  border-color: var(--c);
  background: var(--c-bg, var(--soft));
}

.cs-stat--on .cs-stat-g {
  background: var(--c);
  border-color: var(--c);
  color: #fff;
}

.cs-stat--on .cs-stat-t {
  color: var(--ink);
  font-weight: 600;
}

/* 本次新增：右上折角（狗耳朵），扫一眼就知道这次改了什么 */
.cs-stat--add::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 22rpx 22rpx 0;
  border-color: transparent var(--c) transparent transparent;
}

/* 本次移除：虚框 + 斜杠划过字块 + 文字删除线 */
.cs-stat--rm {
  border-style: dashed;
  border-color: var(--mute);
}

.cs-stat--rm .cs-stat-g {
  color: var(--mute);
  border-color: var(--mute);
  background: var(--paper);
}

.cs-stat-strike {
  position: absolute;
  left: -2rpx;
  right: -2rpx;
  top: 50%;
  height: 2rpx;
  background: var(--mute);
  transform: rotate(-45deg);
}

.cs-stat--rm .cs-stat-t {
  color: var(--mute);
  text-decoration: line-through;
}

/* ================================================================== */
/*  时间轴（记录弹窗 / 状态弹窗的历史）                                     */
/* ================================================================== */

.cs-tl {
  padding-left: 30rpx;
}

/* 记录弹窗没有分区，时间轴直接进 body，需要自己留边距 */
.cs-tl--inset {
  padding: 22rpx 26rpx 24rpx 56rpx;
}

.cs-tl-node {
  position: relative;
  padding-bottom: 18rpx;
}

.cs-tl-node:last-child {
  padding-bottom: 0;
}

.cs-tl-rail {
  position: absolute;
  left: -22rpx;
  top: 30rpx;
  bottom: -10rpx;
  width: 1rpx;
  background: var(--line);
}

.cs-tl-node:last-child .cs-tl-rail {
  display: none;
}

.cs-tl-dot {
  position: absolute;
  left: -27rpx;
  top: 16rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 5rpx var(--paper);
}

.cs-tl-card {
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--paper);
  overflow: hidden;
}

.cs-tl-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
}

.cs-tl-kind {
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink);
}

.cs-tl-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--mute);
}

.cs-tl-time {
  flex-shrink: 0;
  margin-left: auto;
  font-family: monospace;
  font-size: 20rpx;
  color: var(--mute);
  font-variant-numeric: tabular-nums;
}

.cs-tl-del {
  flex-shrink: 0;
  padding: 0 4rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.cs-tl-bd {
  padding: 14rpx 18rpx;
  border-top: 1rpx solid var(--line2);
  background: #fcfbfa;
}

.cs-tl-op {
  display: block;
  margin-bottom: 10rpx;
  font-size: 21rpx;
  color: var(--mute);
  line-height: 1.5;
  word-break: break-all;
}

.cs-tl-op:last-child {
  margin-bottom: 0;
}

/* ---- 字段差异行：旧值划掉 → 新值加粗 ---- */
.cs-diff {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 5rpx 0;
  font-size: 23rpx;
  line-height: 1.5;
}

.cs-diff:first-child {
  padding-top: 0;
}

.cs-diff:last-child {
  padding-bottom: 0;
}

.cs-diff-label {
  flex-shrink: 0;
  width: 124rpx;
  font-size: 21rpx;
  color: var(--mute);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cs-diff-before {
  flex-shrink: 0;
  max-width: 40%;
  font-family: monospace;
  color: var(--faint);
  text-decoration: line-through;
  word-break: break-all;
}

.cs-diff-before--empty {
  text-decoration: none;
}

.cs-diff-arrow {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--faint);
}

.cs-diff-after {
  flex: 1;
  min-width: 0;
  font-family: monospace;
  font-weight: 600;
  color: var(--ink);
  word-break: break-all;
}
