/* ================================================================== */
/*  Page Base                                                           */
/* ================================================================== */

.page {
  position: relative;
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  background: #eef0f6;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}

.grid-page {
  overflow: hidden;
  /* ponytail: 覆盖层而非隐藏列表——列表 scroll-view 常驻可视，返回时滚动位置原生保留 */
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

/* ================================================================== */
/*  Shared States                                                       */
/* ================================================================== */

.center-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  gap: 16rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #969799;
}

.error-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  padding: 0 48rpx;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #c8c9cc;
  background: #f2f3f5;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 26rpx;
  color: #969799;
  text-align: center;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.retry-btn {
  font-size: 26rpx;
  color: #fff;
  padding: 16rpx 56rpx;
  background: linear-gradient(135deg, #ac1736, #8B1229);
  border-radius: 999rpx;
  font-weight: 500;
}

.back-link {
  font-size: 24rpx;
  color: #ac1736;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
}

.empty-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}

.empty-icon {
  font-size: 72rpx;
  color: #c8c9cc;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #969799;
  margin-bottom: 24rpx;
}

/* ================================================================== */
/*  List View                                                           */
/* ================================================================== */

.list-root {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

/* Sticky header */
.list-sticky-header {
  flex-shrink: 0;
  padding: 10rpx 24rpx 8rpx;
  background: #eef0f6;
  z-index: 10;
}

.list-count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.list-count-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #64748b;
}

.list-scanned-at {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 12rpx;
}

.list-filtered-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

.list-refresh-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.92);
  border: 1rpx solid rgba(30,55,90,0.08);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}

/* Search bar */
.list-search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.list-search-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 20rpx;
  border: 1rpx solid rgba(30,55,90,0.08);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}

.list-search-icon {
  flex-shrink: 0;
}

.list-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #323233;
  background: transparent;
}

.list-search-placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}

/* Room filter picker */
.list-filter-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 20rpx;
  border: 1rpx solid rgba(30,55,90,0.08);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
  margin-bottom: 12rpx;
  box-sizing: border-box;
  max-width: 100%;
  overflow: hidden;
}

.list-filter-picker-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Special status button (top-right) */
.list-special-status-btn {
  margin-left: auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #ac1736;
  flex-shrink: 0;
}

/* Collapse/expand all button — 独立于搜索框右侧 */
.list-collapse-all-btn {
  flex-shrink: 0;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #646566;
  background: #f2f3f5;
  white-space: nowrap;
}

.list-search-input {
  flex: 1;
  min-width: 0;
}

/* ====== Special Status Popup（对齐 H5 MobileSpecialStatusPanel） ====== */
.sp-status-popup {
  display: flex;
  flex-direction: column;
  height: 80vh;
  max-height: 80vh;
}

.sp-status-hd {
  padding: 24rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #f0f1f2;
  flex-shrink: 0;
}

.sp-status-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.sp-status-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #969799;
}

.sp-status-scroll {
  flex: 1;
  min-height: 0;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.sp-status-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #969799;
}

.sp-status-err-msg {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #dc2626;
}

.sp-status-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #969799;
}

.sp-status-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

/* ---- 第一层：状态类型卡片 ---- */
.sp-group-card {
  border-radius: 16rpx;
  border: 1rpx solid #ebedf0;
  background: #fff;
  overflow: hidden;
}

.sp-group-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
}

.sp-group-hd:active {
  background: #f7f8fa;
}

.sp-group-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sp-group-abbr {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.sp-group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  flex: 1;
  min-width: 0;
}

.sp-group-badge {
  font-size: 22rpx;
  color: #646566;
  background: #f2f3f5;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sp-group-arrow {
  font-size: 24rpx;
  color: #969799;
  flex-shrink: 0;
}

/* ---- 第二层：笼架分组 ---- */
.sp-group-body {
  border-top: 1rpx solid #ebedf0;
  padding: 12rpx 16rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sp-shelf-card {
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  background: #f7f8fa;
  overflow: hidden;
}

.sp-shelf-hd {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx;
}

.sp-shelf-hd:active {
  background: #eeeff2;
}

.sp-shelf-info {
  flex: 1;
  min-width: 0;
}

.sp-shelf-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #323233;
  display: block;
}

.sp-shelf-meta {
  font-size: 20rpx;
  color: #969799;
  display: block;
  margin-top: 4rpx;
}

.sp-shelf-count {
  font-size: 20rpx;
  color: #969799;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.sp-shelf-arrow {
  font-size: 22rpx;
  color: #969799;
  flex-shrink: 0;
  padding-top: 4rpx;
}

/* ---- 第三层：笼位列表 ---- */
.sp-shelf-body {
  border-top: 1rpx solid #ebedf0;
  max-height: 360rpx;
  overflow-y: auto;
}

.sp-cage-row {
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.sp-cage-row:last-child {
  border-bottom: 0;
}

.sp-cage-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sp-cage-pos {
  font-size: 22rpx;
  font-weight: 600;
  color: #323233;
  font-family: monospace;
  flex-shrink: 0;
}

.sp-cage-pi {
  font-size: 22rpx;
  color: #323233;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sp-cage-detail {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #969799;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-left: 0;
}

/* Scroll area */
.list-scroll {
  flex: 1;
  min-height: 0;
  padding: 8rpx 24rpx 0;
  box-sizing: border-box;
}

.list-pad-bottom {
  height: 64rpx;
}

/* No match */
.no-match-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.no-match-text {
  font-size: 26rpx;
  color: #969799;
  margin-bottom: 24rpx;
}

.clear-filter-btn {
  font-size: 26rpx;
  color: #ac1736;
  font-weight: 500;
  padding: 12rpx 40rpx;
}

/* Campus group — 最外层容器 */
.campus-group {
  margin-bottom: 24rpx;
  border-radius: 18rpx;
  border: 2rpx solid #dde1e8;
  background: #fafbfc;
  overflow: hidden;
}

.campus-group-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #eef0f6 0%, #e2e5ed 100%);
  font-size: 28rpx;
  font-weight: 700;
  color: #323233;
}

.campus-group-body {
  padding: 4rpx 16rpx 12rpx;
}

.cgh-arrow {
  margin-right: 4rpx;
  display: flex;
  align-items: center;
}

.cgh-count {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: #969799;
}

/* Room group */
.room-group {
  margin-bottom: 8rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

/* Room group accordion header — 一级：最突出 */
.room-group-header {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  width: 100%;
  max-width: 100%;
  padding: 14rpx 20rpx 12rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 2rpx solid #dde1e8;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  box-sizing: border-box;
  overflow: hidden;
}

.room-group-header--hl {
  background: rgba(172, 23, 54, 0.04);
  border-color: rgba(172, 23, 54, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(172, 23, 54, 0.06);
}

/* Arrow wrapper — native view keeps van-icon aligned */
.rgh-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 12rpx;
}

/* Room name — shrink to content, truncate if needed */
.rgh-name {
  flex-shrink: 0;
  max-width: 50%;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rgh-name--hl {
  color: #ac1736;
}

/* Shelf count badge */
.rgh-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #969799;
}

.rgh-main {
  flex: 1;
  min-width: 0;
}

.rgh-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rgh-metrics {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.rgh-stats {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.rs-stat {
  font-size: 20rpx;
  font-weight: 600;
}

.rs-sep {
  font-size: 18rpx;
  color: #c0c4cc;
}

.rgh-bar-wrap {
  width: 90%;
}

.rgh-bar {
  display: flex;
  height: 10rpx;
  border-radius: 5rpx;
  overflow: hidden;
  background: #f2f3f5;
}

.rgh-bar-seg {
  min-width: 4rpx;
  height: 100%;
}

.shelf-card-bar-wrap {
  width: 80%;
}

.shelf-card-bar {
  display: flex;
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #f2f3f5;
  width: 100%;
}

.shelf-bar-seg {
  min-width: 4rpx;
  height: 100%;
}

.bar-legend-tag {
  font-size: 18rpx;
  color: #969799;
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.bar-legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ---- 第二层：笼架组（左缩进，左侧 accent 色条） ---- */
.room-shelf-body {
  padding: 4rpx 0 4rpx 8rpx;
}

.shelf-group {
  margin-bottom: 6rpx;
  margin-left: 8rpx;
  border-radius: 10rpx;
  border-left: 6rpx solid #dde1e8;
  background: #f8f9fc;
  overflow: hidden;
}

.shelf-group--hl {
  border-left-color: #ac1736;
  background: rgba(172, 23, 54, 0.03);
}

.shelf-group-hd {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
}

.shelf-group-hd:active {
  background: #f0f1f5;
}

.sgh-arrow {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sgh-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  flex-shrink: 0;
}

.sgh-name--hl {
  color: #ac1736;
}

.sgh-metrics {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3rpx;
  flex: 1;
  min-width: 0;
}

.sgh-stats {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.ss-stat {
  font-size: 20rpx;
  font-weight: 600;
}

.ss-sep {
  font-size: 18rpx;
  color: #c0c4cc;
}

.sgh-bar-wrap {
  width: 70%;
}

.sgh-bar {
  display: flex;
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #e8eaef;
}

.sgh-bar-seg {
  min-width: 4rpx;
  height: 100%;
}

.sgh-count {
  font-size: 20rpx;
  color: #969799;
  flex-shrink: 0;
}

/* Shelf cards grid (2 columns) — 第三层：最内层卡片 */
.room-shelf-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 8rpx 6rpx 8rpx;
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.shelf-card {
  display: flex;
  flex-direction: column;
  flex: 0 0 calc(50% - 4rpx);
  width: calc(50% - 4rpx);
  padding: 16rpx 14rpx 14rpx;
  border-radius: 8rpx;
  background: #fff;
  border: 1rpx solid #eef0f6;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06), 0 1rpx 2rpx rgba(0,0,0,0.04);
  box-sizing: border-box;
  position: relative;
}

.shelf-card:active {
  background: #f8f9fc;
}

.shelf-card-highlight {
  background: #fff5f5;
  border-color: #f4b8b8;
}

.shelf-card-icon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
}

.shelf-card-icon-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #cbd5e1;
}

.shelf-card-highlight .shelf-card-icon-dot {
  background: #ac1736;
}

.shelf-card-head {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.shelf-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}

.shelf-card-metrics {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3rpx;
  flex: 1;
  min-width: 0;
}

.shelf-card-stats {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.sc-stat {
  font-size: 20rpx;
  font-weight: 600;
}

.sc-sep {
  font-size: 18rpx;
  color: #c0c4cc;
}

.shelf-card-highlight .shelf-card-name {
  color: #ac1736;
}

/* ================================================================== */
/*  Grid Scroll & Legend                                                */
/* ================================================================== */

.grid-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 16rpx 12rpx 0;
  overflow-x: hidden;
}

.grid-legend-card {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 14rpx 16rpx 16rpx;
  margin-bottom: 16rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 16rpx;
  border: 1rpx solid rgba(30,55,90,0.06);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}

.legend-section-title {
  display: block;
  max-width: 100%;
  font-size: 22rpx;
  font-weight: 600;
  color: #646566;
  line-height: 1.4;
  word-break: break-all;
}

.legend-section-title--spaced {
  margin-top: 18rpx;
}

.grid-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  margin-top: 10rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  min-width: 0;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.legend-cage-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.18);
  border: 2rpx solid rgba(255,255,255,0.65);
  box-sizing: border-box;
}

.legend-cage-dot text {
  font-size: 16rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.legend-cage-dot--wait {
  background: #f59e0b;
}

.legend-cage-dot--empty {
  background: #10b981;
}

.legend-cage-dot--abnormal {
  background: #3b82f6;
}

.legend-cage-dot--feeding {
  background: #f43f5e;
}

.legend-label {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #646566;
  line-height: 1.35;
  word-break: break-all;
}

.legend-label--mute {
  color: #969799;
}

/* ================================================================== */
/*  Grid Wrapper & Container (8 columns)                                */
/* ================================================================== */

.grid-wrapper {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255,255,255,0.85);
  border-radius: 20rpx;
  border: 1rpx solid rgba(30,55,90,0.06);
  box-shadow: 0 2px 8px rgba(15,23,42,0.04);
  padding: 8rpx;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 4rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* ================================================================== */
/*  Grid Cell (72rpx target)                                            */
/* ================================================================== */

.grid-cell {
  position: relative;
  aspect-ratio: 1;
  min-width: 0;
  max-width: 100%;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
}

.gcell-pos {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.1;
  max-width: 100%;
  padding: 0 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.gcell-empty .gcell-pos { color: #94a3b8; }
.gcell-hidden .gcell-pos { color: #1e293b; }

.gcell-filled:active {
  transform: scale(0.94);
}

.gcell-pi {
  font-size: 22rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 92%;
  margin-top: 2rpx;
}

.gcell-exp {
  font-size: 18rpx;
  font-weight: 400;
  color: #1e293b;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 92%;
  margin-top: 2rpx;
}

.gcell-empty-text {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.gcell-hidden-text {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
  margin-top: 2rpx;
}

.gcell-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.18);
  border: 1rpx solid rgba(255,255,255,0.65);
  box-sizing: border-box;
  z-index: 1;
}

.gcell-dot text {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.grid-pad-bottom {
  height: 48rpx;
}

