  background: #eef0f6;
  display: flex;
  flex-direction: column;
}
.booking-full-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #ebedf0;
  box-sizing: border-box;
  flex-shrink: 0;
}
.booking-full-back {
  width: 120rpx;
  font-size: 28rpx;
  color: #323233;
  flex-shrink: 0;
}
.booking-full-back--ghost {
  visibility: hidden;
}
.booking-full-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}
.booking-full-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.mc-item {
  border: 1rpx solid #ebedf0;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: #fff;
}
.mc-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mc-item-pos {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
}
.mc-item-status {
  font-size: 22rpx;
  font-weight: 600;
  color: #646566;
}
.mc-item-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #969799;
}
.mc-item-reject {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #dc2626;
}
.mc-item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 12rpx;
}
.mc-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.mc-btn--primary {
  color: #fff;
  background: #ac1736;
}
.mc-btn--danger {
  color: #fff;
  background: #ef4444;
}

/* 选人弹窗：已选笼位所属课题组提示 */
.rp-groups {
  font-size: 22rpx;
  color: #969799;
  padding: 8rpx 4rpx 0;
  line-height: 1.5;
}
