/* ================================================================== */
/*  扫码定位 FAB（右下悬浮圆形按钮，常驻）                                    */
/* ================================================================== */

.scan-float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #ac1736;
  box-shadow: 0 8rpx 24rpx rgba(172, 23, 54, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 950;
}

.scan-float-btn:active {
  transform: scale(0.92);
  opacity: 0.85;
}

@keyframes scan-flash {
  0% { opacity: 0.2; transform: scale(0.95); }
  30% { opacity: 0.85; transform: scale(1.03); }
  100% { opacity: 0.35; transform: scale(1); }
}

.scan-flash-overlay {
  position: absolute;
  inset: 0;
  z-index: 10;
  border-radius: 8rpx;
  border: 4rpx solid rgba(239, 68, 68, 0.8);
  box-shadow: 0 0 16rpx rgba(239, 68, 68, 0.5);
  animation: scan-flash 0.5s ease-in-out 2;
  pointer-events: none;
}

/* ================================================================== */
/*  扫码确认核对弹窗                                                    */
/* ================================================================== */

