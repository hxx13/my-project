}
.ea-chip-hover {
  opacity: 0.7;
  transform: scale(0.98);
}
.ea-chip-on {
  border-width: 2rpx;
  border-style: solid;
}
.ea-chip-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.2;
}
.ea-chip-mark {
  font-size: 20rpx;
  font-weight: 700;
  width: 26rpx;
  height: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0,0,0,0.08);
  flex-shrink: 0;
}
.ea-photo-section {
  margin-bottom: 16rpx;
}
.ea-photo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.ea-photo-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #646566;
}
.ea-photo-add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ac1736;
}
.ea-photo-add-icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: 400;
  line-height: 1;
}
.ea-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.ea-photo-wrap {
  position: relative;
}
.ea-photo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ebedf0;
}
.ea-photo-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ea-note {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.ea-note textarea {
  width: 100%;
  min-height: 56rpx;
  max-height: 100rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 8rpx;
  font-size: 22rpx;
  box-sizing: border-box;
}
.ea-note-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}
.ea-btn-new-version {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #ac1736;
  background: transparent;
  border: 1px solid #ac1736;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
}
.ea-btn-save {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #ac1736;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
}
.ea-btns {
  display: flex;
  justify-content: center;
  align-items: center;
}
.ea-btn-close {
  width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #323233;
  padding: 18rpx 0;
  border-radius: 12rpx;
  text-align: center;
}
.ea-history {
  border-top: 1rpx solid #ebedf0;
  padding-top: 16rpx;
  margin-bottom: 16rpx;
}
.ea-history-hd {
  font-size: 22rpx;
  font-weight: 600;
  color: #969799;
  margin-bottom: 10rpx;
}
.ea-history-scroll {
  max-height: 240rpx;
}
.ea-history-item {
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ebedf0;
  margin-bottom: 8rpx;
  font-size: 20rpx;
}
.ea-history-item-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ea-history-label {
  font-weight: 600;
}
.ea-history-time {
  color: #969799;
  font-size: 18rpx;
  flex: 1;
}
.ea-history-del {
  color: #ef4444;
  font-size: 24rpx;
  padding: 4rpx;
}
.ea-history-note {
  color: #646566;
  margin-top: 4rpx;
