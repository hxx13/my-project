          </block>
        </block>
      </view>
      <view wx:if="{{ cageTransferDone.length > 0 }}" class="time-group">
        <view class="time-group-head" bindtap="onCageToggleTransferDone">
          <text class="time-group-arrow {{ cageTransferDoneOpen ? 'open' : '' }}">▶</text>
          <text>已审核 ({{ cageTransferDone.length }})</text>
        </view>
        <block wx:if="{{ cageTransferDoneOpen }}">
          <block wx:for="{{ cageTransferDone }}" wx:key="id" wx:for-item="item">
            <template is="cageOpDoneCard" data="{{...item}}" />
          </block>
        </block>
      </view>
    </block>
  </block>

  <!-- 分笼/转移卡片模板 -->
  <template name="cageOpPendingCard">
    <view class="card">
      <view class="row-head">
        <text class="title">{{ applicantText }}</text>
        <text class="tag tag-warn">待审核</text>
      </view>
      <text class="body">{{ sourceLine }}</text>
      <text class="body">{{ targetText }}</text>
      <text wx:if="{{ reason }}" class="body">原因：{{ reason }}</text>
      <view class="card-footer">
        <text wx:if="{{ createdAtText }}" class="meta">{{ createdAtText }}</text>
        <view class="ops">
          <view class="op op-primary" data-id="{{ id }}" catchtap="onCageOpApprove">通过</view>
          <view class="op op-danger" data-id="{{ id }}" catchtap="onCageOpReject">驳回</view>
        </view>
      </view>
    </view>
  </template>

  <template name="cageOpDoneCard">
    <view class="card">
      <view class="row-head">
        <text class="title">{{ applicantText }}</text>
        <text class="tag {{ statusTagClass }}">{{ statusText }}</text>
      </view>
      <text class="body">{{ sourceLine }}</text>
      <text class="body">{{ targetText }}</text>
      <text wx:if="{{ reason }}" class="body">原因：{{ reason }}</text>
      <text wx:if="{{ isRejected && rejectReason }}" class="body">驳回理由：{{ rejectReason }}</text>
      <view class="card-footer">
        <view class="card-footer-info">
          <text wx:if="{{ createdAtText }}" class="meta">{{ createdAtText }}</text>
          <text wx:if="{{ reviewedAtText }}" class="meta">处理于 {{ reviewedAtText }}</text>
          <text wx:if="{{ reviewerName }}" class="meta meta-reviewer">处理人：{{ reviewerName }}</text>
        </view>
      </view>
    </view>
  </template>

  <auto-approve-panel
    visible="{{ autoApproveVisible }}"
    kind="{{ autoApproveKind }}"
    bind:close="onCloseAutoApprove"
    bind:runsuccess="onAutoApproveRunSuccess"
  />
</view>
