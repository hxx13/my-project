.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.intro {
  font-size: 24rpx;
  color: #969799;
  margin-bottom: 16rpx;
}

.tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.tabs {
  display: inline-flex;
  gap: 10rpx;
  padding-bottom: 4rpx;
}

.tab {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dcdee0;
  font-size: 24rpx;
  color: #646566;
  background: #fff;
}

.tab-on {
  color: #ac1736;
  border-color: #ac1736;
  background: rgba(172, 23, 54, 0.08);
  font-weight: 600;
}

.tab-with-badge {
  display: inline-flex;
  align-items: center;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 8rpx;
}

.tab-badge {
  flex-shrink: 0;
  min-width: 28rpx;
  padding: 2rpx 8rpx;
  font-size: 20rpx;
  line-height: 1.25;
  color: #fff;
  background: #ee0a24;
  border-radius: 999rpx;
  text-align: center;
  font-weight: 700;
  box-sizing: border-box;
}

.tab-on .tab-badge {
  background: #ac1736;
}

.hint {
  color: #969799;
  font-size: 24rpx;
  padding: 18rpx 6rpx;
}

.hint.empty {
  text-align: center;
  padding: 80rpx 12rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #ebedf0;
  padding: 20rpx;
  margin-bottom: 14rpx;
  display: flex;
  flex-direction: column;
}

.row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.mono {
  font-size: 22rpx;
  color: #969799;
  font-family: monospace;
}

.title {
  display: block;
  font-size: 28rpx;
  color: #323233;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.muted {
  font-weight: 400;
  color: #969799;
  font-size: 24rpx;
}

.body {
  display: block;
  font-size: 26rpx;
  color: #646566;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.meta {
  display: block;
  font-size: 22rpx;
  color: #969799;
}

.meta-reviewer {
  color: #64748b;
  font-weight: 500;
}

/* ---- 卡片底部：文字与按钮同行 ---- */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.card-footer-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1;
  min-width: 0;
}

.card-footer-info .meta {
  margin-bottom: 0;
}

.ops {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  justify-content: flex-end;
  flex-shrink: 0;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dcdee0;
}

.tag-warn {
  color: #d97706;
  background: #fffbeb;
  border-color: #fcd34d;
}

.tag-ok {
  color: #059669;
  background: #ecfdf5;
  border-color: #6ee7b7;
}

.tag-muted {
  color: #64748b;
  background: #f8fafc;
}

.tag-approved {
  color: #15803d;
  background: #f0fdf4;
  border-color: #86efac;
}

.tag-rejected {
  color: #b91c1c;
  background: #fef2f2;
  border-color: #fecaca;
}

.tag-fulfilled {
  color: #1d4ed8;
  background: #eff6ff;
  border-color: #93c5fd;
}

.tag-received {
  color: #047857;
  background: #ecfdf5;
  border-color: #6ee7b7;
}

.tag-danger {
  color: #dc2626;
  background: #fef2f2;
  border-color: #fecaca;
}

.sub-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.time-group {
  margin-bottom: 18rpx;
}

.time-group-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 4rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
}

.time-group-arrow {
  display: inline-block;
  font-size: 20rpx;
  color: #969799;
  transition: transform 0.12s ease;
}

.time-group-arrow.open {
  transform: rotate(90deg);
}

.sub-tab {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dcdee0;
  font-size: 22rpx;
  color: #646566;
  background: #fff;
}

.sub-tab-on {
  color: #ac1736;
  border-color: #ac1736;
  background: rgba(172, 23, 54, 0.08);
  font-weight: 600;
}

.alert-banner {
  background: #fffbeb;
  border: 1rpx solid #fcd34d;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}

.alert-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 6rpx;
}

.alert-desc {
  display: block;
  font-size: 22rpx;
  color: #b45309;
}

.op {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid #dcdee0;
  color: #646566;
  background: #fff;
  white-space: nowrap;
  flex-shrink: 0;
}

.op-primary {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(135deg, #c41e3a, #ac1736);
}

.op-danger {
  color: #dc2626;
  border-color: #fecaca;
  background: #fef2f2;
}

.op-warn {
  color: #d97706;
  border-color: #fde68a;
  background: #fffbeb;
}

.op-ghost {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
}

.op-on {
  color: #059669;
  border-color: #6ee7b7;
  background: #ecfdf5;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #fff;
  border: 1rpx solid #ebedf0;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}

.spec-expand-btn {
  margin: 8rpx 0 12rpx;
  font-size: 24rpx;
  color: #ac1736;
  text-align: center;
  padding: 8rpx;
}

.switch-label {
  font-size: 26rpx;
  color: #323233;
}

/* ---- Spec item grouping ---- */
.spec-item-group {
  margin-bottom: 16rpx;
}

.spec-item-group-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 4rpx 10rpx 32rpx;
  margin-bottom: 4rpx;
}

.spec-item-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #1a6fb5;
}

.spec-item-dot-muted {
  background: #94a3b8;
}

.spec-item-arrow {
  display: inline-block;
  font-size: 20rpx;
  color: #969799;
  transition: transform 0.12s ease;
  flex-shrink: 0;
}

.spec-item-arrow.open {
  transform: rotate(90deg);
}

.spec-item-arrow-muted {
  color: #94a3b8;
}

.spec-item-group-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a6fb5;
}

.spec-item-group-name-muted {
  color: #64748b;
}

.spec-sub-tag-muted {
  color: #64748b;
  background: #f8fafc;
  border-color: #e2e8f0;
}

.spec-sub-tag {
  display: inline-block;
  margin: 4rpx 0 8rpx 4rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #1989fa;
  background: #ecf4ff;
  border: 1rpx solid #d4e5fc;
  border-radius: 999rpx;
  font-weight: 500;
}

/* ---- ScanDelay option grouping (与 Web ScanDelayOptionGroupedList 同源) ---- */
.option-group {
  margin-bottom: 18rpx;
}

.option-group-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 4rpx 12rpx;
}

.option-group-arrow {
  display: inline-block;
  font-size: 20rpx;
  color: #969799;
  transition: transform 0.12s ease;
  flex-shrink: 0;
}

.option-group-arrow.open {
  transform: rotate(90deg);
}

.option-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.option-group-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
}

.option-group-count {
  font-size: 22rpx;
  color: #969799;
}

/* ---- 待审/已审子分区头 ---- */
.status-sub-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 4rpx 8rpx 60rpx;
}

.status-sub-arrow {
  display: inline-block;
  font-size: 20rpx;
  color: #969799;
  transition: transform 0.12s ease;
  flex-shrink: 0;
}

.status-sub-arrow.open {
  transform: rotate(90deg);
}

.status-sub-label {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

/* ---- 培训审核卡片 ---- */

.session-group {
  margin-bottom: 18rpx;
}

.session-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.session-arrow {
  display: inline-block;
  font-size: 20rpx;
  color: #969799;
  transition: transform 0.12s ease;
  flex-shrink: 0;
}

.session-arrow.open {
  transform: rotate(90deg);
}

.session-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-meta {
  font-size: 22rpx;
  color: #969799;
  flex-shrink: 0;
}

.session-count {
  font-size: 22rpx;
  color: #ac1736;
  font-weight: 600;
  flex-shrink: 0;
}

.aro-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #ebedf0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 12rpx;
}

.aro-card-header {
  width: 100%;
}

.aro-card-done-card {
  opacity: 0.75;
}

.aro-card-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.aro-card-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #323233;
}

.aro-card-group {
  font-size: 22rpx;
  color: #1989fa;
  background: #ecf4ff;
  border: 1rpx solid #d4e5fc;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.aro-card-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dcdee0;
}

.aro-card-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.aro-card-meta {
  font-size: 24rpx;
  color: #646566;
}

.aro-card-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.aro-card-done {
  font-size: 22rpx;
  color: #969799;
}

/* split button：通过/合格 + 右侧小▼ — 品牌红，小号圆角 */
.aro-split-btn {
  display: inline-flex;
  align-items: stretch;
  border-radius: 20rpx;
  overflow: hidden;
}

.aro-split-main {
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

.aro-split-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #c41e3a, #ac1736);
  color: #fff;
  font-size: 16rpx;
  padding: 0 12rpx;
  border-left: 1rpx solid rgba(255,255,255,0.25);
}

/* 拒绝/不合格 下拉 */
.aro-more-dropdown {
  display: flex;
  gap: 8rpx;
  padding: 6rpx 0 0;
}
