/* 禁止页面级滚动，仅由内部 scroll-view 处理滚动 */

page {
  overflow: hidden;
}

.page {
  position: relative;
  box-sizing: border-box;
  background: #f4f5f7;
  overflow: hidden;
}

/* 搜索栏 + 提示条：fixed 钉在导航下方，彻底脱离 scroll-view 原生层 */
.mall-header-fixed {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 900;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 1px 0 #ebecef;
}

.mall-header-placeholder {
  flex-shrink: 0;
  width: 100%;
}

/* 顶栏：搜索 50% + 右侧入口横滑（内联样式，不依赖 @import） */
.mall-top-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: #fff;
  border-bottom: 1px solid #ebecef;
  box-sizing: border-box;
  width: 100%;
  min-height: 46px;
}

.mall-top-search {
  flex: 1;
  min-width: 0;
}

.mall-top-search-input {
  display: block;
  width: 100%;
  height: 30px;
  line-height: 30px;
  padding: 0 10px;
  font-size: 12px;
  border-radius: 999px;
  border: 1px solid #e6e8eb;
  background: #f7f8fa;
  box-sizing: border-box;
}

.mall-top-actions-wrap {
  flex: 0 1 auto;
  min-width: 0;
}

.mall-top-actions-scroll {
  width: auto;
  height: 32px;
}

.mall-top-actions {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding-right: 4px;
  white-space: nowrap;
}

.mall-top-pill {
  flex-shrink: 0;
  font-size: 11px;
  line-height: 1;
  padding: 7px 10px;
  border-radius: 999px;
  color: #576b95;
  background: #f0f2f5;
  border: 1px solid #e6e8eb;
}

.mall-top-pill-admin {
  color: #1989fa;
  background: #ecf4ff;
  border-color: #d4e5fc;
  padding: 6px 10px;
  font-size: 11px;
}

/* 内联更新标签 — 替代独立 novelty-hint 横幅，与搜索栏同行不占额外空间 */
.mall-top-pill-novelty-new {
  flex-shrink: 0;
  position: relative;
  font-size: 10px;
  line-height: 1;
  padding: 5px 8px;
  border-radius: 999px;
  color: #b54708;
  background: #fff4e5;
  border: 1px solid #ffd7b0;
}

.mall-top-pill-novelty-inbound {
  flex-shrink: 0;
  position: relative;
  font-size: 10px;
  line-height: 1;
  padding: 5px 8px;
  border-radius: 999px;
  color: #027a48;
  background: #ecfdf3;
  border: 1px solid #a7e5c2;
}

.mall-top-pill-process {
  color: #ed6a0c;
  background: #fff7ef;
  border-color: #ffd7b0;
}

.mall-top-mini-badge {
  display: inline-block;
  vertical-align: middle;
  margin-left: 3px;
  height: 14px;
  line-height: 15px;
  padding: 0 4px;
  font-size: 9px;
  font-weight: 700;
  color: #fff;
  background: #ee0a24;
  border-radius: 999px;
  text-align: center;
  box-sizing: border-box;
  transform: scale(0.92);
  transform-origin: left center;
}

.mall-top-mini-badge-mine {
  background: linear-gradient(135deg, #3d9eff, #1989fa);
}

.mall-top-pill-hover {
  opacity: 0.82;
}

.main-split {
  width: 100%;
  display: flex;
  flex-direction: row;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.novelty-hint {
  flex-shrink: 0;
  margin: 0 10px 6px;
  padding: 7px 10px;
  border: 1px solid #ffd591;
  background: #fff7e6;
  color: #ad4e00;
  border-radius: 8px;
  font-size: 12px;
  line-height: 1.4;
}

.cat-side {
  width: 84px;
  flex-shrink: 0;
  background: #fff;
  border-right: 1px solid #ebecef;
  box-sizing: border-box;
}

.cat-item {
  padding: 11px 6px;
  font-size: 12px;
  color: #646566;
  text-align: center;
  border-left: 2px solid transparent;
  line-height: 1.35;
}

.cat-item-on {
  color: #1989fa;
  font-weight: 600;
  background: #f4f9ff;
  border-left-color: #1989fa;
}

.content-side {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding: 8px 10px 6px;
}

.content-muted {
  font-size: 13px;
  color: #969799;
  text-align: center;
  padding: 40px 0;
}

.content-pad-bottom {
  height: 8px;
}

.goods-card {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: #fff;
  border-radius: 10px;
  margin-bottom: 8px;
  border: 1px solid #ebecef;
  overflow: hidden;
  padding: 8px 10px;
  gap: 10px;
}

.goods-cover-sm {
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  border-radius: 8px;
  background: #f2f3f5;
}

.goods-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-ph-sm {
  font-size: 16px;
  font-weight: 600;
  color: #c8c9cc;
}

.goods-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-step-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}

.goods-name-wrap {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-weight: 600;
  font-size: 14px;
  color: #323233;
  line-height: 1.3;
}

.goods-novelty-tag {
  display: inline-block;
  margin-left: 6px;
  padding: 1px 6px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  line-height: 1.5;
}

.goods-novelty-new {
  color: #b54708;
  background: #fff4e5;
}

.goods-novelty-inbound {
  color: #027a48;
  background: #ecfdf3;
}

.goods-sub-inline {
  display: block;
  font-size: 11px;
  color: #969799;
  margin-top: 2px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-stock-line {
  font-size: 11px;
  color: #969799;
  margin-top: 4px;
}

.step-inline {
  flex-shrink: 0;
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  border: 1px solid #dcdee0;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
}

.step-bottom {
  position: absolute;
  right: 10px;
  bottom: 10px;
}

.sku-add-row {
  position: absolute;
  right: 10px;
  bottom: 10px;
}

.si-btn {
  width: 28px;
  height: 28px;
  line-height: 28px;
  text-align: center;
  font-size: 16px;
  color: #323233;
}

.si-btn-off {
  opacity: 0.35;
  pointer-events: none;
}

.si-btn-plus {
  color: #fff;
  background: #1989fa;
}

.si-btn-hover {
  opacity: 0.88;
}

.si-num-input {
  width: 38px;
  height: 24px;
  text-align: center;
  font-size: 12px;
  font-weight: 600;
  color: #323233;
  padding: 0 2px;
  background: #f7f8fa;
  border-left: 1px solid #ebecef;
  border-right: 1px solid #ebecef;
  box-sizing: border-box;
  line-height: 24px;
}

.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid #ebecef;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  z-index: 100;
  backdrop-filter: blur(10px);
}

.cart-entry {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88px;
  padding: 10px 14px;
  border-radius: 999px;
  background: #f7f8fa;
  border: 1px solid #e6e8eb;
}

.cart-entry-hover {
  opacity: 0.9;
}

.cart-entry-txt {
  font-size: 14px;
  font-weight: 500;
  color: #323233;
}

.cart-badge {
  position: absolute;
  top: 2px;
  right: 6px;
  min-width: 16px;
  height: 16px;
  line-height: 16px;
  padding: 0 4px;
  font-size: 10px;
  color: #fff;
  text-align: center;
  background: #ee0a24;
  border-radius: 999px;
}

.cart-submit {
  flex: 1;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  padding: 11px 16px;
  border-radius: 999px;
  background: linear-gradient(180deg, #42a5f5 0%, #1989fa 100%);
  box-shadow: 0 4px 12px rgba(25, 137, 250, 0.22);
}

.cart-submit-hover {
  opacity: 0.92;
}

.cart-submit-disabled {
  opacity: 0.45;
  pointer-events: none;
  box-shadow: none;
}

.sheet-head {
  padding: 16px;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  border-bottom: 1px solid #f2f3f5;
}

.sheet-scroll {
  max-height: 52vh;
  padding: 0 12px 8px;
  box-sizing: border-box;
}

.sheet-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f2f3f5;
  gap: 10px;
}

.sheet-thumb {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  flex-shrink: 0;
  background: #f2f3f5;
}

.sheet-thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #c8c9cc;
  font-weight: 600;
}

.sheet-mid {
  flex: 1;
  min-width: 0;
}

.sheet-name {
  font-size: 14px;
  color: #323233;
  font-weight: 500;
  display: block;
}

.sheet-qty {
  font-size: 12px;
  color: #969799;
  margin-top: 4px;
  display: block;
}

.sheet-step-inline {
  margin-top: 6px;
  display: inline-flex;
  align-items: center;
  border: 1px solid #dcdee0;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
}

.sheet-si-btn {
  width: 24px;
  height: 24px;
  line-height: 24px;
  font-size: 14px;
}

.sheet-si-num-input {
  width: 34px;
  height: 24px;
  line-height: 24px;
  font-size: 12px;
}

.sheet-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid #f2f3f5;
  background: #fafbfc;
}

.sheet-total {
  font-size: 14px;
  color: #646566;
}

.sheet-btn {
  font-size: 14px;
  color: #1989fa;
  padding: 6px 12px;
}

.sheet-btn-primary {
  color: #fff;
  background: #1989fa;
  border-radius: 999px;
  font-weight: 600;
  padding: 8px 18px;
}

.sheet-btn-clear {
  color: #ee0a24;
  margin-right: auto;
}

.sheet-foot-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sheet-remark-input {
  margin-top: 6px;
  width: 100%;
  border: 1px solid #ebedf0;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 12px;
  box-sizing: border-box;
  color: #323233;
}

/* 备注折叠/展开 */
.sheet-remark-toggle {
  margin-top: 4px;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 2px 0;
}

.sheet-remark-toggle-label {
  font-size: 11px;
  color: #969799;
}

.sheet-remark-toggle-arrow {
  font-size: 10px;
  color: #c8c9cc;
  min-width: 14px;
  text-align: center;
}

.sheet-remark-collapsed-text {
  font-size: 11px;
  color: #646566;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

/* 确认弹窗 */
.pop-root {
  display: flex;
  flex-direction: column;
  max-height: 76vh;
}

.pop-top {
  padding: 24rpx;
  border-bottom: 1px solid #f2f3f5;
}

.pop-title {
  display: block;
  font-size: 30rpx;
  color: #323233;
  font-weight: 600;
}

.pop-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #969799;
}

.pop-split-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ed6a0c;
}

.pop-scroll {
  max-height: 48vh;
  padding: 0 24rpx 8rpx;
  box-sizing: border-box;
}

.pop-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #f2f3f5;
}

.pop-btn {
  min-width: 160rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 10rpx;
  padding: 12rpx 10rpx;
}

.pop-btn.ghost {
  color: #646566;
  border: 1px solid #dcdee0;
  background: #fff;
}

.pop-btn.primary {
  color: #fff;
  background: #1989fa;
}

.pop-btn-disabled {
  opacity: 0.5;
}

.confirm-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1px dashed #eceef0;
}

.confirm-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  border: 1px solid #ebedf0;
  flex-shrink: 0;
}

.confirm-thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f6f7;
  color: #969799;
  font-size: 28rpx;
}

.confirm-mid {
  flex: 1;
  min-width: 0;
}

.confirm-name {
  display: block;
  font-size: 26rpx;
  color: #323233;
}

.confirm-qty {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

.confirm-remark-input {
  margin-top: 8rpx;
  width: 100%;
  border: 1px solid #ebedf0;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  color: #323233;
}

.confirm-remark-toggle {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 2rpx 0;
}

.confirm-remark-toggle-label {
  font-size: 22rpx;
  color: #969799;
}

.confirm-remark-toggle-arrow {
  font-size: 18rpx;
  color: #c8c9cc;
  min-width: 28rpx;
  text-align: center;
}

.confirm-remark-collapsed-text {
  font-size: 22rpx;
  color: #646566;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

/* ── 合并到待处理订单弹窗 ─────────────────────── */
.merge-order-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 10rpx;
  border-bottom: 1px dashed #eceef0;
  border-radius: 8rpx;
}

.merge-order-line-on {
  background: #f4f9ff;
}

.merge-radio {
  width: 30rpx;
  height: 30rpx;
  border-radius: 999px;
  border: 1px solid #dcdee0;
  background: #fff;
  box-sizing: border-box;
  flex-shrink: 0;
}

.merge-radio-on {
  border: 8rpx solid #1989fa;
}

.merge-order-mid {
  flex: 1;
  min-width: 0;
}

.merge-order-id {
  display: block;
  font-size: 26rpx;
  color: #323233;
  font-weight: 500;
}

.merge-order-time {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

/* 分组小标题：常规物资 / 独立下单物资 */
.merge-sec-head {
  font-size: 22rpx;
  color: #969799;
  margin: 16rpx 0 4rpx;
}

/* 订单行小字物资摘要（防护服×2、手套×1 等N项） */
.merge-order-items {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 目标单含相同物资时的追加数量提示 */
.merge-order-append {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #ed6a0c;
}

/* 静态行（唯一匹配 / 新建独立订单）：无单选圈 */
.merge-order-static {
  padding-left: 10rpx;
}

/* 独立物资多目标时的组内标题 */
.merge-indep-title {
  font-size: 24rpx;
  color: #323233;
  font-weight: 500;
  margin: 10rpx 0 2rpx;
}

/* ── Spec SKU panel ────────────────────────────── */
.sku-panel {
  margin-top: 6px;
  padding: 6px 0 0;
  border-top: 1px dashed #ebecef;
}

.sku-dim-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 4px;
  gap: 6px;
}

.sku-dim-label {
  font-size: 11px;
  color: #969799;
  line-height: 22px;
  flex-shrink: 0;
  min-width: 28px;
}

.sku-dim-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  flex: 1;
  min-width: 0;
}

.sku-chip {
  padding: 2px 10px;
  font-size: 11px;
  border-radius: 999px;
  border: 1px solid #dcdee0;
  color: #646566;
  background: #fff;
  line-height: 1.6;
}

.sku-chip-on {
  color: #fff;
  background: #1989fa;
  border-color: #1989fa;
}

.sku-add-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
}

.sku-required-hint {
  font-size: 10px;
  color: #ee0a24;
}

.sku-required-banner {
  font-size: 11px;
  color: #ee0a24;
  margin-top: 4px;
  padding: 3px 8px;
  background: #fff0f0;
  border-radius: 4px;
}

/* ── Spec label in sheet / confirm ─────────────── */
.sheet-spec {
  display: block;
  font-size: 11px;
  color: #1989fa;
  margin-top: 2px;
}

.confirm-spec {
  display: block;
  font-size: 22rpx;
  color: #1989fa;
  margin-top: 2rpx;
}
