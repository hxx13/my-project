.page {
  padding: 16px 14px 24px;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef5ff 0%, #f7f8fa 120px);
}
.tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 14px;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 10px 14px;
  border-radius: 999px;
  border: 1px solid #e3e8ef;
  color: #646566;
  background: rgba(255, 255, 255, 0.85);
  font-size: 13px;
  box-shadow: 0 2px 8px rgba(31, 56, 88, 0.06);
}
.tab-on {
  color: #1989fa;
  border-color: rgba(25, 137, 250, 0.35);
  background: rgba(255, 255, 255, 0.98);
  font-weight: 600;
  box-shadow: 0 4px 14px rgba(25, 137, 250, 0.12);
}
.tab-with-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.tab-badge {
  min-width: 28rpx;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 20rpx;
  line-height: 1.25;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff7875 0%, #ee0a24 100%);
  box-shadow: 0 2px 8px rgba(238, 10, 36, 0.25);
}
.muted {
  font-size: 13px;
  color: #969799;
  text-align: center;
  padding: 24px 0;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.row-card {
  background: #fff;
  border-radius: 18px;
  padding: 16px 18px;
  border: 1px solid rgba(235, 238, 239, 0.9);
  box-shadow: 0 4px 18px rgba(31, 56, 88, 0.07);
}
.row-card-muted {
  opacity: 0.96;
  border-style: dashed;
}
.row-title {
  font-size: 15px;
  font-weight: 600;
  color: #323233;
}
.row-sub {
  font-size: 12px;
  color: #646566;
  margin-top: 6px;
}
.row-extra {
  font-size: 12px;
  color: #07c160;
  margin-top: 6px;
}
.row-hint {
  font-size: 11px;
  color: #c8c9cc;
  margin-top: 8px;
}
.row-hint-link {
  color: #1989fa;
}
.row-hint-danger {
  color: #ee0a24;
}
.row-ops {
  margin-top: 12px;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
}
.btn-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 18px;
  border-radius: 999px;
  font-size: 13px;
  line-height: 1.2;
  border: 1px solid transparent;
}
.btn-pill-primary {
  color: #fff;
  background: linear-gradient(135deg, #3d9eff 0%, #1989fa 100%);
  border-color: rgba(25, 137, 250, 0.2);
  box-shadow: 0 4px 12px rgba(25, 137, 250, 0.28);
}
.btn-pill-ghost {
  color: #1989fa;
  background: rgba(25, 137, 250, 0.08);
  border-color: rgba(25, 137, 250, 0.22);
}
.btn-pill-danger {
  color: #ee0a24;
  background: rgba(238, 10, 36, 0.06);
  border-color: rgba(238, 10, 36, 0.2);
}
.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  font-size: 13px;
  color: #646566;
  margin: 20px 0 10px;
}
.pager-rounded .pager-btn {
  padding: 8px 20px;
  border-radius: 999px;
  background: #fff;
  border: 1px solid #e3e8ef;
  color: #1989fa;
  box-shadow: 0 2px 8px rgba(31, 56, 88, 0.06);
}
.pager-num {
  color: #323233;
  font-weight: 600;
  min-width: 28px;
  text-align: center;
}

.detail-root {
  display: flex;
  flex-direction: column;
  max-height: 78vh;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

.detail-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}

.detail-status-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1.3;
  padding: 4rpx 12rpx;
  border-radius: 999px;
  border: 1px solid #e3e8ef;
}

.detail-status-warn {
  color: #d97706;
  background: #fffbeb;
  border-color: #fcd34d;
}

.detail-status-ok {
  color: #059669;
  background: #ecfdf5;
  border-color: #6ee7b7;
}

.detail-status-muted {
  color: #646566;
  background: #f7f8fa;
  border-color: #ebedf0;
}

.detail-meta-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #969799;
  line-height: 1.4;
}

.detail-meta-extra {
  display: block;
  font-size: 20rpx;
  color: #b0b3b8;
  line-height: 1.35;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.detail-scroll {
  flex: 1;
  min-height: 240rpx;
  max-height: 58vh;
}

.detail-line {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 14rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 14rpx;
  border: 1px solid #eceef0;
  box-shadow: 0 2rpx 10rpx rgba(31, 56, 88, 0.04);
}

.detail-thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 12rpx;
  border: 1px solid #ebedf0;
  flex-shrink: 0;
  background: #f5f6f7;
}

.detail-thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #969799;
  font-size: 36rpx;
  font-weight: 600;
}

.detail-mid {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.detail-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  line-height: 1.35;
  display: block;
}

.detail-spec {
  display: block;
  font-size: 22rpx;
  color: #1989fa;
  margin-top: 4rpx;
  line-height: 1.3;
}

.detail-qty-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}

.detail-qty-main {
  font-size: 32rpx;
  font-weight: 700;
  color: #1989fa;
  line-height: 1.2;
}

.detail-qty-sub {
  font-size: 22rpx;
  color: #969799;
}

.detail-remark {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #969799;
  line-height: 1.4;
}

.detail-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #f2f3f5;
  flex-shrink: 0;
}

.detail-foot-btn {
  padding: 10rpx 28rpx;
  border-radius: 999px;
  font-size: 26rpx;
  line-height: 1.3;
}

.detail-foot-btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #3d9eff 0%, #1989fa 100%);
  box-shadow: 0 4rpx 12rpx rgba(25, 137, 250, 0.22);
}

.detail-foot-btn-ghost {
  color: #646566;
  background: #f7f8fa;
}

.confirm-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.confirm-box {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.12);
}
.confirm-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
}
.confirm-body {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 32rpx;
}
.confirm-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}
.confirm-btn {
  min-width: 160rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.confirm-btn.ghost {
  background: #f1f5f9;
  color: #475569;
}
.confirm-btn.danger {
  background: linear-gradient(135deg, #f43f5e, #fb7185);
  color: #fff;
}
