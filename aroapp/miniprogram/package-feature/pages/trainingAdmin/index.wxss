/* 培训管理（教职工端）：卡片语言与小程序其它页一致，按钮走全局 .chip-btn */
.page {
  padding: 16px 14px 88px;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef5ff 0%, #f7f8fa 120px);
}
.search-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.search-input {
  flex: 1;
  height: 40px;
  padding: 0 14px;
  border-radius: 12rpx;
  background: #fff;
  border: 1px solid #e3e8ef;
  font-size: 13px;
  color: #1f2937;
  box-sizing: border-box;
}
.muted {
  font-size: 13px;
  color: #969799;
  text-align: center;
  padding: 24px 0;
}

/* 校区切换：纯文字 */
.campus-tabs {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12px;
}
.campus-tabs-inner {
  display: inline-flex;
  flex-direction: row;
  gap: 32rpx;
  padding-bottom: 2px;
}
.campus-tab {
  flex-shrink: 0;
  font-size: 13px;
  color: #64748b;
}
.campus-tab-on {
  color: #2563eb;
  font-weight: 600;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.row-card {
  background: #fff;
  border-radius: 18px;
  padding: 16px 18px;
  border: 1px solid rgba(235, 238, 239, 0.9);
  box-shadow: 0 4px 18px rgba(31, 56, 88, 0.07);
}
.row-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.row-title {
  flex: 1;
  font-size: 15px;
  font-weight: 600;
  color: #323233;
}
.status-tag {
  flex-shrink: 0;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  border: 1px solid #e3e8ef;
}
.status-ok {
  color: #059669;
  background: #ecfdf5;
  border-color: #6ee7b7;
}
.status-muted {
  color: #64748b;
  background: #f1f3f7;
  border-color: #dcdee0;
}

.meta-line {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 8rpx;
  font-size: 12px;
}
.meta-k {
  width: 96rpx;
  flex-shrink: 0;
  color: #969799;
}
.meta-v {
  flex: 1;
  color: #646566;
  word-break: break-all;
}

.row-ops {
  margin-top: 14px;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
}

.bottombar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #ebedf0;
  box-shadow: 0 -4px 18px rgba(31, 56, 88, 0.06);
}
