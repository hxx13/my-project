/** 领用物资 / 学生申领 共用顶栏：左搜索 + 右入口横向滚动，避免窄屏挤压 */
.top-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding: 8px 14px 6px;
  background: #fff;
  border-bottom: 1px solid #ebecef;
  box-sizing: border-box;
}

.top-search {
  flex: 0 0 38%;
  min-width: 128px;
  max-width: 200px;
}

.top-search-input {
  width: 100%;
  height: 30px;
  line-height: 30px;
  padding: 0 10px;
  font-size: 12px;
  border-radius: 999px;
  border: 1px solid #e6e8eb;
  background: #f7f8fa;
  box-sizing: border-box;
}

.top-actions-scroll {
  flex: 1;
  min-width: 0;
  height: 32px;
}

.top-actions {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding-right: 2px;
  white-space: nowrap;
}

.top-pill {
  flex-shrink: 0;
  font-size: 12px;
  line-height: 1;
  padding: 7px 12px;
  border-radius: 999px;
  color: #576b95;
  background: #f0f2f5;
  border: 1px solid #e6e8eb;
}

.top-pill-admin {
  color: #1989fa;
  background: #ecf4ff;
  border-color: #d4e5fc;
  padding: 6px 11px;
  font-size: 11px;
}

.top-pill-process {
  color: #ed6a0c;
  background: #fff7ef;
  border-color: #ffd7b0;
}

.top-pill-badge-wrap {
  position: relative;
  padding-right: 14px;
}

.top-pill-mine-wrap {
  position: relative;
  padding-right: 14px;
}

.top-pill-mini-badge {
  position: absolute;
  top: -7px;
  right: -4px;
  min-width: 16px;
  height: 16px;
  line-height: 16px;
  padding: 0 5px;
  font-size: 10px;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #ff6034, #ee0a24);
  border-radius: 999px;
  text-align: center;
  box-sizing: border-box;
  border: 1px solid #fff;
}

.top-pill-mine-badge {
  background: linear-gradient(135deg, #3d9eff, #1989fa);
}

.top-pill-hover {
  opacity: 0.82;
}
