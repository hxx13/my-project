.ltp {
  display: block;
  width: 100%;
}

.ltp-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 80rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #ebecef;
  background: #fff;
  box-sizing: border-box;
}

.ltp-trigger-hover {
  background: #f7f8fa;
  border-color: #d4e5fc;
}

.ltp-trigger-disabled {
  opacity: 0.5;
}

.ltp-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ltp-placeholder {
  color: #9aa0a6;
}

.ltp-arrow {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9aa0a6;
}

/* ── 底部弹出面板 ── */
.ltp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}

.ltp-panel {
  width: 100%;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  padding-bottom: env(safe-area-inset-bottom);
}

.ltp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
}

.ltp-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.ltp-close {
  font-size: 26rpx;
  color: #8a8f98;
}

.ltp-search {
  position: relative;
  margin: 0 28rpx 12rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f5f6f7;
}

.ltp-input {
  height: 72rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  padding-right: 40rpx;
}

.ltp-clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #9aa0a6;
}

.ltp-list {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
  padding: 0 16rpx 16rpx;
}

.ltp-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding-right: 16rpx;
  border-radius: 12rpx;
}

.ltp-row-selected {
  background: rgba(25, 137, 250, 0.1);
}

.ltp-chevron {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  flex-shrink: 0;
  text-align: center;
  border-radius: 10rpx;
  font-size: 30rpx;
  color: #9aa0a6;
}

.ltp-chevron-hover {
  background: #eceff3;
}

/* 叶子节点的占位：只为缩进对齐，不接收点击（点它应命中整行的选中） */
.ltp-chevron-gap {
  width: 68rpx;
  flex-shrink: 0;
}

.ltp-icon {
  flex-shrink: 0;
  font-size: 30rpx;
  line-height: 1;
}

.ltp-name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ltp-row-selected .ltp-name {
  color: #1989fa;
  font-weight: 600;
}

.ltp-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9aa0a6;
}
