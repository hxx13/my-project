/* ═══════════════════════════════════════════════════════════════
   ⚠️  AI 复用须知 — 修改任何弹窗/面板 CSS 前务必阅读
   ═══════════════════════════════════════════════════════════════

   【面板高度规则】
     凡 flex-direction: column + 子元素 flex: 1 的弹窗面板，
     必须同时设置 height 和 max-height，禁止只设 max-height。
     只设 max-height 会导致 flex 父元素高度 = 内容高度，
     子元素 flex:1 的「剩余空间」恒为 0 → scroll-view 塌缩到 0×0。

   【按钮颜色规则】同一界面只允许一个实心主按钮
     实心主操作: #2563EB（蓝）/ 实心危险: #DC2626（仅「清空全部」）
     次级/取消: #F1F3F7 底 + #334155 字（无边框）
     次级强调: #EFF4FF 底 + #1D4ED8 字 / 次级危险: #FEF1F1 底 + #B91C1C 字
     禁止再新增实心色块；新按钮先复用 .ui-btn-plain / .panel-close

   【保留不动】
     悬浮扫码: #f97316 橙（唯一橙色实心，语义=扫码）

     参考面板: .batch-panel (height + max-height 正确写法)
   ═══════════════════════════════════════════════════════════════ */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f2f3f5;
  padding: 20rpx;
  box-sizing: border-box;
}

.card {
  flex-shrink: 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

/* ── 列表面板（flex 填充剩余空间） ── */
.list-panel {
  flex: 1;
  min-height: 0;
  background: #f6f7fb;
  border-radius: 16rpx;
  overflow: hidden;
}

.list-scroll {
  height: 100%;
  padding: 16rpx 20rpx 20rpx;
  box-sizing: border-box;
}

/* ── 标题行 ── */
.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  flex: 0 0 auto;
  white-space: nowrap;
}

.title-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1 1 auto;
  flex-wrap: wrap;
  justify-content: flex-end;
  min-width: 0;
}

/* ── 基础按钮 ── */
.ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 10rpx;
  white-space: nowrap;
  text-align: center;
  font-size: 24rpx;
  line-height: 1;
  border: none;
  height: 56rpx;
  padding: 0 16rpx;
  font-weight: 500;
  gap: 4rpx;
}

/* ── 标题行按钮：只有「添加」是实心主按钮 ── */
.ui-btn-add {
  background: #2563eb;
  color: #ffffff;
}

.ui-btn-export {
  background: #f1f3f7;
  color: #334155;
}

.ui-btn-transfer {
  background: #f1f3f7;
  color: #334155;
}

/* ── 搜索栏 ── */
.search-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.search-input-wrap {
  position: relative;
  flex: 1 1 auto;
  min-width: 0;
}

.search-input {
  width: 100%;
  height: 56rpx;
  border: 1rpx solid #e4e8ef;
  border-radius: 10rpx;
  padding: 0 106rpx 0 16rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: normal;
}

/* 降低 placeholder 透明度（不影响输入文字） */
.search-input::placeholder,
.search-input::-webkit-input-placeholder {
  color: #b0b8c4;
  opacity: 1;
}

.scan-btn {
  position: absolute;
  right: 8rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-top: -22rpx;
  border: none;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  background: #f1f3f7;
}

.clear-btn {
  position: absolute;
  right: 56rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-top: -22rpx;
  border: none;
  border-radius: 10rpx;
  color: #94a3b8;
  background: #f1f3f7;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
  overflow: hidden;
}

.ui-btn-search-main {
  background: #2563eb;
  color: #ffffff;
  height: 56rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  min-width: 80rpx;
}

.ui-btn-search-sub {
  background: #f1f3f7;
  color: #334155;
  height: 56rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  min-width: 80rpx;
}

.ui-btn-search-filter {
  background: #f1f3f7;
  color: #334155;
  height: 56rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  min-width: 80rpx;
}

.ui-btn-search-filter.filter-active {
  background: #eff4ff;
  color: #1d4ed8;
}

/* 筛选条件下拉区域 */
.filter-drop {
  margin-top: 2rpx;
}

/* Vant 筛选组件紧凑化 */
.filter-drop .van-dropdown-menu__bar {
  height: 56rpx !important;
  box-shadow: none !important;
}

.filter-drop .van-dropdown-menu__title {
  font-size: 22rpx !important;
  line-height: 56rpx !important;
  padding: 0 14rpx !important;
}

.filter-drop .van-dropdown-menu__title::after {
  right: 2rpx !important;
  margin-left: 2rpx !important;
}

/* ── 文件夹导航（面包屑 + 子文件夹入口） ── */
.folder-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 8rpx 8rpx;
}

.folder-crumb {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.folder-crumb-item {
  font-size: 25rpx;
  color: #2563eb;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.folder-crumb-current {
  color: #1a1a1a;
  font-weight: 600;
}

.folder-crumb-sep {
  margin: 0 8rpx;
  font-size: 22rpx;
  color: #c0c4cc;
}

.folder-back {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ebecef;
  background: #fff;
  font-size: 23rpx;
  color: #4b5563;
}

.folder-list {
  margin-bottom: 12rpx;
}

.folder-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f3f7;
}

.folder-item-icon {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
}

.folder-item-name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.folder-item-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9aa0a6;
}

.folder-item-arrow {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #c0c4cc;
}

/* ── 扫码归位 ── */
.folder-relocate {
  border-color: #d4e5fc;
  color: #2563eb;
}

.relocate-bar {
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d4e5fc;
  background: #eff4ff;
}

.relocate-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.relocate-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d4ed8;
}

.relocate-count {
  font-size: 22rpx;
  color: #4b72d1;
}

.relocate-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.relocate-btn {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #c7d7f5;
  background: #fff;
  font-size: 23rpx;
  color: #4b5563;
}

.relocate-btn-on {
  border-color: #2563eb;
  color: #2563eb;
}

.relocate-btn-primary {
  border-color: #2563eb;
  background: #2563eb;
  color: #fff;
}

.relocate-btn-disabled {
  opacity: 0.45;
}

.relocate-staged {
  margin-bottom: 12rpx;
}

.staged-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  border: 1rpx dashed #9dbdf0;
  background: #f7faff;
}

.staged-main {
  flex: 1;
  min-width: 0;
}

.staged-name {
  font-size: 26rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.staged-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #7c8798;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.staged-remove {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ebecef;
  background: #fff;
  font-size: 22rpx;
  color: #9aa0a6;
}

.list-section-title {
  padding: 12rpx 8rpx 6rpx;
  font-size: 23rpx;
  color: #8a8f98;
}

/* ── 资产卡片 ── */
.asset-item-card {
  position: relative;
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
}

.item-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  min-width: 0;
}

.item-row-label {
  min-width: 132rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.item-row-value {
  flex: 1;
  min-width: 0;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.item-row-with-actions {
  position: relative;
}

.item-row-value-with-actions {
  padding-right: 304rpx;
}

.inline-card-actions {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  z-index: 2;
}

.inline-card-actions .ui-btn {
  background: #f1f3f7;
  color: #334155;
  font-size: 22rpx;
  height: 52rpx;
  min-width: 80rpx;
  padding: 0 14rpx;
  font-weight: 500;
}

/* 卡片按钮：一律次级色，只有「详情」带强调色 */
.inline-card-actions .ui-btn.ui-btn-batch-add {
  background: #f1f3f7;
  color: #334155;
}

.inline-card-actions .ui-btn.ui-btn-batch-remove {
  background: #fef1f1;
  color: #b91c1c;
}

.inline-card-actions .ui-btn.ui-btn-transfer-card {
  background: #f1f3f7;
  color: #334155;
}

.inline-card-actions .ui-btn.ui-btn-detail-card {
  background: #eff4ff;
  color: #1d4ed8;
}

/* ── 通用面板/Mask ── */
.meta {
  color: #64748b;
  font-size: 26rpx;
  text-align: center;
  padding: 30rpx 0;
}

.input {
  flex: 1;
  border: 1rpx solid #e4e8ef;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  min-width: 0;
  height: 56rpx;
  line-height: normal;
}

.row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.panel {
  width: 100%;
  max-height: 90vh;
  background: #fff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  padding: 20rpx;
  overflow-y: auto;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  flex-shrink: 0;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
}

.panel-actions {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

/* 面板操作按钮统一基底（无边框，靠底色分层） */
.panel-act-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
  border: none;
  box-sizing: border-box;
}

/* 编辑 */
.panel-act-edit {
  background: #f1f3f7;
  color: #334155;
}

/* 保存 */
.panel-act-save {
  background: #2563eb;
  color: #ffffff;
}

/* 扫码填充 */
.panel-act-scan {
  background: #eff4ff;
  color: #1d4ed8;
}

/* 关闭 */
.panel-act-close {
  background: #f1f3f7;
  color: #334155;
}

/* 加入批量 */
.panel-act-add {
  background: #eff4ff;
  color: #1d4ed8;
}

/* 移出批量 */
.panel-act-remove {
  background: #fef1f1;
  color: #b91c1c;
}

/* 通用关闭/操作按钮（其他面板沿用） */
.panel-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #334155;
  background: #f1f3f7;
  border: none;
}

.panel-close-primary {
  color: #ffffff;
  background: #2563eb;
}

.field {
  margin-bottom: 18rpx;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
}

.value {
  font-size: 28rpx;
  color: #1e293b;
}

.detail-edit-input {
  font-size: 28rpx;
  padding: 0 14rpx;
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  min-width: 0;
}

/* ── 详情面板 ── */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20rpx;
}

/* ── 资产详情面板 ── */
/* ⚠️ height + max-height 双写规则见文件顶部，禁止回退为仅 max-height */
.detail-panel {
  width: 92vw;
  height: 82vh;
  max-height: 82vh;
  background: #f6f7fb;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.detail-scroll {
  flex: 1;
  max-height: 64vh;
}

/* 详情内容卡片 */
.detail-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f1f3f7;
  min-height: 56rpx;
}
.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  min-width: 120rpx;
  font-size: 26rpx;
  color: #64748b;
  flex: 0 0 auto;
  line-height: 1.4;
}
.detail-label-empty {
  color: #94a3b8;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
  word-break: break-all;
  line-height: 1.4;
}
.detail-value-empty {
  color: #94a3b8;
}
.detail-value-status {
  font-weight: 600;
}

.detail-transfer-card {
  border-left: 4rpx solid #d97706;
}

/* 字段分组标题（与展开更多按钮风格统一） */
.detail-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.group-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #475569;
}

.group-arrow {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 折叠空字段 */
.detail-more-wrap {
  margin-bottom: 14rpx;
}

.detail-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #64748b;
}

.more-arrow {
  font-size: 20rpx;
}

/* 照片头 */
.detail-photo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-photo-empty {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.ui-icon-btn-sm {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: none;
  color: #1d4ed8;
  background: #eff4ff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ── 照片 ── */
.photo-toolbar {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-thumb-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.photo-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #f1f3f7;
}

.photo-remove {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(15, 23, 42, 0.65);
  border-radius: 18rpx;
}

/* ── 上传/图标按钮 ── */
.ui-icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  border: none;
  color: #1d4ed8;
  background: #eff4ff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ui-btn-disabled {
  opacity: 0.55;
}

/* 通用实心按钮（蓝底白字，用于弹窗内确认等） */
.ui-btn-primary {
  background: #2563eb;
  color: #ffffff;
  border: none;
}

.ui-btn-mini {
  min-width: 80rpx;
  height: 56rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  border: none;
  flex: 0 0 auto;
}

/* 转移弹窗（居中） */
.apply-panel {
  width: 92vw;
  max-height: 82vh;
  background: #f6f7fb;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
  overflow-y: auto;
}

.apply-search-scroll {
  max-height: 360rpx;
  border: 1rpx solid #e4e8ef;
  border-radius: 10rpx;
  background: #fff;
}

.ui-btn-submit {
  width: 100%;
  height: 88rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #2563eb;
  color: #fff;
}

/* ── 扫码填充面板 ── */
/* ⚠️ height + max-height 双写规则见文件顶部，禁止回退为仅 max-height */
.fill-panel {
  width: 86vw;
  height: 68vh;
  max-height: 68vh;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.fill-scroll {
  max-height: 40vh;
}

.fill-field-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid #f1f3f7;
}

.fill-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
  flex: 0 0 36rpx;
}

.fill-checkbox-on {
  background: #2563eb;
  border-color: #2563eb;
  color: #fff;
}

.fill-field-label {
  font-size: 23rpx;
  color: #64748b;
  flex: 0 0 auto;
  min-width: 100rpx;
}

.fill-field-value {
  font-size: 23rpx;
  color: #334155;
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fill-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 0;
  padding-top: 16rpx;
  padding-bottom: 4rpx;
  justify-content: center;
  border-top: 1rpx solid #e4e8ef;
  background: #fff;
  flex-shrink: 0;
}

.fill-actions .ui-btn {
  height: 56rpx;
  border: none;
}

/* ── 已存在资产提示 ── */
.existing-hint {
  text-align: center;
  padding: 30rpx 0;
}

.existing-icon {
  font-size: 48rpx;
  margin-bottom: 14rpx;
}

.existing-text {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.existing-detail {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 20rpx;
}

.existing-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.existing-actions .ui-btn {
  border: none;
}

/* ── 转移资产摘要卡片 ── */
.transfer-asset-card {
  background: #f8fafc;
  border-radius: 12rpx;
  border: 1rpx solid #e4e8ef;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.transfer-asset-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.transfer-asset-code {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.transfer-asset-from {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
}

.photo-count {
  font-size: 22rpx;
  color: #64748b;
  margin-left: 8rpx;
}

/* ── 搜索/转移面板 ── */
.search-row {
  padding: 10rpx 12rpx;
  border-bottom: 1rpx solid #f1f3f7;
}

.search-name {
  font-size: 26rpx;
  color: #0f172a;
}

.search-sub {
  font-size: 23rpx;
  color: #64748b;
}

.picker {
  width: 100%;
  border: 1rpx solid #e4e8ef;
  border-radius: 10rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
  background: #fff;
  font-size: 28rpx;
  color: #1e293b;
  text-align: left;
  box-sizing: border-box;
}

.picker-date {
  color: #1e293b;
}

/* ── 批量入口按钮（标题行） ── */
.ui-btn-batch-entry {
  background: #eff4ff;
  color: #1d4ed8;
  gap: 2rpx;
}

.ui-btn-batch-entry-empty {
  background: #f1f3f7;
  color: #334155;
}

.batch-entry-count {
  background: #2563eb;
  color: #ffffff;
  border-radius: 50%;
  width: 32rpx;
  height: 32rpx;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
  line-height: 32rpx;
  display: inline-block;
}

/* ── 扫码快捷浮动入口（右侧上方） ── */
.scan-float-btn {
  position: fixed;
  right: 60rpx;
  bottom: 290rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #f97316;
  box-shadow: 0 6rpx 20rpx rgba(249, 115, 22, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 950;
}

.scan-float-btn .van-icon {
  color: #ffffff !important;
}

/* ── 批量记录浮动入口（右侧下方） ── */
.batch-float-btn {
  position: fixed;
  right: 60rpx;
  bottom: 180rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #1e293b;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 500;
}

.batch-float-icon {
  font-size: 28rpx;
  color: #fff;
  line-height: 1;
}

.batch-float-count {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1;
}

/* ── 批量记录面板 ── */
/* ✅ 正确示范：height + max-height 双写，flex column 子元素正常撑满 */
.batch-panel {
  position: relative;
  width: 92vw;
  height: 78vh;
  max-height: 86vh;
  background: #f6f7fb;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.batch-toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
}

.batch-hint {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: auto;
}

.ui-btn-plain {
  background: #f1f3f7;
  color: #334155;
  border: none;
}

.ui-btn-clear-all {
  background: #dc2626;
  color: #ffffff !important;
  border: none;
}

.batch-scroll {
  flex: 1 1 0;
  min-height: 0;
  padding-bottom: 8rpx;
}

.batch-asset-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 12rpx;
  background: #fff;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.batch-checkbox {
  width: 38rpx;
  height: 38rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
  flex: 0 0 38rpx;
}

.batch-checkbox-on {
  background: #2563eb;
  border-color: #2563eb;
  color: #fff;
}

.batch-asset-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.batch-asset-code {
  font-size: 22rpx;
  color: #94a3b8;
}

.batch-asset-name {
  font-size: 25rpx;
  color: #1e293b;
  word-break: break-all;
  line-height: 1.4;
}

.batch-asset-location {
  font-size: 21rpx;
  color: #94a3b8;
}

.batch-asset-remove {
  width: 56rpx;
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #b91c1c;
  background: #fef1f1;
  border-radius: 8rpx;
  flex: 0 0 auto;
}

/* ── 批量面板子面板（扫码填充/编辑） ── */
.batch-sub-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.35);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.batch-sub-panel {
  width: 92%;
  height: 90%;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.batch-fill-source {
  font-size: 24rpx;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  margin-bottom: 12rpx;
}

.batch-fill-scroll {
  flex: 1 1 0;
  min-height: 0;
  padding-bottom: 8rpx;
}

.batch-fill-field {
  border-bottom: 1rpx solid #f1f3f7;
  padding: 10rpx 0;
}

.batch-fill-field-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.batch-fill-label {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
  min-width: 100rpx;
}

.batch-fill-arrow {
  font-size: 20rpx;
  color: #2563eb;
}

.batch-fill-source-val {
  font-size: 24rpx;
  color: #1d4ed8;
  font-weight: 500;
}

.batch-fill-previews {
  margin-left: 48rpx;
  margin-top: 6rpx;
  padding: 8rpx 12rpx;
  background: #f8fafc;
  border-radius: 6rpx;
  border-left: 3rpx solid #64748b;
}

.batch-fill-previews-title {
  font-size: 21rpx;
  color: #475569;
  display: block;
  margin-bottom: 4rpx;
}

.batch-fill-preview-row {
  padding: 2rpx 0;
  word-break: break-all;
}

.batch-fill-preview-val {
  font-size: 22rpx;
  color: #1e293b;
}

.batch-fill-preview-assets {
  font-size: 20rpx;
  color: #64748b;
}

/* ── 导出确认对话框 ── */
.export-confirm-dialog {
  width: 80vw;
  background: #fff;
  border-radius: 14rpx;
  padding: 28rpx 24rpx 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.2);
}

.export-confirm-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.export-confirm-hint {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 20rpx;
}

.export-confirm-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.export-confirm-config {
  font-size: 24rpx;
  color: #1d4ed8;
  text-decoration: none;
}

.export-confirm-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* ── 导出列选择面板 ── */
/* ⚠️ height + max-height 双写规则见文件顶部注释，禁止回退为仅 max-height */
.export-panel {
  width: 88vw;
  height: 70vh;
  max-height: 70vh;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.export-scroll {
  flex: 1 1 0;
  min-height: 0;
}

.export-col-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 8rpx;
  border-bottom: 1rpx solid #f1f3f7;
}

.export-col-label {
  font-size: 26rpx;
  color: #334155;
}

.batch-edit-input {
  margin: 8rpx 0 8rpx 48rpx;
  width: calc(100% - 48rpx);
  box-sizing: border-box;
}


/* 资产图标（emoji，来自地点/资产图标预置） */
.item-icon {
  margin-right: 6rpx;
  font-size: 28rpx;
  line-height: 1;
}
