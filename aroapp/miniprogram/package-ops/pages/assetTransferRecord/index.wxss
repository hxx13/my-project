.page {
  padding: 20rpx;
  background: #f6f7fb;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.toolbar {
  margin-top: 16rpx;
}

.input {
  flex: 1;
  border: 1rpx solid #dce3ef;
  border-radius: 10rpx;
  padding: 12rpx 14rpx;
  background: #fff;
  font-size: 26rpx;
}

.meta {
  color: #64748b;
  font-size: 26rpx;
  text-align: center;
  padding: 30rpx 0;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  flex: 1;
  min-width: 0;
}

.item-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.detail-mini-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #2563eb;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #bfdbfe;
  background: #eff6ff;
}

.item-sub {
  font-size: 25rpx;
  color: #475569;
  margin-bottom: 6rpx;
}

.item-sub--dim {
  font-size: 23rpx;
  color: #64748b;
}

.transfer-from {
  color: #f97316;
  font-weight: 500;
}

.transfer-arrow {
  color: #94a3b8;
}

.transfer-to {
  color: #3b82f6;
  font-weight: 500;
}

.thumb-section {
  margin-top: 12rpx;
}

.thumb-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.thumb-scroll {
  white-space: nowrap;
  width: 100%;
}

.thumb-img {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  margin-right: 10rpx;
  border-radius: 10rpx;
  vertical-align: top;
  background: #f1f5f9;
}

.thumb-wrap {
  position: relative;
  display: inline-block;
  margin-right: 10rpx;
}

.thumb-wrap .thumb-img {
  margin-right: 0;
}

.thumb-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(185, 28, 28, 0.9);
}

.thumb-del--disabled {
  opacity: 0.45;
}

.row-act {
  margin-top: 12rpx;
}

.row-act-inner {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.row-act-inner--del {
  margin-bottom: 0;
}

.pager-foot {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pager-txt {
  font-size: 24rpx;
  color: #64748b;
}

.pager-btns {
  display: flex;
  gap: 12rpx;
}

.link-btn {
  display: inline-block;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  color: #2563eb;
  border: 1rpx solid #bfdbfe;
  border-radius: 10rpx;
  background: #eff6ff;
}

.link-btn.disabled {
  opacity: 0.5;
}

.link-btn--warn {
  color: #b45309;
  border-color: #fcd34d;
  background: #fffbeb;
}

.link-btn--info {
  color: #0369a1;
  border-color: #bae6fd;
  background: #f0f9ff;
}

.link-btn--danger {
  color: #b91c1c;
  border-color: #fecaca;
  background: #fef2f2;
}

.continue-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.continue-panel {
  width: 90vw;
  max-height: 82vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
}

.panel-close {
  font-size: 26rpx;
  color: #64748b;
}

.field {
  margin-bottom: 14rpx;
}

.field .label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.field .value {
  font-size: 26rpx;
  color: #0f172a;
  word-break: break-all;
}

.continue-actions {
  margin-top: 20rpx;
}

.primary-btn {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #fff;
  background: #2563eb;
  border-radius: 12rpx;
}

.detail-panel {
  max-height: 86vh;
}

.kv-line {
  margin-top: 8rpx;
  padding: 8rpx 10rpx;
  border-radius: 8rpx;
  background: #f8fafc;
}

.kv-k {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 4rpx;
}

.kv-v {
  display: block;
  font-size: 25rpx;
  color: #0f172a;
  word-break: break-all;
}

.mono {
  font-family: monospace;
}

