/**
 * 检查维护模块：统一圆角胶囊按钮、自定义选择条、卡片标题行内操作（禁用整行独占大按钮）
 *
 * 配色一律走 _fm-theme.wxss 的令牌（动物订购页那套）。按钮规矩：
 * **实底**，禁渐变 / 禁半透明底 / 禁描边当身份 / 禁红底。
 * 危险动作（删除）= 中性实底 + 红色文字，不是红底按钮。
 */

.fm-toolbar-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx 12rpx;
  background: var(--paper);
  border-bottom: 1rpx solid var(--line);
}

.fm-select-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.fm-select-label {
  font-size: 24rpx;
  color: var(--mute);
  flex-shrink: 0;
}

/* 选择条：白底 + 可见描边（输入框类控件，不是按钮，描边在这里是身份的一部分） */
.fm-select-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  background: var(--paper);
  border: 1rpx solid var(--line-strong);
  font-size: 26rpx;
  color: var(--ink);
  box-sizing: border-box;
  max-width: 100%;
}

.fm-select-chip--grow {
  flex: 1;
  min-width: 200rpx;
  justify-content: flex-start;
}

/* 卡片内联小按钮：圆角矩形（原胶囊），与 .fm-pill 同一档 */
.fm-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  min-height: 56rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.fm-chip-xs {
  padding: 6rpx 18rpx;
  min-height: 48rpx;
  font-size: 22rpx;
}

.fm-chip-primary {
  color: #fff;
  background: var(--accent);
}

/* 次级：中性实底（原先是淡红底 + 红描边） */
.fm-chip-ghost {
  color: var(--body);
  background: var(--fill-2);
}

/* 危险：中性实底 + 红字。不铺红底 —— 用户明令禁红色按钮 */
.fm-chip-danger {
  color: var(--danger);
  background: var(--fill-2);
}

.fm-sheet {
  padding: 20rpx 0 28rpx;
  max-height: 70vh;
}

.fm-sheet-title {
  padding: 0 28rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.fm-sheet-row {
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  border-bottom: 1rpx solid var(--line);
}

.fm-sheet-row--on {
  color: var(--accent);
  font-weight: 600;
  background: var(--accent-bg);
}

.fm-fab-round {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.28);
}

.fm-fab-plus {
  font-size: 64rpx;
  font-weight: 300;
  color: #fff;
  line-height: 1;
  margin-top: -6rpx;
}

.card-head-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-height: 48rpx;
}

.card-title-ellipsis {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-inline-actions {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 8rpx;
  flex-shrink: 0;
  max-width: 52%;
}

.card-detail-lines {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
}

.card-detail-line {
  font-size: 24rpx;
  color: var(--mute);
  line-height: 1.5;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.popup-actions-row {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}
