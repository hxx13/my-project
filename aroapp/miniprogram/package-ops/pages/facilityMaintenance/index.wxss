@import './_fm-theme.wxss';
@import './fm-controls.wxss';

.page {
  min-height: 100vh;
  background: var(--fill);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.toolbar {
  padding: 20rpx 24rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.toolbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.toolbar-site-filter {
  margin: 0;
  padding: 0;
  border: 0;
  flex: 1;
  min-width: 0;
}
.toolbar-links {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}
/* .text-link 的按钮外观统一定义在 _fm-theme.wxss，这里不重复声明尺寸 */
.picker-label {
  font-size: 24rpx;
  color: var(--faint);
  margin-bottom: 8rpx;
}
.picker-box {
  padding: 16rpx 20rpx;
  background: var(--fill);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.picker-box.sm {
  padding: 12rpx 16rpx;
  font-size: 26rpx;
}
.list-pad {
  padding: 16rpx 24rpx 120rpx;
}
.daily-pad {
  padding: 16rpx 24rpx 32rpx;
}
.daily-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: flex-end;
}
.daily-field {
  min-width: 200rpx;
}
.daily-field.grow {
  flex: 1;
  min-width: 280rpx;
}
.daily-label {
  display: block;
  font-size: 22rpx;
  color: var(--faint);
  margin-bottom: 6rpx;
}
.daily-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.sheet-meta {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
}
.sheet-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}
.meta-text {
  font-size: 26rpx;
  color: var(--mute);
  flex: 1;
  min-width: 0;
}
.meta-btns {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
  flex-shrink: 0;
}
.matrix-wrap {
  margin-top: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  overflow: hidden;
}
.matrix-scroll {
  width: 100%;
  white-space: nowrap;
}
.matrix {
  display: inline-block;
  min-width: 100%;
  padding-bottom: 8rpx;
}
.matrix-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  border-bottom: 1rpx solid var(--line);
}
.matrix-row.matrix-head {
  background: var(--fill);
  font-weight: 600;
}
.matrix-cell {
  flex: 0 0 auto;
  width: 200rpx;
  padding: 12rpx 8rpx;
  font-size: 24rpx;
  color: var(--ink);
  box-sizing: border-box;
  white-space: normal;
}
.matrix-cell.sticky-col {
  width: 160rpx;
  position: sticky;
  left: 0;
  z-index: 2;
  background: #fff;
  border-right: 1rpx solid var(--line);
}
.matrix-head .matrix-cell.sticky-col {
  background: var(--fill);
}
.matrix-cell.head-cell {
  font-size: 24rpx;
  color: var(--mute);
}
.site-name {
  font-weight: 500;
}
.cell-input {
  width: 100%;
  min-height: 64rpx;
  padding: 8rpx 12rpx;
  font-size: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  box-sizing: border-box;
}
.cell-input--picker {
  display: flex;
  align-items: center;
  color: var(--ink);
}
.fm-preset-scroll {
  max-width: 100%;
  margin-bottom: 8rpx;
  white-space: nowrap;
}
.fm-preset-row {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 12rpx;
  padding: 0 4rpx 8rpx;
}
.hint-amber {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #b88230;
}
.hint-muted {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--faint);
}
.ledger-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 0;
  background: var(--fill);
}
.ledger-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
/* 标题右侧的总条数：台账现在一次拉全，条数是真实总数（原来是分页加载，写总数就是骗人的） */
.ledger-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}
.ledger-count {
  font-size: 22rpx;
  color: var(--faint);
}
.preset-scroll {
  white-space: nowrap;
  padding: 12rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.preset-hint {
  font-size: 24rpx;
  color: var(--faint);
  margin-right: 12rpx;
}
.preset-chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}
.card {
  background: #fff;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 22rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid var(--line);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.card-sub {
  font-size: 24rpx;
  color: var(--faint);
  margin-top: 8rpx;
}
.card-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
  gap: 16rpx;
}
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 10;
}
.fm-fab {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  color: #fff;
}
/* 工具按钮：**圆角矩形，不用胶囊**（用户 2026-09-21 明确）—— 与订购页 .foot-btn / 笼架页
   .mc-btn 同一档 12rpx。胶囊形状只留给状态标签，不给按钮。 */
.fm-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  height: 64rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.fm-pill-sm {
  height: 56rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}
.fm-pill-xs {
  height: 52rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}
.fm-pill-block {
  display: flex;
  width: 100%;
}
.fm-pill-primary {
  color: #fff;
}
.fm-pill-info {
  color: #fff;
}
/* 次级 / 危险：中性实底 + 一道可见描边。
   为什么必须带描边：这组 .fm-pill 会同时落在**灰底**（页面、ledger-head）和
   **白底**（弹窗、确认框）上。只有 --fill-2 填充的话，压在灰底 #f6f7fb 上几乎同色，
   按钮会「消失」成一片灰字（实测「刷新」就看不见了）；描边在灰底上托住轮廓，
   填充在白底上托住轮廓，两个场景都立得住。
   危险动作只给红字，不铺红底、不描红边。 */
.fm-pill-ghost {
  color: var(--body);
  background: var(--fill-2);
  border: 1rpx solid var(--line-strong);
}
.fm-pill-danger-ghost {
  color: var(--danger);
  background: var(--fill-2);
  border: 1rpx solid var(--line-strong);
}
/* 禁用：实心中灰，不用 opacity（半透明在浅底上会糊成一片，看不出是禁用还是没渲染） */
.fm-disabled {
  color: var(--off);
  background: var(--off-bg);
  box-shadow: none;
  pointer-events: none;
}
.fm-mt {
  margin-top: 24rpx;
}
.fm-confirm-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.fm-confirm-box {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.15);
}
.fm-confirm-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.fm-confirm-body {
  display: block;
  font-size: 26rpx;
  color: var(--mute);
  margin-bottom: 28rpx;
}
.fm-confirm-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}
/* 危险动作：中性实底 + 红字 + 可见描边。原先是玫红渐变 —— 明令禁止的红底按钮。 */
.fm-pill-danger {
  color: var(--danger);
  background: var(--fill-2);
  border: 1rpx solid var(--line-strong);
}
.popup-body {
  padding: 24rpx 32rpx 32rpx;
  max-height: 70vh;
  overflow-y: auto;
}
.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--ink);
}
.submit-btn {
  margin-top: 24rpx;
}

/* 分组折叠 */
.group-card {
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 22rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid var(--line);
  overflow: hidden;
}
.group-head {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 12rpx;
}
.group-arrow {
  font-size: 22rpx;
  color: var(--faint);
  flex-shrink: 0;
  width: 32rpx;
  text-align: center;
}
.group-title-ellipsis {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.group-meta {
  font-size: 22rpx;
  color: var(--faint);
  flex-shrink: 0;
}
.group-body {
  border-top: 1rpx solid var(--line);
  padding: 8rpx 16rpx 16rpx;
}
.card--sub {
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid var(--fill);
}
.card--sub:last-child {
  margin-bottom: 0;
}

.preset-selected-hint {
  margin-bottom: 8rpx;
}
.preset-selected-label {
  font-size: 22rpx;
  color: var(--faint);
}

/* 更换分区弹窗内预设多选 toggle 行（纯 view，无 checkbox 组件） */
.preset-toggle-list {
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  overflow: hidden;
}

.preset-toggle-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--fill-2);
  background: #fff;
}

.preset-toggle-row:last-child {
  border-bottom: none;
}

.preset-toggle-row--on {
  background: var(--accent-bg);
}

.preset-toggle-row--hover {
  background: var(--fill);
}

.preset-toggle-checkmark {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 700;
  flex-shrink: 0;
  border: 2rpx solid var(--line-strong);
  border-radius: 6rpx;
  box-sizing: border-box;
}

.preset-toggle-row--on .preset-toggle-checkmark {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

.preset-toggle-label {
  font-size: 28rpx;
  color: var(--ink);
}

.preset-toggle-row--on .preset-toggle-label {
  font-weight: 600;
  color: var(--accent);
}
