.auto-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.auto-panel {
  width: 100%;
  max-height: 88vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.auto-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.auto-head-ops {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.auto-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #323233;
}

.auto-close {
  font-size: 40rpx;
  color: #969799;
  padding: 0 8rpx;
}

.auto-run {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.auto-tip {
  display: block;
  font-size: 22rpx;
  color: #969799;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.sub-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.sub-tab {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dcdee0;
  font-size: 24rpx;
  color: #646566;
  background: #fff;
}

.sub-tab-on {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(135deg, #c41e3a, #ac1736);
  font-weight: 600;
}

.auto-scroll {
  flex: 1;
  min-height: 0;
  max-height: calc(88vh - 220rpx);
}

.hint {
  color: #969799;
  font-size: 24rpx;
  padding: 12rpx 0;
}

.form-card,
.rule-card {
  background: #fafafa;
  border: 1rpx solid #ebedf0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.form-title,
.list-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 12rpx;
}

.field-label {
  display: block;
  font-size: 22rpx;
  color: #646566;
  margin: 12rpx 0 8rpx;
}

.picker-box,
.field-input {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #dcdee0;
  border-radius: 12rpx;
  background: #fff;
  padding: 16rpx 18rpx;
  font-size: 26rpx;
  color: #323233;
}

.field-input.mono {
  font-family: monospace;
  font-size: 22rpx;
}

.info-box {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #f5f6f7;
  font-size: 22rpx;
  color: #646566;
}

.check-list {
  max-height: 260rpx;
  overflow-y: auto;
  border: 1rpx solid #dcdee0;
  border-radius: 12rpx;
  background: #fff;
  padding: 8rpx 12rpx;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 4rpx;
  font-size: 24rpx;
  color: #323233;
}

.check-box {
  width: 32rpx;
  color: #ac1736;
}

.form-ops {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.list-section {
  margin-bottom: 16rpx;
}

.rule-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.rule-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}

.rule-meta {
  display: block;
  font-size: 22rpx;
  color: #969799;
  margin-top: 6rpx;
}

.rule-ops {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.link {
  font-size: 24rpx;
  color: #2563eb;
}

.link-danger {
  color: #dc2626;
}

.sug-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
}

.sug-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #323233;
}

.op {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid #dcdee0;
  color: #646566;
  background: #fff;
}

.op-sm {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.op-primary {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(135deg, #c41e3a, #ac1736);
}

.op-ghost {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dcdee0;
}

.tag-ok {
  color: #059669;
  background: #ecfdf5;
  border-color: #6ee7b7;
}

.tag-muted {
  color: #64748b;
  background: #f8fafc;
}
