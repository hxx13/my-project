/* 禁止页面级滚动，仅由内部 scroll-view 处理滚动 */

page {
  overflow: hidden;
}

.page {
  position: relative;
  box-sizing: border-box;
  background: #eef0f6;
  overflow: hidden;
}

/* 搜索栏：fixed 钉在自定义导航下方 */
.mall-header-fixed {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 900;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 1px 0 #ebecef;
}

.mall-header-placeholder {
  flex-shrink: 0;
  width: 100%;
}

/* 顶栏：搜索 + 右侧入口横滑（内联样式，不依赖 @import） */
.mall-top-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: #fff;
  border-bottom: 1px solid #ebecef;
  box-sizing: border-box;
  width: 100%;
  min-height: 46px;
}

.mall-top-search {
  flex: 1;
  min-width: 0;
}

.mall-top-search-input {
  display: block;
  width: 100%;
  height: 30px;
  line-height: 30px;
  padding: 0 10px;
  font-size: 12px;
  border-radius: 999px;
  border: 1px solid #e6e8eb;
  background: #f7f8fa;
  box-sizing: border-box;
}

.mall-top-actions-wrap {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
}

.mall-top-actions-scroll {
  width: auto;
  height: 36px;
}

.mall-top-actions {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  height: 36px;
  padding: 0 4px 0 0;
  white-space: nowrap;
}

.mall-top-pill {
  flex-shrink: 0;
  position: relative;
  font-size: 11px;
  line-height: 1;
  padding: 7px 10px;
  border-radius: 12rpx;
  color: #334155;
  background: #f1f3f7;
}

.mall-top-pill-admin {
  color: #fff;
  background: #2563eb;
}

.mall-top-pill-badge-wrap,
.mall-top-pill-mine-wrap {
  padding-right: 14px;
}

.mall-top-mini-badge {
  position: absolute;
  top: -5px;
  right: -4px;
  min-width: 16px;
  height: 16px;
  line-height: 16px;
  padding: 0 5px;
  font-size: 10px;
  font-weight: 700;
  color: #fff;
  background: #ef4444;
  border-radius: 999px;
  text-align: center;
  box-sizing: border-box;
  border: 1px solid #fff;
}

.mall-top-mini-badge-mine {
  background: #2563eb;
}

.mall-top-pill-hover {
  opacity: 0.82;
}

.main-split {
  width: 100%;
  display: flex;
  flex-direction: row;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.cat-side {
  width: 84px;
  flex-shrink: 0;
  background: #f6f7fb;
  border-right: 1rpx solid #eef0f4;
  box-sizing: border-box;
}

.novelty-hint {
  flex-shrink: 0;
  margin: 6px 10px 0;
  padding: 7px 10px;
  border: 1px solid #ffd591;
  background: #fff7e6;
  color: #ad4e00;
  border-radius: 8px;
  font-size: 12px;
  line-height: 1.4;
}

.cat-item {
  margin-bottom: 8rpx;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.4;
  word-break: break-all;
  /* 聚焦切换的缓动：与订购页左侧栏同一套观感 */
  transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

.cat-item-on {
  color: #fff;
  font-weight: 600;
  background: #2563eb;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}

.content-side {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding: 8px 10px 6px;
}

.content-muted {
  font-size: 13px;
  color: #969799;
  text-align: center;
  padding: 40px 0;
}

.content-pad-bottom {
  height: 12px;
}

.goods-card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 8px;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
  padding: 8px 10px;
  gap: 10px;
  position: relative;
}

.goods-cover-sm {
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  border-radius: 8px;
  background: #f2f3f5;
}

.goods-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-ph-sm {
  font-size: 16px;
  font-weight: 600;
  color: #c8c9cc;
}

.goods-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-step-row {
  display: block;
}

/* 规格/数量控件脱离文本流，钉在卡片右下角：标题行与副标题可吃满整行宽度 */
.name-step-row .step-inline,
.name-step-row .spec-anchor {
  position: absolute;
  right: 10px;
  bottom: 8px;
  z-index: 2;
}

.goods-name-wrap {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-weight: 600;
  font-size: 14px;
  color: #323233;
  line-height: 1.3;
}

.goods-novelty-tag {
  display: inline-block;
  margin-left: 6px;
  padding: 1px 6px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  line-height: 1.5;
}

.goods-novelty-new {
  color: #b54708;
  background: #fff4e5;
}

.goods-novelty-inbound {
  color: #027a48;
  background: #ecfdf3;
}

.goods-sub-inline {
  display: block;
  font-size: 11px;
  color: #969799;
  margin-top: 2px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-stock-line {
  font-size: 11px;
  color: #969799;
  margin-top: 4px;
  /* 给右下角控件让位，库存文字与控件同一水平线 */
  min-height: 24px;
  line-height: 24px;
  padding-right: 92px;
  box-sizing: border-box;
}

.step-inline {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 1px solid #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
}

.si-btn {
  width: 24px;
  height: 24px;
  line-height: 24px;
  text-align: center;
  font-size: 14px;
  color: #323233;
}

.si-btn-off {
  opacity: 0.35;
  pointer-events: none;
}

.si-btn-plus {
  color: #fff;
  background: #2563eb;
}

.si-btn-hover {
  opacity: 0.88;
}

.si-num-input {
  width: 32px;
  height: 22px;
  text-align: center;
  font-size: 12px;
  font-weight: 600;
  color: #323233;
  padding: 0 2px;
  background: #f7f8fa;
  border-left: 1px solid #ebecef;
  border-right: 1px solid #ebecef;
  box-sizing: border-box;
  line-height: 22px;
}

.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid #ebecef;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  z-index: 100;
  backdrop-filter: blur(10px);
}

.cart-entry {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88px;
  padding: 10px 14px;
  border-radius: 12rpx;
  background: #f1f3f7;
}

.cart-entry-hover {
  opacity: 0.9;
}

.cart-entry-txt {
  font-size: 14px;
  font-weight: 500;
  color: #334155;
}

.cart-badge {
  position: absolute;
  top: 2px;
  right: 6px;
  min-width: 16px;
  height: 16px;
  line-height: 16px;
  padding: 0 4px;
  font-size: 10px;
  color: #fff;
  text-align: center;
  background: #ef4444;
  border-radius: 999px;
}

.cart-submit {
  flex: 1;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  padding: 11px 16px;
  border-radius: 12rpx;
  background: #2563eb;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.22);
}

.cart-submit-hover {
  opacity: 0.92;
}

.cart-submit-disabled {
  opacity: 0.45;
  pointer-events: none;
  box-shadow: none;
}

.sheet-head {
  padding: 16px;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  border-bottom: 1px solid #f2f3f5;
}

.sheet-scroll {
  max-height: 52vh;
  padding: 0 12px 8px;
  box-sizing: border-box;
}

.sheet-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f2f3f5;
  gap: 10px;
}

.sheet-thumb {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  flex-shrink: 0;
  background: #f2f3f5;
}

.sheet-thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #c8c9cc;
  font-weight: 600;
}

.sheet-mid {
  flex: 1;
  min-width: 0;
}

.sheet-name {
  font-size: 14px;
  color: #323233;
  font-weight: 500;
  display: block;
}

.sheet-qty {
  font-size: 12px;
  color: #969799;
  margin-top: 4px;
  display: block;
}

.sheet-step-inline {
  margin-top: 6px;
  display: inline-flex;
  align-items: center;
  border: 1px solid #dcdee0;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
}

.sheet-si-btn {
  width: 24px;
  height: 24px;
  line-height: 24px;
  font-size: 14px;
}

.sheet-si-num-input {
  width: 34px;
  height: 24px;
  line-height: 24px;
  font-size: 12px;
}

.sheet-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid #f2f3f5;
  background: #fafbfc;
}

.sheet-total {
  font-size: 14px;
  color: #646566;
}

.sheet-btn {
  font-size: 14px;
  color: #2563eb;
  padding: 6px 12px;
}

.sheet-btn-primary {
  color: #fff;
  background: #2563eb;
  border-radius: 12rpx;
  font-weight: 600;
  padding: 8px 18px;
}

.sheet-foot-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sheet-remark-input {
  margin-top: 6px;
  width: 100%;
  border: 1px solid #ebedf0;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 12px;
  box-sizing: border-box;
  color: #323233;
}

/* 确认弹窗 */
.pop-root {
  display: flex;
  flex-direction: column;
  max-height: 76vh;
}

.pop-top {
  padding: 24rpx;
  border-bottom: 1px solid #f2f3f5;
}

.pop-title {
  display: block;
  font-size: 30rpx;
  color: #323233;
  font-weight: 600;
}

.pop-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #969799;
}

.pop-split-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ed6a0c;
}

.pop-scroll {
  max-height: 48vh;
  padding: 0 24rpx 8rpx;
  box-sizing: border-box;
}

.pop-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #f2f3f5;
}

.pop-btn {
  min-width: 160rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 12rpx 10rpx;
}

.pop-btn.ghost {
  color: #334155;
  background: #f1f3f7;
}

.pop-btn.primary {
  color: #fff;
  background: #2563eb;
}

.pop-btn-disabled {
  opacity: 0.5;
}

/* 合并弹窗：待处理申领单单选行 */
.merge-req-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1px dashed #eceef0;
}

.merge-radio {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  border-radius: 999px;
  border: 2rpx solid #dcdee0;
  background: #fff;
  box-sizing: border-box;
}

.merge-radio-on {
  border: 9rpx solid #2563eb;
}

.merge-req-mid {
  flex: 1;
  min-width: 0;
}

.merge-req-title {
  display: block;
  font-size: 26rpx;
  color: #323233;
  font-weight: 500;
}

.merge-req-title-on {
  color: #2563eb;
  font-weight: 600;
}

.merge-req-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

.merge-req-pickup {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #e6a23c;
}

.confirm-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1px dashed #eceef0;
}

.confirm-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  border: 1px solid #ebedf0;
  flex-shrink: 0;
}

.confirm-thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f6f7;
  color: #969799;
  font-size: 28rpx;
}

.confirm-mid {
  flex: 1;
  min-width: 0;
}

.confirm-name {
  display: block;
  font-size: 26rpx;
  color: #323233;
}

.confirm-qty {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

.confirm-remark-input {
  margin-top: 8rpx;
  width: 100%;
  border: 1px solid #ebedf0;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  color: #323233;
}

/* ---- Spec panel ---- */
.spec-section {
  margin-top: 6px;
  padding-top: 6px;
  border-top: 1px dashed #e8eaed;
}

.spec-toggle {
  margin-top: 6px;
  font-size: 12px;
  color: #2563eb;
}

.spec-pick-btn {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 24px;
  padding: 0 10px;
  border-radius: 12rpx;
  background: #f6f7fb;
  color: #1f2937;
  font-size: 11px;
  font-weight: 600;
}

.spec-pick-btn--disabled {
  opacity: 0.45;
}

.spec-pick-btn--on {
  background: #2563eb;
  color: #fff;
}

.spec-anchor {
  flex-shrink: 0;
}

.spec-pick-badge {
  position: absolute;
  top: -6px;
  right: -4px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  border-radius: 999px;
  background: #ef4444;
  color: #fff;
  font-size: 10px;
  line-height: 16px;
  text-align: center;
}

.spec-picker {
  display: flex;
  flex-direction: column;
  max-height: 85vh;
  background: #fff;
}

.spec-picker-head {
  padding: 16px 16px 12px;
  border-bottom: 1px solid #ebecef;
}

.spec-picker-title {
  display: block;
  font-size: 16px;
  font-weight: 700;
  color: #323233;
  text-align: center;
}

.spec-picker-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
  padding: 12px 16px;
  box-sizing: border-box;
}

.spec-item-brief {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12px;
  padding: 10px 12px;
  margin-bottom: 12px;
  border-radius: 10px;
  background: #f7f8fa;
}

.spec-item-cover {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
  border-radius: 8px;
  background: #fff;
}

.spec-item-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 700;
  color: #cbd5e1;
}

.spec-item-text {
  flex: 1;
  min-width: 0;
  padding-top: 2px;
}

.spec-item-name {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #323233;
  line-height: 1.35;
}

.spec-item-sub {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #969799;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spec-dim-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.spec-dim-block {
  border: 1px solid #ebecef;
  border-radius: 10px;
  overflow: hidden;
}

.spec-dim-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 10px 12px;
  background: #fff;
}

.spec-dim-chev {
  flex-shrink: 0;
  font-size: 11px;
  color: #969799;
  width: 14px;
}

.spec-dim-title {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  font-weight: 600;
  color: #323233;
}

.spec-dim-summary {
  flex-shrink: 0;
  max-width: 45%;
  font-size: 12px;
  color: #2563eb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-dim-body {
  padding: 0 12px 12px;
  border-top: 1px solid #f2f3f5;
}

.spec-opt-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding-top: 10px;
}

.spec-combo-section {
  margin-top: 12px;
}

.spec-combo-label {
  display: block;
  font-size: 12px;
  font-weight: 500;
  color: #969799;
  margin-bottom: 8px;
}

.spec-combo-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  margin-bottom: 8px;
  border-radius: 10px;
  background: #f7f8fa;
}

.spec-picker-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid #ebecef;
  background: #fafbfc;
}

.spec-picker-total {
  font-size: 13px;
  color: #646566;
}

.spec-picker-total-num {
  font-size: 15px;
  font-weight: 700;
  color: #323233;
}

.spec-picker-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.spec-picker-cancel {
  padding: 10px 16px;
  min-height: 44px;
  line-height: 24px;
  font-size: 13px;
  color: #334155;
  border-radius: 12rpx;
  background: #f1f3f7;
  box-sizing: border-box;
}

.spec-picker-done {
  padding: 10px 20px;
  min-height: 44px;
  line-height: 24px;
  border-radius: 12rpx;
  background: #2563eb;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  box-sizing: border-box;
}

.spec-oos-hint {
  text-align: center;
  font-size: 12px;
  color: #ef4444;
  padding: 10px 0 4px;
}

.spec-skip-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px dashed #e8eaed;
  font-size: 12px;
  color: #646566;
}

.spec-skip-qty {
  min-width: 24px;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  color: #323233;
}

.spec-required-tag {
  display: inline-block;
  margin-bottom: 6px;
  font-size: 11px;
  color: #b45309;
  background: rgba(245, 158, 11, 0.12);
  padding: 2px 8px;
  border-radius: 999px;
}

.spec-sku-row--oos {
  opacity: 0.55;
}

.spec-oos-tag {
  margin-left: 6px;
  font-size: 11px;
  color: #94a3b8;
}

.spec-dim {
  margin-bottom: 6px;
}

.spec-dim-name {
  display: block;
  font-size: 11px;
  color: #969799;
  margin-bottom: 4px;
}

.spec-opt-scroll {
  white-space: nowrap;
  width: 100%;
}

.spec-opt-list {
  display: flex;
  flex-direction: row;
  gap: 6px;
}

.spec-opt {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px 12px;
  font-size: 12px;
  color: #646566;
  background: #f7f8fa;
  border: 1px solid #e6e8eb;
  border-radius: 999px;
  flex-shrink: 0;
  line-height: 1.3;
}

.spec-selected {
  color: #2563eb;
  background: #eaf1ff;
  border-color: #2563eb;
  border-width: 2px;
  font-weight: 600;
}

.spec-sku-grid {
  margin-top: 6px;
}

.spec-sku-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 4px 0;
  border-bottom: 1px dotted #f2f3f5;
}

.spec-sku-label {
  font-size: 12px;
  color: #323233;
  font-weight: 500;
}

.spec-step-inline {
  flex-shrink: 0;
}

.spec-hint {
  font-size: 11px;
  color: #c8c9cc;
  text-align: center;
  padding: 8px 0;
}

/* ---- Cart sheet spec label ---- */
.sheet-spec-label {
  display: block;
  font-size: 11px;
  color: #2563eb;
  margin-top: 2px;
}

/* ---- Confirm spec label ---- */
.confirm-spec-label {
  display: block;
  font-size: 20rpx;
  color: #2563eb;
  margin-top: 2rpx;
}

/* ---- 确认弹窗第三按钮：预约领取 ---- */
.pop-btn.outline {
  color: #2563eb;
  background: #eaf1ff;
}

/* ---- 预约时间选择 ---- */
.pickup-section {
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1px solid #f2f3f5;
}

.pickup-section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #323233;
  margin-bottom: 12rpx;
}

.pickup-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.pickup-preset {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  color: #646566;
  background: #f7f8fa;
  border: 1px solid #e6e8eb;
  border-radius: 8rpx;
  line-height: 1.3;
}

.pickup-preset-on {
  color: #2563eb;
  background: #eaf1ff;
  border-color: #2563eb;
  font-weight: 600;
}

.pickup-preset-custom {
  color: #334155;
  background: #f1f3f7;
  border: 1px dashed #d4d7db;
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  margin-top: 6rpx;
}

.pickup-label-row {
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1px solid #f2f3f5;
  text-align: center;
}

.pickup-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2563eb;
}

.pickup-label-edit {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #2563eb;
  text-decoration: underline;
}
