.page {
  padding: 12px 14px 24px;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}
.muted {
  font-size: 13px;
  color: #969799;
  text-align: center;
  padding: 40px 0;
}
.player-wrap {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.player {
  width: 100%;
  border-radius: 14px;
  background: #000;
}
.status {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 2px;
}
.status-txt {
  font-size: 13px;
  font-weight: 600;
  color: #4b5563;
}
.status-ok {
  color: #059669;
}
.status-hint {
  font-size: 12px;
  color: #d97706;
}
.tip {
  padding: 0 2px;
  font-size: 12px;
  line-height: 1.6;
  color: #8a9099;
}
