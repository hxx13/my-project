/* 视频学习列表：与答题页同一套白卡语言 */
.page {
  padding: 16px 14px 24px;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef5ff 0%, #f7f8fa 120px);
}
.tip {
  margin-bottom: 12px;
  font-size: 12px;
  line-height: 1.6;
  color: #8a9099;
}
.muted {
  font-size: 13px;
  color: #969799;
  text-align: center;
  padding: 24px 0;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.row-card {
  background: #fff;
  border-radius: 18px;
  padding: 16px 18px;
  border: 1px solid rgba(235, 238, 239, 0.9);
  box-shadow: 0 4px 18px rgba(31, 56, 88, 0.07);
}
.row-card-ok {
  border-color: #6ee7b7;
  background: #f4fff8;
}
.row-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}
.row-title {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  font-weight: 600;
  color: #1f3858;
  line-height: 1.4;
}
.state-tag {
  flex-shrink: 0;
  font-size: 11px;
  color: #8a9099;
}
.state-ok {
  color: #059669;
}
.progress {
  margin-top: 10px;
  height: 6px;
  border-radius: 999px;
  background: #eef1f5;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 999px;
  background: #1677ff;
}
.meta-line {
  margin-top: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
}
.meta-k {
  color: #969799;
}
.meta-v {
  color: #4b5563;
}
.watch-btn {
  margin-left: auto;
  padding: 4px 14px;
  border-radius: 999px;
  background: #1677ff;
  color: #fff;
  font-size: 12px;
}
