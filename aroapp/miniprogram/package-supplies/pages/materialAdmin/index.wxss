  display: flex;
  gap: 8px;
}

.toolbar-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}

.inp-cat-short {
  width: 80px;
  height: 40px;
  padding: 0 8px;
  font-size: 12px;
  border-radius: 10px;
  border: 1px solid #ebecef;
  background: #fff;
  box-sizing: border-box;
}

.icon-tool {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  border: 1px solid #ebecef;
  background: #fff;
}

.icon-tool--primary {
  background: #1989fa;
  border-color: #1989fa;
}

.icon-tool-hover {
  opacity: 0.85;
}

.cat-head-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: auto;
}

.cat-quick-add {
  padding: 4px;
