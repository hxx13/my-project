  font-weight: 600;
  font-size: 14px;
  color: #323233;
}

.cat-meta-inline {
  font-size: 11px;
  color: #969799;
}

.cat-body {
  padding: 0 6px 4px;
}

.cat-empty {
  text-align: center;
  padding: 12px;
}
