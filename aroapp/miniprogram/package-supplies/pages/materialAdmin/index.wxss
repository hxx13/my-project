.page {
  padding: 12px 14px 40px;
  background: #f4f5f7;
  min-height: 100vh;
  box-sizing: border-box;
}

.hint {
  font-size: 12px;
  color: #969799;
  margin-bottom: 14px;
  line-height: 1.55;
}

.sec-head {
  font-size: 13px;
  font-weight: 600;
  color: #323233;
  margin: 14px 0 8px;
}

.tools-hint {
  font-size: 12px;
  color: #969799;
  font-weight: 400;
}

.cat-block {
  background: #fff;
  border-radius: 12px;
  border: 1px solid #ebecef;
  margin-bottom: 10px;
  overflow: hidden;
}

.cat-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  padding: 7px 10px;
  background: #fafafa;
}

.cat-head-hover {
  background: #f0f1f5;
}

.cat-chev {
  font-size: 12px;
  color: #646566;
  width: 18px;
  text-align: center;
  flex-shrink: 0;
}

.cat-head-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.cat-head-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  min-width: 0;
}

.cat-name-part {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  font-weight: 600;
  color: #323233;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cat-meta-inline {
  flex-shrink: 0;
  font-size: 11px;
  font-weight: 400;
  color: #969799;
  line-height: 1.3;
  white-space: nowrap;
}

.cat-head-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 2px;
}

.cat-quick-add {
  padding: 2px 4px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-quick-add-hover {
  background: rgba(25, 137, 250, 0.1);
}

.cat-del-ico {
  padding: 2px 4px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-body {
  padding: 8px 10px 12px;
  border-top: 1px solid #f2f3f5;
}

.cat-body .item-card {
  margin-bottom: 10px;
}

.cat-body .item-card:last-child {
  margin-bottom: 0;
}

.cat-empty {
  margin: 8px 0 4px;
  text-align: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mini-ops {
  display: flex;
  gap: 8px;
}

.btn-mini {
  font-size: 12px;
  color: #646566;
  border: 1px solid #dcdee0;
  border-radius: 999px;
  padding: 2px 10px;
  background: #fff;
}

.btn-mini-danger {
  color: #ee0a24;
  border-color: #f3a6af;
}

.cell-row {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  padding: 12px 14px;
  border-radius: 10px;
  margin-bottom: 8px;
  border: 1px solid #ebecef;
}

.cell-main {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  color: #323233;
}

.cell-id {
  font-size: 11px;
  color: #c8c9cc;
}

.link {
  font-size: 13px;
  color: #1989fa;
  padding: 4px 0;
}

.link-warn {
  color: #ed6a0c;
}

.link-danger {
  font-size: 13px;
  color: #ee0a24;
  padding: 4px 0;
}

.add-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.toolbar-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.icon-tool {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1px solid #dcdee0;
  background: #fff;
}

.icon-tool--primary {
  border-color: #b3d4ff;
  background: linear-gradient(180deg, #42a5f5 0%, #1989fa 100%);
  box-shadow: 0 2px 8px rgba(25, 137, 250, 0.22);
}

.icon-tool-hover {
  opacity: 0.88;
}

.inp-cat-short {
  flex: 0 0 100px;
  width: 100px;
  min-width: 0;
  height: 40px;
  padding: 0 8px;
  font-size: 13px;
  border-radius: 10px;
  border: 1px solid #ebecef;
  background: #fff;
  box-sizing: border-box;
}

.inp-inline {
  flex: 1;
  min-width: 0;
  height: 40px;
  padding: 0 12px;
  font-size: 14px;
  border-radius: 10px;
  border: 1px solid #ebecef;
  background: #fff;
  box-sizing: border-box;
}

.btn-ghost {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 500;
  color: #646566;
  padding: 8px 14px;
  border-radius: 999px;
  background: #fff;
  border: 1px solid #dcdee0;
}

.btn-ghost-primary {
  color: #1989fa;
  border-color: #b3d4ff;
  background: #f4f9ff;
}

.btn-ghost-hover {
  opacity: 0.88;
}

.item-card {
  background: #fff;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 10px;
  border: 1px solid #ebecef;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
}

.item-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12px;
}

.item-thumb {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  flex-shrink: 0;
  background: #f2f3f5;
}

.item-thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 600;
  color: #c8c9cc;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}

.item-title {
  font-weight: 600;
  font-size: 15px;
  color: #323233;
  line-height: 1.35;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-actions-inline {
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 6px;
  max-width: 58%;
}

.pill-btn {
  font-size: 11px;
  line-height: 1;
  padding: 6px 10px;
  border-radius: 999px;
  color: #646566;
  background: #f7f8fa;
  border: 1px solid #e6e8eb;
}

.pill-btn-primary {
  color: #ac1736;
  background: rgba(172, 23, 54, 0.08);
  border-color: rgba(172, 23, 54, 0.22);
  font-weight: 600;
}

.pill-btn-warn {
  color: #ed6a0c;
  background: #fff8f0;
  border-color: #ffe0c2;
}

.pill-btn-danger {
  color: #ee0a24;
  background: #fef5f5;
  border-color: #fcc;
}

.item-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 6px;
}

.item-subtitle {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #969799;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-off {
  flex-shrink: 0;
  font-size: 10px;
  color: #969799;
  padding: 2px 6px;
  border-radius: 4px;
  background: #f2f3f5;
  border: 1px solid #ebedf0;
}

.link-strong {
  font-weight: 600;
}

.item-meta {
  font-size: 11px;
  color: #969799;
}

.item-actions {
  display: none;
}

.panel {
  margin-top: 12px;
  padding: 12px;
  background: #f4f9ff;
  border-radius: 10px;
  border: 1px solid #d4e5fc;
}

.panel-amber {
  background: #fff8f0;
  border-color: #ffe0c2;
}

.panel-tip {
  font-size: 12px;
  color: #646566;
  margin-bottom: 10px;
  line-height: 1.45;
}

.inp-panel {
  width: 100%;
  box-sizing: border-box;
  height: 42px;
  padding: 0 12px;
  font-size: 15px;
  border-radius: 8px;
  border: 1px solid #dcdee0;
  background: #fff;
  margin-bottom: 12px;
}

.panel-btns {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-fill {
  flex: 1;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  padding: 10px 12px;
  border-radius: 10px;
  background: linear-gradient(180deg, #42a5f5 0%, #1989fa 100%);
}

.btn-fill-warn {
  background: linear-gradient(180deg, #ff9f4a 0%, #ed6a0c 100%);
}

.btn-fill-hover {
  opacity: 0.92;
}

.btn-fill-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.btn-line {
  flex-shrink: 0;
  font-size: 14px;
  color: #646566;
  padding: 10px 16px;
  border-radius: 10px;
  border: 1px solid #dcdee0;
  background: #fff;
}

.btn-line-hover {
  opacity: 0.88;
}

/* —— 居中弹窗 —— */
.popup-wrap {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.popup-head {
  padding: 20px 48px 12px 20px;
  font-size: 17px;
  font-weight: 700;
  color: #323233;
  text-align: center;
  border-bottom: 1px solid #f2f3f5;
}

.popup-body {
  flex: 1;
  max-height: 52vh;
  padding: 16px 20px 4px;
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.popup-body .form-label,
.popup-body .form-input,
.popup-body .form-picker,
.popup-body .form-check-row,
.popup-body .cover-row,
.popup-body staff-reviewer-picker {
  flex-shrink: 0;
}

.popup-footer {
  flex-shrink: 0;
  border-top: 1px solid #f2f3f5;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: #fafbfc;
}

.popup-footer-inner {
  display: flex;
  gap: 10px;
}

.btn-line-wide {
  flex: 1;
  text-align: center;
  font-size: 15px;
  font-weight: 500;
  color: #646566;
  padding: 12px 8px;
  border-radius: 12px;
  border: 1px solid #dcdee0;
  background: #fff;
}

.btn-fill-wide {
  flex: 1.2;
  text-align: center;
  font-size: 15px;
  font-weight: 600;
  color: #fff;
  padding: 12px 8px;
  border-radius: 12px;
  background: linear-gradient(180deg, #42a5f5 0%, #1989fa 100%);
  box-shadow: 0 4px 12px rgba(25, 137, 250, 0.22);
}

.form-label {
  font-size: 12px;
  color: #969799;
  margin-bottom: 8px;
  margin-top: 4px;
}

.req {
  color: #ee0a24;
}

.opt {
  color: #c8c9cc;
  font-weight: 400;
}

.form-picker {
  display: block;
  width: 100%;
  box-sizing: border-box;
  min-height: 44px;
  padding: 12px 14px;
  font-size: 15px;
  color: #323233;
  background: #f7f8fa;
  border-radius: 10px;
  border: 1px solid #ebecef;
  margin-bottom: 14px;
}

.form-input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  height: 44px;
  min-height: 44px;
  line-height: 44px;
  padding: 0 14px;
  font-size: 15px;
  color: #323233;
  border-radius: 10px;
  border: 1px solid #ebecef;
  background: #fff;
  margin-bottom: 14px;
}

.cover-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 8px;
}

.cover-preview-wrap {
  position: relative;
  width: 88px;
  height: 88px;
}

.cover-preview {
  width: 88px;
  height: 88px;
  border-radius: 12px;
  background: #f2f3f5;
}

.cover-remove {
  position: absolute;
  top: -6px;
  right: -6px;
  width: 24px;
  height: 24px;
  line-height: 22px;
  text-align: center;
  font-size: 16px;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 999px;
}

.cover-add {
  width: 88px;
  height: 88px;
  border-radius: 12px;
  border: 1px dashed #c8c9cc;
  background: #fafbfc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #969799;
}

.cover-add-hover {
  background: #f0f2f5;
}

.cover-add-icon {
  font-size: 28px;
  line-height: 1;
  font-weight: 300;
}

.cover-add-txt {
  font-size: 11px;
  margin-top: 4px;
}

.cover-hint {
  flex: 1;
  min-width: 120px;
  font-size: 11px;
  color: #c8c9cc;
  line-height: 1.5;
  padding-top: 8px;
}

.form-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 12px 0 4px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #f9fafb;
  border: 1px solid #ebecef;
}

.form-switch-row-sub {
  margin-top: 8px;
  background: #fff;
}

.form-switch-copy {
  flex: 1;
  min-width: 0;
}

.form-label-tight {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #323233;
  margin-bottom: 2px;
}

.form-hint-inline {
  display: block;
  font-size: 11px;
  color: #969799;
  line-height: 1.4;
}

.form-check-row {
  display: none;
}

/* ---- Spec config in form ---- */
.form-section-divider {
  height: 1px;
  background: #ebecef;
  margin: 12px 0 8px;
}

.spec-config-list {
  margin-top: 4px;
}

.spec-dim-config {
  background: #f9fafb;
  border: 1px solid #ebecef;
  border-radius: 10px;
  padding: 10px;
  margin-bottom: 10px;
}

.spec-dim-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.spec-dim-label {
  font-size: 13px;
  font-weight: 600;
  color: #323233;
}

.spec-dim-remove {
  font-size: 11px;
}

.spec-dim-name-input {
  height: 40px;
  min-height: 40px;
  line-height: 40px;
  font-size: 14px;
  margin-bottom: 8px;
}

.spec-opt-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;
}

.spec-opt-tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px;
  font-size: 12px;
  color: #ac1736;
  background: rgba(172, 23, 54, 0.08);
  border: 1px solid rgba(172, 23, 54, 0.18);
  border-radius: 999px;
}

.spec-opt-tag-edit {
  padding: 2px 4px 2px 8px;
}

.spec-opt-tag-input {
  width: 72px;
  min-width: 48px;
  height: 28px;
  line-height: 28px;
  font-size: 12px;
  color: #323233;
  border: none;
  background: transparent;
}

.spec-opt-tag-remove {
  width: 16px;
  height: 16px;
  line-height: 15px;
  text-align: center;
  font-size: 12px;
  color: #969799;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.06);
}

.spec-opt-add-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.spec-opt-input {
  flex: 1;
  min-width: 0;
  height: 38px;
  min-height: 38px;
  line-height: 38px;
  font-size: 13px;
  margin-bottom: 0;
}

.btn-mini {
  flex-shrink: 0;
  font-size: 12px;
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid #dcdee0;
  color: #646566;
  background: #fff;
}

.btn-mini-primary {
  color: #1989fa;
  border-color: #b3d4ff;
  background: #f4f9ff;
}

.btn-mini-danger {
  color: #ee0a24;
  border-color: #fcc;
  background: #fef5f5;
}

.form-add-dim {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 10px;
  font-size: 13px;
  color: #1989fa;
  border: 1px dashed #b3d4ff;
  border-radius: 10px;
  background: #f4f9ff;
  margin-bottom: 10px;
}

.form-add-dim-icon {
  font-size: 16px;
  font-weight: 600;
}

.link-danger {
  font-size: 12px;
  color: #ee0a24;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.cell-row {
  display: flex;
  flex-direction: row;
