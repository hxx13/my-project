  font-size: 13px;
}

.cell-main {
  flex: 1;
  min-width: 0;
}

.cell-id {
  font-size: 11px;
  color: #969799;
  margin-top: 4px;
}

.link {
  font-size: 12px;
  color: #1989fa;
  padding: 2px 4px;
}

