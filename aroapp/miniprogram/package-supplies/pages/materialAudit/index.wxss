/* 复用「领用审计」的骨架样式（page / card / chips / 中心弹窗），本页只加列表行样式 */
@import "../suppliesAudit/index.wxss";

.ma-summary {
  padding: 8px 12px 0;
  font-size: 12px;
  color: #969799;
}

.ma-row {
  padding: 10px 0;
  border-bottom: 1px solid #ebedf0;
}
.ma-row:last-child {
  border-bottom: none;
}

.ma-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ma-time {
  font-size: 12px;
  color: #969799;
}
.ma-badge {
  flex-shrink: 0;
  font-size: 11px;
  color: #646566;
  padding: 1px 8px;
  border-radius: 6px;
  background: #f2f3f5;
}

.ma-row-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 6px;
}
.ma-item {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  color: #323233;
}
.ma-qty {
  flex-shrink: 0;
  margin-left: 8px;
  font-size: 14px;
  color: #323233;
}

.ma-row-sub {
  margin-top: 2px;
  font-size: 12px;
  color: #646566;
}

.ma-row-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
  font-size: 12px;
}
.ma-who {
  color: #323233;
}
.ma-group {
  color: #646566;
  max-width: 60%;
  text-align: right;
}

.ma-row-id {
  margin-top: 2px;
  font-size: 11px;
  color: #969799;
  word-break: break-all;
}

.ma-clear {
  flex-shrink: 0;
  margin-left: 6px;
  padding: 0 10px;
  min-height: 36px;
  line-height: 36px;
  font-size: 12px;
  color: #646566;
  border-radius: 10px;
  background: #fff;
  border: 1px solid #ebedf0;
  box-sizing: border-box;
}

.ma-foot {
  padding: 12px 0 24px;
  text-align: center;
  font-size: 12px;
  color: #969799;
}
