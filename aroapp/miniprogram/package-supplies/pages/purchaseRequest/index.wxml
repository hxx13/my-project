<view class="page">
  <!-- 新建申请 -->
  <view class="wo-panel wo-panel--form">
    <view class="wo-panel-head" bindtap="toggleForm">
      <view class="wo-panel-title">新建采购申请</view>
      <view class="wo-head-actions">
        <view class="wo-toggle {{ form.isPublic ? 'wo-toggle--on' : '' }}" catchtap="togglePublic">{{ form.isPublic ? '公开' : '私密' }}</view>
        <view class="wo-head-btn wo-head-btn--submit" catchtap="submit">提交</view>
      </view>
      <text class="wo-expand-arrow {{ formExpanded ? 'wo-expand-arrow--open' : '' }}">▾</text>
    </view>
    <view class="wo-form-body {{ formExpanded ? 'wo-form-body--open' : '' }}">
      <input class="wo-input" value="{{ form.location }}" bindinput="onLocationInput" placeholder="使用地点（例：浦东A201）" />
      <view class="wo-desc-box">
        <textarea class="wo-input wo-textarea" value="{{ form.content }}" bindinput="onContentInput" placeholder="请描述采购需求、规格与数量" auto-height />
        <view class="wo-desc-bar">
          <view wx:if="{{ form.requestImages.length }}" class="image-grid image-grid--inline">
            <view wx:for="{{ form.requestImages }}" wx:key="*this" class="image-item image-item--sm">
              <image class="image-thumb image-thumb--sm" mode="aspectFill" lazy-load src="{{ item }}" data-url="{{ item }}" bindtap="onPreviewRequestImages" />
              <view class="image-remove" data-idx="{{ index }}" bindtap="onRemoveRequestImage">×</view>
            </view>
          </view>
          <view wx:if="{{ form.requestImages.length < 9 }}" class="image-add image-add--sm" catchtap="onChooseRequestImages">
            <text class="image-add-plus">+</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 采购单记录：标题与筛选固定，列表在容器内滚动 -->
  <view class="wo-panel wo-panel--list">
    <view class="wo-panel-list-head">
      <view class="title-row">
        <view class="wo-panel-title">采购单记录</view>
      </view>
      <view class="pill-list">
        <view class="pill {{ statusFilter === '' ? 'pill-on' : '' }}" hover-class="pill--hover" data-status="" bindtap="onStatusFilter">全部</view>
        <view class="pill {{ statusFilter === 'PENDING' ? 'pill-on' : '' }}" hover-class="pill--hover" data-status="PENDING" bindtap="onStatusFilter">待处理</view>
        <view class="pill {{ statusFilter === 'PROCESSING' ? 'pill-on' : '' }}" hover-class="pill--hover" data-status="PROCESSING" bindtap="onStatusFilter">处理中</view>
        <view class="pill {{ statusFilter === 'COMPLETED' ? 'pill-on' : '' }}" hover-class="pill--hover" data-status="COMPLETED" bindtap="onStatusFilter">已完成</view>
      </view>
    </view>

    <scroll-view
      scroll-y
      class="wo-list-scroll"
      enhanced
      show-scrollbar="{{ false }}"
      scroll-into-view="{{ scrollIntoViewId }}"
      lower-threshold="120"
      bindscrolltolower="onListReachBottom"
    >
      <view wx:if="{{ loading }}" class="meta">加载中…</view>
      <van-empty wx:elif="{{ rows.length === 0 }}" description="暂无采购记录" />
      <view wx:else>
        <view
          wx:for="{{ rows }}"
          wx:key="id"
          id="wo-{{ item.id }}"
          class="wo-row-card wo-card--{{ item.status }} {{ item.id === highlightId ? 'wo-row-card--focus' : '' }}"
          hover-class="wo-row-card--hover"
          data-id="{{ item.id }}"
          bindtap="onCardTap"
        >
          <view class="item-head">
            <view class="item-title">{{ item.location }} · {{ item.statusText }}</view>
            <view class="wo-card-acts">
              <view wx:if="{{ item.hasUnreadNotice }}" class="wo-act wo-act-read" data-id="{{ item.id }}" catchtap="markOrderRead">已读</view>
              <view wx:if="{{ item.canStart }}" class="wo-act wo-act-primary" data-id="{{ item.id }}" catchtap="startOrder">接单</view>
              <view wx:if="{{ item.canComplete }}" class="wo-act wo-act-success" data-id="{{ item.id }}" catchtap="openCompletePopup">完成</view>
              <view wx:if="{{ item.canWithdraw }}" class="wo-act wo-act-warn" data-id="{{ item.id }}" catchtap="withdraw">撤回</view>
              <view wx:if="{{ item.canDelete }}" class="wo-act wo-act-danger-plain" data-id="{{ item.id }}" catchtap="deleteOrder">删除</view>
            </view>
          </view>
          <view class="item-sub">{{ item.content }}</view>
          <view wx:if="{{ item.requestImages.length }}" class="image-grid">
            <image wx:for="{{ item.requestImages }}" wx:for-item="imgUrl" wx:key="*this" class="image-thumb" mode="aspectFill" lazy-load src="{{ imgUrl }}" data-url="{{ imgUrl }}" data-urls="{{ item.requestImages }}" catchtap="onPreviewCardImages" />
          </view>
          <view wx:if="{{ item.processorId }}" class="meta">处理人：{{ item.processorId }}</view>
          <view wx:if="{{ item.resultRemark }}" class="meta">处理结果：{{ item.resultRemark }}</view>
          <view wx:if="{{ item.resultImages.length }}" class="image-grid">
            <image wx:for="{{ item.resultImages }}" wx:for-item="imgUrl2" wx:key="*this" class="image-thumb" mode="aspectFill" lazy-load src="{{ imgUrl2 }}" data-url="{{ imgUrl2 }}" data-urls="{{ item.resultImages }}" catchtap="onPreviewCardImages" />
          </view>
          <view class="meta-row">
            <text class="meta-text">申请人：{{ item.applicantName || item.applicantId || '-' }} · 创建：{{ item.createTimeText }}</text>
          </view>
        </view>
      </view>

      <view class="list-foot">
        <text wx:if="{{ loadingMore }}" class="list-foot-text">加载中…</text>
        <text wx:elif="{{ !hasMore && rows.length }}" class="list-foot-text">没有更多了</text>
      </view>

      <!-- 回收站：仅处理权限可见 -->
      <block wx:if="{{ canProcess }}">
        <view class="recycle-head">
          <text class="recycle-title">回收站（7天后自动清空）</text>
          <view class="recycle-ops">
            <text class="recycle-op" bindtap="onPurgeRecycleSelected">选删</text>
            <text class="recycle-op recycle-op-danger" bindtap="onPurgeRecycleAll">清空</text>
          </view>
        </view>
        <view wx:if="{{ recycleRows.length === 0 }}" class="recycle-row recycle-row--empty">回收站为空</view>
        <view wx:for="{{ recycleRows }}" wx:key="id" class="recycle-row">
          <text class="recycle-main">{{ item.location }} · {{ item.statusText }}</text>
          <view class="recycle-line-ops">
            <text class="recycle-link" data-id="{{ item.id }}" bindtap="onToggleRecycleSelect">{{ recycleSelected[item.id] ? '已选' : '勾选' }}</text>
            <text class="recycle-link" data-id="{{ item.id }}" bindtap="onRestoreRecycle">恢复</text>
            <text class="recycle-link recycle-link-danger" data-id="{{ item.id }}" bindtap="onPurgeRecycleOne">删</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <van-popup show="{{ detailShow }}" position="bottom" round bind:close="closeDetail" custom-style="max-height:82vh;">
    <view class="wo-detail-head" wx:if="{{ detailRow }}">
      <text class="wo-detail-title">{{ detailRow.location }} · {{ detailRow.statusText }}</text>
      <text class="wo-detail-time">创建：{{ detailRow.createTimeText }}</text>
    </view>
    <scroll-view wx:if="{{ detailRow }}" scroll-y class="wo-detail-scroll">
      <text class="wo-detail-body" selectable="true">{{ detailRow.content }}</text>
      <view wx:if="{{ detailRow.requestImages.length }}" class="image-grid wo-detail-images">
        <image wx:for="{{ detailRow.requestImages }}" wx:for-item="imgUrl" wx:key="*this" class="image-thumb" mode="aspectFill" lazy-load src="{{ imgUrl }}" data-url="{{ imgUrl }}" data-urls="{{ detailRow.requestImages }}" catchtap="onPreviewCardImages" />
      </view>
    </scroll-view>
    <view class="wo-detail-actions" wx:if="{{ detailRow }}">
      <view class="wo-chip wo-chip-ghost" bindtap="copyDetailBody">复制全文</view>
      <view wx:for="{{ detailLinkList }}" wx:key="*this" class="wo-chip wo-chip-ghost" data-url="{{ item }}" bindtap="copyDetailLink">复制链接</view>
    </view>
  </van-popup>

  <van-popup show="{{ showComplete }}" position="bottom" round closeable bind:close="closeCompletePopup">
    <view class="popup-body">
      <view class="popup-title">完成采购处理</view>
      <textarea class="input" value="{{ completeRemark }}" bindinput="onCompleteRemarkInput" placeholder="填写处理结论（可选）" />
      <view class="popup-line">
        <text class="popup-tip">结果图片（最多 9 张）</text>
        <view class="wo-act-mini" bindtap="onChooseCompleteImages">添加</view>
      </view>
      <view wx:if="{{ completeImages.length }}" class="image-grid">
        <view wx:for="{{ completeImages }}" wx:key="*this" class="image-item">
          <image class="image-thumb" mode="aspectFill" lazy-load src="{{ item }}" data-url="{{ item }}" bindtap="onPreviewCompleteImages" />
          <view class="image-remove" data-idx="{{ index }}" bindtap="onRemoveCompleteImage">×</view>
        </view>
      </view>
      <view class="wo-popup-submit wo-popup-submit--ok {{ submitting ? 'wo-popup-submit--busy' : '' }}" bindtap="completeOrder">{{ submitting ? '提交中…' : '确认完成' }}</view>
    </view>
  </van-popup>
</view>
