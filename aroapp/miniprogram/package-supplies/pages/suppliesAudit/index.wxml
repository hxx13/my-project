<block wx:if="{{ pageGateOk }}">
  <view class="page">
    <view wx:if="{{ canAuditSection }}" class="tabs">
      <view class="tab {{ activeTab === 'personal' ? 'tab-on' : '' }}" data-tab="personal" bindtap="onMainTab">个人领用单</view>
      <view class="tab {{ activeTab === 'audit' ? 'tab-on' : '' }}" data-tab="audit" bindtap="onMainTab">按物品审计</view>
    </view>

    <block wx:if="{{ !canAuditSection || activeTab === 'personal' }}">
      <view class="card card-tight">
        <view class="toolbar-row">
          <view class="seg2">
            <view class="seg2-i {{ personalMode === 'single' ? 'seg2-on' : '' }}" data-mode="single" bindtap="onPersonalMode">单次</view>
            <view class="seg2-i {{ personalMode === 'multi' ? 'seg2-on' : '' }}" data-mode="multi" bindtap="onPersonalMode">多次</view>
          </view>
          <view wx:if="{{ personalMode === 'single' }}" class="toolbar-grow picker-compact" bindtap="openClaimDateSheet">{{ singleClaimChipText }}</view>
          <view wx:else class="toolbar-grow picker-compact hint-chip">下方日期与领用人变更后自动汇总</view>
          <view
            class="btn-compact btn-compact-primary {{ (exportingPersonal || exportingRange) || (personalMode === 'single' && !selectedClaimId) || (personalMode === 'multi' && (!rangeFrom || !rangeTo)) ? 'disabled' : '' }}"
            bindtap="onPersonalExportUnified"
          >导出</view>
        </view>

        <view wx:if="{{ personalMode === 'multi' }}" class="range-toolbar range-toolbar-mt">
          <view class="date-chip" bindtap="openRangeFromSheet">{{ rangeFrom || '开始' }}</view>
          <text class="range-sep">～</text>
          <view class="date-chip" bindtap="openRangeToSheet">{{ rangeTo || '结束' }}</view>
          <view wx:if="{{ canPickRangeApplicants }}" class="picker-compact applicant-chip" bindtap="openApplicantSheet">{{ rangeApplicantLabel }}</view>
          <view wx:else class="picker-compact applicant-chip applicant-chip-readonly">{{ rangeApplicantLabel }}</view>
        </view>

        <view wx:if="{{ loadingPersonal }}" class="muted">加载中…</view>
        <block wx:elif="{{ claimDetail }}">
          <view class="summary-grid summary-grid-tight">
            <view><text class="summary-k">单据状态</text><view>{{ claimDetail.statusText }}</view></view>
            <view><text class="summary-k">领用申请时间</text><view>{{ claimDetail.createdAtText }}</view></view>
            <view><text class="summary-k">出库完成时间</text><view>{{ claimDetail.fulfilledAtText }}</view></view>
            <view><text class="summary-k">申请领用人</text><view>{{ claimDetail.applicantDisp }}</view></view>
            <view><text class="summary-k">出库处理人</text><view>{{ claimDetail.fulfilledByDisp }}</view></view>
          </view>
          <view class="hint hint-tight">下列与「领用单明细」导出一致（无库存列）。</view>
          <scroll-view scroll-x class="scroll-table">
            <view class="table-inner">
              <view class="tr tr-head">
                <view class="td w-name">物资名称</view>
                <view class="td w-spec">规格</view>
                <view class="td w-time">领用申请时间</view>
                <view class="td w-time">出库完成时间</view>
                <view class="td w-xs">申请领用数量</view>
                <view class="td w-xs">出库数量</view>
                <view class="td w-sm">出入库类型</view>
                <view class="td w-mid">出库处理人</view>
                <view class="td w-mid">申请领用人</view>
                <view class="td w-remark">备注</view>
              </view>
              <view wx:for="{{ claimDetail.lines }}" wx:key="id" class="tr">
                <view class="td w-name">{{ item.snapshotName }}</view>
                <view class="td w-spec">{{ item.specLabel || '—' }}</view>
                <view class="td w-time">{{ claimDetail.createdAtText }}</view>
                <view class="td w-time">{{ claimDetail.fulfilledAtText }}</view>
                <view class="td w-xs">{{ item.qty }}</view>
                <view class="td w-xs">{{ item.fulfilledQty != null ? item.fulfilledQty : 0 }}</view>
                <view class="td w-sm">{{ item.lineIoType }}</view>
                <view class="td w-mid">{{ claimDetail.fulfilledByDisp }}</view>
                <view class="td w-mid">{{ claimDetail.applicantDisp }}</view>
                <view class="td w-remark muted">—</view>
              </view>
            </view>
          </scroll-view>
        </block>

        <view wx:if="{{ personalMode === 'multi' && rangeMeta }}" class="range-meta-line range-meta-mt">{{ rangeMeta.applicantDisplayName || rangeMeta.applicantUserId }} · {{ rangeMeta.total }} 单 · {{ rangeMeta.from }}～{{ rangeMeta.to }}</view>
        <scroll-view wx:if="{{ personalMode === 'multi' && rangeFlatRows.length }}" scroll-x class="scroll-table">
          <view class="table-inner table-inner-wide">
            <view class="tr tr-head">
              <view class="td w-name">物资名称</view>
              <view class="td w-spec">规格</view>
              <view class="td w-time">领用申请时间</view>
              <view class="td w-time">出库完成时间</view>
              <view class="td w-xs">申请领用数量</view>
              <view class="td w-xs">出库数量</view>
              <view class="td w-sm">出入库类型</view>
              <view class="td w-mid">出库处理人</view>
              <view class="td w-mid">申请领用人</view>
              <view class="td w-remark">备注</view>
            </view>
            <view wx:for="{{ rangeFlatRows }}" wx:key="_key" class="tr">
              <view class="td w-name">{{ item.snapshotName }}</view>
              <view class="td w-spec">{{ item.specLabel || '—' }}</view>
              <view class="td w-time">{{ item.createdAtText }}</view>
              <view class="td w-time">{{ item.fulfilledAtText }}</view>
              <view class="td w-xs">{{ item.qty }}</view>
              <view class="td w-xs">{{ item.fq }}</view>
              <view class="td w-sm">{{ item.lineIoType }}</view>
              <view class="td w-mid">{{ item.fulfilledByDisp }}</view>
              <view class="td w-mid">{{ item.applicantDisp }}</view>
              <view class="td w-remark muted">—</view>
            </view>
          </view>
        </scroll-view>
      </view>
    </block>

    <block wx:elif="{{ activeTab === 'audit' && canAuditSection }}">
      <view class="card card-tight">
        <view class="audit-one-line">
          <view class="audit-chip audit-chip-cat" bindtap="openAuditCategorySheet">{{ categoryChipShort }}</view>
          <input class="audit-inp-inline" placeholder="搜索物品" value="{{ itemKeyword }}" bindinput="onItemKeyword" />
          <view class="audit-chip audit-chip-item" bindtap="openAuditItemSheet">{{ itemChipShort }}</view>
          <view class="audit-ico" bindtap="onRefreshAudit">↻</view>
          <view class="audit-ico audit-ico-go {{ exportingAudit || !selectedItemId ? 'disabled' : '' }}" bindtap="onExportAudit">导出</view>
        </view>
        <view class="hint hint-tight">类型仅「入库/出库」；现存为流水快照库存；领用还原行无存库快照时留空。点刷新拉最新。</view>
        <view wx:if="{{ loadingAudit }}" class="muted">加载中…</view>
        <block wx:else>
          <scroll-view wx:if="{{ mergedRows.length }}" scroll-x class="scroll-table">
            <view class="table-inner table-inner-audit">
              <view class="tr tr-head">
                <view class="td w-time">变动时间</view>
                <view class="td w-name">物资名称</view>
                <view class="td w-sm">类型</view>
                <view class="td w-add">增加的库存</view>
                <view class="td w-add">新增的库存</view>
                <view class="td w-stock">现存</view>
                <view class="td w-mid">处理人</view>
                <view class="td w-mid">领用人</view>
                <view class="td w-remark">备注</view>
              </view>
              <view wx:for="{{ mergedRows }}" wx:key="_key" class="tr {{ item.rowTint === 'violet' ? 'tr-restored' : '' }}">
                <view class="td w-time">{{ item.timeText }}</view>
                <view class="td w-name">{{ item.name }}</view>
                <view class="td w-sm">{{ item.ioType }}</view>
                <view class="td w-add">{{ item.applyQty }}</view>
                <view class="td w-add">{{ item.changeQty }}</view>
                <view class="td w-stock">{{ item.stockText }}</view>
                <view class="td w-mid">{{ item.op }}</view>
                <view class="td w-mid">{{ item.ap }}</view>
                <view class="td w-remark">{{ item.remark }}</view>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="empty-block">本页暂无数据</view>
          <view class="hint hint-tight">本页 {{ mergedRows.length }} 行；流水共 {{ auditTotal }} 条、还原共 {{ restoredTotal }} 条。</view>
          <view wx:if="{{ auditPagerShow }}" class="pager">
            <view class="pager-btn" bindtap="onAuditPrev">上一页</view>
            <text>第 {{ auditPage }} 页</text>
            <view class="pager-btn" bindtap="onAuditNext">下一页</view>
          </view>
        </block>
      </view>
    </block>

    <!-- 统一中心弹窗选择（禁用微信原生 picker）；样式与项目内胶囊/卡片一致 -->
    <view wx:if="{{ centerSheet.visible }}" class="center-mask" bindtap="closeCenterSheet">
      <view class="center-sheet" catchtap="noop">
        <view class="center-sheet-title">{{ centerSheet.title }}</view>
        <scroll-view scroll-y class="center-sheet-scroll">
          <view
            wx:for="{{ centerSheet.rows }}"
            wx:key="k"
            class="center-sheet-row"
            data-index="{{ index }}"
            bindtap="onCenterSheetRowTap"
          >
            <view class="center-sheet-main">{{ item.main }}</view>
            <view wx:if="{{ item.sub }}" class="center-sheet-sub">{{ item.sub }}</view>
          </view>
        </scroll-view>
        <view class="center-sheet-footer">
          <view class="center-sheet-btn" bindtap="closeCenterSheet">关闭</view>
        </view>
      </view>
    </view>
  </view>
</block>
