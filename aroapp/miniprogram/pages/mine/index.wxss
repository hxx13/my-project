@keyframes mine-shimmer {
  0% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.45;
  }
}

/* 自定义 fixed tabBar：为页面预留底部空间（安全区在 page 上统一处理） */
page {
  padding-bottom: calc(50px + constant(safe-area-inset-bottom));
  padding-bottom: calc(50px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.mine-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 32rpx;
  background-color: #f4f6fb;
  background-image: radial-gradient(ellipse 120% 80% at 0% -10%, rgba(99, 102, 241, 0.22), transparent 52%),
    radial-gradient(ellipse 100% 70% at 100% 0%, rgba(45, 212, 191, 0.16), transparent 48%),
    radial-gradient(ellipse 80% 50% at 50% 100%, rgba(99, 102, 241, 0.08), transparent 55%);
}

/* 主卡片：轻量「玻璃」层次 + 顶部光感 */
.mine-header-card {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 48rpx rgba(79, 70, 229, 0.09), 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  backdrop-filter: blur(20px);
}

.mine-header-mesh {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 200rpx;
  pointer-events: none;
  background: radial-gradient(ellipse 90% 120% at 100% 0%, rgba(129, 140, 248, 0.35), transparent 58%),
    radial-gradient(ellipse 70% 100% at 0% 20%, rgba(45, 212, 191, 0.28), transparent 50%);
  opacity: 0.9;
}

.mine-header-badges {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  max-width: 46%;
}

.mine-chip-row {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.mine-header-badges .mine-chip {
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

/* 点击角色 chip 同步角色（外观与普通 chip 一致，无额外图标） */
.mine-chip--role-tap-hover {
  opacity: 0.88;
  filter: brightness(0.96);
}

.mine-header-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 28rpx;
  padding: 36rpx 32rpx 28rpx;
}

.mine-avatar-ring {
  flex-shrink: 0;
  padding: 6rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.55), rgba(45, 212, 191, 0.55));
  box-shadow: 0 8rpx 28rpx rgba(99, 102, 241, 0.25);
}

.mine-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
  border: 4rpx solid #fff;
  box-sizing: border-box;
}

.mine-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.mine-avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #e0e7ff 0%, #ccfbf1 100%);
}

.mine-avatar-char {
  font-size: 48rpx;
  font-weight: 800;
  color: #4338ca;
  letter-spacing: -2rpx;
}

.mine-header-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-right: 176rpx;
  box-sizing: border-box;
}

.mine-kicker-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mine-kicker {
  font-size: 22rpx;
  font-weight: 600;
  color: #6366f1;
  letter-spacing: 2rpx;
}

.mine-kicker-dot {
  font-size: 20rpx;
  color: #cbd5e1;
}

.mine-kicker-sub {
  font-size: 18rpx;
  font-weight: 600;
  color: #94a3b8;
  letter-spacing: 3rpx;
}

.mine-name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.mine-display-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
  letter-spacing: -0.5rpx;
}

.mine-chip {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.15);
  color: #475569;
  border: 1rpx solid rgba(148, 163, 184, 0.25);
}

.mine-chip--ok {
  background: rgba(16, 185, 129, 0.12);
  color: #059669;
  border-color: rgba(16, 185, 129, 0.28);
}

.mine-chip--warn {
  background: rgba(249, 115, 22, 0.12);
  color: #ea580c;
  border-color: rgba(249, 115, 22, 0.28);
}

/* 档案区 */
.mine-archive {
  position: relative;
  z-index: 1;
  padding: 0 24rpx 28rpx;
}

.mine-archive--hint {
  padding: 8rpx 24rpx 32rpx;
}

.mine-hint-text {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.55;
}

.mine-archive-head {
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  gap: 20rpx;
  padding: 8rpx 8rpx 20rpx;
}

.mine-archive-title-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.mine-archive-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5rpx;
}

.mine-archive-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 头部右上角操作按钮（AI画像 / 详情），与上方指示 chip 右对齐成列。
   实底、无渐变、非胶囊。 */
.mine-badge-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 2rpx;
}

.mine-archive-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  background: #2563eb;
  border: none;
}

.mine-archive-action--ghost {
  background: #ffffff;
  border: 1rpx solid #bfdbfe;
}

.mine-archive-action-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
}

.mine-archive-action-text--ghost {
  color: #2563eb;
}

.mine-archive-action-arrow {
  font-size: 28rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1;
}

.mine-archive-body {
  padding: 0 0 4rpx;
}

.mine-archive-state {
  padding: 8rpx 0 12rpx;
}

.mine-archive-state--loading {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mine-skel-line {
  height: 28rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #e2e8f0, #f1f5f9, #e2e8f0);
  background-size: 200% 100%;
  animation: mine-shimmer 1.4s ease-in-out infinite;
}

.mine-skel-line--long {
  width: 100%;
}

.mine-skel-line--mid {
  width: 72%;
}

.mine-archive-state--empty {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(248, 250, 252, 0.95);
  border: 1rpx dashed #cbd5e1;
  text-align: center;
}

.mine-empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #475569;
  margin-bottom: 8rpx;
}

.mine-empty-desc {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.55;
}

.mine-archive-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.mine-info-tile {
  flex: 1 1 calc(50% - 8rpx);
  min-width: 0;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.mine-info-tile--accent {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(45, 212, 191, 0.08));
  border-color: rgba(99, 102, 241, 0.18);
}

.mine-info-tile--span {
  flex: 1 1 100%;
}

.mine-info-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #94a3b8;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.mine-info-value {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-info-value--lg {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.mine-archive--compact {
  padding: 0 32rpx 24rpx;
}

.mine-archive--compact .mine-archive-head {
  margin-bottom: 0;
}

.mine-archive-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.mine-menu-group {
  margin-bottom: 24rpx;
}

.mine-menu-group--system {
  margin-bottom: 8rpx;
}

.mine-menu-group-title {
  display: block;
  margin: 0 12rpx 12rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
  letter-spacing: 1rpx;
}

/* 常用功能标题 */
.mine-section {
  margin: 36rpx 8rpx 16rpx 12rpx;
}

.mine-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mine-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5rpx;
}

.mine-section-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #a5b4fc;
  letter-spacing: 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(99, 102, 241, 0.1);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
}

.mine-list-card {
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.06);
  transition: box-shadow 0.08s ease;
}

/* 菜单组淡入（短动画，无感知延迟） */
.mine-menu-group {
  margin-bottom: 24rpx;
  animation: mine-fade-up 0.1s ease both;
}
.mine-menu-group:nth-child(1) { animation-delay: 0s; }
.mine-menu-group:nth-child(2) { animation-delay: 0.02s; }
.mine-menu-group:nth-child(3) { animation-delay: 0.04s; }
.mine-menu-group:nth-child(4) { animation-delay: 0.06s; }
.mine-menu-group:nth-child(5) { animation-delay: 0.08s; }

@keyframes mine-fade-up {
  from { opacity: 0.6; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Cell 按压微动效 */
.mine-list-card .van-cell {
  transition: padding-left 0.06s ease, background 0.06s ease;
}
.mine-list-card .van-cell:active {
  padding-left: 36rpx;
  background: rgba(99, 102, 241, 0.04);
}

/* 常用功能：与 Web 侧栏同语义的小图标（线框风格，高度不超过标题字） */
.mine-slot-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.mine-cell-title-wrap {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  min-width: 0;
}

.mine-cell-title-text {
  font-size: 28rpx;
  color: #323233;
  flex: 1;
  min-width: 0;
}

.mine-menu-badge {
  flex-shrink: 0;
  min-width: 30rpx;
  padding: 2rpx 8rpx;
  font-size: 20rpx;
  line-height: 1.25;
  color: #ffffff;
  background: #ee0a24;
  border-radius: 999rpx;
  text-align: center;
  font-weight: 700;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(238, 10, 36, 0.35);
}

.profile-summary-muted {
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}

.mine-cell-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx 28rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(248, 250, 252, 0.6) 0%, #fff 40%);
  border-top: 1rpx solid rgba(226, 232, 240, 0.9);
}

/* 按钮一律「实底 + 无渐变 + 无半透明」：rgba/渐变在浅色底上会透出背景，看着脏。
   主操作统一 #2563eb；次要动作走浅色实底 + 实色描边（不是半透明）。 */
.mine-foot-btn {
  min-width: 200rpx !important;
  height: 72rpx !important;
  line-height: 70rpx !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  border-radius: 12rpx !important;
  border: none !important;
}

.mine-foot-btn--bind,
.mine-foot-btn--login {
  background: #2563eb !important;
  color: #fff !important;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.22) !important;
}

.mine-foot-btn--logout {
  background: #fef2f2 !important;
  color: #dc2626 !important;
  border: 1rpx solid #fecaca !important;
}

.mine-profile-popup {
  width: 90vw !important;
  max-width: 700rpx;
  box-sizing: border-box;
  border-radius: 28rpx !important;
  overflow: hidden;
}

.profile-popup-root {
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  background: #fafbfc;
}

.profile-popup-head {
  padding: 32rpx 32rpx 24rpx;
  background: linear-gradient(180deg, #fff 0%, #f8fafc 100%);
  border-bottom: 1rpx solid #e2e8f0;
}

.profile-popup-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -1rpx;
}

.profile-popup-scroll {
  flex: 1;
  max-height: 70vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx 40rpx;
}

.profile-popup-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.profile-popup-quick-item {
  flex: 1 1 calc(50% - 8rpx);
  min-width: 0;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}

.profile-popup-quick-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #94a3b8;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.profile-popup-quick-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
  line-height: 1.35;
  word-break: break-all;
}

.profile-popup-id-card {
  padding: 24rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(99, 102, 241, 0.08), rgba(45, 212, 191, 0.06));
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  box-shadow: 0 8rpx 28rpx rgba(79, 70, 229, 0.08);
}

.profile-popup-id-head {
  margin-bottom: 16rpx;
}

.profile-popup-id-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #64748b;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.profile-popup-id-code {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.45;
  word-break: break-all;
}

.profile-id-qr-canvas {
  display: block;
  width: 200px;
  height: 200px;
  margin: 0 auto;
  background: #fff;
}

.profile-id-qr-canvas--popup {
  width: 180px;
  height: 180px;
  border-radius: 16rpx;
}

.profile-id-qr-image {
  display: block;
  width: 180px;
  height: 180px;
  margin: 0 auto;
  background: #fff;
  border-radius: 16rpx;
}

.profile-id-qr-placeholder {
  width: 180px;
  height: 180px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
  background: #f8fafc;
  border-radius: 16rpx;
}

.profile-id-qr-offscreen {
  position: fixed;
  left: -2000px;
  top: 0;
  opacity: 0;
  pointer-events: none;
}

.profile-popup-section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #94a3b8;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.profile-popup-kv {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #eef2f6;
}

.profile-popup-k {
  flex: 0 0 200rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  line-height: 1.45;
}

.profile-popup-v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
  white-space: pre-wrap;
}

.profile-popup-loading {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
}

.profile-popup-empty {
  padding: 32rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.mine-bind-popup {
  width: 86vw !important;
  max-width: 640rpx;
  box-sizing: border-box;
}

.bind-panel {
  padding: 32rpx 28rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.bind-panel--center {
  padding-bottom: 36rpx;
}

.bind-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
  color: #0f172a;
  letter-spacing: -0.5rpx;
}

/* 标题下的一句话说明：光一个「账号登录」太干，用户不知道能填什么 */
.bind-sub {
  display: block;
  font-size: 23rpx;
  color: #94a3b8;
  line-height: 1.45;
  margin-bottom: 24rpx;
}

.bind-tip {
  display: block;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.55;
  margin-bottom: 28rpx;
}

.bind-student-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.bind-input-grow {
  flex: 1;
  min-width: 0;
}

.bind-scan-btn {
  flex-shrink: 0;
  font-size: 22rpx !important;
  padding: 0 12rpx !important;
  white-space: nowrap;
}

.bind-input {
  min-height: 80rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 27rpx;
  color: #0f172a;
  background: #fff;
  box-sizing: border-box;
}

.bind-input-block {
  display: block;
  width: 100%;
  margin-bottom: 16rpx;
}

/* 密码规则提示：规则提前说清，别让用户提交后才被后端打回 */
.bind-pwd-hint {
  display: block;
  font-size: 21rpx;
  color: #94a3b8;
  line-height: 1.45;
  margin: -6rpx 0 14rpx;
}

/* 学生注册两条路：已有人员编号 / 我是新用户（与 Web 端两个 tab 对齐） */
.reg-mode-tabs {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
}

.reg-mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
}

.reg-mode-tab--on {
  background: #fff;
  color: #2563eb;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

/* 姓名与性别同行：性别只有两个选项，单独占一行太费高度 */
.reg-name-gender-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.reg-name-input {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.reg-gender-chip {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 80rpx;
  line-height: 78rpx;
  text-align: center;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fff;
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  box-sizing: border-box;
}

.reg-gender-chip--on {
  border-color: #2563eb;
  background: #eff6ff;
  color: #2563eb;
}

/* 主按钮：实底 + 直角圆角 + 无渐变无半透明。
   早先是「酒红半透明渐变 + 胶囊」，既显脏，又和全站其它实底按钮不是一套。 */
.bind-submit {
  height: 84rpx !important;
  line-height: 84rpx !important;
  margin-top: 12rpx !important;
  border-radius: 12rpx !important;
  background: #2563eb !important;
  border: none !important;
  color: #fff !important;
  font-size: 29rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.2) !important;
}

/* vant 按钮自带 1rpx 描边伪元素：圆角改小后它会从边上露出来 */
.bind-submit::after {
  border: none !important;
}

/* WxPusher 双二维码区 */
.wxpusher-qr-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin: 16rpx 0;
}

.wxpusher-qr-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.wxpusher-qr-canvas {
  width: 140px;
  height: 140px;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
  background: #fff;
}

.wxpusher-qr-label {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 500;
}

/* ====== 登录/注册表单 ====== */
.login-register-link {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 4rpx;
  padding: 6rpx 0;
  min-height: 56rpx;
}

.login-register-text {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 500;
}

/* ====== 注册表单 ====== */
/* 拍照/上传：主操作就走实底，和提交按钮同一套（浅底描边那版看着像"线条按钮"，不用） */
.reg-qr-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 16rpx;
  margin: 16rpx 0 12rpx;
  border-radius: 14rpx;
  background: #2563eb;
  border: none;
}

.reg-qr-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.reg-qr-scanning {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  font-size: 24rpx;
  color: #2563eb;
}

.reg-error-text {
  color: #ef4444;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx 16rpx;
  background: rgba(239, 68, 68, 0.06);
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.reg-verified-icon {
  font-size: 72rpx;
  text-align: center;
  margin-bottom: 12rpx;
}

.reg-verified-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.reg-info-card {
  margin: 20rpx 0 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.reg-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.reg-info-row + .reg-info-row {
  border-top: 1rpx solid #eef2f6;
}

.reg-info-label {
  font-size: 26rpx;
  color: #94a3b8;
}

.reg-info-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

/* 邮箱绑定弹窗 */
.mine-email-popup {
  width: 86vw !important;
  max-width: 600rpx !important;
  padding: 0 !important;
}

.mine-email-popup-body {
  padding: 28rpx 28rpx 24rpx;
}

.mine-email-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  text-align: center;
  margin-bottom: 8rpx;
}

.mine-email-hint {
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 20rpx;
}

.mine-email-input {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #0f172a;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
}

.mine-email-btns {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

/* ====== 邮箱绑定验证码 ====== */
.mine-email-code-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.mine-email-input--code {
  flex: 1;
  min-width: 0;
}

.sendkey-link-hint {
  margin-bottom: 16rpx;
}
.sendkey-link-text {
  font-size: 22rpx;
  color: var(--app-color-accent, #d97706);
  text-decoration: underline;
}

.mine-email-send-btn {
  flex-shrink: 0;
  font-size: 22rpx !important;
  padding: 0 16rpx !important;
  white-space: nowrap;
  min-width: 140rpx;
  text-align: center;
}

/* ====== 忘记密码 ====== */
.forgot-method-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
  transition: background 0.06s ease;
}

.forgot-method-btn:active {
  background: rgba(99, 102, 241, 0.06);
  border-color: rgba(99, 102, 241, 0.25);
}

.forgot-method-icon {
  flex-shrink: 0;
  font-size: 48rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(45, 212, 191, 0.1));
}

.forgot-method-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.forgot-method-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.3;
}

.forgot-method-desc {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.4;
}

/* QR upload row */
.forgot-qr-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* 实底，不用渐变/半透明：那两种在浅色底上会透出背景 */
.forgot-qr-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  background: #2563eb;
  border: none;
}

.forgot-qr-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.forgot-qr-hint {
  font-size: 22rpx;
  color: #6366f1;
  font-weight: 500;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Email send row */
.forgot-email-send-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* ---- 电子签名链接弹窗 ---- */
.sig-link-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 32rpx 32rpx;
}

.sig-link-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.sig-link-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #969799;
  text-align: center;
}

.sig-link-qr {
  width: 400rpx;
  margin: 24rpx 0 16rpx;
  border-radius: 12rpx;
  background: #fff;
}

.sig-link-url {
  width: 100%;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #969799;
  word-break: break-all;
  text-align: center;
}

/* 离屏画布：只用来生成二维码图，不能 display:none（那样画不出来） */
.sig-link-qr-offscreen {
  position: absolute;
  left: -9999rpx;
  top: 0;
  width: 200px;
  height: 200px;
}

/* ---- 电子签名预览弹窗（已签过） ---- */
.sig-view-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 32rpx 32rpx;
}

.sig-view-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

/* 签名图：白底、按宽度撑满，长按可保存 —— 跟网页端的展示口径一致 */
.sig-view-img {
  width: 100%;
  margin: 24rpx 0 16rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 12rpx;
  background: #fff;
}

.sig-view-note {
  font-size: 24rpx;
  line-height: 1.6;
  color: #969799;
  text-align: center;
}
