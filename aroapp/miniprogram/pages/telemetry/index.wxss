page {
  box-sizing: border-box;
}

.telemetry-page {
  min-height: 100vh;
  background: #f0f5f1;
  padding: 12rpx 12rpx 0;
  /* 底栏在本页是藏起来的（custom-tab-bar 按路由判），不用再给它留位 */
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.state {
  text-align: center;
  padding: 80rpx 0;
  color: #94a3b8;
  font-size: 24rpx;
}

.state-err {
  color: #b91c1c;
}

/* 导航栏上的「监测」入口（退回键右侧，跟在 flex 流里；窄控件，不压标题） */
.nav-entry {
  margin-left: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #2563eb;
  line-height: 1.4;
}

.nav-entry--hover { opacity: 0.86; }
