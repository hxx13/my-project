# ===== Twin System 环境变量 =====
# 复制此文件到 /opt/twin/.env 并填入真实值
# cp deploy/linux/.env.example /opt/twin/.env

# ── 必须配置 ──
DB_PASSWORD=你的MySQL密码

# ── 微信小程序（非必须，不配则小程序登录功能不可用）──
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── 以下可选，有合理默认值 ──
# SPRING_PROFILES_ACTIVE=prod
# INVITE_CODE_PEPPER=替换为随机长字符串
# UPLOAD_SYNC_SECRET=
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# WINCC_USERNAME=admin
# WINCC_PASSWORD=
# DEEPSEEK_API_KEY=
