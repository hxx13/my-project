# ===== Twin System 环境变量 =====
# 复制此文件到 /opt/twin/.env 并填入真实值
# cp deploy/linux/.env.example /opt/twin/.env

# ── 必须配置 ──
DB_PASSWORD=你的MySQL密码

# ── 微信小程序（生产环境必须配置，否则以下功能全部不可用）──
# • 小程序打开时静默获取 OpenID
# • OpenID 自动绑定校内账户（学生学号 / 教职工账号密码）
# • 下次打开小程序根据已绑定 OpenID 自动登录
# 获取方式：https://mp.weixin.qq.com → 开发管理 → 开发设置 → AppID / AppSecret
# 只在生产环境生效（开发环境走 MD5 Mock，跳过微信静默登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── 以下可选，有合理默认值 ──
# SPRING_PROFILES_ACTIVE=prod
# INVITE_CODE_PEPPER=替换为随机长字符串
# UPLOAD_SYNC_SECRET=
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# WINCC_USERNAME=admin
# WINCC_PASSWORD=
# DEEPSEEK_API_KEY=

# ── 安维迪「云组态」饮水流量监测 ──
# 不填这两个键，这套功能在生产上拿不到任何数据：模块能启动，但登录不上去，
# 日志里会一直报「登录失败」，页面是空的。账号是对方平台上的那个管理员账号。
# AVIDITY_USERNAME=
# AVIDITY_PASSWORD=
