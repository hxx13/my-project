# 本地开发 API 地址（Vite proxy / Spring 后端）
VITE_API_BASE_URL=http://localhost:8081

# Socket 地址（本地开发用 9093，避免与生产 9092 冲突）
VITE_SOCKET_URL=http://localhost:9093

# 富文本图片：单图最大宽度（百分数，如 50 表示 50%）
VITE_RICH_TEXT_IMAGE_MAX_WIDTH=50
# 富文本图片：同行并排张数（默认 1=单图居中；≥2 时多选/Ctrl+V 才插入同一行）
VITE_RICH_TEXT_IMAGE_ROW_MAX=1
