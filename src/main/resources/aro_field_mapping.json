{
  "version": "6",
  "description": "ARO 字段名 → 本地规范名 双向映射。sources=拉取时ARO→本地, targets=推送时本地→ARO。空串视为真实空（写 null 清空本地），别名仅在路径不存在时回退。",
  "endpoints": {
    "back":   { "path": "/admin/cageBox/{roomId}/{shelveId}/animalCages/back", "direction": "pull" },
    "book":   { "path": "/admin/book/{roomId}/{shelveId}/animalCages", "direction": "pull" },
    "detail": { "path": "/admin/animalCage/{id}", "direction": "pull" },
    "list":   { "path": "/admin/animalCage/list", "direction": "pull" },
    "cageBoxAction":   { "path": "/admin/animalCageBoxPart/save", "direction": "push" },
    "specialBreeding": { "path": "/admin/specialBreeding/save", "direction": "push" },
    "animalHealth":    { "path": "/admin/animalHealth/save", "direction": "push" },
    "cageRelatedBox":  { "path": "/admin/cageRelatedBox/save", "direction": "push" },
    "cancelColor":     { "path": "/admin/cageBox/cancelColor", "direction": "push" },
    "updateAnimalCage":{ "path": "/admin/animalCage/update", "direction": "push" }
  },
  "filters": [
    { "rule": "skip", "endpoint": "back", "field": "isCageBox", "match": [1, "1", true] },
    { "rule": "skip", "endpoint": "list", "field": "isCageBox", "match": [1, "1", true] }
  ],
  "mappings": [
    {
      "canonical": "animal_cage_id",
      "type": "long",
      "sources": { "back": "id", "book": "id", "detail": "id", "list": "id" }
    },
    {
      "canonical": "position_x",
      "type": "int",
      "sources": { "back": ["postionX","positionX"], "book": ["postionX","positionX"], "list": ["postionX","positionX"] },
      "targets": { "updateAnimalCage": "postionX" }
    },
    {
      "canonical": "position_y",
      "type": "int",
      "sources": { "back": ["postionY","positionY"], "book": ["postionY","positionY"], "list": ["postionY","positionY"] },
      "targets": { "updateAnimalCage": "postionY" }
    },
    {
      "canonical": "cage_type_code",
      "sqlColumn": "cage_type_code",
      "type": "int",
      "sources": { "back": "animalCageType", "book": "animalCageType", "list": "animalCageType" }
    },
    {
      "canonical": "cage_box_code",
      "sqlColumn": "cage_box_code",
      "type": "string",
      "sources": { "back": ["cageBoxVo.cageBoxCode","cageBoxVo.cageBoxQrCode"], "list": ["cageBoxVo.cageBoxCode","cageBoxVo.cageBoxQrCode"] },
      "targets": { "cageRelatedBox": "cageBoxCode" }
    },
    {
      "canonical": "cage_use_time",
      "type": "string",
      "comment": "使用时间：cageBoxVo.createTime（笼盒创建/挂上那一刻），替换原合笼日期 cohabitation_date",
      "sources": { "back": "cageBoxVo.createTime", "list": "cageBoxVo.createTime" }
    },
    {
      "canonical": "pi_name",
      "sqlColumn": "pi_name",
      "comment": "笼位顶层 PI / 课题组长 ← ARO animalCage.piName（与 simplifyCell.piName 一致）",
      "type": "string",
      "sources": {
        "back": ["piName", "cageBoxVo.piName"],
        "list": ["piName", "cageBoxVo.piName"]
      }
    },
    {
      "canonical": "project_pi_name",
      "sqlColumn": "project_pi_name",
      "comment": "项目/课题 PI ← ARO cageBoxVo.projectPiName（网格常用此字段作课题组标识）。/book 无此字段，勿在 book sources 中声明。",
      "type": "string",
      "sources": {
        "back": ["cageBoxVo.projectPiName", "projectPiName"],
        "list": ["cageBoxVo.projectPiName", "projectPiName"]
      }
    },
    {
      "canonical": "project_name",
      "sqlColumn": "project_name",
      "comment": "项目名称 ← ARO cageBoxVo.projectName（API 网格字段名 projectGroup，不是独立课题组表）",
      "type": "string",
      "sources": { "back": "cageBoxVo.projectName", "list": "cageBoxVo.projectName" }
    },
    {
      "canonical": "department_name",
      "sqlColumn": "department_name",
      "type": "string",
      "sources": { "back": "cageBoxVo.departmentName", "list": "cageBoxVo.departmentName" }
    },
    {
      "canonical": "aup_number",
      "sqlColumn": "aup_number",
      "type": "string",
      "sources": { "back": "cageBoxVo.aupNumber", "list": "cageBoxVo.aupNumber" }
    },
    {
      "canonical": "needs_division",
      "sqlColumn": "needs_division",
      "type": "boolean",
      "sources": { "back": "cageBoxVo.needDivideYn" },
      "targets": { "cageBoxAction": "NeedDivideYn", "updateAnimalCage": "needDivideYn" }
    },
    {
      "canonical": "needs_special_feeding",
      "sqlColumn": "needs_special_feeding",
      "type": "boolean",
      "sources": { "back": "cageBoxVo.needFeedingYn" },
      "targets": { "updateAnimalCage": "needFeedingYn" }
    },
    {
      "canonical": "needs_transfer",
      "sqlColumn": "needs_transfer",
      "type": "boolean",
      "sources": { "back": "cageBoxVo.needTransferYn" },
      "targets": { "updateAnimalCage": "needTransferYn" }
    },
    {
      "canonical": "has_health_abnormality",
      "sqlColumn": "has_health_abnormality",
      "type": "boolean",
      "sources": { "back": "cageBoxVo.abnormalHealthYn" },
      "targets": { "updateAnimalCage": "abnormalHealthYn" }
    },
    {
      "canonical": "needs_cohabitation",
      "sqlColumn": "needs_cohabitation",
      "type": "boolean",
      "comment": "合笼 0/1：closingdate 非空 且 (无取消 或 取消早于合笼)。ARO 无布尔字段，由两时间戳综合判定；cageBoxVo 不存在时不判定（保留旧值）。closingdate<=rescindDatetime 视为已解除。",
      "endpoints": ["back"],
      "computed": {
        "rule": "cohabitationActive",
        "inputs": {
          "closing": "cageBoxVo.closingdate",
          "rescind": "cageBoxVo.rescindDatetime"
        }
      }
    },
    {
      "canonical": "special_breeding_name",
      "sqlColumn": "special_breeding_name",
      "type": "string",
      "sources": { "back": "cageBoxVo.specialBreedingName", "list": "cageBoxVo.specialBreedingName" },
      "targets": { "specialBreeding": "specialBreedingName" }
    },
    {
      "canonical": "special_breeding_desc",
      "sqlColumn": "special_breeding_desc",
      "type": "string",
      "sources": { "back": "cageBoxVo.specialBreedingDescription", "list": "cageBoxVo.specialBreedingDescription" },
      "targets": { "specialBreeding": "specialBreedingDescription" }
    },
    {
      "canonical": "experimenter_name",
      "sqlColumn": "experimenter_name",
      "type": "string",
      "sources": { "back": "cageBoxVo.experimenterName", "list": "cageBoxVo.experimenterName" }
    },
    {
      "canonical": "lab_assistant_name",
      "sqlColumn": "lab_assistant_name",
      "type": "string",
      "sources": { "back": "cageBoxVo.labAssistantName", "list": "cageBoxVo.labAssistantName" }
    },
    {
      "canonical": "animal_strain_name",
      "sqlColumn": "animal_strain_name",
      "type": "string",
      "sources": { "back": "cageBoxVo.animalStrainName", "list": "cageBoxVo.animalStrainName" }
    },
    {
      "canonical": "animal_sex",
      "sqlColumn": "animal_sex",
      "type": "string",
      "sources": { "back": "cageBoxVo.animalSex", "list": "cageBoxVo.animalSex" }
    },
    {
      "canonical": "animal_week_age",
      "sqlColumn": "animal_week_age",
      "type": "string",
      "sources": { "back": "cageBoxVo.animalWeekAge", "list": "cageBoxVo.animalWeekAge" }
    },
    {
      "canonical": "animal_male_number",
      "sqlColumn": "animal_male_number",
      "type": "int",
      "sources": { "back": "cageBoxVo.animalMaleNumber", "list": "cageBoxVo.animalMaleNumber" }
    },
    {
      "canonical": "animal_female_number",
      "sqlColumn": "animal_female_number",
      "type": "int",
      "sources": { "back": "cageBoxVo.animalFemaleNumber", "list": "cageBoxVo.animalFemaleNumber" }
    },
    {
      "canonical": "animal_come_from",
      "sqlColumn": "animal_come_from",
      "type": "string",
      "sources": { "back": "cageBoxVo.animalComeFrom", "list": "cageBoxVo.animalComeFrom" }
    }
  ]
}
