<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.cageshelf.mapper.CageFormAuditLogMapper">

    <resultMap id="CageFormAuditLogMap" type="com.example.demo.modules.cageshelf.entity.CageFormAuditLog">
        <id property="id" column="id"/>
        <result property="category" column="category"/>
        <result property="changeType" column="change_type"/>
        <result property="entity" column="entity"/>
        <result property="entityId" column="entity_id"/>
        <result property="entityCode" column="entity_code"/>
        <result property="entityName" column="entity_name"/>
        <result property="targetType" column="target_type"/>
        <result property="targetId" column="target_id"/>
        <result property="targetLabel" column="target_label"/>
        <result property="fieldCode" column="field_code"/>
        <result property="fieldName" column="field_name"/>
        <result property="beforeValue" column="before_value"/>
        <result property="afterValue" column="after_value"/>
        <result property="beforeJson" column="before_json"/>
        <result property="afterJson" column="after_json"/>
        <result property="operatorId" column="operator_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 纯条件片段（不含 <where> 包裹），同时被平铺查询与按操作聚合查询复用 -->
    <sql id="FilterCondition">
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="changeType != null and changeType != ''">
                AND change_type = #{changeType}
            </if>
            <if test="entity != null and entity != ''">
                AND entity = #{entity}
            </if>
            <if test="operatorId != null and operatorId != ''">
                AND operator_id = #{operatorId}
            </if>
            <!-- 按人员：审计行只记操作人，占用者维度由占用事件日志还原出「此人占用过的笼位」，再取这些笼位的留痕 -->
            <if test="personId != null">
                AND target_id IN (
                    SELECT from_animal_cage_id FROM cage_transfer_log
                    WHERE occupant_id = #{personId} AND from_animal_cage_id IS NOT NULL
                    UNION
                    SELECT to_animal_cage_id FROM cage_transfer_log
                    WHERE occupant_id = #{personId} AND to_animal_cage_id IS NOT NULL
                )
            </if>
            <if test="dateFrom != null and dateFrom != ''">
                AND created_at &gt;= #{dateFrom}
            </if>
            <if test="dateTo != null and dateTo != ''">
                AND created_at &lt;= #{dateTo}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (
                    entity_code LIKE CONCAT('%', #{keyword}, '%')
                    OR entity_name LIKE CONCAT('%', #{keyword}, '%')
                    OR field_code LIKE CONCAT('%', #{keyword}, '%')
                    OR field_name LIKE CONCAT('%', #{keyword}, '%')
                    OR target_label LIKE CONCAT('%', #{keyword}, '%')
                    OR before_value LIKE CONCAT('%', #{keyword}, '%')
                    OR after_value LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
    </sql>

    <sql id="FilterWhere">
        <where>
            <include refid="FilterCondition"/>
        </where>
    </sql>

    <!-- 按操作聚合的口径：在通用条件之上，按「人工 / 系统同步」再分一层。
         全表 99.9% 的行是 ARO 同步写进来的（operator_id='SYNC'），不分开就只剩噪声。 -->
    <sql id="OperationFilterWhere">
        <where>
            <include refid="FilterCondition"/>
            <if test="operatorKind != null and operatorKind == 'manual'">
                AND (operator_id IS NULL OR operator_id &lt;&gt; 'SYNC')
            </if>
            <if test="operatorKind != null and operatorKind == 'system'">
                AND operator_id = 'SYNC'
            </if>
        </where>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cage_form_audit_log (
            category, change_type, entity, entity_id, entity_code, entity_name,
            target_type, target_id, target_label,
            field_code, field_name, before_value, after_value, before_json, after_json,
            operator_id, created_at
        ) VALUES (
            #{category}, #{changeType}, #{entity}, #{entityId}, #{entityCode}, #{entityName},
            #{targetType}, #{targetId}, #{targetLabel},
            #{fieldCode}, #{fieldName}, #{beforeValue}, #{afterValue}, #{beforeJson}, #{afterJson},
            #{operatorId}, NOW()
        )
    </insert>

    <select id="listFiltered" resultMap="CageFormAuditLogMap">
        SELECT *
        FROM cage_form_audit_log
        <include refid="FilterWhere"/>
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countFiltered" resultType="long">
        SELECT COUNT(*)
        FROM cage_form_audit_log
        <include refid="FilterWhere"/>
    </select>

    <select id="countByEntity" resultType="map">
        SELECT entity AS entity, COUNT(*) AS cnt
        FROM cage_form_audit_log
        <where>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
        </where>
        GROUP BY entity
        ORDER BY cnt DESC
    </select>

    <select id="listByTargetId" resultMap="CageFormAuditLogMap">
        SELECT *
        FROM cage_form_audit_log
        WHERE target_id = #{targetId}
        <if test="category != null and category != ''">
            AND category = #{category}
        </if>
        ORDER BY created_at ASC, id ASC
    </select>

    <!-- 折叠状态区间用：只取五个特殊状态字段、data + animal_cage、created_at >= since。
         命中索引 idx_cage_form_audit_field (field_code, created_at)；
         ORDER BY id ASC 是折叠正确性的前提（同秒内 created_at 相同，靠 id 定序），调用方不重排。 -->
    <select id="listStatusFieldRows" resultMap="CageFormAuditLogMap">
        SELECT *
        FROM cage_form_audit_log
        WHERE category = 'data'
          AND target_type = 'animal_cage'
          AND (
            field_code IN
            <foreach collection="fieldCodes" item="fc" open="(" separator="," close=")">
                #{fc}
            </foreach>
            <!-- 特殊饲养明细：码表项可增长，按前缀取。
                 写成 LIKE CONCAT(前缀,'%') 而不是给下划线加转义 —— MySQL 只认 \n \t \\ \' 等有限几种转义，
                 `\_` **不是**其一，反斜杠会被原样保留，模式串变成 `SF_\_%`（要求字面反斜杠）→ 一条也匹配不到。
                 前缀 `SF_` 末尾那个下划线在这里当通配符用，没问题：码本身就是同一个常量拼出来的。 -->
            <if test="fieldPrefix != null and fieldPrefix != ''">
              OR field_code LIKE CONCAT(#{fieldPrefix}, '%')
            </if>
          )
        <if test="since != null">
          AND created_at &gt;= #{since}
        </if>
        ORDER BY id ASC
    </select>

    <!-- 按操作聚合：同笼位 + 同类型 + 同一秒 归为一次操作。id 单调，用 MIN(id) 当稳定排序键。 -->
    <select id="pageOperationGroups" resultType="map">
        SELECT target_id AS targetId,
               change_type AS changeType,
               DATE_FORMAT(created_at, '%Y-%m-%d %H:%i:%s') AS createdAt,
               MAX(operator_id) AS operatorId,
               COUNT(*) AS fieldCount,
               MIN(id) AS firstId
        FROM cage_form_audit_log
        <include refid="OperationFilterWhere"/>
        GROUP BY target_id, change_type, created_at
        ORDER BY firstId DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countOperationGroups" resultType="long">
        SELECT COUNT(*) FROM (
            SELECT 1
            FROM cage_form_audit_log
            <include refid="OperationFilterWhere"/>
            GROUP BY target_id, change_type, created_at
        ) t
    </select>

    <select id="listByOperationGroups" resultMap="CageFormAuditLogMap">
        SELECT a.*
        FROM cage_form_audit_log a
        JOIN (
            SELECT target_id, change_type, created_at, MIN(id) AS firstId
            FROM cage_form_audit_log
            <include refid="OperationFilterWhere"/>
            GROUP BY target_id, change_type, created_at
            ORDER BY firstId DESC
            LIMIT #{limit} OFFSET #{offset}
        ) g ON g.target_id = a.target_id
           AND g.change_type = a.change_type
           AND g.created_at = a.created_at
        <!-- 组内所有行共享笼位/类型/时间，这里再补一遍按行生效的条件，保证明细条数与分组计数一致 -->
        <where>
            <if test="category != null and category != ''">
                AND a.category = #{category}
            </if>
            <if test="operatorKind != null and operatorKind == 'manual'">
                AND (a.operator_id IS NULL OR a.operator_id &lt;&gt; 'SYNC')
            </if>
            <if test="operatorKind != null and operatorKind == 'system'">
                AND a.operator_id = 'SYNC'
            </if>
        </where>
        ORDER BY a.created_at DESC, a.id ASC
    </select>
</mapper>
