<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.cageshelf.mapper.CageFormTemplateMapper">

    <resultMap id="CageFormTemplateMap" type="com.example.demo.modules.cageshelf.entity.CageFormTemplate">
        <id property="id" column="id"/>
        <result property="formKey" column="form_key"/>
        <result property="title" column="title"/>
        <result property="kind" column="kind"/>
        <result property="dictKey" column="dict_key"/>
        <result property="hostType" column="host_type"/>
        <result property="status" column="status"/>
        <result property="version" column="version"/>
        <result property="active" column="active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id, form_key, title, kind, dict_key, host_type, status, version, active, created_at, updated_at
    </sql>

    <select id="selectAll" resultMap="CageFormTemplateMap">
        SELECT <include refid="BaseColumns"/>
        FROM cage_form_template
        WHERE active = 1
        ORDER BY kind ASC, form_key ASC
    </select>

    <select id="selectByFormKey" resultMap="CageFormTemplateMap">
        SELECT <include refid="BaseColumns"/>
        FROM cage_form_template
        WHERE form_key = #{formKey}
        LIMIT 1
    </select>

    <select id="selectById" resultMap="CageFormTemplateMap">
        SELECT <include refid="BaseColumns"/>
        FROM cage_form_template
        WHERE id = #{id}
        LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cage_form_template (form_key, title, kind, dict_key, host_type, status, version, active, created_at, updated_at)
        VALUES (#{formKey}, #{title}, #{kind}, #{dictKey}, #{hostType}, #{status}, #{version}, 1, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE cage_form_template
        SET title = #{title},
            status = #{status},
            version = #{version},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM cage_form_template WHERE id = #{id}
    </delete>
</mapper>
