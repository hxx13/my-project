<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.cageshelf.mapper.CageInfoFieldDictionaryMapper">

    <resultMap id="CageInfoFieldDictionaryMap" type="com.example.demo.modules.cageshelf.entity.CageInfoFieldDictionary">
        <id property="id" column="id"/>
        <result property="dictKey" column="dict_key"/>
        <result property="name" column="name"/>
        <result property="species" column="species"/>
        <result property="description" column="description"/>
        <result property="structureJson" column="structure_json"/>
        <result property="version" column="version"/>
        <result property="status" column="status"/>
        <result property="active" column="active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id, dict_key, name, species, description, structure_json, version, status, active, created_at, updated_at
    </sql>

    <select id="selectAllActive" resultMap="CageInfoFieldDictionaryMap">
        SELECT <include refid="BaseColumns"/>
        FROM cage_info_field_dictionary
        WHERE active = 1
        ORDER BY id ASC
    </select>

    <select id="selectByDictKey" resultMap="CageInfoFieldDictionaryMap">
        SELECT <include refid="BaseColumns"/>
        FROM cage_info_field_dictionary
        WHERE dict_key = #{dictKey}
        LIMIT 1
    </select>

    <select id="selectById" resultMap="CageInfoFieldDictionaryMap">
        SELECT <include refid="BaseColumns"/>
        FROM cage_info_field_dictionary
        WHERE id = #{id}
        LIMIT 1
    </select>

    <update id="update">
        UPDATE cage_info_field_dictionary
        SET name = #{name},
            species = #{species},
            description = #{description},
            structure_json = #{structureJson},
            version = #{version},
            updated_at = NOW()
        WHERE id = #{id}
    </update>
</mapper>
