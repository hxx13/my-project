<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.cageshelf.mapper.CageTransferLogMapper">

    <resultMap id="CageTransferLogMap" type="com.example.demo.modules.cageshelf.entity.CageTransferLog">
        <id property="id" column="id"/>
        <result property="fromAnimalCageId" column="from_animal_cage_id"/>
        <result property="toAnimalCageId" column="to_animal_cage_id"/>
        <result property="dataSnapshot" column="data_snapshot"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="reason" column="reason"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cage_transfer_log (from_animal_cage_id, to_animal_cage_id, data_snapshot, operator_id, operator_name, reason)
        VALUES (#{fromAnimalCageId}, #{toAnimalCageId}, #{dataSnapshot}, #{operatorId}, #{operatorName}, #{reason})
    </insert>

    <select id="selectByFrom" resultMap="CageTransferLogMap">
        SELECT * FROM cage_transfer_log WHERE from_animal_cage_id = #{animalCageId} ORDER BY created_at DESC
    </select>

    <select id="selectByTo" resultMap="CageTransferLogMap">
        SELECT * FROM cage_transfer_log WHERE to_animal_cage_id = #{animalCageId} ORDER BY created_at DESC
    </select>

</mapper>
