<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.facerecognition.mapper.FaceBaselineRecordMapper">

    <resultMap id="FaceBaselineResult" type="com.example.demo.modules.facerecognition.entity.FaceBaselineRecord">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="face_image_url" property="faceImageUrl"/>
        <result column="storage_key" property="storageKey"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO face_baseline (user_id, face_image_url, storage_key, created_at, updated_at)
        VALUES (#{userId}, #{faceImageUrl}, #{storageKey}, NOW(), NOW())
    </insert>

    <delete id="deleteById">
        DELETE FROM face_baseline WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM face_baseline WHERE user_id = #{userId}
    </delete>

    <select id="findByUserId" resultMap="FaceBaselineResult">
        SELECT * FROM face_baseline WHERE user_id = #{userId} ORDER BY created_at DESC LIMIT 1
    </select>

    <select id="findAllByUserId" resultMap="FaceBaselineResult">
        SELECT * FROM face_baseline WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <select id="findById" resultMap="FaceBaselineResult">
        SELECT * FROM face_baseline WHERE id = #{id}
    </select>

</mapper>
