<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.facerecognition.mapper.FaceDebugPhotoMapper">

    <resultMap id="FaceDebugPhotoResult" type="com.example.demo.modules.facerecognition.entity.FaceDebugPhoto">
        <id column="id" property="id"/>
        <result column="label" property="label"/>
        <result column="storage_key" property="storageKey"/>
        <result column="public_url" property="publicUrl"/>
        <result column="original_name" property="originalName"/>
        <result column="mime_type" property="mimeType"/>
        <result column="size_bytes" property="sizeBytes"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO face_debug_photo (label, storage_key, public_url, original_name, mime_type, size_bytes, created_at)
        VALUES (#{label}, #{storageKey}, #{publicUrl}, #{originalName}, #{mimeType}, #{sizeBytes}, NOW())
    </insert>

    <select id="findAll" resultMap="FaceDebugPhotoResult">
        SELECT * FROM face_debug_photo ORDER BY created_at DESC
    </select>

    <select id="findById" resultMap="FaceDebugPhotoResult">
        SELECT * FROM face_debug_photo WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM face_debug_photo WHERE id = #{id}
    </delete>

</mapper>
