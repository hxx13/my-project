<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.telemetry.mapper.TelemetryLongtermSampleLogMapper">

    <resultMap id="LogMap" type="com.example.demo.modules.telemetry.entity.TelemetryLongtermSampleLogRow">
        <id column="id" property="id"/>
        <result column="run_at" property="runAt"/>
        <result column="outcome" property="outcome"/>
        <result column="rows_written" property="rowsWritten"/>
        <result column="reason" property="reason"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO telemetry_longterm_sample_log (run_at, outcome, rows_written, reason, duration_ms)
        VALUES (#{runAt}, #{outcome}, #{rowsWritten}, #{reason}, #{durationMs})
    </insert>

    <select id="selectRecent" resultMap="LogMap">
        SELECT * FROM telemetry_longterm_sample_log ORDER BY run_at DESC, id DESC LIMIT #{limit}
    </select>
</mapper>
