<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.twin.scan.delay.mapper.TwinScanDelayRoomOptionMapper">

    <resultMap id="BaseMap" type="com.example.demo.modules.twin.scan.delay.entity.TwinScanDelayRoomOption">
        <id column="id" property="id"/>
        <result column="room_id" property="roomId"/>
        <result column="option_id" property="optionId"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <select id="listAll" resultMap="BaseMap">
        SELECT id, room_id, option_id, sort_order
        FROM twin_scan_delay_room_option
        ORDER BY room_id, sort_order DESC, id ASC
    </select>

    <select id="listByRoomId" resultMap="BaseMap">
        SELECT id, room_id, option_id, sort_order
        FROM twin_scan_delay_room_option
        WHERE room_id = #{roomId}
        ORDER BY sort_order DESC, id ASC
    </select>

    <select id="listByRoomIds" resultMap="BaseMap">
        SELECT id, room_id, option_id, sort_order
        FROM twin_scan_delay_room_option
        <if test="roomIds != null and roomIds.size() > 0">
            WHERE room_id IN
            <foreach collection="roomIds" item="rid" open="(" separator="," close=")">
                #{rid}
            </foreach>
        </if>
        ORDER BY room_id, sort_order DESC, id ASC
    </select>

    <delete id="deleteByRoomId">
        DELETE FROM twin_scan_delay_room_option WHERE room_id = #{roomId}
    </delete>

    <delete id="deleteByOptionId">
        DELETE FROM twin_scan_delay_room_option WHERE option_id = #{optionId}
    </delete>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO twin_scan_delay_room_option (room_id, option_id, sort_order)
        VALUES (#{roomId}, #{optionId}, #{sortOrder})
    </insert>
</mapper>
