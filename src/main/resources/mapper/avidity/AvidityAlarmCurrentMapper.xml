<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.avidity.mapper.AvidityAlarmCurrentMapper">

    <resultMap id="BaseMap" type="com.example.demo.modules.avidity.entity.AvidityAlarmCurrent">
        <id property="id" column="id"/>
        <result property="alarmId" column="alarm_id"/>
        <result property="virtualDeviceId" column="virtual_device_id"/>
        <result property="deviceName" column="device_name"/>
        <result property="alarmName" column="alarm_name"/>
        <result property="message" column="message"/>
        <result property="state" column="state"/>
        <result property="alarmLevel" column="alarm_level"/>
        <result property="alarmGroupName" column="alarm_group_name"/>
        <result property="triggeredTime" column="triggered_time"/>
        <result property="syncedAt" column="synced_at"/>
    </resultMap>

    <delete id="deleteAll">
        DELETE FROM avidity_alarm_current
    </delete>

    <insert id="insert" parameterType="com.example.demo.modules.avidity.entity.AvidityAlarmCurrent"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO avidity_alarm_current
        (alarm_id, virtual_device_id, device_name, alarm_name, message, state, alarm_level,
         alarm_group_name, triggered_time, synced_at)
        VALUES
        (#{alarmId}, #{virtualDeviceId}, #{deviceName}, #{alarmName}, #{message}, #{state}, #{alarmLevel},
         #{alarmGroupName}, #{triggeredTime}, #{syncedAt})
    </insert>

    <select id="selectAll" resultMap="BaseMap">
        SELECT * FROM avidity_alarm_current
        ORDER BY triggered_time DESC, id DESC
    </select>

</mapper>
