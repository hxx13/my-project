<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.avidity.mapper.AvidityAlarmNotifiedMapper">

    <resultMap id="BaseMap" type="com.example.demo.modules.avidity.entity.AvidityAlarmNotified">
        <id property="id" column="id"/>
        <result property="notifyKey" column="notify_key"/>
        <result property="ruleCode" column="rule_code"/>
        <result property="deviceName" column="device_name"/>
        <result property="alarmName" column="alarm_name"/>
        <result property="message" column="message"/>
        <result property="notifiedAt" column="notified_at"/>
    </resultMap>

    <insert id="insertIgnore" parameterType="com.example.demo.modules.avidity.entity.AvidityAlarmNotified"
            useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO avidity_alarm_notified
        (notify_key, rule_code, device_name, alarm_name, message, notified_at)
        VALUES
        (#{notifyKey}, #{ruleCode}, #{deviceName}, #{alarmName}, #{message}, #{notifiedAt})
    </insert>

    <select id="selectRecent" resultMap="BaseMap">
        SELECT * FROM avidity_alarm_notified
        ORDER BY notified_at DESC, id DESC
        LIMIT #{limit}
    </select>

    <delete id="deleteByKey">
        DELETE FROM avidity_alarm_notified WHERE notify_key = #{notifyKey}
    </delete>

</mapper>
