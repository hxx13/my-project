<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.avidity.mapper.AvidityChannelMapper">

    <resultMap id="BaseMap" type="com.example.demo.modules.avidity.entity.AvidityChannel">
        <id property="id" column="id"/>
        <result property="channelId" column="channel_id"/>
        <result property="channelName" column="channel_name"/>
        <result property="sortIndex" column="sort_index"/>
        <result property="virtualDeviceId" column="virtual_device_id"/>
        <result property="deviceName" column="device_name"/>
        <result property="configureViewId" column="configure_view_id"/>
        <result property="syncedAt" column="synced_at"/>
    </resultMap>

    <delete id="deleteAll">
        DELETE FROM avidity_channel
    </delete>

    <insert id="insert" parameterType="com.example.demo.modules.avidity.entity.AvidityChannel"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO avidity_channel
        (channel_id, channel_name, sort_index, virtual_device_id, device_name, configure_view_id, synced_at)
        VALUES
        (#{channelId}, #{channelName}, #{sortIndex}, #{virtualDeviceId}, #{deviceName}, #{configureViewId}, #{syncedAt})
    </insert>

    <select id="selectAll" resultMap="BaseMap">
        SELECT * FROM avidity_channel
        ORDER BY sort_index, channel_id, virtual_device_id
    </select>

</mapper>
