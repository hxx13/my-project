<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.modules.notification.push.recipient.NotifySourceRecipientMapper">
  <resultMap id="BaseResultMap" type="com.example.demo.modules.notification.push.recipient.NotifySourceRecipient">
    <id column="id" property="id"/>
    <result column="source_id" property="sourceId"/>
    <result column="perspective" property="perspective"/>
    <result column="scope_type" property="scopeType"/>
    <result column="scope_value" property="scopeValue"/>
  </resultMap>
  <select id="findBySourceId" resultMap="BaseResultMap">SELECT * FROM notify_source_recipient WHERE source_id = #{sourceId}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO notify_source_recipient (source_id, perspective, scope_type, scope_value)
    VALUES (#{sourceId}, #{perspective}, #{scopeType}, #{scopeValue})
  </insert>
  <delete id="deleteById">DELETE FROM notify_source_recipient WHERE id = #{id}</delete>
  <delete id="deleteBySourceId">DELETE FROM notify_source_recipient WHERE source_id = #{sourceId}</delete>
</mapper>
